---
// Версия 7 лендинга: v6, прогнанная через скиллы. Тексты: src/data/content-v7.ts.
// Изменения по сравнению с v6 — в founder/landing.md, раздел v7.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import ScreenSlot from '../components/ScreenSlot.astro';
import MiniReport from '../components/MiniReport.astro';
import Pen from '../components/Pen.astro';
import { botLink } from '../data/content';
import { fmt } from '../lib/fmt';
import {
  meta, cta, nav, hero, result, analytics, send, what, compare, reports, segments, reviews, data, pricing, faq, final, footer, steps,
} from '../data/content-v7';

// Карандашные пометки: режем заголовок на «до / слово / после».
const cut = (text: string, word: string) => { const i = text.indexOf(word); return i < 0 ? [text, '', ''] : [text.slice(0, i), word, text.slice(i + word.length)]; };
const h1Cut = cut(hero.title, '20\u00a0минут');
const resCut = cut(result.title, '20 минут');
const anA = cut(analytics.title, 'Таблица');
const anB = cut(anA[2], 'ведётся сама');
const sendCut = cut(send.title, 'дальше');
const variants = ['plain', 'final', 'steps', 'numbers', 'circle', 'underline', 'side'] as const;

// Разметка для поиска и ИИ-ответов: продукт с тарифами и вопросы. Цены — временные, как на странице.
const site = 'https://nota.axiomco.io';
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Nota',
    url: `${site}/`,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Telegram',
    inLanguage: ['ru', 'en', 'id'],
    description: meta.description,
    publisher: { '@type': 'Organization', name: 'Axiom Consulting' },
    offers: pricing.plans.map((p) => ({
      '@type': 'Offer', name: p.name, price: p.month.price.replace('$', ''), priceCurrency: 'USD',
      url: botLink(p.tag),
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={meta.title} description={meta.description} noindex og="/og-v7.png">
  <a class="skip" href="#main">К содержанию</a>
  <!-- Технический переключатель вариантов: «Как сейчас» / «Шаги со стрелками». Убрать перед запуском. -->
  <div class="techbar" role="group" aria-label={steps.bar.label}>
    <div class="wrap">
      <span class="techbar-label">{steps.bar.label}</span>
      {variants.map((v, i) => <button type="button" data-variant={v} aria-pressed={i === 0 ? 'true' : 'false'}>{steps.bar[v]}</button>)}
      <small>{steps.bar.note}</small>
    </div>
  </div>
  <script is:inline>
    (function () {
      var root = document.documentElement;
      var known = ['final', 'steps', 'numbers', 'circle', 'underline', 'side'];
      function set(v) {
        if (known.indexOf(v) < 0) v = 'plain';
        if (v === 'plain') root.removeAttribute('data-variant'); else root.setAttribute('data-variant', v);
        document.querySelectorAll('.techbar [data-variant]').forEach(function (b) { b.setAttribute('aria-pressed', b.dataset.variant === v ? 'true' : 'false'); });
        document.dispatchEvent(new CustomEvent('variant'));
      }
      set(location.hash.slice(1));
      document.querySelectorAll('.techbar [data-variant]').forEach(function (b) {
        b.addEventListener('click', function () {
          set(b.dataset.variant);
          try { history.replaceState(null, '', b.dataset.variant === 'plain' ? location.pathname + location.search : '#' + b.dataset.variant); } catch (e) {}
        });
      });
    })();
  </script>
  <header class="header">
    <div class="wrap">
      <a class="logo-link" href="/" aria-label="Nota — на главную"><Logo height={30} /></a>
      <nav aria-label="Разделы">{nav.map((n) => <a href={n.href}>{n.label}</a>)}</nav>
      <a class="btn btn--sm btn--dark" href={botLink('land7_header')}>Открыть в Telegram</a>
    </div>
  </header>

  <main class="tight v7" id="main">
    <!-- 1. Первый экран: архив → отчёт за 20 минут, QR, пример отчёта -->
    <section class="hero hero2 hero3">
      <div class="wrap split hero-split">
        <div>
          <span class="side-num" aria-hidden="true">1</span>
          <span class="hero-eyebrow">{hero.eyebrow}</span>
          <h1 data-side="1">{h1Cut[0]}<Pen c u id="h1">{h1Cut[1]}</Pen>{h1Cut[2]}</h1>
          <p class="lead">{hero.lead}</p>
          <div class="time-strip">
            <div class="ts-item"><small>{hero.you.k}</small><b>{hero.you.v}</b><span>{hero.you.t}</span></div>
            <span class="ts-arrow" aria-hidden="true">→</span>
            <div class="ts-item ts-item--nota"><small>{hero.nota.k}</small><b>{hero.nota.v}</b><span>{hero.nota.t}</span></div>
          </div>
          <div class="step-tag v-steps"><span class="step-n">1</span>{steps.tags[0]}</div>
          <div class="num-group">
          <span class="num-dot" aria-hidden="true"><i>1</i></span>
          <div class="cta-row cta-row--qr">
            <a class="btn" href={botLink('land7_hero')}>{cta}</a>
            <div class="cta-qr">
              <img src="/screens/qr-bot.svg" alt="QR-код: открыть @NotaGetBot в Telegram" width="64" height="64" />
              <span>{hero.qr}</span>
            </div>
          </div>
          <p class="cta-note">{hero.note}</p>
          <details class="howto-mini">
            <summary>{hero.howto.summary}</summary>
            <ul>{hero.howto.lines.map((l) => <li>{l}</li>)}</ul>
          </details>
          </div>
        </div>
        <figure class="hero-report">
          <span class="rep-wrap">
          <svg class="pen-svg rep-pen" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path pathLength="1" d="M30 41C11 26 52 6 108 6c56 0 90 13 86 30-4 15-58 21-104 19C44 53 5 45 9 30 12 19 40 10 74 8" /></svg>
          <img src={hero.report.file} alt="Пример отчёта Nota по архиву: 96,15 млн рупий, 37 платежей, 2 дубля, 3 стоит проверить, категории и поставщики" width={hero.report.w} height={hero.report.h} fetchpriority="high" />
          </span>
          <figcaption>{hero.report.caption}</figcaption>
        </figure>
      </div>
    </section>

    <!-- 2. Что придёт через 20 минут -->
    <section class="section num-sec" id="result">
      <div class="wrap">
        <div class="v-plain">
          <span class="side-num" aria-hidden="true">2</span>
          <h2 class="h2-gap" data-side="2">{resCut[0]}<Pen c u id="result">{resCut[1]}</Pen>{resCut[2]}</h2>
          <div class="grid" style="--min: 280px">
            {result.items.map((r) => {
              const t = r.icon === 'table' ? cut(r.title, 'Таблица') : null;
              return (
                <div class="card card--compact"><div class="send-head"><div class="card-icon"><Icon name={r.icon} /></div><h3>{t ? <>{t[0]}<Pen c id="tcard">{t[1]}</Pen>{t[2]}</> : r.title}</h3></div><p>{r.text}</p></div>
              );
            })}
          </div>
          <p class="note">{result.note}</p>
        </div>
        <div class="v-steps">
          <div class="step-tag step-tag--link"><span class="step-n">2</span>{steps.tags[1]}</div>
          <h2 class="h2-gap"><span class="num-dot" aria-hidden="true"><i>2</i></span><span class="t-steps">{steps.report.title}</span><span class="t-final">{steps.report.titleFinal}</span></h2>
          <div class="grid" style="--min: 280px">
            {steps.report.items.map((r) => (
              <div class="card card--compact"><div class="send-head"><div class="card-icon"><Icon name={r.icon} /></div><h3>{r.title}</h3></div><p>{r.text}</p></div>
            ))}
          </div>
          <p class="note">{steps.report.note}</p>
        </div>
        <div class="cta-row" style="margin-top: 24px"><a class="btn" href={botLink('land7_result')}>{cta}</a></div>
      </div>
    </section>

    <!-- 3. Таблица, которая ведётся сама -->
    <section class="section section--line num-sec" id="analytics">
      <div class="wrap">
        <div class="v-plain">
          <span class="side-num" aria-hidden="true">3</span>
          <h2 data-side="3">{anA[0]}<Pen c id="table">{anA[1]}</Pen>{anB[0]}<Pen u>{anB[1]}</Pen>{anB[2]}</h2>
          <p class="lead">{analytics.lead}</p>
        </div>
        <div class="v-steps">
          <div class="step-tag step-tag--link"><span class="step-n">3</span>{steps.tags[2]}</div>
          <h2><span class="num-dot" aria-hidden="true"><i>3</i></span>{steps.table.title}</h2>
          <p class="lead">{steps.table.lead}</p>
        </div>
        <div class="an" data-an>
          <div class="an-pick" role="tablist" aria-label="Листы таблицы">
            {analytics.screens.map((sc, i) => (
              <button type="button" role="tab" class="an-btn" id={`an-tab-${sc.id}`} aria-controls={`an-panel-${sc.id}`} aria-selected={i === 0 ? 'true' : 'false'}>
                <small>{sc.tab}</small><b>{sc.label}</b><span>{sc.short}</span>
              </button>
            ))}
          </div>
          {analytics.screens.map((sc, i) => (
            <div class:list={['an-panel', { on: i === 0 }]} role="tabpanel" id={`an-panel-${sc.id}`} aria-labelledby={`an-tab-${sc.id}`}>
              <ScreenSlot file={sc.file} tab={sc.tab} tabs={analytics.tabs} alt={`Лист ${sc.tab} на тестовых данных`} w={sc.w} h={sc.h} mobile={sc.mobile} />
              <ul class="an-points">{sc.points.map((t) => <li><Icon name="check" size={20} />{t}</li>)}</ul>
            </div>
          ))}
        </div>
        <script is:inline>
          (function () {
            var root = document.querySelector('[data-an]');
            if (!root) return;
            root.classList.add('js');
            var tabs = root.querySelectorAll('[role="tab"]');
            var panels = root.querySelectorAll('[role="tabpanel"]');
            function show(i) {
              tabs.forEach(function (t, k) { t.setAttribute('aria-selected', k === i ? 'true' : 'false'); t.tabIndex = k === i ? 0 : -1; });
              panels.forEach(function (p, k) { p.classList.toggle('on', k === i); });
            }
            tabs.forEach(function (t, i) {
              t.addEventListener('click', function () { show(i); });
              t.addEventListener('keydown', function (e) {
                if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
                var n = (i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length;
                show(n); tabs[n].focus();
              });
            });
            show(0);
          })();
        </script>
        <p class="note">{analytics.note}</p>
      </div>
    </section>

    <!-- 4. Как присылать документы дальше: четыре способа, группа по желанию -->
    <section class="section section--paper num-sec" id="send">
      <div class="wrap">
        <div class="step-tag step-tag--link v-steps"><span class="step-n">4</span>{steps.tags[3]}</div>
        <span class="side-num" aria-hidden="true">4</span>
        <h2 class="h2-gap" data-side="4"><span class="num-dot" aria-hidden="true"><i>4</i></span>{sendCut[0]}<Pen u>{sendCut[1]}</Pen>{sendCut[2]}</h2>
        <div class="grid" style="--min: 240px">
          {send.items.map((c) => (
            <div class="card send-card send-card--row">
              <div class="send-head"><div class="card-icon"><Icon name={c.icon} /></div><h3>{c.title}</h3></div>
              <p>{c.text}</p>
              <span class:list={['tag', `tag--${c.tone}`]}>{c.tag}</span>
            </div>
          ))}
        </div>
        <p class="note">{send.seen}</p>
      </div>
    </section>

    <!-- 5. Что Nota делает с каждым документом: список вместо серых карточек + цифра -->
    <section class="section" id="what">
      <div class="wrap">
        <h2 class="h2-gap">{what.title}</h2>
        <ul class="feat-list">
          {what.items.map((c) => (
            <li><span class="feat-icon"><Icon name={c.icon} /></span><div><h3>{c.title}</h3><p>{c.text}</p></div></li>
          ))}
        </ul>
        <div class="proof-band"><b>{what.proof.value}</b><span>{what.proof.text}</span></div>
      </div>
    </section>

    <!-- 6. Сравнение: накладная в 9:41 -->
    <section class="section section--line">
      <div class="wrap">
        <h2 class="cmp-title">{compare.title}</h2>
        <div class="cmp" role="table" aria-label="Сравнение: Nota, админ с Excel, приложение для расходов">
          <div class="cmp-row cmp-head" role="row">
            <div class="cmp-q" role="columnheader"><span class="sr-only">Вопрос</span></div>
            {compare.options.map((o) => (
              <div class:list={['cmp-c', { 'cmp-c--nota': o.nota }]} role="columnheader">{o.nota ? <Logo height={24} /> : o.name}</div>
            ))}
          </div>
          <div class="cmp-row cmp-when" role="row">
            <div class="cmp-q" role="rowheader">{compare.whenLabel}</div>
            {compare.options.map((o) => (
              <div class:list={['cmp-c', { 'cmp-c--nota': o.nota }]} role="cell">
                <span class="cmp-who">{o.short ?? o.name}</span><b>{o.when}</b><small>{o.whenNote}</small>
              </div>
            ))}
          </div>
          {compare.rows.map((q, i) => (
            <div class="cmp-row" role="row">
              <div class="cmp-q" role="rowheader">{q}</div>
              {compare.options.map((o) => {
                const [m, t] = o.cells[i];
                return (
                  <div class:list={['cmp-c', `m-${m}`, { 'cmp-c--nota': o.nota }]} role="cell">
                    <span class="vs-mark"><Icon name={m === 'yes' ? 'check' : m === 'no' ? 'x' : 'minus'} size={16} /></span>
                    <span class="cmp-who">{o.short ?? o.name}</span>
                    <span class="cmp-t">{t}</span>
                  </div>
                );
              })}
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 7. Отчёт каждый понедельник. Октябрь сведён с примером отчёта на первом экране: 96,15 млн, 37 платежей -->
    <section class="section section--paper">
      <div class="wrap">
        <h2>{reports.title}</h2>
        <p class="lead">{reports.lead}</p>
        <div class="reports-row">
          <MiniReport
            title="Неделя · 3–9 ноя" period="Сравнение с прошлой неделей: +8%" total="21,70" sub="16 платежей"
            marks={[{ n: '1', label: 'дубль', alert: true }, { n: '2', label: 'проверить', alert: true }, { n: '4', label: 'рукописных' }, { n: '0', label: 'не прочитано' }]}
            bars={[3.1, 5.4, 2.2, 6.8, 2.9, 0.8, 0.5]}
            cats={[['Материалы', '9 800 000', 45], ['Подрядчики', '6 200 000', 29], ['Без категории', '700 000', 3]]}
          />
          <MiniReport
            title="Октябрь 2026" period="Сравнение с сентябрём: −4%" total="96,15" sub="37 платежей"
            marks={[{ n: '2', label: 'дубля', alert: true }, { n: '3', label: 'проверить', alert: true }, { n: '9', label: 'рукописных' }, { n: '1', label: 'не прочитано' }]}
            bars={[18.4, 31.2, 26.9, 19.65]} barsLabel="По неделям"
            cats={[['Материалы', '41 120 000', 43], ['Подрядчики', '24 600 000', 26], ['Зарплаты', '14 400 000', 15]]}
          />
        </div>
      </div>
    </section>

    <!-- 8. Для кого: компактный список вместо серых карточек -->
    <section class="section">
      <div class="wrap">
        <h2 class="h2-gap">{segments.title}</h2>
        <ul class="seg-list">{segments.items.map((c) => <li><h3>{c.title}</h3><p>{c.text}</p></li>)}</ul>
        <p class="note">{segments.note}</p>
      </div>
    </section>

    <!-- 9. Отзывы (заглушки до реальных текстов) -->
    <section class="section section--paper">
      <div class="wrap">
        <h2 class="h2-gap">{reviews.title}</h2>
        <div class="grid reviews" style="--min: 250px">
          {reviews.items.map((r) => (
            <figure class="review">
              <blockquote set:html={fmt(r.text)} />
              <figcaption><b set:html={fmt(r.name)} /><span set:html={fmt(r.role)} /></figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 10. Цены: подняты перед «Ваши данные»; переключатель «помесячно / за год» -->
    <section class="section" id="price" data-bill="month">
      <div class="wrap">
        <div class="price-head">
          <div>
            <h2>{pricing.title}</h2>
            <p class="lead">{pricing.lead}</p>
          </div>
          <fieldset class="bill">
            <legend class="sr-only">{pricing.billing.label}</legend>
            <label><input type="radio" name="bill" value="month" checked /><span>{pricing.billing.month}</span></label>
            <label><input type="radio" name="bill" value="year" /><span>{pricing.billing.year} <em>{pricing.billing.save}</em></span></label>
          </fieldset>
        </div>
        <div class="grid plans" style="--min: 290px; gap: 24px">
          {pricing.plans.map((p) => (
            <div class:list={['plan', { 'plan--hl': p.highlight }]}>
              <h3>{p.name}</h3>
              <div class="plan-price">
                <span class="pm">{p.month.price}</span><span class="py">{p.year.price}</span><small> / мес</small>
              </div>
              <div class="plan-unit">
                <span class="pm">{p.month.unit}</span><span class="py">{p.year.total} · {p.year.unit}</span>
              </div>
              <p><b>{p.docs}</b><br /><span class="muted">{p.who}</span></p>
              <ul class="check">{[...p.feats, ...pricing.common].map((f) => <li><Icon name="check" size={20} />{f}</li>)}</ul>
              <a class:list={['btn', 'btn--plan', { 'btn--outline': p.outline }]} href={botLink(p.tag)}>{p.cta}</a>
            </div>
          ))}
        </div>
        <dl class="plan-facts3">
          {pricing.facts.map((f) => <div><dt>{f.q}</dt><dd>{f.a}</dd></div>)}
        </dl>
        <script is:inline>
          (function () {
            var sec = document.getElementById('price');
            if (!sec) return;
            sec.querySelectorAll('input[name="bill"]').forEach(function (r) {
              r.addEventListener('change', function () { if (r.checked) sec.setAttribute('data-bill', r.value); });
            });
          })();
        </script>
      </div>
    </section>

    <!-- 11. Данные и кто делает -->
    <section class="section section--dark">
      <div class="wrap">
        <h2>{data.title}</h2>
        <div class="grid" style="--min: 300px; gap: 36px">
          {data.items.map((d) => (
            <div class="dark-item"><Icon name={d.icon} /><div><h3>{d.title}</h3><p set:html={fmt(d.text)} /></div></div>
          ))}
        </div>
        <div class="who"><span class="who-label">КТО ДЕЛАЕТ</span><p>{data.who} <span class="op-line" set:html={fmt(data.operator)} /></p></div>
      </div>
    </section>

    <!-- 12. Вопросы -->
    <section class="section" id="faq">
      <div class="wrap">
        <h2 style="margin-bottom: 24px">Вопросы</h2>
        <div class="faq">{faq.map((f) => <details><summary>{f.q}</summary><p set:html={fmt(f.a)} /></details>)}</div>
      </div>
    </section>

    <!-- Финал -->
    <section class="section--dark final">
      <div class="wrap">
        <h2>{final.title}</h2>
        <p>{final.lead}</p>
        <a class="btn" href={botLink('land7_final')}>{cta}</a>
        <div class="final-qr">
          <img src="/screens/qr-bot.svg" alt="QR-код: открыть @NotaGetBot в Telegram" width="96" height="96" />
          <span>Или наведите камеру телефона</span>
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap">
      <div class="brand"><Logo height={24} color="#F2F0EA" /><span>by Axiom</span></div>
      <nav aria-label="Документы">
        <a href={footer.terms}>Пользовательское соглашение <mark class="todo">ссылка</mark></a>
        <a href={footer.privacy}>Политика конфиденциальности <mark class="todo">ссылка</mark></a>
        <a href={botLink('land7_support')}>Поддержка в боте</a>
      </nav>
      <div class="op">{footer.operator} · © 2026</div>
    </div>
  </footer>
  <script is:inline>
    // Карандашные стрелки (вариант «Обводки») и нить с номерами на поле (вариант «Нить сбоку»).
    // Рисуются поверх страницы одним SVG и пересчитываются при любом изменении размеров.
    (function () {
      var root = document.documentElement, NS = 'http://www.w3.org/2000/svg', layer, timer;
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function q(s) { return document.querySelector(s); }
      function box(e) { var r = e.getBoundingClientRect(); return { l: r.left + scrollX, r: r.right + scrollX, t: r.top + scrollY, b: r.bottom + scrollY, cx: (r.left + r.right) / 2 + scrollX, cy: (r.top + r.bottom) / 2 + scrollY }; }
      function add(d, cls) { var p = document.createElementNS(NS, 'path'); p.setAttribute('d', d); p.setAttribute('pathLength', '1'); if (cls) p.setAttribute('class', cls); layer.appendChild(p); return p; }
      function head(x, y, fx, fy, cls) {
        var a = Math.atan2(y - fy, x - fx), L = 13, s = 0.5;
        add('M' + (x - L * Math.cos(a - s)) + ' ' + (y - L * Math.sin(a - s)) + ' L' + x + ' ' + y + ' L' + (x - L * Math.cos(a + s)) + ' ' + (y - L * Math.sin(a + s)), cls || 'pen-head');
      }
      function ring(x, y, n) {
