        forPeriod: '{sum} за {m}', mGen: { 3: '3 месяца', 6: '6 месяцев' }, yours: 'ваш тариф',
        packH: 'Не хватает документов', packT: '+50 документов — $10', packD: 'Добавятся сразу и действуют до {d}, тариф менять не нужно.',
        packLow: 'Осталось {n} из {l} документов. ', packFree: 'Пакеты можно докупать, когда тариф уже действует.',
        sumH: 'Итого', linePack: '+50 документов × {n}', lineCredit: 'Зачёт: {days} тарифа «{p}»',
        docsLine: 'Документов в месяц', term: 'Новый срок', due: 'К оплате', choose: 'Выберите тариф, чтобы увидеть сумму.',
        sameAuto: 'Это ваш тариф: он продлится сам {d} — {sum}. Сейчас платить не нужно.',
        leftover: 'Остаток зачёта {sum} уменьшит следующее списание.',
        email: 'Почта для чека и уведомлений о списаниях', emailErr: 'Проверьте адрес почты',
        method: 'Способ оплаты', card: 'Карта', cardSub: 'Visa, Mastercard', crypto: 'Криптовалюта', cryptoSub: 'разово, без автопродления',
        auto: 'Продлевать автоматически', every: { 1: 'каждый месяц', 3: 'каждые 3 месяца', 6: 'каждые 6 месяцев' },
        autoText: '{sum} {every}, следующее списание {d}. Отключить можно в любой момент.',
        oneTime: 'Разовая оплата: тариф закончится {d}, продлить можно здесь же.',
        pay: 'Оплатить {sum}', nothing: 'Сейчас платить не нужно', next: 'Выберите тариф',
        fineCard: 'Оплата проходит на защищённой странице Bank of Georgia. После оплаты таблица обновится сама.',
        fineCrypto: 'Откроется страница оплаты криптовалютой. Таблица обновится, когда сеть подтвердит платёж.',
        terms: 'Условия использования', refund: 'Правила возврата', privacy: 'Конфиденциальность',
        more: 'Больше 500 документов в месяц?', moreL: 'Обсудим индивидуально', ask: 'Вопросы по оплате',
        invoice: 'Нужен счёт с реквизитами компании? Запросите его в боте.', missing: 'Ссылка появится позже',
