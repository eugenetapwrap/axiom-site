      return '<h2 class="pp-h2">' + t('period') + '</h2>' + radios(t('period'), [1, 3, 6].map(function (m) { return { n: 'pp-bill', v: m, l: t('m')[m], e: m === 3 ? '−10%' : m === 6 ? '−15%' : '' }; }), S.sel.period);
    }
