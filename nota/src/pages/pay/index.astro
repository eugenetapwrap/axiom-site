    };

    // ── Даты и числа
    var DAY = 864e5;
    var now0 = new Date(); var TODAY = new Date(now0.getFullYear(), now0.getMonth(), now0.getDate());
    function addDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
