    function diff(a, b) { return Math.round((b - a) / DAY); }
    function endOf(start, months) { return addDays(addMonths(start, months), -1); }
    function r2(x) { return Math.round(x * 100) / 100; }
    var LOC = { ru: 'ru-RU', en: 'en-GB', id: 'id-ID' };
    function fd(d) { return d ? new Intl.DateTimeFormat(LOC[S.lang], { day: 'numeric', month: 'long' }).format(d) : ''; }
    function money(x) {
      var neg = x < 0; x = Math.abs(r2(x));
      var s = Number.isInteger(x) ? String(x) : x.toFixed(2);
      if (S.lang !== 'en') s = s.replace('.', ',');
      return (neg ? '−' : '') + '$' + s;
    }
    function days(n) {
      if (S.lang === 'ru') { var a = n % 10, b = n % 100; var w = (a === 1 && b !== 11) ? 'день' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'дня' : 'дней'; return n + ' ' + w; }
      if (S.lang === 'en') return n + (n === 1 ? ' day' : ' days');
      return n + ' hari';
    }
    function t(k, v) {
      var s = T[S.lang][k]; if (s == null) s = T.ru[k];
      if (v) Object.keys(v).forEach(function (x) { s = s.split('{' + x + '}').join(v[x]); });
      return s;
    }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function pname(p) { return T[S.lang].names[p] || p; }

    // ── Тестовые данные (пока нет сервера). Даты считаются от сегодняшнего дня.
    var DEMO = [
      ['free', 'Бесплатные документы'], ['active', 'Тариф действует, автопродление'], ['manual', 'Тариф действует, без автопродления (крипто)'],
      ['low', 'Мало документов'], ['expired', 'Срок истёк, списание не прошло'], ['processing', 'Оплата обрабатывается'],
      ['success', 'Оплачено'], ['failed', 'Оплата не прошла'], ['notfound', 'Ссылка не найдена'], ['manage', 'Управление подпиской']
    ];
    function mock(kind) {
      var name = { ru: 'Nota — Ваша компания', en: 'Nota — Your company', id: 'Nota — Perusahaan Anda' }[S.lang];
      var b = { table: name, owner: 'i•••@gmail.com', sheetUrl: '#', email: '', history: [] };
      var from = addDays(TODAY, -17), until = addDays(TODAY, 12);
      var paid = { plan: 'growth', period: 1, paid: 35, limit: 200, used: 72, from: from, until: until, auto: true, method: 'card', card: '4242' };
      var hist = [[from, 35], [addMonths(from, -1), 35], [addMonths(from, -2), 35]];
      if (kind === 'free') return Object.assign(b, { plan: 'free', period: 0, paid: 0, limit: 30, used: 12, from: null, until: null, auto: false, method: null, card: null });
      if (kind === 'manual') return Object.assign(b, paid, { auto: false, method: 'crypto', card: null, history: hist.slice(0, 1) });
      if (kind === 'low') return Object.assign(b, paid, { used: 194, history: hist });
      if (kind === 'expired') return Object.assign(b, paid, { from: addDays(TODAY, -36), until: addDays(TODAY, -6), used: 161, auto: false, failed: { date: addDays(TODAY, -5), sum: 35 }, history: hist.slice(1) });
      return Object.assign(b, paid, { history: hist });
    }

    // ── Состояние страницы
    var S = { lang: 'ru', screen: 'pay', demo: 'active', d: null, sel: null, emailBad: false, confirmOff: false, last: null, customEmail: false };
    function isActive(d) { return d && d.plan !== 'free' && d.until && d.until >= TODAY; }
    function defaultSel(d) {
      var keep = d.plan !== 'free';
      // На бесплатном сразу выбран «Рост» — его же выделяет лендинг; сумма видна сразу
