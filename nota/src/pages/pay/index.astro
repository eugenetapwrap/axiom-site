    function renderPay() {
      var q = quote();
      app.innerHTML = '<h1 class="pp-h1">' + t('title') + '</h1><div class="pp-grid"><div>' + ctx() + periods() + plans() + pack(q) + '</div>' + summary(q) + '</div>' + foot();
      bar.hidden = !(q && q.total > 0);
      bar.innerHTML = '<div class="in"><div class="s1">' + (q ? t('planLine', { p: pname(S.sel.plan), m: t('m')[S.sel.period] }) + '<b>' + money(q.total) + '</b>' : t('choose')) + '</div>' +
        (q && q.total > 0 ? '<button type="button" class="pp-btn" data-act="pay">' + t('pay', { sum: money(q.total) }) + '</button>' : '<button type="button" class="pp-btn" disabled>' + (q ? t('nothing') : t('next')) + '</button>') + '</div>';
    }
    var ICON_OK = '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>';
    var ICON_X = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M7 7l10 10M17 7L7 17"/></svg>';
    var ICON_Q = '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/></svg>';
    function renderOne(icon, cls, h, p, btns) {
      bar.hidden = true;
      app.innerHTML = '<div class="pp-one"><div class="pp-ic ' + cls + '">' + icon + '</div><h1>' + h + '</h1>' + p + (btns || '') + '</div>' + foot();
    }
    function renderProcessing() { bar.hidden = true; app.innerHTML = '<div class="pp-one"><div class="pp-ic" style="background:none"><div class="pp-spin" aria-hidden="true"></div></div><h1>' + t('procH') + '</h1><p>' + t('procP') + '</p></div>' + foot(); }
    function renderSuccess() {
      // После оплаты в браузере — то, что выбрали; после возврата со страницы банка — свежие данные с сервера.
      var d = S.d, q = S.last || (d && d.plan && d.plan !== 'free' && d.until ? { plan: d.plan, period: d.period, end: d.until, auto: d.auto, price: PLANS[d.plan].total[d.period], nextDate: addDays(d.until, 1) }
        : { plan: 'growth', period: 1, end: endOf(TODAY, 1), auto: true, price: 35, nextDate: addMonths(TODAY, 1) });
      var p = '<p>' + t('okP', { p: pname(q.plan), d: fd(q.end), n: PLANS[q.plan].docs }) + (q.auto ? ' ' + t('okNext', { d: fd(q.nextDate), sum: money(q.price) }) : '') + '</p><p>' + t('okP2') + '</p>';
      renderOne(ICON_OK, '', t('okH'), p, '<a class="pp-btn" href="' + esc(S.d.sheetUrl || '#') + '" target="_blank" rel="noopener">' + t('openSheet') + '</a><a class="pp-btn sec" href="' + esc(CONFIG.bot) + '" target="_blank" rel="noopener">' + t('openBot') + '</a>');
    }
    function renderFailed() { renderOne(ICON_X, 'bad', t('failH'), '<p>' + t('failP') + '</p>', '<button type="button" class="pp-btn" data-act="retry">' + t('retry') + '</button><button type="button" class="pp-btn sec" data-act="retry-crypto">' + t('payCrypto') + '</button>'); }
    function renderNotFound() { renderOne(ICON_Q, 'nf', t('nfH'), '<p>' + t('nfP') + '</p>', '<a class="pp-btn" href="' + esc(CONFIG.bot) + '" target="_blank" rel="noopener">' + t('openBot') + '</a>'); }
    function renderManage() {
      var d = S.d; bar.hidden = true;
      var h = '<div class="pp-mg"><button type="button" class="pp-link pp-back" data-act="back">' + t('back') + '</button><h1 class="pp-h1">' + t('subH') + '</h1><div class="pp-card">';
      h += '<div class="pp-row"><span>' + t('rPlan') + '</span><b>' + t('planLine', { p: pname(d.plan), m: t('m')[d.period] }) + ' · ' + money(PLANS[d.plan].total[d.period]) + '</b></div>';
      if (d.auto) h += '<div class="pp-row"><span>' + t('rNext') + '</span><b>' + fd(addDays(d.until, 1)) + ' · ' + money(PLANS[d.plan].total[d.period]) + '</b></div>';
      else h += '<div class="pp-row"><span>' + t('rUntil') + '</span><b>' + fd(d.until) + '</b></div>';
      if (d.card) h += '<div class="pp-row"><span>' + t('rCard') + '</span><b>•• ' + esc(d.card) + '</b></div>';
      h += '<div class="pp-acts"><button type="button" class="pp-btn sec" data-act="back">' + t('changePlan') + '</button>' + (d.card ? '<button type="button" class="pp-btn sec" data-act="card">' + t('changeCard') + '</button>' : '') +
        (d.auto ? (S.confirmOff ? '' : '<button type="button" class="pp-btn sec" data-act="off">' + t('autoOff') + '</button>') : (d.card ? '<button type="button" class="pp-btn" data-act="on">' + t('autoOnBtn') + '</button>' : '')) + '</div>';
      if (d.auto && S.confirmOff) h += '<div class="pp-conf">' + t('confirm', { d: fd(d.until) }) + '<div class="pp-acts"><button type="button" class="pp-btn" style="background:#c5221f" data-act="off-yes">' + t('yesOff') + '</button><button type="button" class="pp-btn sec" data-act="off-no">' + t('keep') + '</button></div></div>';
      if (!d.auto) h += '<div class="pp-note">' + t('offState', { d: fd(d.until) }) + '</div>';
      h += '</div>';
      if (d.history && d.history.length) {
        h += '<div class="pp-lbl">' + t('hist') + '</div><div class="pp-card pp-hist">';
        d.history.forEach(function (r) { h += '<div class="pp-row"><span>' + fd(r[0]) + ' · ' + t('planLine', { p: pname(d.plan), m: t('m')[d.period] }) + '</span><b>' + money(r[1]) + (r[2] ? ' · <a class="pp-link" href="' + esc(r[2]) + '" target="_blank" rel="noopener">' + t('receipt') + '</a>' : CONFIG.api ? '' : ' · <a class="pp-link" href="#" data-act="receipt">' + t('receipt') + '</a>') + '</b></div>'; });
        h += '</div>';
      }
      h += '<div class="pp-note">' + t('invoice') + '</div></div>';
      app.innerHTML = h + foot();
    }
    function render() {
      document.documentElement.lang = S.lang; document.title = t('title');
      document.getElementById('pp-help').textContent = t('help');
      Array.prototype.forEach.call(document.querySelectorAll('#pp-lang button'), function (b) { b.setAttribute('aria-pressed', b.getAttribute('data-lang') === S.lang); });
      ({ pay: renderPay, processing: renderProcessing, success: renderSuccess, failed: renderFailed, notfound: renderNotFound, manage: renderManage }[S.screen] || renderPay)();
      renderDemo();
    }

    // ── Панель «Прототип» (только без сервера)
    function renderDemo() {
      var el = document.getElementById('pp-demo'); if (CONFIG.api) { el.hidden = true; return; }
      el.hidden = false;
      el.innerHTML = '<div class="pp-in"><b>Прототип</b><span>на тестовых данных · экран:</span><select id="pp-demo-s" aria-label="Экран">' +
        DEMO.map(function (x) { return '<option value="' + x[0] + '"' + (x[0] === S.demo ? ' selected' : '') + '>' + x[1] + '</option>'; }).join('') + '</select></div>';
    }
    function loadDemo(kind) {
      S.demo = kind; S.confirmOff = false; S.emailBad = false; S.last = null;
      var screens = { processing: 1, success: 1, failed: 1, notfound: 1, manage: 1 };
      S.d = mock(screens[kind] ? (kind === 'notfound' ? 'active' : 'active') : kind);
      S.sel = defaultSel(S.d); S.screen = screens[kind] ? kind : 'pay';
      render();
    }

    // ── Запросы к серверу бота (только когда CONFIG.api задан)
    function api(path, body) {
      return fetch(CONFIG.api + '/pay/' + encodeURIComponent(CODE) + path, body ? { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) } : {})
        .then(function (r) { if (!r.ok) throw r.status; return r.json(); });
    }
    function toDate(x) { return x ? new Date(x + 'T00:00:00') : null; }
    // Возврат со страницы банка: ?status=processing — спрашиваем сервер каждые 3 с до 2 минут, пока платёж не подтвердится.
    function poll(n) {
      api('/status').then(function (j) {
        if (j.status === 'paid') { load(function () { S.screen = 'success'; }); }
        else if (j.status === 'failed') { S.screen = 'failed'; render(); }
        else if (n < 40) setTimeout(function () { poll(n + 1); }, 3000);
      }).catch(function () { if (n < 40) setTimeout(function () { poll(n + 1); }, 3000); });
    }

    // ── Действия
    function toast(msg) { var el = document.getElementById('pp-toast'); el.textContent = msg; el.hidden = false; clearTimeout(toast.t); toast.t = setTimeout(function () { el.hidden = true; }, 2600); }
    function pay() {
      var q = quote(); if (!q || q.total <= 0) return;
      var em = (S.sel.email || '').trim();
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(em)) { S.emailBad = true; render(); var i = document.getElementById('pp-email'); if (i) { i.focus(); i.scrollIntoView({ block: 'center' }); } return; }
      S.emailBad = false;
      S.last = { plan: S.sel.plan, period: S.sel.period, end: q.kind === 'change' || q.kind === 'new' ? q.end : q.end, auto: q.auto, price: q.price, nextDate: q.nextDate };
      if (CONFIG.api) {
        // Сервер создаёт платёж в Bank of Georgia (карта) или у крипто-сервиса и возвращает адрес страницы оплаты.
        // Сумму сервер считает сам по тем же правилам — сумме из браузера не доверяем.
        api('/checkout', { plan: S.sel.plan, period: S.sel.period, packs: q.packs, method: S.sel.method, auto: q.auto, email: em, lang: S.lang })
          .then(function (j) { location.href = j.redirect_url; })
          .catch(function () { S.screen = 'failed'; render(); });
        return;
      }
      toast(t('procToast')); S.screen = 'processing'; render();
      setTimeout(function () { if (S.screen === 'processing') { S.screen = 'success'; S.demo = 'success'; render(); } }, 2200);
    }
    document.addEventListener('click', function (e) {
      var lb = e.target.closest('#pp-lang button'); if (lb) { S.lang = lb.getAttribute('data-lang'); if (!CONFIG.api) { var keep = S.sel; S.d = mock({ processing: 1, success: 1, failed: 1, notfound: 1, manage: 1 }[S.demo] ? 'active' : S.demo); S.sel = keep; } render(); try { localStorage.setItem('nota-lang', S.lang); } catch (x) {} return; }
      var b = e.target.closest('[data-act]'); if (!b || b.disabled) return;
      var a = b.getAttribute('data-act'), v = b.getAttribute('data-v');
      if (a === 'auto' || a === 'receipt') { if (a === 'receipt') e.preventDefault(); return; }
      if (a === 'period') S.sel.period = +v;
      else if (a === 'plan') S.sel.plan = v;
      else if (a === 'pack') S.sel.packs = Math.max(0, Math.min(20, S.sel.packs + (+v)));
      else if (a === 'method') S.sel.method = v;
      else if (a === 'pay') return pay();
      else if (a === 'manage') { S.screen = 'manage'; S.confirmOff = false; window.scrollTo(0, 0); }
      else if (a === 'back') { S.screen = 'pay'; window.scrollTo(0, 0); }
      else if (a === 'retry') { S.screen = 'pay'; }
      else if (a === 'retry-crypto') { S.screen = 'pay'; S.sel.method = 'crypto'; }
      else if (a === 'off') S.confirmOff = true;
      else if (a === 'off-no') S.confirmOff = false;
      else if (a === 'off-yes' || a === 'on') {
        var on = a === 'on';
        if (CONFIG.api) { api('/autorenew', { on: on }).then(function () { S.d.auto = on; S.confirmOff = false; render(); }).catch(function () { toast(t('failH')); }); return; }
        S.d.auto = on; S.confirmOff = false;
      }
      else if (a === 'card') { if (CONFIG.api) { api('/card', { lang: S.lang }).then(function (j) { location.href = j.redirect_url; }).catch(function () { toast(t('failH')); }); return; } toast(t('cardToast')); return; }
      render();
    });
    document.addEventListener('change', function (e) {
      if (e.target.id === 'pp-demo-s') return loadDemo(e.target.value);
      if (e.target.getAttribute('data-act') === 'auto') { S.sel.auto = e.target.checked; render(); }
    });
    document.addEventListener('input', function (e) { if (e.target.id === 'pp-email') { S.sel.email = e.target.value; if (S.emailBad) { S.emailBad = false; e.target.classList.remove('bad'); } } });

    // ── Старт: язык (?lang= → сохранённый → язык браузера), код таблицы из адреса /pay/<код>
    var qs = new URLSearchParams(location.search), CODE = (location.pathname.match(/\/pay\/([A-Za-z0-9_-]{4,})/) || [])[1] || qs.get('c') || '';
    var saved = null; try { saved = localStorage.getItem('nota-lang'); } catch (x) {}
    var nav = (navigator.language || 'ru').slice(0, 2);
    S.lang = [qs.get('lang'), saved, nav].filter(function (x) { return x && T[x]; })[0] || 'ru';
    // Сервер отдаёт данные таблицы по коду (формат — nota/PAY.md); 404 — экран «Ссылка не найдена».
    function load(after) {
      api('').then(function (j) {
        j.from = toDate(j.from); j.until = toDate(j.until);
        if (j.failed) j.failed.date = toDate(j.failed.date);
        j.history = (j.history || []).map(function (r) { return [toDate(r.date), r.amount, r.receipt_url]; });
        S.d = j; S.sel = defaultSel(j); if (j.lang && T[j.lang] && !qs.get('lang') && !saved) S.lang = j.lang;
        if (after) after(); render();
      }).catch(function () { S.d = { sheetUrl: '' }; S.screen = 'notfound'; render(); });
    }
    if (CONFIG.api) {
      var st = qs.get('status');
      load(function () { S.screen = /\/manage\/?$/.test(location.pathname) ? 'manage' : st === 'processing' ? 'processing' : st === 'failed' ? 'failed' : 'pay'; });
      if (st === 'processing') poll(0);
    } else loadDemo(qs.get('demo') || 'active');
  })();
  </script>
</Base>
