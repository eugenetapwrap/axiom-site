---
// Страница оплаты Nota: /pay/<код таблицы>. Одна страница на все экраны (оплата, обработка, «Оплачено»,
// «Оплата не прошла», «Ссылка не найдена», управление подпиской) — экран выбирает скрипт по адресу и ответу сервера.
// Пока сервера нет (CONFIG.api = null), страница работает на тестовых данных и показывает сверху панель «Прототип».
// Договорённости основателя 20.11: оплата картой через Bank of Georgia с автопродлением + криптовалюта (разово);
// смена тарифа сразу, неиспользованные дни идут в зачёт; пакет +50 = $10 до конца оплаченного срока, только при действующем тарифе;
// цены как на сайте, налоги включены; счёт с реквизитами — по запросу в боте. Подробности для программиста — nota/PAY.md.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
---
<Base title="Оплата Nota" description="Оплата тарифа Nota" noindex selfFonts>
  <div class="pp">
    <div class="pp-demo" id="pp-demo" hidden></div>
    <header class="pp-top">
      <div class="pp-in">
        <a class="pp-logo" href="/" aria-label="Nota"><Logo height={26} /></a>
        <div class="pp-tr">
          <div class="pp-lang" role="group" aria-label="Язык" id="pp-lang">
            <button type="button" data-lang="ru">RU</button><button type="button" data-lang="en">EN</button><button type="button" data-lang="id">ID</button>
          </div>
          <a class="pp-help" id="pp-help" href="https://t.me/NotaGetBot" target="_blank" rel="noopener">Помощь в Telegram</a>
        </div>
      </div>
    </header>
    <main class="pp-main" id="pp-app" aria-live="polite">
      <noscript><p class="pp-note">Для оплаты включите JavaScript в браузере.</p></noscript>
    </main>
    <div class="pp-bar" id="pp-bar" hidden></div>
    <div class="pp-toast" id="pp-toast" role="status" hidden></div>
  </div>

  <style is:global>
    .pp{min-height:100vh;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;-webkit-font-smoothing:antialiased}
    .pp *{box-sizing:border-box}
    .pp button{font:inherit;color:inherit}
    .pp-in{max-width:1120px;margin:0 auto;padding:0 24px}
    .pp-top{background:#fff;border-bottom:1px solid var(--line)}
    .pp-top .pp-in{height:64px;display:flex;align-items:center;justify-content:space-between;gap:16px}
    .pp-logo{display:flex;align-items:center}
    .pp-tr{display:flex;align-items:center;gap:20px;font-size:14px;color:var(--muted)}
    .pp-lang{display:flex;gap:2px}
    .pp-lang button{border:0;background:none;padding:6px 7px;border-radius:7px;cursor:pointer;color:var(--muted);font-size:14px}
    .pp-lang button[aria-pressed="true"]{color:var(--ink);font-weight:600}
    .pp-lang button:hover{background:var(--box)}
    .pp-help{color:var(--muted);text-decoration:none}
    .pp-help:hover{color:var(--ink)}
    .pp-main{max-width:1120px;margin:0 auto;padding:28px 24px 72px}
    .pp-h1{font-size:28px;line-height:1.15;font-weight:700;letter-spacing:-.015em;margin:0 0 18px}
    .pp-grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:28px;align-items:start}
    .pp-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px 20px}
    .pp-ctx{display:flex;gap:14px;align-items:flex-start}
    .pp-sh{width:34px;height:34px;border-radius:8px;background:#1e8e3e;flex:none;position:relative}
    .pp-sh::after{content:"";position:absolute;inset:9px 8px;border:2px solid #fff;border-radius:2px;background:linear-gradient(#fff,#fff) 50% 0/2px 100% no-repeat,linear-gradient(#fff,#fff) 0 50%/100% 2px no-repeat}
    .pp-nm{font-size:16px;font-weight:700;overflow-wrap:anywhere}
    .pp-ow{font-size:13.5px;color:var(--muted);margin-top:3px}
    .pp-now{margin-top:14px;padding-top:14px;border-top:1px solid var(--line);font-size:14px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center}
    .pp-now b{color:var(--ink)}
    .pp .pp-link{color:var(--green-text);font-weight:600;text-decoration:none;background:none;border:0;padding:0;cursor:pointer;font-size:inherit}
    .pp .pp-link:hover{text-decoration:underline}
    .pp-alert{margin-top:12px;padding:10px 12px;border-radius:10px;background:#fdece6;color:#9c3510;font-size:13.5px;line-height:1.45}
    .pp-lbl{font-size:12.5px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.05em;margin:24px 0 10px}
    .pp-seg{display:inline-flex;background:#e9eeea;border-radius:11px;padding:4px;gap:4px;flex-wrap:wrap}
    .pp-seg button{border:0;background:none;padding:9px 16px;border-radius:8px;font-size:14.5px;font-weight:600;color:var(--muted);cursor:pointer}
    .pp-seg button[aria-pressed="true"]{background:#fff;color:var(--ink);box-shadow:0 1px 3px rgba(20,32,27,.12)}
    .pp-seg em{font-style:normal;color:var(--green);margin-left:6px}
    .pp-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
    .pp-pl{position:relative;text-align:left;background:#fff;border:1.5px solid var(--line);border-radius:14px;padding:16px 16px 15px;cursor:pointer;transition:border-color .15s,box-shadow .15s}
    .pp-pl:hover{border-color:#bcc7c0}
    .pp-pl[aria-checked="true"]{border-color:var(--green);box-shadow:0 0 0 3px rgba(12,122,79,.13)}
    .pp-rd{position:absolute;right:14px;top:16px;width:18px;height:18px;border-radius:50%;border:2px solid #c3ccc6}
    .pp-pl[aria-checked="true"] .pp-rd{border:5.5px solid var(--green)}
    .pp-pn{font-size:16px;font-weight:700;padding-right:26px}
    .pp-pp{font-size:28px;font-weight:700;letter-spacing:-.02em;margin-top:8px}
    .pp-pp small{font-size:14px;font-weight:500;color:var(--muted);margin-left:3px}
    .pp-pt{font-size:12.5px;color:var(--muted);margin-top:2px;min-height:17px}
    .pp-pl ul{list-style:none;margin:10px 0 0;padding:0;font-size:13.5px;color:var(--muted);line-height:1.6}
    .pp-tag{display:inline-block;margin-left:8px;padding:2px 8px;border-radius:20px;background:#eaf5ef;color:var(--green-text);font-size:12px;font-weight:600;vertical-align:2px}
    .pp-pack{display:flex;align-items:center;justify-content:space-between;gap:16px}
    .pp-pack.low{background:#fff7f3;border-color:#f6cdbb}
    .pp-pack .t{font-size:15px;font-weight:700}
    .pp-pack .d{font-size:13.5px;color:var(--muted);margin-top:3px;line-height:1.45}
    .pp-step{display:flex;align-items:center;border:1px solid var(--line);border-radius:10px;overflow:hidden;flex:none;background:#fff}
    .pp-step button{width:38px;height:38px;border:0;background:none;cursor:pointer;font-size:17px;color:var(--muted)}
    .pp-step button:disabled{opacity:.35;cursor:default}
    .pp-step span{width:42px;text-align:center;font-weight:700;border-left:1px solid var(--line);border-right:1px solid var(--line);line-height:38px}
    .pp-sum{position:sticky;top:20px}
    .pp-sum .ttl{font-size:17px;font-weight:700;margin-bottom:10px}
    .pp-ln{display:flex;justify-content:space-between;gap:12px;font-size:14px;padding:6px 0;color:var(--muted)}
    .pp-ln b{color:var(--ink);font-weight:600;white-space:nowrap}
    .pp-ln.cr b{color:var(--green-text)}
    .pp-tot{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line);margin-top:8px;padding-top:12px}
    .pp-tot span{font-size:15px;font-weight:600}
    .pp-tot b{font-size:28px;letter-spacing:-.02em}
    .pp-info{margin-top:10px;font-size:13px;line-height:1.5;color:var(--muted)}
    .pp-info b{color:var(--ink);font-weight:600}
    .pp-fld{margin-top:16px}
    .pp-fld label,.pp-fld .cap{display:block;font-size:12.5px;color:var(--muted);margin-bottom:6px}
    .pp-fld input[type=email]{width:100%;height:42px;border:1px solid #cfd6d1;border-radius:10px;padding:0 12px;font:inherit;font-size:15px;color:var(--ink);background:#fff}
    .pp-fld input[type=email]:focus{outline:2px solid rgba(12,122,79,.35);border-color:var(--green)}
    .pp-fld input.bad{border-color:#d93025}
    .pp-err{color:#c5221f;font-size:12.5px;margin-top:5px}
    .pp-mth{display:grid;grid-template-columns:1fr 1fr;gap:8px}
    .pp-mth button{text-align:left;border:1.5px solid var(--line);background:#fff;border-radius:11px;padding:9px 11px;cursor:pointer}
    .pp-mth button[aria-checked="true"]{border-color:var(--green);box-shadow:0 0 0 3px rgba(12,122,79,.12)}
    .pp-mth b{display:block;font-size:14px}
    .pp-mth small{display:block;font-size:12px;color:var(--muted);margin-top:1px}
    .pp-auto{display:flex;gap:10px;align-items:flex-start;margin-top:14px;font-size:13px;line-height:1.45;color:var(--muted);cursor:pointer}
    .pp-auto input{margin:2px 0 0;width:16px;height:16px;accent-color:var(--green);flex:none}
    .pp-auto b{color:var(--ink);font-weight:600}
    .pp-btn{display:flex;align-items:center;justify-content:center;width:100%;height:50px;margin-top:16px;border:0;border-radius:11px;background:var(--green);color:#fff!important;font-size:16.5px;font-weight:700;cursor:pointer;text-decoration:none}
    .pp-btn:hover{background:#0a6943}
    .pp-btn:disabled{background:#c9d3cd;cursor:default}
    .pp-btn.sec{background:#fff;color:var(--ink)!important;border:1.5px solid var(--line)}
    .pp-btn.sec:hover{background:var(--box)}
    .pp-fine{margin-top:12px;font-size:12.5px;line-height:1.5;color:var(--muted)}
    .pp-legal{margin-top:10px;font-size:12.5px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 10px}
    .pp-legal a,.pp-foot a{color:var(--muted);text-decoration:underline;text-decoration-color:#b9c2bd;text-underline-offset:2px}
    .pp-legal a.miss,.pp-foot a.miss{text-decoration-style:dashed;opacity:.7}
    .pp-foot{margin-top:34px;padding-top:16px;border-top:1px solid var(--line);font-size:12.5px;color:var(--muted);display:flex;justify-content:space-between;gap:8px 20px;flex-wrap:wrap}
    .pp-one{max-width:460px;margin:40px auto 0;text-align:center}
    .pp-ic{width:66px;height:66px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:#eaf5ef;color:var(--green)}
    .pp-ic.bad{background:#fdece6;color:#c5221f}
    .pp-ic.nf{background:var(--box);color:var(--muted)}
    .pp-one h1{font-size:26px;margin:18px 0 0;letter-spacing:-.015em}
    .pp-one p{font-size:15px;line-height:1.55;color:var(--muted);margin:10px 0 0}
    .pp-one p b{color:var(--ink)}
    .pp-one .pp-btn{margin-top:22px}
    .pp-one .pp-btn + .pp-btn{margin-top:10px}
    .pp-spin{width:42px;height:42px;border-radius:50%;border:4px solid #d6e9de;border-top-color:var(--green);animation:pp-r 0.9s linear infinite}
    @keyframes pp-r{to{transform:rotate(360deg)}}
    .pp-mg{max-width:620px;margin:0 auto}
    .pp-back{display:inline-block;margin-bottom:14px;font-size:14px}
    .pp-row{display:flex;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid var(--line);font-size:14.5px}
    .pp-row:first-of-type{border-top:0;padding-top:4px}
    .pp-row span{color:var(--muted)}
    .pp-row b{font-weight:600;text-align:right}
    .pp-acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:14px}
    .pp-acts .pp-btn{width:auto;height:42px;margin:0;padding:0 16px;font-size:14.5px}
    .pp-conf{margin-top:14px;padding:14px;border-radius:12px;background:#fff7f3;border:1px solid #f6cdbb;font-size:14px;line-height:1.5}
    .pp-hist{margin-top:22px}
    .pp-hist .pp-row b{font-weight:500}
    .pp-note{font-size:13.5px;color:var(--muted);margin-top:14px;line-height:1.5}
    .pp-demo{background:#14201b;color:#dfe6e1;font-size:13px}
    .pp-demo .pp-in{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-height:40px;padding-top:6px;padding-bottom:6px}
    .pp-demo b{color:#fff}
    .pp-demo select{font:inherit;font-size:13px;padding:4px 8px;border-radius:7px;border:0;background:#2a3832;color:#fff}
    .pp-bar{position:fixed;left:0;right:0;bottom:0;z-index:20;background:#fff;border-top:1px solid var(--line);box-shadow:0 -6px 20px rgba(20,32,27,.06);padding:10px 16px calc(12px + env(safe-area-inset-bottom))}
    .pp-bar .in{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:640px;margin:0 auto}
    .pp-bar .s1{font-size:12px;color:var(--muted);line-height:1.3}
    .pp-bar .s1 b{display:block;font-size:19px;color:var(--ink)}
    .pp-bar .pp-btn{width:auto;height:44px;margin:0;padding:0 22px;font-size:15.5px}
    .pp-toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);background:#14201b;color:#fff;font-size:14px;padding:10px 16px;border-radius:10px;z-index:30;max-width:calc(100% - 32px)}
    @media (max-width:900px){
      .pp-grid{grid-template-columns:1fr}
      .pp-sum{position:static}
      .pp-main{padding-bottom:110px}
    }
    @media (max-width:640px){
      .pp-in{padding:0 16px}
      .pp-main{padding:20px 16px 110px}
      .pp-h1{font-size:23px}
      .pp-help{display:none}
      .pp-plans{grid-template-columns:1fr;gap:8px}
      .pp-pl{display:grid;grid-template-columns:1fr auto;align-items:center;padding:12px 14px;column-gap:12px}
      .pp-pl .pp-rd{display:none}
      .pp-pn{padding-right:0;font-size:15px}
      .pp-pl ul{margin:2px 0 0;font-size:12.5px;line-height:1.45;grid-column:1}
      .pp-pp{grid-column:2;grid-row:1 / span 2;margin:0;font-size:21px;text-align:right}
      .pp-pt{grid-column:2;text-align:right;min-height:0}
      .pp-seg{display:flex}
      .pp-seg button{flex:1;padding:8px 6px;font-size:13px}
      .pp-seg em{display:block;margin:0}
      .pp-pack{flex-direction:column;align-items:stretch}
      .pp-step{align-self:flex-start}
      .pp-card{padding:14px 15px}
      .pp-one{margin-top:24px}
    }
    @media (min-width:901px){ .pp-bar{display:none!important} }
  </style>

  <script is:inline>
  (function () {
    // ── Настройки. Ссылки и почту заполняет основатель в «Техническом кабинете»; пустые ссылки показаны пунктиром.
    var CONFIG = {
      api: null,                                   // адрес сервера бота, например 'https://api.nota.axiomco.io'; null — прототип на тестовых данных
      bot: 'https://t.me/NotaGetBot',
      custom: 'https://t.me/NotaGetBot',          // «Больше 500 документов — обсудим»
      terms: '', refund: '', privacy: '',          // условия использования, правила возврата, политика конфиденциальности
      supportEmail: ''                             // почта поддержки
    };
    var PLANS = {
      start:  { docs: 100, groups: 5,  total: { 1: 19, 3: 51,  6: 96 },  pm: { 1: 19, 3: 17, 6: 16 } },
      growth: { docs: 200, groups: 10, total: { 1: 35, 3: 93,  6: 174 }, pm: { 1: 35, 3: 31, 6: 29 } },
      scale:  { docs: 500, groups: 0,  total: { 1: 79, 3: 213, 6: 402 }, pm: { 1: 79, 3: 71, 6: 67 } }
    };
    var ORDER = ['start', 'growth', 'scale'];
    var PACK = { size: 50, price: 10 };

    var T = {
      ru: {
        title: 'Оплата Nota', help: 'Помощь в Telegram', sheet: 'Google-таблица', owner: 'владелец',
        now: 'Сейчас: <b>тариф «{p}»</b>, до {d}', nowFree: 'Сейчас: <b>бесплатные документы</b>', nowEnded: 'Тариф «{p}» закончился {d}',
        autoOn: 'Автопродление {d} — {sum}, карта •• {c}', manage: 'Управление подпиской',
