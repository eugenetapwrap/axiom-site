        failH: 'Оплата не прошла', failP: 'Деньги не списаны. Банк отклонил платёж — например, из-за лимита по карте или нехватки средств.',
        retry: 'Попробовать ещё раз', payCrypto: 'Оплатить криптовалютой',
        nfH: 'Ссылка не найдена', nfP: 'Откройте ссылку из своей таблицы Nota — кнопка <b>Payment</b> в шапке листа Payments.',
        back: '← К оплате', subH: 'Подписка', rPlan: 'Тариф', rNext: 'Следующее списание', rCard: 'Карта', rUntil: 'Действует до',
        changeCard: 'Сменить карту', changePlan: 'Сменить тариф', autoOff: 'Отключить автопродление', autoOnBtn: 'Включить автопродление',
        confirm: 'Отключить автопродление? Тариф будет работать до {d}, потом не продлится.', yesOff: 'Да, отключить', keep: 'Оставить',
