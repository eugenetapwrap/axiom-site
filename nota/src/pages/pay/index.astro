          '<button type="button" role="radio" data-act="method" data-v="card" aria-checked="' + (s.method === 'card') + '"><b>' + t('card') + '</b><small>' + t('cardSub') + '</small></button>' +
          '<button type="button" role="radio" data-act="method" data-v="crypto" aria-checked="' + (s.method === 'crypto') + '"><b>' + t('crypto') + '</b><small>' + t('cryptoSub') + '</small></button></div></div>';
