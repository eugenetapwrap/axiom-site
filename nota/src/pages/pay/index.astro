    };

    // ── Даты и числа
    var DAY = 864e5;
    var now0 = new Date(); var TODAY = new Date(now0.getFullYear(), now0.getMonth(), now0.getDate());
    function addDays(d, n) { return new Date(d.getFullYear(), d.getMonth(), d.getDate() + n); }
    function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth() + n, d.getDate()); }
    function diff(a, b) { return Math.round((b - a) / DAY); }
    function endOf(start, months) { return addDays(addMonths(start, months), -1); }
    function r2(x) { return Math.round(x * 100) / 100; }
    var LOC = { ru: 'ru-RU', en: 'en-GB', id: 'id-ID' };
    function fd(d) { return d ? new Intl.DateTimeFormat(LOC[S.lang], { day: 'numeric', month: 'long' }).format(d) : ''; }
    function money(x) {
      var neg = x < 0; x = Math.abs(r2(x));
      var s = Number.isInteger(x) ? String(x) : x.toFixed(2);
      if (S.lang !== 'en') s = s.replace('.', ',');
      return (neg ? '−' : '') + '$' + s;
    }
    function days(n) {
      if (S.lang === 'ru') { var a = n % 10, b = n % 100; var w = (a === 1 && b !== 11) ? 'день' : (a >= 2 && a <= 4 && (b < 12 || b > 14)) ? 'дня' : 'дней'; return n + ' ' + w; }
      if (S.lang === 'en') return n + (n === 1 ? ' day' : ' days');
      return n + ' hari';
    }
    function t(k, v) {
      var s = T[S.lang][k]; if (s == null) s = T.ru[k];
      if (v) Object.keys(v).forEach(function (x) { s = s.split('{' + x + '}').join(v[x]); });
      return s;
    }
    function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function pname(p) { return T[S.lang].names[p] || p; }

    // ── Тестовые данные (пока нет сервера). Даты считаются от сегодняшнего дня.
    var DEMO = [
      ['free', 'Бесплатные документы'], ['active', 'Тариф действует, автопродление'], ['manual', 'Тариф действует, без автопродления (крипто)'],
      ['low', 'Мало документов'], ['expired', 'Срок истёк, списание не прошло'], ['processing', 'Оплата обрабатывается'],
      ['success', 'Оплачено'], ['failed', 'Оплата не прошла'], ['notfound', 'Ссылка не найдена'], ['manage', 'Управление подпиской']
    ];
    function mock(kind) {
      var name = { ru: 'Nota — Ваша компания', en: 'Nota — Your company', id: 'Nota — Perusahaan Anda' }[S.lang];
      var b = { table: name, owner: 'i•••@gmail.com', sheetUrl: '#', email: '', history: [] };
      var from = addDays(TODAY, -17), until = addDays(TODAY, 12);
      var paid = { plan: 'growth', period: 1, paid: 35, limit: 200, used: 72, from: from, until: until, auto: true, method: 'card', card: '4242' };
      var hist = [[from, 35], [addMonths(from, -1), 35], [addMonths(from, -2), 35]];
      if (kind === 'free') return Object.assign(b, { plan: 'free', period: 0, paid: 0, limit: 30, used: 12, from: null, until: null, auto: false, method: null, card: null });
      if (kind === 'manual') return Object.assign(b, paid, { auto: false, method: 'crypto', card: null, history: hist.slice(0, 1) });
      if (kind === 'low') return Object.assign(b, paid, { used: 194, history: hist });
      if (kind === 'expired') return Object.assign(b, paid, { from: addDays(TODAY, -36), until: addDays(TODAY, -6), used: 161, auto: false, failed: { date: addDays(TODAY, -5), sum: 35 }, history: hist.slice(1) });
      return Object.assign(b, paid, { history: hist });
    }

    // ── Состояние страницы
    var S = { lang: 'ru', screen: 'pay', demo: 'active', d: null, sel: null, emailBad: false, confirmOff: false, last: null };
    function isActive(d) { return d && d.plan !== 'free' && d.until && d.until >= TODAY; }
    function defaultSel(d) {
      var keep = d.plan !== 'free';
      // На бесплатном сразу выбран «Рост» — его же выделяет лендинг; сумма видна сразу
      return { plan: keep ? d.plan : 'growth', period: keep && d.period ? d.period : 1, packs: 0, method: 'card', auto: true, email: S.sel ? S.sel.email : (d.email || '') };
    }

    // ── Расчёт суммы: продление, смена тарифа с зачётом неиспользованных дней, пакеты
    function quote() {
      var d = S.d, s = S.sel; if (!s.plan) return null;
      var price = PLANS[s.plan].total[s.period], act = isActive(d), q = { price: price, credit: 0, creditDays: 0, leftover: 0 };
      if (act && s.plan === d.plan && s.period === d.period) {
        q.kind = d.auto ? 'autorenew' : 'renew';
        q.start = addDays(d.until, 1); q.end = endOf(q.start, s.period); q.planDue = d.auto ? 0 : price;
      } else if (act) {
        q.kind = 'change';
        var left = diff(TODAY, d.until) + 1, total = diff(d.from, d.until) + 1;
        q.credit = r2(d.paid * left / total); q.creditDays = left;
        q.start = TODAY; q.end = endOf(TODAY, s.period);
        q.planDue = r2(Math.max(0, price - q.credit)); q.leftover = r2(Math.max(0, q.credit - price));
      } else {
        q.kind = 'new'; q.start = TODAY; q.end = endOf(TODAY, s.period); q.planDue = price;
      }
      q.packs = act ? s.packs : 0; q.packDue = q.packs * PACK.price;
      q.packUntil = q.kind === 'change' ? q.end : d.until;
      q.total = r2(q.planDue + q.packDue);
      q.auto = s.method === 'card' && (q.kind === 'autorenew' ? true : s.auto);
      q.nextDate = q.kind === 'autorenew' ? q.start : addDays(q.end, 1);
      return q;
    }

    // ── Отрисовка
    var app = document.getElementById('pp-app'), bar = document.getElementById('pp-bar');
    function linkTag(url, label) { return url ? '<a href="' + esc(url) + '" target="_blank" rel="noopener">' + label + '</a>' : '<a class="miss" title="' + esc(t('missing')) + '">' + label + '</a>'; }
    function legal() { return '<div class="pp-legal">' + linkTag(CONFIG.terms, t('terms')) + '<span>·</span>' + linkTag(CONFIG.refund, t('refund')) + '<span>·</span>' + linkTag(CONFIG.privacy, t('privacy')) + '</div>'; }
    function foot() {
      var mail = CONFIG.supportEmail ? ' · <a href="mailto:' + esc(CONFIG.supportEmail) + '">' + esc(CONFIG.supportEmail) + '</a>' : ' · <a class="miss" title="' + esc(t('missing')) + '">support@…</a>';
      return '<footer class="pp-foot"><span>© 2026 Axiom Consulting</span><span>' + t('more') + ' <a href="' + esc(CONFIG.custom) + '" target="_blank" rel="noopener">' + t('moreL') + '</a></span><span>' + t('ask') + ' — <a href="' + esc(CONFIG.bot) + '" target="_blank" rel="noopener">@NotaGetBot</a>' + mail + '</span></footer>';
    }
    function ctx() {
      var d = S.d, h = '<div class="pp-card"><div class="pp-ctx"><span class="pp-sh" aria-hidden="true"></span><div><div class="pp-nm">' + esc(d.table) + '</div><div class="pp-ow">' + t('sheet') + ' · ' + t('owner') + ' ' + esc(d.owner) + '</div></div></div><div class="pp-now">';
      if (d.plan === 'free') h += '<span>' + t('nowFree') + '</span>';
      else if (isActive(d)) {
        h += '<span>' + t('now', { p: pname(d.plan), d: fd(d.until) }) + '</span>';
        if (d.auto) h += '<span>' + t('autoOn', { d: fd(addDays(d.until, 1)), sum: money(PLANS[d.plan].total[d.period]), c: d.card }) + '</span><button type="button" class="pp-link" data-act="manage">' + t('manage') + '</button>';
      } else h += '<span>' + t('nowEnded', { p: pname(d.plan), d: fd(d.until) }) + '</span>';
      h += '</div>';
      if (d.failed && !isActive(d)) h += '<div class="pp-alert">' + t('chargeFailed', { sum: money(d.failed.sum), d: fd(d.failed.date) }) + '</div>';
      return h + '</div>';
    }
    function periods() {
      var h = '<div class="pp-lbl">' + t('period') + '</div><div class="pp-seg" role="group" aria-label="' + esc(t('period')) + '">';
      [1, 3, 6].forEach(function (m) { h += '<button type="button" data-act="period" data-v="' + m + '" aria-pressed="' + (S.sel.period === m) + '">' + t('m')[m] + (m === 3 ? '<em>−10%</em>' : m === 6 ? '<em>−15%</em>' : '') + '</button>'; });
      return h + '</div>';
    }
    function plans() {
      var d = S.d, h = '<div class="pp-lbl">' + t('plan') + '</div><div class="pp-plans" role="radiogroup" aria-label="' + esc(t('plan')) + '">';
      ORDER.forEach(function (k) {
        var p = PLANS[k], m = S.sel.period, cur = d.plan === k && d.plan !== 'free';
        h += '<button type="button" class="pp-pl" role="radio" data-act="plan" data-v="' + k + '" aria-checked="' + (S.sel.plan === k) + '"><span class="pp-rd" aria-hidden="true"></span>' +
          '<div class="pp-pn">' + pname(k) + (cur ? '<span class="pp-tag">' + t('yours') + '</span>' : '') + '</div>' +
          '<div class="pp-pp">' + money(p.pm[m]) + '<small>' + t('perMo') + '</small></div>' +
          '<div class="pp-pt">' + (m > 1 ? t('forPeriod', { sum: money(p.total[m]), m: t('mGen')[m] }) : '') + '</div>' +
          '<ul><li>' + t('docsMo', { n: p.docs }) + '</li><li>' + (p.groups ? t('groups', { n: p.groups }) : t('groupsAll')) + '</li></ul></button>';
      });
      return h + '</div>';
    }
    function pack(q) {
