      return '<div class="pp-lbl">' + t('packH') + '</div><div class="pp-card pp-pack' + (low ? ' low' : '') + '"><div><div class="t">' + t('packT') + '</div><div class="d">' +
        (low ? t('packLow', { n: Math.max(0, d.limit - d.used), l: d.limit }) : '') + t('packD', { d: fd(until) }) + '</div></div>' +
        '<div class="pp-step"><button type="button" data-act="pack" data-v="-1" aria-label="−"' + (S.sel.packs ? '' : ' disabled') + '>−</button><span>' + S.sel.packs + '</span><button type="button" data-act="pack" data-v="1" aria-label="+">+</button></div></div>';
    }
    function summary(q) {
      var s = S.sel, h = '<aside class="pp-card pp-sum" aria-label="' + esc(t('sumH')) + '"><div class="ttl">' + t('sumH') + '</div>';
      if (!q) return h + '<div class="pp-info">' + t('choose') + '</div>' + legal() + '</aside>';
      if (q.kind !== 'autorenew') h += '<div class="pp-ln"><span>' + t('planLine', { p: pname(s.plan), m: t('m')[s.period] }) + '</span><b>' + money(q.price) + '</b></div>';
      if (q.credit) h += '<div class="pp-ln cr"><span>' + t('lineCredit', { days: days(q.creditDays), p: pname(S.d.plan) }) + '</span><b>' + money(-Math.min(q.credit, q.price)) + '</b></div>';
      if (q.packs) h += '<div class="pp-ln"><span>' + t('linePack', { n: q.packs }) + '</span><b>' + money(q.packDue) + '</b></div>';
      if (q.kind !== 'autorenew') {
        h += '<div class="pp-ln"><span>' + t('docsLine') + '</span><b>' + PLANS[s.plan].docs + '</b></div>';
        h += '<div class="pp-ln"><span>' + t('term') + '</span><b>' + fd(q.start) + ' – ' + fd(q.end) + '</b></div>';
