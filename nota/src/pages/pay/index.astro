---
// Страница оплаты Nota: /pay/<код таблицы>. Одна страница на все экраны (оплата, обработка, «Оплачено»,
// «Оплата не прошла», «Ссылка не найдена», управление подпиской) — экран выбирает скрипт по адресу и ответу сервера.
// Пока сервера нет (CONFIG.api = null), страница работает на тестовых данных и показывает сверху панель «Прототип».
// Договорённости основателя 20.11: оплата картой через Bank of Georgia с автопродлением + криптовалюта (разово);
// смена тарифа сразу, неиспользованные дни идут в зачёт; пакет +50 = $10 до конца оплаченного срока, только при действующем тарифе;
// цены как на сайте, налоги включены; счёт с реквизитами — по запросу в боте. Подробности для программиста — nota/PAY.md.
import Base from '../../layouts/Base.astro';
import Logo from '../../components/Logo.astro';
---
<Base title="Оплата Nota" description="Оплата тарифа Nota" noindex selfFonts>
  <div class="pp">
    <div class="pp-demo" id="pp-demo" hidden></div>
    <!-- Шапка — как на лендинге: логотип, переключатель языков-«таблетка» (на телефоне — меню), кнопка в Telegram -->
    <header class="header">
      <div class="wrap">
        <a class="logo-link" href="/" aria-label="Nota — на главную"><Logo height={30} /></a>
        <div class="lang" role="group" aria-label="Язык" id="pp-lang">
          <button type="button" class="lang-b" data-lang="ru">RU</button><button type="button" class="lang-b" data-lang="en">EN</button><button type="button" class="lang-b" data-lang="id">ID</button>
        </div>
        <details class="lang-m" id="pp-lang-m">
          <summary aria-label="Язык">RU</summary>
          <div class="lang-menu"><button type="button" data-lang="ru">Русский <small>RU</small></button><button type="button" data-lang="en">English <small>EN</small></button><button type="button" data-lang="id">Bahasa Indonesia <small>ID</small></button></div>
        </details>
        <a class="btn btn--sm btn--dark" id="pp-help" href="https://t.me/NotaGetBot" target="_blank" rel="noopener"><span class="hb-lg">Помощь в Telegram</span><span class="hb-sm">Помощь</span></a>
      </div>
    </header>
    <main class="wrap pp-main" id="pp-app" aria-live="polite">
      <noscript><p class="pp-note">Для оплаты включите JavaScript в браузере.</p></noscript>
    </main>
    <footer class="footer">
      <div class="wrap">
        <div class="brand"><Logo height={24} color="#F2F0EA" /><span>by Axiom</span></div>
        <nav aria-label="Документы" id="pp-fnav"></nav>
        <div class="op">© 2026</div>
      </div>
    </footer>
    <div class="pp-bar" id="pp-bar" hidden></div>
    <div class="pp-toast" id="pp-toast" role="status" hidden></div>
  </div>

  <style is:global>
    /* Страница оплаты повторяет лендинг: те же шапка (.header, .lang), кнопки (.btn), переключатель срока (.bill),
       карточки тарифов (.pa-c, .pa-v, .pa-p) и тёмный подвал (.footer) из global.css. Здесь — только то, чего на лендинге нет. */
    .pp .header .btn--dark{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 2px var(--ink)}
    .pp .header .btn--dark:hover{background:var(--ink);color:#fff;box-shadow:none}
    .pp .lang-b{cursor:pointer}
    .pp .lang-b:not(.on):hover{color:var(--ink)}
    .pp .lang-menu button{display:flex;justify-content:space-between;align-items:baseline;gap:12px;width:100%;padding:8px 10px;border:0;border-radius:8px;background:none;font:inherit;font-size:14px;font-weight:700;color:var(--muted);cursor:pointer;text-align:left}
    .pp .lang-menu button.on{color:var(--ink);background:var(--box)}
    .pp-main{padding-top:36px;padding-bottom:80px}
    .pp-h1{font-size:clamp(30px,3.4vw,42px);line-height:1.1;font-weight:700;letter-spacing:-.015em;margin:0 0 24px}
    .pp-h2{font-size:19px;font-weight:700;line-height:1.3;margin:32px 0 14px}
    .pp-grid{display:grid;grid-template-columns:minmax(0,1fr) 360px;gap:32px;align-items:start}
    .pp-card{background:#fff;border-radius:18px;padding:22px;box-shadow:inset 0 0 0 1px var(--line)}
    .pp-ctx{display:flex;gap:14px;align-items:flex-start}
    .pp-sh{width:36px;height:36px;border-radius:9px;background:#1e8e3e;flex:none;position:relative}
    .pp-sh::after{content:"";position:absolute;inset:10px 9px;border:2px solid #fff;border-radius:2px;background:linear-gradient(#fff,#fff) 50% 0/2px 100% no-repeat,linear-gradient(#fff,#fff) 0 50%/100% 2px no-repeat}
    .pp-nm{font-size:17px;font-weight:700;line-height:1.35;overflow-wrap:anywhere}
    .pp-ow{font-size:14px;color:var(--muted);margin-top:2px}
    .pp-now{margin-top:16px;padding-top:16px;border-top:1px solid var(--line);font-size:15px;color:var(--muted);display:flex;flex-wrap:wrap;gap:6px 18px;align-items:center}
    .pp-now b{color:var(--ink)}
    .pp .pp-link{color:var(--slate);font-weight:600;text-decoration:underline;text-underline-offset:3px;background:none;border:0;padding:0;cursor:pointer;font:inherit;font-weight:600}
    .pp .pp-link:hover{color:var(--ink)}
    .pp-alert{margin-top:14px;padding:12px 14px;border-radius:12px;background:#fdece6;color:#9c3510;font-size:14.5px;line-height:1.45}
    .pp .bill{flex-wrap:wrap}
    .pp-plans{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
    .pp .pp-pc{position:relative;text-align:left;font:inherit;color:inherit;border:0;cursor:pointer;width:100%;transition:box-shadow .15s ease}
    .pp .pp-pc:hover{box-shadow:inset 0 0 0 1px #b9c4bd}
    .pp .pp-pc[aria-checked="true"]{box-shadow:inset 0 0 0 2px var(--slate)}
    .pp .pp-pc:focus-visible{outline:3px solid var(--slate);outline-offset:3px}
    .pp-rd{position:absolute;right:20px;top:24px;width:20px;height:20px;border-radius:50%;box-shadow:inset 0 0 0 2px #c3ccc6}
    .pp-pc[aria-checked="true"] .pp-rd{box-shadow:inset 0 0 0 6px var(--slate)}
    .pp .pp-pc .pa-n{padding-right:28px}
    .pp .pp-pc .pa-p{min-height:0}
    .pp-tag{display:inline-block;margin-left:6px;padding:2px 8px;border-radius:999px;background:#dcefe4;color:var(--green-text);font-size:12.5px;font-weight:700;vertical-align:2px}
    .pp-grp{display:flex;gap:8px;align-items:center;margin-top:14px;padding-top:14px;border-top:1px solid var(--line);font-size:14px;color:var(--ink)}
    .pp-grp svg,.pp-ck{color:var(--green);flex:none}
    .pp-pack{display:flex;align-items:center;justify-content:space-between;gap:16px}
    .pp-pack.low{background:#fff7f3;box-shadow:inset 0 0 0 1px #f6cdbb}
    .pp-pack .t{font-size:17px;font-weight:700}
    .pp-pack .d{font-size:14.5px;color:var(--muted);margin-top:3px;line-height:1.45}
    .pp-step{display:flex;align-items:center;border-radius:999px;background:#fff;box-shadow:inset 0 0 0 1px var(--line);flex:none;padding:3px}
    .pp-step button{width:38px;height:38px;border:0;border-radius:999px;background:none;cursor:pointer;font-size:18px;font-weight:600;color:var(--ink)}
    .pp-step button:hover:not(:disabled){background:var(--box)}
    .pp-step button:disabled{opacity:.3;cursor:default}
    .pp-step span{min-width:34px;text-align:center;font-weight:700}
    .pp-sum{position:sticky;top:92px}
    .pp-sum .ttl{font-size:19px;font-weight:700;margin-bottom:10px}
    .pp-ln{display:flex;justify-content:space-between;gap:12px;font-size:15px;padding:6px 0;color:var(--muted)}
    .pp-ln b{color:var(--ink);font-weight:600;white-space:nowrap}
    .pp-ln.cr b{color:var(--green-text)}
    .pp-tot{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid var(--line);margin-top:10px;padding-top:14px}
    .pp-tot span{font-size:16px;font-weight:600}
    .pp-tot b{font-size:34px;line-height:1;color:var(--slate);letter-spacing:-.01em}
    .pp-info{margin-top:12px;font-size:14px;line-height:1.5;color:var(--muted)}
    .pp-info b{color:var(--ink);font-weight:600}
    .pp-fld{margin-top:18px}
    .pp-fld .cap{display:block;font-size:13.5px;color:var(--muted);margin-bottom:8px}
    .pp-fld input[type=email]{width:100%;height:46px;border:0;box-shadow:inset 0 0 0 1px #cfd6d1;border-radius:12px;padding:0 14px;font:inherit;font-size:16px;color:var(--ink);background:#fff}
    .pp-fld input[type=email]:focus{outline:3px solid rgba(51,65,84,.25);box-shadow:inset 0 0 0 2px var(--slate)}
    .pp-fld input.bad{box-shadow:inset 0 0 0 2px #d93025}
    .pp-err{color:#c5221f;font-size:13px;margin-top:6px}
    .pp-mail{font-size:14px;line-height:1.5;color:var(--muted)}
    .pp-mail b{color:var(--ink);font-weight:600}
    .pp .pp-fld .bill{display:flex;width:100%}
    .pp .pp-fld .bill label{flex:1}
    .pp .pp-fld .bill span{justify-content:center;padding:0 10px;font-size:15px;min-height:42px}
    .pp-sub{margin-top:6px;font-size:13px;color:var(--muted)}
    .pp-auto{display:flex;gap:10px;align-items:flex-start;margin-top:16px;font-size:14px;line-height:1.45;color:var(--muted);cursor:pointer}
    .pp-auto input{margin:3px 0 0;width:17px;height:17px;accent-color:var(--ink);flex:none}
    .pp-auto b{color:var(--ink);font-weight:600}
    .pp .pp-pay{width:100%;margin-top:18px;min-height:56px;font-size:19px;border:0;cursor:pointer;font-family:inherit}
    .pp .btn:disabled{background:#c9d0cc;box-shadow:none;transform:none;cursor:default;color:#fff}
    .pp-fine{margin-top:12px;font-size:13px;line-height:1.5;color:var(--muted)}
    .pp-legal{margin-top:10px;font-size:13px;color:var(--muted);display:flex;flex-wrap:wrap;gap:4px 10px}
    .pp-legal a{color:var(--muted);text-underline-offset:2px}
    .pp .footer nav a{text-decoration:none}
    .pp .footer nav a:hover{color:#fff}
    .pp-one{max-width:520px;margin:24px auto 0;text-align:center}
    .pp-ic{width:72px;height:72px;border-radius:50%;margin:0 auto;display:flex;align-items:center;justify-content:center;background:#dcefe4;color:var(--green)}
    .pp-ic.bad{background:#fdece6;color:#c5221f}
    .pp-ic.nf{background:var(--box);color:var(--muted)}
    .pp-one h1{font-size:clamp(28px,3vw,36px);line-height:1.15;margin:20px 0 0;letter-spacing:-.015em}
    .pp-one p{font-size:17px;line-height:1.55;color:var(--muted);margin:12px 0 0}
    .pp-one p b{color:var(--ink)}
    .pp-acts1{display:grid;gap:10px;margin-top:26px}
    .pp-acts1 .btn{width:100%;min-height:56px;font-size:18px;border:0;cursor:pointer;font-family:inherit}
    .pp-spin{width:46px;height:46px;border-radius:50%;border:4px solid var(--box);border-top-color:var(--slate);animation:pp-r .9s linear infinite}
    @keyframes pp-r{to{transform:rotate(360deg)}}
    @media (prefers-reduced-motion:reduce){.pp-spin{animation-duration:3s}}
    .pp-mg{max-width:680px;margin:0 auto}
    .pp-back{display:inline-block;margin-bottom:16px;font-size:15px}
    .pp-row{display:flex;justify-content:space-between;gap:16px;padding:13px 0;border-top:1px solid var(--line);font-size:15.5px}
    .pp-row:first-child{border-top:0;padding-top:2px}
    .pp-row span{color:var(--muted)}
    .pp-row b{font-weight:600;text-align:right}
    .pp-acts{display:flex;flex-wrap:wrap;gap:10px;margin-top:16px}
    .pp-acts .btn{min-height:46px;padding:0 18px;font-size:15.5px;border:0;cursor:pointer;font-family:inherit}
    .pp-acts .btn--outline{background:transparent}
    .pp-conf{margin-top:16px;padding:16px;border-radius:14px;background:#fff7f3;box-shadow:inset 0 0 0 1px #f6cdbb;font-size:15px;line-height:1.5}
    .pp-note{font-size:14.5px;color:var(--muted);margin-top:16px;line-height:1.5}
    .pp-demo{background:var(--dark);color:#dfe6e1;font-size:13px}
    .pp-demo .wrap{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-height:40px;padding-top:6px;padding-bottom:6px}
    .pp-demo b{color:#fff}
    .pp-demo select{font:inherit;font-size:13px;padding:4px 8px;border-radius:7px;border:0;background:#2a313a;color:#fff}
    .pp-bar{position:fixed;left:0;right:0;bottom:0;z-index:20;background:rgba(251,252,250,.96);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:10px max(16px,env(safe-area-inset-left,0px)) calc(10px + env(safe-area-inset-bottom,0px))}
    .pp-bar .in{display:flex;align-items:center;justify-content:space-between;gap:12px;max-width:640px;margin:0 auto}
    .pp-bar .s1{font-size:12.5px;color:var(--muted);line-height:1.3}
    .pp-bar .s1 b{display:block;font-size:20px;color:var(--ink)}
    .pp-bar .btn{width:auto;min-height:50px;padding:0 22px;font-size:17px;border:0;cursor:pointer;font-family:inherit;white-space:nowrap}
    .pp-toast{position:fixed;left:50%;bottom:96px;transform:translateX(-50%);background:var(--ink);color:#fff;font-size:14px;padding:10px 16px;border-radius:10px;z-index:30;max-width:calc(100% - 32px)}
    @media (max-width:1000px){ .pp-grid{grid-template-columns:1fr} .pp-sum{position:static} .pp-main{padding-bottom:120px} }
    @media (max-width:760px){
      .pp-main{padding-top:24px}
      .pp-plans{grid-template-columns:1fr;gap:10px}
      .pp .pp-pc{display:grid;grid-template-columns:1fr auto;column-gap:14px;align-items:center;padding:16px}
      .pp-rd{display:none}
      .pp .pp-pc .pa-n{padding-right:0;font-size:16px}
      .pp .pp-pc .pa-w{font-size:13px;margin:0}
      .pp .pp-pc .pa-v{display:none}
      .pp .pp-pc .pa-p{grid-column:2;grid-row:1 / span 3;margin:0;font-size:26px;text-align:right}
      .pp .pp-pc .pp-grp{grid-column:1;margin-top:6px;padding-top:0;border-top:0;font-size:13px;color:var(--muted)}
      .pp-pack{flex-direction:column;align-items:stretch}
      .pp-step{align-self:flex-start}
      .pp-card{padding:18px}
      .pp .bill{width:100%;display:flex}
      .pp .bill label{flex:1}
      .pp .bill span{justify-content:center;padding:0 8px;font-size:14px;flex-direction:column;gap:0;min-height:50px;line-height:1.2}
    }
    @media (min-width:1001px){ .pp-bar{display:none!important} }
  </style>

  <script is:inline>
  (function () {
    // ── Настройки. Ссылки и почту заполняет основатель в «Техническом кабинете»; пустые ссылки показаны пунктиром.
    var CONFIG = {
      api: null,                                   // адрес сервера бота, например 'https://api.nota.axiomco.io'; null — прототип на тестовых данных
      bot: 'https://t.me/NotaGetBot',
      custom: 'https://t.me/NotaGetBot',          // «Больше 500 документов — обсудим»
      terms: '', refund: '', privacy: '',          // условия использования, правила возврата, политика конфиденциальности
      supportEmail: ''                             // почта поддержки
    };
    var PLANS = {
      start:  { docs: 100, groups: 5,  total: { 1: 19, 3: 51,  6: 96 },  pm: { 1: 19, 3: 17, 6: 16 } },
      growth: { docs: 200, groups: 10, total: { 1: 35, 3: 93,  6: 174 }, pm: { 1: 35, 3: 31, 6: 29 } },
      scale:  { docs: 500, groups: 0,  total: { 1: 79, 3: 213, 6: 402 }, pm: { 1: 79, 3: 71, 6: 67 } }
    };
    var ORDER = ['start', 'growth', 'scale'];
    var PACK = { size: 50, price: 10 };

    var T = {
      ru: {
        title: 'Оплата Nota', help: 'Помощь в Telegram', sheet: 'Google-таблица', owner: 'владелец',
        now: 'Сейчас: <b>тариф «{p}»</b>, до {d}', nowFree: 'Сейчас: <b>бесплатные документы</b>', nowEnded: 'Тариф «{p}» закончился {d}',
        autoOn: 'Автопродление {d} — {sum}, карта •• {c}', manage: 'Управление подпиской',
        chargeFailed: 'Не удалось списать {sum} {d}: банк отклонил карту. Оплатите вручную или смените карту.',
        period: 'Срок', m: { 1: '1 месяц', 3: '3 месяца', 6: '6 месяцев' }, plan: 'Тариф',
        names: { free: 'Бесплатно', start: 'Старт', growth: 'Рост', scale: 'Масштаб' },
        perMo: '/мес', docsMo: '{n} документов в месяц', groups: 'до {n} групп', groupsAll: 'групп без ограничений',
        forPeriod: '{sum} за {m}', mGen: { 3: '3 месяца', 6: '6 месяцев' }, yours: 'ваш тариф',
        packH: 'Не хватает документов', packT: '+50 документов — $10', packD: 'Добавятся сразу и действуют до {d}, тариф менять не нужно.',
        packLow: 'Осталось {n} из {l} документов. ', packFree: 'Пакеты можно докупать, когда тариф уже действует.',
        sumH: 'Итого', linePack: '+50 документов × {n}', lineCredit: 'Зачёт: {days} тарифа «{p}»',
        docsLine: 'Документов в месяц', term: 'Новый срок', due: 'К оплате', choose: 'Выберите тариф, чтобы увидеть сумму.',
        sameAuto: 'Это ваш тариф: он продлится сам {d} — {sum}. Сейчас платить не нужно.',
        leftover: 'Остаток зачёта {sum} уменьшит следующее списание.',
        email: 'Почта для чека и уведомлений о списаниях', emailErr: 'Проверьте адрес почты',
        method: 'Способ оплаты', card: 'Карта', cardSub: 'Visa, Mastercard', crypto: 'Криптовалюта', cryptoSub: 'разово, без автопродления',
        auto: 'Продлевать автоматически', every: { 1: 'каждый месяц', 3: 'каждые 3 месяца', 6: 'каждые 6 месяцев' },
        autoText: '{sum} {every}, следующее списание {d}. Отключить можно в любой момент.',
        oneTime: 'Разовая оплата: тариф закончится {d}, продлить можно здесь же.',
        pay: 'Оплатить {sum}', nothing: 'Сейчас платить не нужно', next: 'Выберите тариф',
        fineCard: 'Оплата проходит на защищённой странице Bank of Georgia. После оплаты таблица обновится сама.',
        fineCrypto: 'Откроется страница оплаты криптовалютой. Таблица обновится, когда сеть подтвердит платёж.',
        terms: 'Условия использования', refund: 'Правила возврата', privacy: 'Конфиденциальность',
        more: 'Больше 500 документов в месяц?', moreL: 'Обсудим индивидуально', ask: 'Вопросы по оплате',
        invoice: 'Нужен счёт с реквизитами компании? Запросите его в боте.', missing: 'Ссылка появится позже',
        procH: 'Проверяем оплату', procP: 'Обычно это занимает до минуты. Страница обновится сама.',
        okH: 'Оплачено', okP: 'Тариф «{p}» до {d}, {n} документов в месяц.', okNext: 'Следующее списание — {d}, {sum}.',
        okP2: 'Блок в таблице обновится в течение минуты. Чек придёт на почту, бот пришлёт подтверждение.',
        openSheet: 'Открыть таблицу', openBot: 'Открыть бота',
        failH: 'Оплата не прошла', failP: 'Деньги не списаны. Банк отклонил платёж — например, из-за лимита по карте или нехватки средств.',
        retry: 'Попробовать ещё раз', payCrypto: 'Оплатить криптовалютой',
        nfH: 'Ссылка не найдена', nfP: 'Откройте ссылку из своей таблицы Nota — кнопка <b>Payment</b> в шапке листа Payments.',
        back: '← К оплате', subH: 'Подписка', rPlan: 'Тариф', rNext: 'Следующее списание', rCard: 'Карта', rUntil: 'Действует до',
        changeCard: 'Сменить карту', changePlan: 'Сменить тариф', autoOff: 'Отключить автопродление', autoOnBtn: 'Включить автопродление',
