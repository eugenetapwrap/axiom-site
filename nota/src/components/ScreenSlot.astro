---
// Рамка «Google-таблица» под скриншот листа.
// Картинки лежат в nota/public/screens/. Если файла нет, показывается заглушка.
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  file: string;   // путь от public, например /screens/insights.webp
  tab: string;    // активный лист
  tabs: string[]; // все листы внизу рамки
  alt: string;
  w?: number;
  h?: number;
}
const { file, tab, tabs, alt, w, h } = Astro.props;
const exists = fs.existsSync(path.join(process.cwd(), 'public', file));
---
<div class="shot">
  <div class="shot-bar" aria-hidden="true">
    <span class="shot-doc"></span>
    <span class="shot-name">Nota · Google Таблицы</span>
    <span class="shot-dots"><i></i><i></i><i></i></span>
  </div>
  <div class="shot-body">
    {exists ? (
      <a href={file} target="_blank" rel="noopener" title="Открыть в полном размере">
        <img src={file} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
      </a>
    ) : (
      <div class="shot-empty" role="img" aria-label={`Здесь будет скриншот листа ${tab}`}>
        <span>Скриншот листа «{tab}»</span>
        <small>{`public${file}`}</small>
      </div>
    )}
  </div>
  <div class="shot-tabs" aria-hidden="true">
    {tabs.map((t) => <span class:list={{ on: t === tab }}>{t}</span>)}
  </div>
</div>
