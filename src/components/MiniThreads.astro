---
// Нити для управленческого учёта: отчёт собственнику за декабрь. Поступления пяти проектов сходятся в один счёт
// и расходятся по статьям. Длина прямого участка нити пропорциональна сумме, толщина тоже.
// В широкой карточке горизонтальная схема в стиле нитей первого экрана из ветки redesign (Евгений 02.11.2026:
// «раньше было круче»): нити-линии, которые сливаются у счёта, подписи «название сумма», заголовки колонок,
// сумма месяца над счётом. При появлении на экране нити втекают в счёт и расходятся по статьям, потом по ним
// раз в несколько секунд пробегает блик. В узкой колонке и на телефоне вертикальная схема и легенда.
// Данные демонстрационные (src/lib/sankey.ts). Геометрия своя, в пикселях колонки.
import { SERIES, MONTHS } from '../lib/sankey';
import { frame, PROJ_NAMES, COST_NAMES, PROJ_COLORS, COST_COLORS, fmt2 } from '../lib/threads';
import MiniThreadsX from './MiniThreadsX.astro';

const M = SERIES.length - 1;
const fr = frame(SERIES[M]);
const p = fr.left.map((t) => t.v);
const c = fr.right.map((t) => t.v);
const total = fr.total;
const month = MONTHS[M].toLowerCase();
const f = (n: number) => n.toFixed(1);
const maxP = Math.max(...p);
const maxC = Math.max(...c);
const share = (v: number) => `${Math.round((v / total) * 100)}%`;
const build = c[0] + c[1] + c[2];
const rest = c[c.length - 1];

// ---------- Горизонтальная схема (широкая карточка) ----------
const W = 1200;
const H = 254;
const K = 11; // px на 1 млрд IDR
const NW = 3; // толщина планки счёта
const CY = 146; // середина нитей
const PX = 600; // планка счёта
const X1 = 430; // конец прямых участков слева
const X2 = 770; // начало прямых участков справа
const LMAX = 250;
const RMAX = 240;
const LSTEP = 46;
const RSTEP = 27;
const G = 60; // длина блика, px
const top0 = CY - (total * K) / 2;

let acc = top0;
const left = p.map((v, k) => {
  const h = v * K;
  const y = CY + (k - (p.length - 1) / 2) * LSTEP;
  const x = X1 - (v / maxP) * LMAX;
  const yb = acc + h / 2;
  acc += h;
  const len = X1 - x + Math.hypot(PX - X1, yb - y);
  return { v, h, y, x, len, d: `M${f(x)},${f(y)} L${X1},${f(y)} C${X1 + 92},${f(y)} ${PX - 82},${f(yb)} ${PX},${f(yb)}` };
});
acc = top0;
const right = c.map((v, k) => {
  const h = v * K;
  const y = CY + (k - (c.length - 1) / 2) * RSTEP;
  const x = X2 + (v / maxC) * RMAX;
  const ya = acc + h / 2;
  acc += h;
  const len = Math.hypot(X2 - PX, y - ya) + (x - X2);
  return { v, h: Math.max(h, 1.4), y, x, len, d: `M${PX + NW},${f(ya)} C${PX + 92},${f(ya)} ${X2 - 82},${f(y)} ${X2},${f(y)} L${f(x)},${f(y)}` };
});
const outDelay = (i: number) => 760 + i * 50;
const outDur = (len: number) => Math.round(380 + len * 0.9);

// ---------- Вертикальная схема (узкая колонка, телефон) ----------
const VW = 440;
const VCX = VW / 2;
const VK = 16;
const VLSTEP = 88;
const VRSTEP = 53;
const VLMAX = 64;
const VRMAX = 128;
const VBEND = 82;
const VY1 = 34 + VLMAX;
const VPY = VY1 + VBEND;
const VY2 = VPY + NW + VBEND;
const VH = VY2 + VRMAX + 20;
const SHORT = (name: string) => name.replace(/^Arvo /, '').replace('Прочие проекты', 'Прочие');

// Лента ширины w: прямой участок ya→yb на x0, изгиб yb→yc с x0 на x1, прямой участок yc→yd на x1.
// Края ленты — кривые с одинаковыми вертикальными опорами, поэтому соседние ленты не перекрываются.
const ribbon = (x0: number, x1: number, w: number, ya: number, yb: number, yc: number, yd: number) => {
  const h = w / 2;
  const b = (yc - yb) * 0.55;
  return `M${f(x0 - h)},${f(ya)} L${f(x0 - h)},${f(yb)} C${f(x0 - h)},${f(yb + b)} ${f(x1 - h)},${f(yc - b)} ${f(x1 - h)},${f(yc)} L${f(x1 - h)},${f(yd)} `
    + `L${f(x1 + h)},${f(yd)} L${f(x1 + h)},${f(yc)} C${f(x1 + h)},${f(yc - b)} ${f(x0 + h)},${f(yb + b)} ${f(x0 + h)},${f(yb)} L${f(x0 + h)},${f(ya)} Z`;
};
let vacc = VCX - (total * VK) / 2;
const vtop = p.map((v, k) => {
  const w = v * VK;
  const x = VCX + (k - (p.length - 1) / 2) * VLSTEP;
  const y = VY1 - (v / maxP) * VLMAX;
  const xb = vacc + w / 2;
  vacc += w;
  return { v, x, y, d: ribbon(x, xb, w, y, VY1, VPY, VPY) };
});
vacc = VCX - (total * VK) / 2;
const vbottom = c.map((v, k) => {
  const w = v * VK;
  const x = VCX + (k - (c.length - 1) / 2) * VRSTEP;
  const y = VY2 + (v / maxC) * VRMAX;
  const xa = vacc + w / 2;
  vacc += w;
  const y0 = VPY + NW;
  return { v, x, y, d: ribbon(xa, x, Math.max(w, 1.4), y0, y0, VY2, y) };
});
---

<figure class="mini" aria-label={`Пример отчёта для собственника: ${month}, поступления ${fmt2(total)} млрд IDR от пяти проектов. На стройку ушло ${fmt2(build)}, на счетах осталось ${fmt2(rest)}`}>
  <div class="mt-a">
    <p class="mini-head">Отчёт собственнику за {month}, млрд IDR</p>
    <dl class="mini-kpis">
      <div><dt>Поступления</dt><dd>{fmt2(total)}</dd></div>
      <div><dt>На стройку</dt><dd>{fmt2(build)}</dd></div>
      <div><dt>Осталось на счетах</dt><dd>{fmt2(rest)}</dd></div>
    </dl>
  </div>

  <!-- Широкая карточка: основная схема и расширенная (группы, раскладка по проектам при наведении) -->
  <div class="mt-w" data-mtw>
  <div class="mt-sw" role="group" aria-label="Вид схемы">
    <button type="button" aria-pressed="true" data-sw="0">Основная</button>
    <button type="button" aria-pressed="false" data-sw="1">Расширенная</button>
  </div>
  <div class="mt-h" data-mt>
    <svg viewBox={`0 0 ${W} ${H}`} aria-hidden="true">
      <text class="mt-cap mt-t" x="0" y="12" style="--d:0ms">Поступления по проектам</text>
      <text class="mt-cap mt-t" x={X2 + 60} y="12" style="--d:1000ms">Куда ушли деньги</text>
      <text class="mt-t" x={PX + NW / 2} y="12" text-anchor="middle" style="--d:620ms"><tspan class="mt-cap">Поступления за {month}</tspan><tspan class="mt-big" dx="10">{fmt2(total)}</tspan><tspan class="mt-unit" dx="5">млрд IDR</tspan></text>
      <line class="mt-lead mt-t" x1={PX + NW / 2} x2={PX + NW / 2} y1="28" y2={f(top0 - 12)} style="--d:700ms"></line>
      {left.map((t, i) => <path class="mt-in" d={t.d} pathLength="1" stroke={PROJ_COLORS[i]} stroke-width={f(t.h)} style={`--d:${i * 40}ms`}><title>{PROJ_NAMES[i]}: {fmt2(t.v)} млрд IDR, {share(t.v)} поступлений</title></path>)}
      {right.map((t, i) => <path class="mt-out" d={t.d} pathLength="1" stroke={COST_COLORS[i]} stroke-width={f(t.h)} style={`--d:${outDelay(i)}ms;--t:${outDur(t.len)}ms`}><title>{COST_NAMES[i]}: {fmt2(t.v)} млрд IDR, {share(t.v)}</title></path>)}
      <g class="mt-glints">
        {left.map((t) => <path class="mt-glint mt-glint--l" d={t.d} pathLength="1" stroke-width={f(t.h)} style={`--g:${(G / t.len).toFixed(3)}`}></path>)}
        {right.map((t) => <path class="mt-glint mt-glint--r" d={t.d} pathLength="1" stroke-width={f(t.h)} style={`--g:${(G / t.len).toFixed(3)}`}></path>)}
      </g>
      <rect class="mt-bar" x={PX} y={f(top0 - 8)} width={NW} height={f(total * K + 16)} rx="1.5"></rect>
      {left.map((t, i) => <text class="mt-t" x={f(t.x - 12)} y={f(t.y)} text-anchor="end" style={`--d:${i * 40}ms`}><tspan class="mt-name">{PROJ_NAMES[i]}</tspan><tspan class="mt-val" dx="8">{fmt2(t.v)}</tspan></text>)}
      {right.map((t, i) => <text class="mt-t" x={f(t.x + 12)} y={f(t.y)} style={`--d:${Math.round(outDelay(i) + outDur(t.len) * 0.55)}ms`}><tspan class="mt-name">{COST_NAMES[i]}</tspan><tspan class="mt-val" dx="8">{fmt2(t.v)}</tspan><tspan class="mt-share" dx="6">{share(t.v)}</tspan></text>)}
    </svg>
  </div>
  <div class="mt-x"><MiniThreadsX /></div>
  </div>

  <div class="mt-b">
    <svg viewBox={`0 0 ${VW} ${VH}`} aria-hidden="true">
      {vtop.map((t, i) => <path class="mt" d={t.d} fill={PROJ_COLORS[i]}><title>{PROJ_NAMES[i]}: {fmt2(t.v)} млрд IDR</title></path>)}
      {vbottom.map((t, i) => <path class="mt" d={t.d} fill={COST_COLORS[i]}><title>{COST_NAMES[i]}: {fmt2(t.v)} млрд IDR, {share(t.v)}</title></path>)}
      <rect class="mt-vbar" x={f(VCX - (total * VK) / 2 - 6)} y={VPY} width={f(total * VK + 12)} height={NW} rx="1.5"></rect>
      {vtop.map((t, i) => (
        <Fragment>
          <text class="mt-lab" x={f(t.x)} y={f(t.y - 20)} text-anchor="middle">{SHORT(PROJ_NAMES[i])}</text>
          <text class="mt-v" x={f(t.x)} y={f(t.y - 6)} text-anchor="middle">{fmt2(t.v)}</text>
        </Fragment>
      ))}
      {vbottom.map((t) => <text class="mt-v" x={f(t.x)} y={f(t.y + 14)} text-anchor="middle">{fmt2(t.v)}</text>)}
    </svg>
  </div>
  <div class="mt-c">
    <ul class="mb-list">
      {fr.right.map((t, i) => <li><i style={`background:${COST_COLORS[i]}`}></i><span>{COST_NAMES[i]}</span><b>{share(t.v)}</b></li>)}
    </ul>
  </div>
</figure>

<script>
  // Переключатель «Основная / Расширенная»
  document.querySelectorAll<HTMLElement>('[data-mtw]').forEach((w) => {
    const btns = [...w.querySelectorAll<HTMLButtonElement>('[data-sw]')];
    btns.forEach((b) => b.addEventListener('click', () => {
      const x = b.dataset.sw === '1';
      w.classList.toggle('is-x', x);
      btns.forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
    }));
  });

  // Нити втекают в счёт, когда карточка появляется на экране. Без JS и при «уменьшить движение» схема видна сразу
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-mt]').forEach((el) => {
    if (reduce || !('IntersectionObserver' in window)) return;
    el.classList.add('is-armed');
    const io = new IntersectionObserver((entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      el.classList.add('is-in');
      io.disconnect();
    }, { threshold: 0.35 });
    io.observe(el);
  });
</script>

<style>
  .mini { display: flex; flex-direction: column; justify-content: space-between; gap: 14px; height: 100%; margin: 0; padding: 18px 20px; border-radius: 8px; background: var(--bg); }
  .mini svg { display: block; width: 100%; height: auto; overflow: visible; }
  .mt-b svg { max-width: 460px; margin-inline: auto; }
  .mt-w { display: none; position: relative; width: 100%; max-width: 1200px; margin-inline: auto; }
  .mt-x { display: none; }
  .mt-w.is-x .mt-h { display: none; }
  .mt-w.is-x .mt-x { display: block; }
  .mt-sw { position: absolute; z-index: 1; top: -6px; right: 0; display: flex; gap: 2px; padding: 2px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .mt-sw button { padding: 4px 12px; border: 0; border-radius: 999px; background: none; font: 500 12px var(--font); color: var(--ink-2); cursor: pointer; }
  .mt-sw button:hover { color: var(--ink); }
  .mt-sw button[aria-pressed='true'] { background: var(--ink); color: var(--surface); }

  /* Широкая карточка: схема на всю ширину примера, показатели переходят в заголовки колонок */
  @container (min-width: 1000px) {
    .mini { justify-content: center; padding: 18px 24px 14px; }
    .mt-a, .mt-b, .mt-c { display: none; }
    .mt-w { display: block; }
  }

  .mt-h text { dominant-baseline: middle; }
  .mt-cap { font: 500 13px var(--font); fill: var(--ink-3); }
  .mt-big { font: 700 20px var(--font); fill: var(--ink); font-variant-numeric: tabular-nums; }
  .mt-unit { font: 500 13px var(--font); fill: var(--ink-2); }
  .mt-name { font: 500 13px var(--font); fill: var(--ink); }
  .mt-val { font: 400 13px var(--font); fill: var(--ink-2); font-variant-numeric: tabular-nums; }
  .mt-share { font: 400 13px var(--font); fill: var(--ink-3); font-variant-numeric: tabular-nums; }
  .mt-lead { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 2 3; }
  .mt-bar { fill: var(--ink); transform-box: fill-box; transform-origin: center; }
  .mt-in, .mt-out { fill: none; stroke-opacity: .9; stroke-dasharray: 1 1; stroke-dashoffset: 0; transition: stroke-opacity .2s ease; }
  .mt-h svg:hover .mt-in, .mt-h svg:hover .mt-out { stroke-opacity: .25; }
  .mt-h svg:hover .mt-in:hover, .mt-h svg:hover .mt-out:hover { stroke-opacity: 1; }
  .mt-glint { fill: none; stroke: var(--surface); stroke-opacity: 0; stroke-dasharray: var(--g) 2; stroke-dashoffset: var(--g); pointer-events: none; }

  /* Появление: нити бьют в счёт, планка вздрагивает, статьи расходятся веером. Потом по нитям бегает блик */
  .mt-h.is-armed:not(.is-in) .mt-in, .mt-h.is-armed:not(.is-in) .mt-out { stroke-dashoffset: 1; }
  .mt-h.is-armed:not(.is-in) .mt-t { opacity: 0; }
  .mt-h.is-in .mt-in { animation: mt-draw 700ms cubic-bezier(.7, 0, .84, 0) var(--d) both; }
  .mt-h.is-in .mt-bar { animation: mt-pum 520ms cubic-bezier(.3, .7, .3, 1) 640ms both; }
  .mt-h.is-in .mt-out { animation: mt-draw var(--t) cubic-bezier(.16, 1, .3, 1) var(--d) both; }
  .mt-h.is-in .mt-t { animation: mt-fade 420ms cubic-bezier(.2, .7, .2, 1) var(--d) both; }
  .mt-h.is-in .mt-glint { stroke-opacity: .5; }
  .mt-h.is-in .mt-glint--l { animation: mt-glint-l 6.2s linear 2.6s infinite; }
  .mt-h.is-in .mt-glint--r { animation: mt-glint-r 6.2s linear 2.6s infinite; }
  @keyframes mt-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes mt-pum { 0% { transform: scaleY(0); } 55% { transform: scaleY(1.2); } 100% { transform: scaleY(1); } }
  @keyframes mt-fade { from { opacity: 0; } }
  @keyframes mt-glint-l { 0% { stroke-dashoffset: var(--g); } 16%, 100% { stroke-dashoffset: -1; } }
  @keyframes mt-glint-r { 0%, 16% { stroke-dashoffset: var(--g); } 36%, 100% { stroke-dashoffset: -1; } }

  /* Вертикальная схема */
  .mini-head { font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .mb-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4px 16px; margin: 0; padding: 0; list-style: none; font-size: 12px; color: var(--ink-2); }
  .mb-list li { display: grid; grid-template-columns: 8px minmax(0, 1fr) auto; gap: 8px; align-items: center; }
  .mb-list i { width: 8px; height: 8px; border-radius: 2px; }
  .mb-list b { font-weight: 600; color: var(--ink); font-variant-numeric: tabular-nums; }
  @container (max-width: 440px) { .mb-list { grid-template-columns: 1fr; } }
  .mt { fill-opacity: .9; transition: fill-opacity .2s ease; }
  .mt-b svg:hover .mt { fill-opacity: .35; }
  .mt-b svg:hover .mt:hover { fill-opacity: 1; }
  .mt-vbar { fill: var(--ink); }
  .mt-lab { font: 400 12px var(--font); fill: var(--ink-3); }
  .mt-v { font: 600 12px var(--font); fill: var(--ink); }
  /* На телефоне схема ужимается, подписи в единицах схемы делаем крупнее, чтобы на экране они остались читаемыми */
  @media (max-width: 479px) { .mt-lab, .mt-v { font-size: 13.5px; } }
  .mini-kpis { display: grid; grid-template-columns: repeat(3, auto); justify-content: space-between; gap: 8px; margin: 10px 0 0; padding-top: 10px; border-top: 1px solid var(--line); }
  .mini-kpis dt { font-size: 12px; color: var(--ink-3); }
  .mini-kpis dd { margin: 0; font-size: 18px; font-weight: 700; color: var(--ink); white-space: nowrap; font-variant-numeric: tabular-nums; }

  @media (prefers-reduced-motion: reduce) {
    .mt-h .mt-glint { display: none; }
  }
</style>
