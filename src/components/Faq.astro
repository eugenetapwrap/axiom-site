---
import { t } from '../lib/typo';
import { faq } from '../content/ru';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div class="faq__head">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 id="faq-title" class="h2">{t(faq.title)}</h2>
    </div>
    <div class="faq__list">
      {
        faq.items.map((item) => (
          <details class:list={['item', { tbd: item.tbd }]}>
            <summary>{t(item.q)}</summary>
            <p>{t(item.a)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 1040px) {
    .faq {
      grid-template-columns: 1fr 2fr;
      gap: var(--s-8);
    }
  }
  .faq__head {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .faq__list {
    border-top: 1px solid var(--c-line);
  }
  .item {
    border-bottom: 1px solid var(--c-line);
  }
  summary {
    position: relative;
    display: block;
    padding: var(--s-5) var(--s-7) var(--s-5) 0;
    font-weight: 600;
    font-size: var(--fs-md);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: var(--s-2);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--f-mono);
    font-size: 20px;
    font-weight: 400;
    color: var(--c-muted);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 var(--s-7) var(--s-5) 0;
    color: var(--c-ink-2);
    max-width: 68ch;
  }
</style>
