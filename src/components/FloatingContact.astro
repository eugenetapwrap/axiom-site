---
// Плавающая кнопка Telegram справа внизу. Появляется после первого экрана.
import { site } from '../data/site';
---

<div class="fc" data-fc hidden>
  <a class="fc-btn" href={site.telegramUrl}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 4.2 2.9 11.4c-1 .4-1 1.6 0 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.8 3.5c.6.4 1.4.1 1.6-.6L22.9 5.6c.3-1-.5-1.8-1.4-1.4Z" fill="currentColor"/></svg>
    Написать в Telegram
  </a>
</div>

<script>
  const fc = document.querySelector<HTMLElement>('[data-fc]');
  if (fc) {
    const onScroll = () => { fc.hidden = window.scrollY < window.innerHeight * 0.9; };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .fc {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: grid;
    justify-items: end;
    gap: 10px;
    max-width: calc(100vw - 32px);
  }
  .fc[hidden] { display: none; }
  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--deep);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(10, 42, 36, 0.3);
  }
  .fc-btn svg { width: 18px; height: 18px; color: var(--gold-on-deep); }
  .fc-btn:hover { background: var(--deep-2); }
  @media (min-width: 720px) {
    .fc { right: 24px; bottom: 24px; }
  }
</style>
