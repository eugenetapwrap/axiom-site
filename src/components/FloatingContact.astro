---
// Плавающая кнопка Telegram справа внизу. Появляется после первого экрана.
// Карточка с быстрыми темами открывается только по клику на кнопку, сама не всплывает.
import { site } from '../data/site';
import { tr, isEn } from '../lib/i18n';

const topics = isEn() ? [
  { label: 'Financial model', text: 'Hello! We need a financial model for a project.' },
  { label: 'Model audit', text: 'Hello! I would like to send a financial model for review.' },
  { label: 'Accounting', text: 'Hello! We are interested in management accounting and payment control.' },
  { label: 'Investment analysis', text: 'Hello! I have an investment analysis task.' },
] : [
  { label: 'Финмодель', text: 'Здравствуйте! Нужна финансовая модель проекта.' },
  { label: 'Аудит модели', text: 'Здравствуйте! Хочу отправить финмодель на аудит.' },
  { label: 'Учёт', text: 'Здравствуйте! Интересует управленческий учёт и контроль платежей.' },
  { label: 'Инвестанализ', text: 'Здравствуйте! Есть задача по инвестиционному анализу.' },
];
---

<div class="fc" data-fc hidden>
  <div class="fc-card ui-card" data-fc-card hidden>
    <button class="fc-close" type="button" aria-label={tr('Закрыть')} data-fc-close>×</button>
    <p class="fc-q">{tr('Какая у вас задача?')}</p>
    <div class="fc-topics">
      {topics.map((tp) => (
        <a href={`${site.telegramUrl}?text=${encodeURIComponent(tp.text)}`}>{tp.label}</a>
      ))}
    </div>
    <a class="fc-plain" href={site.telegramUrl}>{tr('Написать без темы')}</a>
  </div>
  <button class="fc-btn" type="button" aria-expanded="false" data-fc-btn>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.5 4.2 2.9 11.4c-1 .4-1 1.6 0 1.9l4.6 1.5 1.8 5.6c.2.7 1.1.9 1.6.4l2.6-2.4 4.8 3.5c.6.4 1.4.1 1.6-.6L22.9 5.6c.3-1-.5-1.8-1.4-1.4Z" fill="currentColor"/></svg>
    {tr('Написать в Telegram')}
  </button>
</div>

<script>
  const fc = document.querySelector<HTMLElement>('[data-fc]');
  const card = document.querySelector<HTMLElement>('[data-fc-card]');
  const btn = document.querySelector<HTMLButtonElement>('[data-fc-btn]');
  if (fc && card && btn) {
    const onScroll = () => {
      fc.hidden = window.scrollY < window.innerHeight * 0.9;
      if (fc.hidden) setOpen(false);
    };
    const setOpen = (open: boolean) => {
      card.hidden = !open;
      btn.setAttribute('aria-expanded', String(open));
    };
    btn.addEventListener('click', () => setOpen(card.hidden));
    document.querySelector('[data-fc-close]')?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>

<style>
  .fc {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    display: grid;
    justify-items: end;
    gap: 10px;
    max-width: calc(100vw - 32px);
  }
  .fc[hidden], .fc-card[hidden] { display: none; }
  .fc-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: var(--deep);
    color: var(--on-deep);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    border: 0;
    font-family: inherit;
    cursor: pointer;
    box-shadow: 0 10px 30px rgba(10, 42, 36, 0.3);
  }
  .fc-btn svg { width: 18px; height: 18px; color: var(--gold-on-deep); }
  .fc-btn:hover { background: var(--deep-2); }
  .fc-card {
    position: relative;
    width: 300px;
    max-width: 100%;
    padding: 14px 16px;
    font-size: 15px;
    line-height: 1.4;
    animation: fc-in .4s ease;
  }
  @keyframes fc-in { from { opacity: 0; transform: translateY(8px); } }
  .fc-q { padding-right: 20px; font-weight: 600; }
  .fc-topics { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .fc-topics a {
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--ink);
    font-size: 14px;
    text-decoration: none;
  }
  .fc-topics a:hover { border-color: var(--accent); color: var(--accent); }
  .fc-plain { display: inline-block; margin-top: 10px; font-size: 14px; color: var(--ink-2); }
  .fc-close {
    position: absolute;
    top: 6px;
    right: 8px;
    border: 0;
    background: none;
    color: var(--ink-3);
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  @media (min-width: 720px) {
    .fc { right: 24px; bottom: 24px; }
  }
</style>
