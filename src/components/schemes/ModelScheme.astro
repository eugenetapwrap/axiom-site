---
// Интерактивная схема финансовой модели: блоки по ходу данных, по нажатию — описание блока.
import { t } from '../../lib/typo';
import { modelScheme, roleLabels, type Role } from '../../content/schemes';

interface Props {
  id?: string;
}
const { id = 'model-scheme' } = Astro.props;
const roles = Object.keys(roleLabels) as Role[];
const usedRoles = roles.filter((r) => modelScheme.columns.some((c) => c.blocks.some((b) => b.role === r)));
---

<div class="ms" id={id} data-scheme>
  <div class="ms__map" role="group" aria-label="Из чего состоит финансовая модель">
    {
      modelScheme.columns.map((col, ci) => (
        <div class="ms__col">
          <p class="ms__colTitle">
            <span class="mono">{String.fromCharCode(65 + ci)}</span> {col.title}
          </p>
          <div class="ms__blocks">
            {col.blocks.map((b) => (
              <button
                type="button"
                class={`ms__block role-${b.role}`}
                data-target={`${id}-${b.id}`}
                aria-pressed={b.id === modelScheme.defaultId ? 'true' : 'false'}
                aria-controls={`${id}-${b.id}`}
              >
                <span class="ms__blockTitle">{b.title}</span>
                <span class="ms__blockShort">{t(b.short)}</span>
              </button>
            ))}
          </div>
        </div>
      ))
    }
  </div>

  <ul class="ms__legend" aria-label="Роли блоков">
    {usedRoles.map((r) => <li class={`role-${r}`}><i aria-hidden="true"></i>{roleLabels[r]}</li>)}
  </ul>

  <div class="ms__panels" aria-live="polite">
    {
      modelScheme.columns.flatMap((col) =>
        col.blocks.map((b) => (
          <section class="ms__panel" id={`${id}-${b.id}`} hidden={b.id !== modelScheme.defaultId} aria-label={b.title}>
            <div class="ms__panelHead">
              <p class="ms__panelTitle">{b.title}</p>
              <span class={`ms__chip role-${b.role}`}>
                <i aria-hidden="true" />
                {roleLabels[b.role]}
              </span>
            </div>
            <div class="ms__panelGrid">
              <div>
                <p class="ms__label">Что внутри</p>
                <ul class="ms__list">
                  {b.inside.map((x) => <li>{t(x)}</li>)}
                </ul>
              </div>
              <div>
                <p class="ms__label">Зачем</p>
                <p class="ms__why">{t(b.why)}</p>
              </div>
              <div>
                <p class="ms__label">Кому полезно</p>
                <ul class="ms__who">
                  {b.who.map((w) => <li>{w}</li>)}
                </ul>
              </div>
            </div>
          </section>
        )),
      )
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-scheme]').forEach((root) => {
    const buttons = root.querySelectorAll<HTMLButtonElement>('[data-target]');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
        root.querySelectorAll<HTMLElement>('.ms__panel').forEach((p) => {
          p.hidden = p.id !== btn.dataset.target;
        });
      });
    });
  });
</script>

<style>
  .ms {
    --r-input: #3b6fd4;
    --r-calc: #7a828c;
    --r-result: var(--c-accent);
    --r-analysis: #7b55c7;
    --r-report: #2f8f9d;
    --r-control: #c27a1a;
    display: grid;
    gap: var(--s-4);
  }
  .role-input { --rc: var(--r-input); }
  .role-calc { --rc: var(--r-calc); }
  .role-result { --rc: var(--r-result); }
  .role-analysis { --rc: var(--r-analysis); }
  .role-report { --rc: var(--r-report); }
  .role-control { --rc: var(--r-control); }

  .ms__map {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 1040px) {
    .ms__map {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: var(--s-6);
    }
  }
  .ms__col {
    position: relative;
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  /* Стрелки между колонками */
  .ms__col:not(:last-child)::after {
    content: '↓';
    display: block;
    text-align: center;
    color: var(--c-muted);
    font-family: var(--f-mono);
    margin-top: var(--s-1);
  }
  @media (min-width: 1040px) {
    .ms__col:not(:last-child)::after {
      content: '→';
      position: absolute;
      right: calc(-1 * var(--s-6) / 2 - 6px);
      top: 50%;
      margin: 0;
    }
  }
  .ms__colTitle {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--c-ink-2);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .ms__colTitle .mono {
    color: var(--c-muted);
  }
  .ms__blocks {
    display: grid;
    gap: var(--s-2);
  }
  @media (min-width: 640px) and (max-width: 1039px) {
    .ms__blocks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .ms__block {
    display: grid;
    gap: 2px;
    width: 100%;
    padding: 10px 12px 10px 14px;
    border: 1px solid var(--c-line);
    border-left: 3px solid var(--rc);
    border-radius: var(--r-md);
    background: var(--c-surface);
    color: var(--c-ink);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .ms__block:hover {
    border-color: var(--c-ink-2);
    border-left-color: var(--rc);
  }
  .ms__block[aria-pressed='true'] {
    border-color: var(--c-ink);
    border-left-color: var(--rc);
    background: var(--c-accent-soft);
  }
  .ms__blockTitle {
    font-weight: 600;
    font-size: var(--fs-sm);
    line-height: 1.3;
  }
  .ms__blockShort {
    font-size: var(--fs-xs);
    color: var(--c-muted);
    line-height: 1.35;
  }
  .ms__legend {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .ms__legend li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ms__legend i,
  .ms__chip i {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--rc);
  }
  .ms__panel {
    padding: var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }
  .ms__panelHead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-bottom: var(--s-4);
  }
  .ms__panelTitle {
    font-size: var(--fs-xl);
    font-weight: 600;
  }
  .ms__chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 8px;
    border: 1px solid var(--c-line);
    border-radius: 999px;
    font-size: var(--fs-xs);
    color: var(--c-ink-2);
  }
  .ms__panelGrid {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 760px) {
    .ms__panelGrid {
      grid-template-columns: 1.3fr 1.2fr 0.8fr;
    }
  }
  .ms__label {
    margin-bottom: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-muted);
  }
  .ms__list {
    list-style: none;
    display: grid;
    gap: 6px;
    font-size: var(--fs-sm);
  }
  .ms__list li {
    position: relative;
    padding-left: 16px;
  }
  .ms__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 7px;
    height: 1px;
    background: var(--c-ink-2);
  }
  .ms__why {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .ms__who {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ms__who li {
    padding: 3px 10px;
    border-radius: 999px;
    background: var(--c-bg-soft);
    font-size: var(--fs-xs);
    font-weight: 500;
  }
</style>
