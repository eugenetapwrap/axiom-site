---
// Страница услуги «Управленческий учёт» (ветка accounting, 03.11.2026). Собрана по промту, который утвердил Евгений:
// https://claude.ai/artifact/4KfiXXP5VNSn1xHGCvypBj. Тексты и скрины в src/data/accounting.ts.
// Пока только русская версия: английскую пишем после того, как Евгений утвердит русскую (промт, раздел 6).
// Шапка, подвал, кнопки, кейсы, вопросы и контакты повторяют главную (HomePage.astro), главную этот файл не меняет.
import Base from '../layouts/Base.astro';
import AccShot from './AccShot.astro';
import AccLightbox from './AccLightbox.astro';
import FinalThreads from './FinalThreads.astro';
import { site, tgLink } from '../data/site';
import { content } from '../data/content';
import { page, hero, problems, flow, reports, roles, cases, rollout, included, faq, contact } from '../data/accounting';
import { t } from '../lib/typo';
import { group } from '../lib/calc';

const { finalCta, requestForm } = content();
const SERVICE = requestForm.services[1]; // «Управленческий учёт»
const tg = tgLink(contact.topic);

// Дни этапов внедрения: 1–5, 6–13, 14–21, 22–25, 26–30
let day = 0;
const stages = rollout.stages.map((s) => {
  const from = day + 1;
  day += s.days;
  return { ...s, range: `${from}–${day}` };
});
const dayWord = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'день' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'дня' : 'дней');

const ld = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Управленческий учёт и контроль платежей',
    serviceType: 'Management accounting system',
    description: page.description,
    provider: { '@type': 'ProfessionalService', name: site.name, url: 'https://axiomco.io/' },
    areaServed: ['Indonesia', 'Thailand', 'United Arab Emirates', 'Uzbekistan', 'Southeast Asia', 'CIS'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Axiom', item: 'https://axiomco.io/' },
      { '@type': 'ListItem', position: 2, name: hero.eyebrow, item: 'https://axiomco.io/accounting/' },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---

<Base title={page.title} description={page.description} jsonLd={ld} alternates={false} header={{ cta: '#contact', ru: '/accounting/', en: '/en/' }}>
  <!-- Первый экран: заголовок, строка, три цифры с главной и кнопка. Под ними обзор финансов из портала -->
  <section class="hero">
    <div class="container">
      <nav class="crumbs" aria-label="Навигация">
        <a href="/#practices">Услуги</a><span aria-hidden="true">/</span><span aria-current="page">{hero.eyebrow}</span>
      </nav>
      <div class="hero-top">
        <div class="hero-text">
          <h1>{t(hero.title)}</h1>
          <p class="hero-lead">{t(hero.lead)}</p>
        </div>
        <div class="hero-side">
          <dl class="hero-stats">
            {hero.stats.map((s) => <div><dt>{s.value}</dt><dd>{t(s.text)}</dd></div>)}
          </dl>
          <div class="hero-btns">
            <a class="btn btn-primary" href={tg} data-cta="acc_hero_discuss">{hero.cta}</a>
            <a class="link-down" href="#flow" data-cta="acc_hero_flow">{hero.more}</a>
          </div>
        </div>
      </div>
      <AccShot shot={hero.shot} eager size="92vw" class="hero-shot" />
    </div>
  </section>

  <!-- Что закрывает система: шесть задач со слайда 3, сетка 3 × 2, без скринов -->
  <section class="section section--white" aria-labelledby="pb-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{problems.eyebrow}</p>
        <h2 id="pb-title">{t(problems.title)}</h2>
      </div>
      <ul class="pb" data-reveal style="--d: 100ms">
        {problems.items.map((p) => <li><h3>{t(p.title)}</h3><p>{t(p.text)}</p></li>)}
      </ul>
    </div>
  </section>

  <!-- Путь платежа. Компьютер (от 1100 px): шаги слева, справа закреплённый скрин активного шага,
       смена прозрачностью за 200 мс. Телефон и планшет: скрин под своим шагом -->
  <section class="section section--alt" id="flow" aria-labelledby="flow-title">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">{flow.eyebrow}</p>
          <h2 id="flow-title">{t(flow.title)}</h2>
        </div>
        <p class="caption">{t(flow.note)}</p>
      </div>
      <div class="flow">
        <ol class="steps">
          {flow.steps.map((s, i) => (
            <li class={`step${i === 0 ? ' is-on' : ''}`} data-step={i}>
              <span class="step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3>{t(s.title)}</h3>
              <p>{t(s.text)}</p>
              <AccShot shot={s.shot} size="55vw" class="step-fig" />
            </li>
          ))}
        </ol>
        <div class="stage-col">
          <div class="stage">
            {flow.steps.map((s, i) => <AccShot shot={s.shot} size="55vw" class={`stage-fig${i === 0 ? ' is-on' : ''}`} />)}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Отчёты: вкладки в стиле переключателя «Основная / Расширенная» на главной, скрин на всю ширину сетки.
       На телефоне вкладки прокручиваются вбок -->
  <section class="section" id="reports" aria-labelledby="rep-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{reports.eyebrow}</p>
        <h2 id="rep-title">{t(reports.title)}</h2>
      </div>
      <div class="rep" data-tabs>
        <div class="rep-scroll">
          <div class="rep-tabs" role="tablist" aria-label="Отчёты">
            {reports.tabs.map((r, i) => (
              <button type="button" role="tab" id={`rep-t-${r.id}`} aria-controls={`rep-p-${r.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-tab={i}>{r.label}</button>
            ))}
          </div>
        </div>
        {reports.tabs.map((r, i) => (
          <div class="rep-panel" role="tabpanel" id={`rep-p-${r.id}`} aria-labelledby={`rep-t-${r.id}`} data-panel={i} hidden={i !== 0}>
            <p class="rep-text">{t(r.text)}</p>
            <AccShot shot={r.shot} size="92vw" legend={false} />
          </div>
        ))}
      </div>
      <div class="rep-cta">
        <a class="btn btn-soft" href={tg} data-cta="acc_reports_discuss">{reports.cta}</a>
      </div>
    </div>
  </section>

  <!-- Кто что видит: роль и что она получает, без скринов -->
  <section class="section section--white" aria-labelledby="roles-title">
    <div class="container roles-wrap">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{roles.eyebrow}</p>
        <h2 id="roles-title">{t(roles.title)}</h2>
      </div>
      <dl class="roles" data-reveal style="--d: 100ms">
        {roles.items.map((r) => <div><dt>{t(r.role)}</dt><dd>{t(r.text)}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- Два кейса в том же виде, что на главной -->
  <section class="section section--alt" aria-labelledby="cases-title">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">{cases.eyebrow}</p>
          <h2 id="cases-title">{t(cases.title)}</h2>
        </div>
        <p class="caption">{cases.note}</p>
      </div>
      <div class="cases">
        {cases.items.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card">
                  <p><span>{t('Заявка № 63')}</span><b>{group(1080000)} IDR</b></p>
                  <p class="cv-dup"><span>{t('Заявка № 75')}</span><b>{group(1080000)} IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Внедрение за 30 дней: этапы на шкале, ширина этапа пропорциональна числу дней (5 + 8 + 8 + 4 + 5) -->
  <section class="section" aria-labelledby="ro-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{rollout.eyebrow}</p>
        <h2 id="ro-title">{t(rollout.title)}</h2>
      </div>
      <ol class="ro" data-reveal style={`--d: 100ms; --cols: ${stages.map((s) => `${s.days}fr`).join(' ')}`}>
        {stages.map((s, i) => (
          <li style={`--c: var(--th-${i + 1})`}>
            <span class="ro-days">{t(`Дни ${s.range}`)}<span class="ro-len">{t(`, ${s.days} ${dayWord(s.days)}`)}</span></span>
            <i class="ro-bar" aria-hidden="true"></i>
            <b class="ro-name">{t(s.name)}</b>
            <span class="ro-text">{t(s.text)}</span>
          </li>
        ))}
      </ol>
      <p class="ro-after" data-reveal>{t(rollout.after)}</p>
    </div>
  </section>

  <!-- Что входит: состав решения со слайда 20 и стек -->
  <section class="section section--white" aria-labelledby="inc-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{included.eyebrow}</p>
        <h2 id="inc-title">{t(included.title)}</h2>
      </div>
      <div class="inc" data-reveal style="--d: 100ms">
        <ul class="dots inc-list">
          {included.items.map((x) => <li>{t(x)}</li>)}
        </ul>
        <div class="inc-stack">
          <p class="inc-h">{included.stackTitle}</p>
          <ul class="inc-chips">
            {included.stack.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Вопросы: как на главной, список слева, ответ справа. На телефоне ответ под вопросом -->
  <section class="section" id="faq">
    <div class="container faq-wrap" data-faq>
      <div class="faq-side">
        <h2>Вопросы о внедрении</h2>
        <div class="faq-list" role="tablist" aria-orientation="vertical" aria-label="Вопросы о внедрении">
          {faq.map((f, i) => (
            <button type="button" role="tab" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-faq-q={i}>{t(f.q)}</button>
          ))}
        </div>
        <p class="muted faq-more">Не нашли ответ? <a href={tg}>Напишите в Telegram</a></p>
      </div>
      <div class="faq-answers">
        {faq.map((f, i) => (
          <div class="faq-answer" role="tabpanel" id={`faq-a-${i}`} aria-labelledby={`faq-q-${i}`} data-faq-a={i} hidden={i !== 0}>
            <p class="faq-answer-q">{t(f.q)}</p>
            <p>{t(f.a)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Контакты: тот же блок, что на главной. В форме заранее выбрана услуга «Управленческий учёт» -->
  <section class="section section--dark final" id="contact">
    <div class="final-top">
      <FinalThreads />
      <div class="container final-inner" data-reveal>
        <p class="eyebrow">Контакты</p>
        <h2>{contact.title}</h2>
        <p class="final-text">{t(finalCta.text)}</p>
        <div class="btn-row final-btns">
          <a class="btn btn-light" href={tg} data-cta="acc_final_telegram">Написать в Telegram @{site.telegram}</a>
          <a class="btn btn-ghost-light" href={`mailto:${site.email}`} data-cta="acc_final_email">{site.email}</a>
          <button type="button" class="btn btn-ghost-light req-open" aria-expanded="false" aria-controls="req" data-req-open>{requestForm.open}</button>
        </div>
      </div>
    </div>
    <div class="container final-req">
      <form class="req" id="req" hidden data-req data-email={site.email} data-greet={requestForm.greet} data-subject={requestForm.subject}>
        <p class="req-title">{requestForm.title}</p>
        <div class="req-grid">
          <label><span>{requestForm.name}</span><input name="name" autocomplete="name" required /></label>
          <label><span>{requestForm.company}</span><input name="company" autocomplete="organization" /></label>
          <label><span>{requestForm.service}</span><select name="service"><option value="">{requestForm.choose}</option>{requestForm.services.map((o) => <option selected={o === SERVICE}>{o}</option>)}</select></label>
          <label><span>{requestForm.country}</span><select name="country"><option value="">{requestForm.choose}</option>{requestForm.countries.map((o) => <option>{o}</option>)}</select></label>
          <label><span>{requestForm.stage}</span><select name="stage"><option value="">{requestForm.choose}</option>{requestForm.stages.map((o) => <option>{o}</option>)}</select></label>
          <label class="req-wide"><span>{requestForm.task}</span><textarea name="task" rows="3" placeholder={requestForm.taskHint}></textarea></label>
        </div>
        <fieldset class="req-ch">
          <legend>{requestForm.channel}</legend>
          <label><input type="radio" name="channel" value="telegram" checked /> Telegram</label>
          <label><input type="radio" name="channel" value="email" /> {site.email}</label>
        </fieldset>
        <div class="req-foot">
          <button class="btn btn-light" type="submit">{requestForm.submit}</button>
          <p>{t(requestForm.note)}</p>
        </div>
      </form>
    </div>
  </section>

  <AccLightbox />
</Base>

<script>
  import { track } from '../lib/track';
  import { tgLink } from '../data/site';

  // Высота шапки (с панелью палитр) для закреплённого скрина
  const hdr = document.querySelector<HTMLElement>('.header');
  const setHdr = () => { if (hdr) document.documentElement.style.setProperty('--hdr', `${hdr.offsetHeight}px`); };
  setHdr();
  window.addEventListener('resize', setHdr);

  // Путь платежа: активный шаг тот, что пересекает середину экрана. Его скрин справа виден, остальные прозрачны
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const figs = [...document.querySelectorAll<HTMLElement>('.stage-fig')];
  const seen = new Set<number>();
  const setStep = (i: number) => {
    steps.forEach((s, k) => s.classList.toggle('is-on', k === i));
    figs.forEach((f, k) => f.classList.toggle('is-on', k === i));
    if (!seen.has(i)) {
      seen.add(i);
      track('accounting_step_view', { step: i + 1 });
    }
  };
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setStep(Number((e.target as HTMLElement).dataset.step)); });
    }, { rootMargin: '-50% 0px -50% 0px' });
    steps.forEach((s) => io.observe(s));
  }
  // На компьютере нажатие на шаг прокручивает к нему, и справа появляется его скрин
  const wide = window.matchMedia('(min-width: 1100px)');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  steps.forEach((s) => {
    s.addEventListener('click', (e) => {
      if (!wide.matches || (e.target as HTMLElement).closest('a, button')) return;
      s.scrollIntoView({ block: 'center', behavior: reduce.matches ? 'auto' : 'smooth' });
    });
  });

  // Вкладки отчётов: стрелки влево и вправо переключают вкладку
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (i: number, focus = false) => {
      tabs.forEach((b, k) => {
        b.setAttribute('aria-selected', String(k === i));
        b.tabIndex = k === i ? 0 : -1;
      });
      panels.forEach((p, k) => { p.hidden = k !== i; });
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (focus) tabs[i].focus();
    };
    tabs.forEach((b, i) => {
      b.addEventListener('click', () => show(i));
      b.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        show((i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length, true);
      });
    });
  });

  // Вопросы: как на главной
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLButtonElement>('[data-faq-q]')];
    const as = [...root.querySelectorAll<HTMLElement>('[data-faq-a]')];
    const box = root.querySelector<HTMLElement>('.faq-answers')!;
    const narrow = window.matchMedia('(max-width: 899px)');
    let cur = 0;
    const place = () => {
      if (narrow.matches) qs[cur].after(as[cur]);
      else as.forEach((a) => box.append(a));
    };
    const show = (i: number) => {
      cur = i;
      qs.forEach((q, k) => {
        q.setAttribute('aria-selected', String(k === i));
        q.tabIndex = k === i ? 0 : -1;
      });
      as.forEach((a, k) => { a.hidden = k !== i; });
      place();
    };
    qs.forEach((q, i) => {
      q.addEventListener('click', () => show(i));
      q.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowDown' ? 1 : qs.length - 1)) % qs.length;
        qs[n].focus();
        show(n);
      });
    });
    narrow.addEventListener('change', place);
    place();
  });

  // Форма запроса: как на главной, собирает сообщение и открывает Telegram или почту
  const req = document.querySelector<HTMLFormElement>('[data-req]');
  const reqBtn = document.querySelector<HTMLButtonElement>('[data-req-open]');
  reqBtn?.addEventListener('click', () => {
    if (!req) return;
    req.hidden = !req.hidden;
    reqBtn.setAttribute('aria-expanded', String(!req.hidden));
    if (!req.hidden) {
      track('request_open', { service: (req.elements.namedItem('service') as HTMLSelectElement).value });
      req.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    }
  });
  req?.addEventListener('submit', (e) => {
    e.preventDefault();
    const lines = [req.dataset.greet!, ''];
    req.querySelectorAll<HTMLElement>('.req-grid label').forEach((l) => {
      const f = l.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')!;
      const v = f.value.trim();
      if (v) lines.push(`${l.querySelector('span')!.textContent}: ${v}`);
    });
    const text = lines.join('\n');
    const ch = (req.elements.namedItem('channel') as RadioNodeList).value;
    track('lead', { channel: ch, service: (req.elements.namedItem('service') as HTMLSelectElement).value });
    if (ch === 'email') location.href = `mailto:${req.dataset.email}?subject=${encodeURIComponent(req.dataset.subject!)}&body=${encodeURIComponent(text)}`;
    else window.open(tgLink(text), '_blank', 'noopener');
  });

  // События кнопок для аналитики
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((a) => {
    a.addEventListener('click', () => track('cta_click', { id: a.dataset.cta! }));
  });
</script>

<style>
  /* Первый экран: как на главной, заголовок слева, цифры и кнопка справа. Скрин во всю ширину сетки ниже */
  .hero { padding: var(--s4) 0 var(--s6); background-color: var(--bg); }
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--s3); font-size: 15px; color: var(--ink-3); }
  .crumbs a { color: var(--accent); text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .hero-top { --hfs: clamp(32px, 3.6vw, 56px); display: grid; gap: var(--s4); }
  .hero h1 { font-size: var(--hfs); line-height: 1.06; max-width: 13em; }
  .hero-lead { margin-top: var(--s3); font-size: clamp(18px, 1.5vw, 21px); line-height: 1.45; color: var(--ink-2); }
  .hero-side { display: grid; gap: var(--s4); align-content: start; }
  @media (min-width: 1200px) {
    .hero-top { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: var(--s6); }
    .hero-side { align-content: space-between; padding-top: calc(var(--hfs) * 0.166); }
  }
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin: 0; }
  .hero-stats div { padding-top: 14px; border-top: 3px solid var(--th-1); }
  .hero-stats div:nth-child(2) { border-top-color: var(--th-2); }
