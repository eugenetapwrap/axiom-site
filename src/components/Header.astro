---
import { site } from '../data/site';
import PaletteBar from './PaletteBar.astro';

// На главной после логотипа две точки: переключают мотив первого экрана (нити или J-кривая)
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const sigViews = [
  { id: 'threads', label: 'Деньги за месяц' },
  { id: 'jcurve', label: 'Окупаемость проекта' },
];

const nav = [
  { href: '/#practices', label: 'Направления' },
  { href: '/#expertise', label: 'Экспертиза' },
  { href: '/#cases', label: 'Кейсы' },
  { href: '/#team', label: 'Команда' },
];
---

<header class="header">
  <PaletteBar />
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Axiom, на главную">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="var(--btn-bg)"></rect>
        <path d="M9 24 16 8l7 16M11.8 18h8.4" fill="none" stroke="var(--btn-ink)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>Axiom</span>
    </a>
    {isHome && (
      <div class="sig-dots" role="tablist" aria-label="Пример на первом экране">
        {sigViews.map((v, i) => (
          <button
            type="button"
            role="tab"
            class="sig-dot"
            id={`sig-tab-${v.id}`}
            aria-controls={`sig-${v.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={v.label}
            title={v.label}
            tabindex={i === 0 ? 0 : -1}
            data-sig-tab={v.id}
          ></button>
        ))}
      </div>
    )}
    <nav class="nav" aria-label="Основное меню">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="header-login" href={site.portalUrl} aria-label="Личный кабинет клиента">
      <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="7" r="3.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.8 16.5c.9-2.9 3.3-4.5 6.2-4.5s5.3 1.6 6.2 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      <span>Личный кабинет</span>
    </a>
    <a class="btn btn-primary header-cta" href={site.telegramUrl}>Написать в Telegram</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s4);
    min-height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .sig-dots { display: inline-flex; gap: 2px; margin-left: calc(var(--s2) * -1); }
  .sig-dot {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }
  .sig-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1.5px solid var(--ink-3);
    transition: background-color .2s ease, border-color .2s ease;
  }
  .sig-dot:hover::before { border-color: var(--ink); }
  .sig-dot[aria-selected='true']::before { background: var(--ink); border-color: var(--ink); }
  .sig-dot:focus-visible { outline: 2px solid var(--accent); outline-offset: 0; }
  .nav {
    display: flex;
    gap: var(--s3);
    margin-left: auto;
    font-size: 16px;
  }
  .nav a { color: var(--ink-2); text-decoration: none; }
  .nav a:hover { color: var(--ink); }
  .header-cta { min-height: 40px; padding: 8px 16px; font-size: 15px; }
  .header-login {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 6px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink);
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .header-login:hover { border-color: var(--accent); color: var(--accent); }
  .header-login svg { width: 18px; height: 18px; color: var(--accent); }
  .nav { margin-right: var(--s1); }

  @media (max-width: 899px) {
    .nav { display: none; }
    .header-login { margin-left: auto; }
  }
  @media (max-width: 519px) {
    .header-inner { gap: var(--s1); }
    .sig-dots { margin-left: -4px; gap: 0; }
    .sig-dot { width: 18px; }
    .logo { font-size: 18px; gap: 8px; }
    .header-cta { padding: 8px 12px; font-size: 14px; white-space: nowrap; }
    .header-login { padding: 8px 10px; }
    .header-login span { display: none; }
  }
</style>
