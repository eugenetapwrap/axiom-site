---
interface Props {
  nav: { href: string; label: string }[];
  cta: { href: string; label: string };
  brand: string;
}
const { nav, cta, brand } = Astro.props;
---

<header class="header">
  <div class="container header__inner">
    <a class="logo" href="/" aria-label={`${brand}, на главную`}>
      <span class="logo__mark" aria-hidden="true">A</span>
      <span class="logo__word">{brand}</span>
    </a>
    <nav class="nav" aria-label="Разделы">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <a class="btn btn--primary header__cta" href={cta.href}>{cta.label}</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--c-line);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    min-height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--c-ink);
    text-decoration: none;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .logo__mark {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: var(--c-ink);
    color: #fff;
    font-family: var(--f-mono);
    font-size: 15px;
  }
  .logo__word {
    font-size: 17px;
  }
  .nav {
    margin-left: auto;
    display: none;
  }
  .nav ul {
    display: flex;
    gap: var(--s-1);
    list-style: none;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--s-3);
    border-radius: var(--r-md);
    color: var(--c-ink-2);
    text-decoration: none;
    font-size: var(--fs-sm);
  }
  .nav a:hover {
    color: var(--c-ink);
    background: var(--c-bg-soft);
  }
  .header__cta {
    margin-left: auto;
    min-height: 40px;
    padding: 0 var(--s-4);
    font-size: var(--fs-sm);
  }
  @media (min-width: 960px) {
    .nav {
      display: block;
    }
    .header__cta {
      margin-left: 0;
    }
  }
</style>
