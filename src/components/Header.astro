---
import { site } from '../data/site';

const nav = [
  { href: '/#services', label: 'Услуги' },
  { href: '/#system', label: 'Как работает учёт' },
  { href: '/#cases', label: 'Кейсы' },
  { href: '/#about', label: 'О нас' },
];
---

<header class="header">
  <div class="container header-inner">
    <a class="logo" href="/" aria-label="Axiom, на главную">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <rect width="32" height="32" rx="6" fill="var(--accent)"></rect>
        <path d="M9 24 16 8l7 16M11.8 18h8.4" fill="none" stroke="#faf8f3" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>Axiom</span>
    </a>
    <nav class="nav" aria-label="Основное меню">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <a class="btn btn-primary header-cta" href={site.telegramUrl}>Написать в Telegram</a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--s4);
    min-height: 64px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .nav {
    display: flex;
    gap: var(--s3);
    margin-left: auto;
    font-size: 16px;
  }
  .nav a { color: var(--ink-2); text-decoration: none; }
  .nav a:hover { color: var(--ink); }
  .header-cta { min-height: 40px; padding: 8px 16px; font-size: 15px; }

  @media (max-width: 899px) {
    .nav { display: none; }
    .header-cta { margin-left: auto; }
  }
</style>
