---
// Схема движения денег по мотивам экрана Cash Flow Sankey в портале.
// Под схемой столбики поступлений по месяцам: видно, как портфель растёт и добавляются проекты.
// Клик по месяцу или кнопка воспроизведения перестраивают потоки. Данные демонстрационные (млрд IDR).
import { NODES, LINKS, MONTHS, MONTHS_SHORT, SERIES, MONTH_TOTALS, GEOM, layout, fmt, linkColor } from '../lib/sankey';

const { W, H, NODE_W, colX } = GEOM;
const colTitles = ['Проекты', 'Поступления', 'Группы затрат', 'Статьи расходов'];
const first = layout(SERIES[0]);
const visible = (v: number) => v > 0.005;

const sideLabel = (id: string) => {
  const n = NODES.find((x) => x.id === id)!;
  const p = first.nodes[id];
  const right = n.col === 3;
  return { x: right ? p.x + NODE_W + 12 : p.x - 12, y: p.y + p.h / 2, anchor: right ? 'start' : 'end', compact: p.h < 34 };
};
// Подписи средних колонок — плашки над узлом, чтобы не лежать на лентах
const chipPos = (id: string) => {
  const p = first.nodes[id];
  return { x: p.x + NODE_W / 2, y: p.y - 14 };
};
const estW = (text: string) => text.length * 7.4 + 18;

const totals = MONTH_TOTALS.map((p) => p.reduce((s, v) => s + v, 0));
const maxTotal = Math.max(...totals);
---

<figure class="sankey theme-paper" data-sankey>
  <div class="sankey-scroll">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="sankey-title sankey-desc">
      <title id="sankey-title">Движение денег по проектам за месяц</title>
      <desc id="sankey-desc">
        Пример на демонстрационных данных: поступления по проектам распределяются на строительство, операционные расходы, инвестиции и прирост остатка. В январе деньги идут с одного проекта, к концу года с пяти. Столбики под схемой переключают месяцы.
      </desc>
      <defs>
        <clipPath id="sankey-reveal">
          <rect class="sankey-clip" x="0" y="0" width={W} height={H}></rect>
        </clipPath>
      </defs>
      {colTitles.map((t, i) => (
        <text class="col-title" x={i === 3 ? colX[i] : i === 0 ? colX[i] + NODE_W : colX[i] + NODE_W / 2} y="14" text-anchor={i === 3 ? 'start' : i === 0 ? 'end' : 'middle'}>{t}</text>
      ))}
      <g clip-path="url(#sankey-reveal)">
        {LINKS.map((l, i) => (
          <path class="flow" d={first.links[i].d} fill={linkColor(l)} data-link={i}></path>
        ))}
      </g>
      {NODES.map((n) => {
        const p = first.nodes[n.id];
        return <rect class={`node${visible(p.value) ? '' : ' is-off'}`} x={p.x} y={p.y} width={NODE_W} height={Math.max(p.h, 2)} rx="2" fill="var(--ink)" data-node={n.id}></rect>;
      })}
      {NODES.filter((n) => n.col === 0 || n.col === 3).map((n) => {
        const lp = sideLabel(n.id);
        const val = `${fmt(first.nodes[n.id].value)} млрд`;
        const off = visible(first.nodes[n.id].value) ? '' : ' is-off';
        return lp.compact ? (
          <text class={`node-label${off}`} x={lp.x} y={lp.y} text-anchor={lp.anchor} data-label={n.id}>
            <tspan data-t="name" x={lp.x} dy="0">{n.label}</tspan><tspan class="node-value" data-t="val" dx="6" dy="0">{val}</tspan>
          </text>
        ) : (
          <text class={`node-label${off}`} x={lp.x} y={lp.y} text-anchor={lp.anchor} data-label={n.id}>
            <tspan data-t="name" x={lp.x} dy="-0.25em">{n.label}</tspan><tspan class="node-value" data-t="val" x={lp.x} dy="1.3em">{val}</tspan>
          </text>
        );
      })}
      {NODES.filter((n) => n.col === 1 || n.col === 2).map((n) => {
        const c = chipPos(n.id);
        const val = `${fmt(first.nodes[n.id].value)} млрд`;
        const w = estW(`${n.label} ${val}`);
        return (
          <g class="chip" data-chip={n.id} transform={`translate(${c.x.toFixed(1)} ${c.y.toFixed(1)})`}>
            <rect x={(-w / 2).toFixed(1)} y="-11" width={w.toFixed(1)} height="22" rx="11"></rect>
            <text text-anchor="middle" y="0.5"><tspan class="chip-name">{n.label}</tspan><tspan class="node-value" dx="5" data-t="val">{val}</tspan></text>
          </g>
        );
      })}
    </svg>
  </div>

  <div class="sk-controls">
    <button class="sk-play" type="button" data-play aria-label="Воспроизвести по месяцам">
      <svg class="sk-i-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3.5v9l7.5-4.5Z" fill="currentColor"/></svg>
      <svg class="sk-i-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M4.5 3.5h2.5v9H4.5zM9 3.5h2.5v9H9z" fill="currentColor"/></svg>
    </button>
    <div class="sk-months" role="group" aria-label="Поступления по месяцам">
      {MONTH_TOTALS.map((p, i) => (
        <button type="button" class={`sk-month${i === 0 ? ' is-on' : ' is-ahead'}`} aria-pressed={i === 0 ? 'true' : 'false'} aria-label={`${MONTHS[i]}: ${fmt(totals[i])} млрд IDR`} data-month-btn={i}>
          <span class="sk-stack" style={`--h:${((totals[i] / maxTotal) * 100).toFixed(1)}%`}>
            {p.map((v, k) => (v > 0 ? <i style={`flex-grow:${v};background:var(--th-${k + 1})`}></i> : null))}
          </span>
          <span class="sk-m">{MONTHS_SHORT[i]}</span>
        </button>
      ))}
    </div>
    <div class="sk-period">
      <b data-month>{MONTHS[0]}</b>
      <span>Поступления <b data-total>{fmt(first.total)}</b> млрд IDR</span>
      <span class="sk-projects" data-projects>Проектов: {MONTH_TOTALS[0].filter((v) => v > 0).length}</span>
    </div>
  </div>

  <figcaption class="sankey-caption">
    <span class="sankey-info" aria-live="polite" data-default="Наведите на поток, чтобы увидеть сумму и долю">Наведите на поток, чтобы увидеть сумму и долю</span>
    <span class="caption">Демо-данные, млрд IDR за месяц</span>
  </figcaption>
</figure>

<style>
  .sankey {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--s3) var(--s3) var(--s2);
  }
  .sankey-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .sankey-scroll svg { width: 100%; min-width: 760px; height: auto; font-family: var(--font); }
  .col-title { font-size: 13px; font-weight: 500; fill: var(--ink-3); }
  .flow { fill-opacity: 0.82; transition: fill-opacity 0.2s ease; cursor: pointer; }
  .flow:hover, .flow.is-active { fill-opacity: 0.95; }
  .sankey.has-active .flow:not(.is-active) { fill-opacity: 0.15; }
  .node { cursor: pointer; transition: opacity .4s ease; }
  .node-label { font-size: 14px; fill: var(--ink); dominant-baseline: middle; cursor: default; transition: opacity .4s ease; }
  .node-value { font-size: 13px; font-weight: 700; fill: var(--ink-2); }
  .node.is-off, .node-label.is-off, .chip.is-off { opacity: 0; }
  .chip { transition: opacity .4s ease; cursor: default; }
  .chip rect { fill: var(--surface); stroke: var(--line); }
  .chip text { font-size: 13px; dominant-baseline: middle; fill: var(--ink); }
  .chip .chip-name { font-weight: 600; }
  .sankey-clip { transform-origin: left; }
  .sankey.is-armed .sankey-clip { transform: scaleX(0); }
  .sankey.is-armed .node, .sankey.is-armed .node-label, .sankey.is-armed .chip { opacity: 0; }
  .sankey.is-visible .sankey-clip { transform: scaleX(1); transition: transform 1.8s cubic-bezier(0.65, 0, 0.35, 1); }

  .sk-controls {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: var(--s2) var(--s3);
    margin-top: var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--line);
  }
  @media (min-width: 900px) { .sk-controls { grid-template-columns: auto minmax(0, 1fr) 210px; } }
  .sk-play {
    display: grid;
    place-items: center;
    align-self: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--btn-bg);
    color: var(--btn-ink);
    cursor: pointer;
  }
  .sk-play:hover { background: color-mix(in srgb, var(--btn-bg) 86%, var(--ink)); }
  .sk-play svg { width: 18px; height: 18px; }
  .sk-i-pause, .sankey.is-playing .sk-i-play { display: none; }
  .sankey.is-playing .sk-i-pause { display: block; }

  /* Месяцы: столбик поступлений по проектам, цвета как у проектов на схеме */
  .sk-months { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 4px; }
  .sk-month {
    display: grid;
    grid-template-rows: 64px auto;
    gap: 4px;
    padding: 4px 0 2px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    font: inherit;
    cursor: pointer;
    transition: opacity .3s ease, background-color .2s ease;
  }
  .sk-month:hover { background: var(--track); }
  .sk-month.is-ahead { opacity: .32; }
  .sk-month.is-ahead:hover { opacity: .7; }
  .sk-month:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .sk-stack { align-self: end; justify-self: center; display: flex; flex-direction: column-reverse; width: min(26px, 70%); height: var(--h); border-radius: 3px; overflow: hidden; }
  .sk-stack i { display: block; min-height: 0; }
  .sk-stack i + i { border-bottom: 1px solid var(--surface); }
  .sk-m { font-size: 12px; color: var(--ink-3); text-align: center; }
  .sk-month.is-on { background: var(--track); }
  .sk-month.is-on .sk-m { color: var(--ink); font-weight: 700; }
  @media (max-width: 599px) {
    .sk-month { grid-template-rows: 48px auto; }
    .sk-month:nth-child(even) .sk-m { visibility: hidden; }
  }

  .sk-period { grid-column: 1 / -1; display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 12px; font-size: 15px; color: var(--ink-2); }
  .sk-period > b { font-size: 18px; color: var(--ink); }
  .sk-period span b { color: var(--accent); }
  .sk-projects { color: var(--ink-3); }
  @media (min-width: 900px) { .sk-period { grid-column: auto; align-self: center; display: grid; gap: 2px; justify-items: end; text-align: right; } }

  .sankey-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s1) var(--s3);
    margin-top: var(--s2);
    padding-top: var(--s2);
    border-top: 1px solid var(--line);
    font-size: 15px;
  }
  .sankey-info { font-weight: 600; min-height: 1.4em; }
  @media (max-width: 719px) { .sankey { padding: var(--s2); } }
</style>

<script>
  import { NODES, LINKS, MONTHS, SERIES, GEOM, layout, fmt } from '../lib/sankey';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const label = Object.fromEntries(NODES.map((n) => [n.id, n.label]));
  const col = Object.fromEntries(NODES.map((n) => [n.id, n.col]));

  document.querySelectorAll<HTMLElement>('[data-sankey]').forEach((root) => {
    const info = root.querySelector<HTMLElement>('.sankey-info')!;
    const def = info.dataset.default ?? '';
    const flows = [...root.querySelectorAll<SVGPathElement>('[data-link]')];
    const rects = Object.fromEntries([...root.querySelectorAll<SVGRectElement>('[data-node]')].map((r) => [r.dataset.node!, r]));
    const texts = Object.fromEntries([...root.querySelectorAll<SVGTextElement>('[data-label]')].map((t) => [t.dataset.label!, t]));
    const chips = Object.fromEntries([...root.querySelectorAll<SVGGElement>('[data-chip]')].map((g) => [g.dataset.chip!, g]));
    const months = [...root.querySelectorAll<HTMLButtonElement>('[data-month-btn]')];
    const monthEl = root.querySelector<HTMLElement>('[data-month]')!;
    const totalEl = root.querySelector<HTMLElement>('[data-total]')!;
    const projEl = root.querySelector<HTMLElement>('[data-projects]')!;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;

    let month = 0;
    let current = SERIES[0].slice();
    let lay = layout(current);

    // Подсказки по наведению считают долю от поступлений текущего месяца
    const share = (v: number) => `${Math.round((v / lay.total) * 100)}%`;
    const linkInfo = (i: number) => `${label[LINKS[i].from]} → ${label[LINKS[i].to]}: ${fmt(current[i])} млрд IDR · ${share(current[i])}`;
    const nodeInfo = (id: string) => `${label[id]}: ${fmt(lay.nodes[id].value)} млрд IDR · ${share(lay.nodes[id].value)}`;
    let hovered: (() => string) | null = null;
    const showInfo = () => { info.textContent = hovered ? hovered() : def; };

    flows.forEach((el, i) => {
      el.addEventListener('mouseenter', () => { root.classList.add('has-active'); el.classList.add('is-active'); hovered = () => linkInfo(i); showInfo(); });
      el.addEventListener('mouseleave', () => { root.classList.remove('has-active'); el.classList.remove('is-active'); hovered = null; showInfo(); });
      el.addEventListener('click', () => { hovered = () => linkInfo(i); showInfo(); });
    });
    [...Object.entries(rects), ...Object.entries(texts), ...Object.entries(chips)].forEach(([id, el]) => {
      el.addEventListener('mouseenter', () => { hovered = () => nodeInfo(id); showInfo(); });
      el.addEventListener('mouseleave', () => { hovered = null; showInfo(); });
    });

    // Ширина плашки по настоящему тексту
    const fitChip = (g: SVGGElement) => {
      const t = g.querySelector('text')!;
      const w = t.getComputedTextLength() + 20;
      const r = g.querySelector('rect')!;
      r.setAttribute('x', (-w / 2).toFixed(1));
      r.setAttribute('width', w.toFixed(1));
    };

    const draw = (values: number[]) => {
      current = values;
      lay = layout(values);
      lay.links.forEach((l, i) => flows[i].setAttribute('d', l.d));
      NODES.forEach((n) => {
        const p = lay.nodes[n.id];
        const on = p.value > 0.005;
        const r = rects[n.id];
        r.setAttribute('y', p.y.toFixed(1));
        r.setAttribute('height', Math.max(p.h, 2).toFixed(1));
        r.classList.toggle('is-off', !on);
        const val = `${fmt(p.value)} млрд`;
        if (col[n.id] === 1 || col[n.id] === 2) {
          const g = chips[n.id];
          g.setAttribute('transform', `translate(${(p.x + GEOM.NODE_W / 2).toFixed(1)} ${(p.y - 14).toFixed(1)})`);
          const v = g.querySelector('[data-t="val"]')!;
          if (v.textContent !== val) { v.textContent = val; fitChip(g); }
          g.classList.toggle('is-off', !on);
          return;
        }
        const t = texts[n.id];
        t.classList.toggle('is-off', !on);
        const right = n.col === 3;
        const x = right ? p.x + GEOM.NODE_W + 12 : p.x - 12;
        t.setAttribute('y', (p.y + p.h / 2).toFixed(1));
        const [name, v] = [t.querySelector('[data-t="name"]')!, t.querySelector('[data-t="val"]')!];
        v.textContent = val;
        if (p.h < 34) {
          name.setAttribute('dy', '0');
          v.removeAttribute('x');
          v.setAttribute('dx', '6');
          v.setAttribute('dy', '0');
        } else {
          name.setAttribute('dy', '-0.25em');
          v.setAttribute('x', String(x));
          v.setAttribute('dx', '0');
          v.setAttribute('dy', '1.3em');
        }
      });
      if (hovered) showInfo();
    };
    Object.values(chips).forEach(fitChip);

    // Плавный переход между месяцами
    let raf = 0;
    const goTo = (m: number, animate = true) => {
      month = m;
      months.forEach((b, i) => {
        b.classList.toggle('is-on', i === m);
        b.classList.toggle('is-ahead', i > m);
        b.setAttribute('aria-pressed', String(i === m));
      });
      monthEl.textContent = MONTHS[m];
      const target = SERIES[m];
      const proj = target.slice(0, 5);
      totalEl.textContent = fmt(proj.reduce((s, v) => s + v, 0));
      projEl.textContent = `Проектов: ${proj.filter((v) => v > 0).length}`;
      cancelAnimationFrame(raf);
      if (!animate || reduce) { draw(target.slice()); return; }
      const from = current.slice();
      const t0 = performance.now();
      const dur = 800;
      const step = (now: number) => {
        const k = Math.min(1, (now - t0) / dur);
        const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        draw(from.map((v, i) => v + (target[i] - v) * e));
        if (k < 1) raf = requestAnimationFrame(step);
      };
      raf = requestAnimationFrame(step);
    };

    // Воспроизведение
    let timer = 0;
    const stop = () => { clearInterval(timer); timer = 0; root.classList.remove('is-playing'); playBtn.setAttribute('aria-label', 'Воспроизвести по месяцам'); };
    const play = () => {
      if (month >= MONTHS.length - 1) goTo(0);
      root.classList.add('is-playing');
      playBtn.setAttribute('aria-label', 'Пауза');
      timer = window.setInterval(() => {
        if (month >= MONTHS.length - 1) { stop(); return; }
        goTo(month + 1);
      }, 1500);
    };
    playBtn.addEventListener('click', () => (timer ? stop() : play()));
    months.forEach((b, i) => b.addEventListener('click', () => { stop(); goTo(i); }));

    if (reduce || !('IntersectionObserver' in window)) { goTo(11, false); return; }
    root.classList.add('is-armed');
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          root.classList.add('is-visible');
          root.classList.remove('is-armed');
          io.disconnect();
          // После появления схемы один раз проигрываем год
          window.setTimeout(() => { if (!timer && month === 0) play(); }, 1900);
        }
      });
    }, { threshold: 0.3 });
    io.observe(root);
  });
</script>
