---
import { t } from '../lib/typo';
import { process } from '../content/ru';
---

<section class="section" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2 id="process-title" class="h2">{t(process.title)}</h2>
    </div>

    <ol class="steps">
      {
        process.steps.map((s, i) => (
          <li class="step">
            <span class="step__num mono">{i + 1}</span>
            <p class="step__title">{s.title}</p>
            <p class="step__text">{t(s.text)}</p>
          </li>
        ))
      }
    </ol>

    <ul class="notes">
      {
        process.notes.map((n) => (
          <li class:list={['note', { tbd: n.tbd }]}>
            <p class="note__title">{n.title}</p>
            <p class="note__text">{t(n.text)}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    gap: var(--s-5);
    counter-reset: step;
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-6);
    }
  }
  .step {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 2px solid var(--c-ink);
  }
  .step__num {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .step__title {
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .step__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .notes {
    list-style: none;
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-8);
  }
  @media (min-width: 1040px) {
    .notes {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .note {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-bg-soft);
  }
  .note__title {
    font-weight: 600;
  }
  .note__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
</style>
