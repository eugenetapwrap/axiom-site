---
import { t } from '../lib/typo';
import { process } from '../content/ru';
---

<section class="section section--soft" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{process.eyebrow}</p>
      <h2 id="process-title" class="h2">{t(process.title)}</h2>
    </div>

    <ol class="steps">
      {
        process.steps.map((s, i) => (
          <li class="step">
            <span class="step__num mono">{i + 1}</span>
            <p class="step__title">{s.title}</p>
            <p class="step__text">{t(s.text)}</p>
          </li>
        ))
      }
    </ol>

    <div class="cond">
      <ul class="terms">
        {
          process.terms.map((n) => (
            <li class:list={['term', { tbd: n.tbd }]}>
              <p class="term__title">{n.title}</p>
              <p class="term__text">{t(n.text)}</p>
            </li>
          ))
        }
      </ul>
      <div class="not">
        <p class="not__title">{process.notTitle}</p>
        <ul>
          {process.not.map((n) => <li>{t(n)}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--s-6);
    }
  }
  .step {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 2px solid var(--c-ink);
  }
  .step__num {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .step__title {
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .step__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .cond {
    display: grid;
    gap: var(--s-4);
    margin-top: var(--s-8);
  }
  @media (min-width: 1040px) {
    .cond {
      grid-template-columns: 2fr 1fr;
    }
  }
  .terms {
    list-style: none;
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 640px) {
    .terms {
      grid-template-columns: 1fr 1fr;
    }
  }
  .term {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    border-radius: var(--r-lg);
    background: var(--c-surface);
  }
  .term__title {
    font-weight: 600;
  }
  .term__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .not {
    padding: var(--s-5);
    border: 1px dashed var(--c-line-strong);
    border-radius: var(--r-lg);
  }
  .not__title {
    font-weight: 600;
    margin-bottom: var(--s-3);
  }
  .not ul {
    list-style: none;
    display: grid;
    gap: var(--s-3);
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .not li {
    position: relative;
    padding-left: 20px;
  }
  .not li::before {
    content: '×';
    position: absolute;
    left: 0;
    top: -1px;
    font-family: var(--f-mono);
    color: var(--c-muted);
  }
</style>
