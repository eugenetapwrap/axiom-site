---
// Рамка для макета продукта: строка с названием файла или экрана и подпись «данные вымышленные».
interface Props {
  title: string;
  meta?: string;
  note?: string;
  tabs?: string[];
  activeTab?: number;
}
const { title, meta, note = 'Пример. Данные вымышленные', tabs, activeTab = 0 } = Astro.props;
---

<figure class="mock">
  <div class="mock__bar">
    <span class="mock__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="mock__title">{title}</span>
    {meta && <span class="mock__meta">{meta}</span>}
  </div>
  {
    tabs && (
      <div class="mock__tabs" aria-hidden="true">
        {tabs.map((t, i) => (
          <span class:list={['mock__tab', { 'is-active': i === activeTab }]}>{t}</span>
        ))}
      </div>
    )
  }
  <div class="mock__body">
    <slot />
  </div>
  <figcaption class="mock__note">{note}</figcaption>
</figure>

<style>
  .mock {
    margin: 0;
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-1);
    overflow: hidden;
    font-size: var(--fs-xs);
    line-height: 1.4;
    color: var(--c-ink);
  }
  .mock__bar {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    padding: 10px var(--s-4);
    border-bottom: 1px solid var(--c-line);
    background: #fafbfa;
  }
  .mock__dots {
    display: inline-flex;
    gap: 5px;
  }
  .mock__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--c-line-strong);
  }
  .mock__title {
    font-family: var(--f-mono);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .mock__meta {
    margin-left: auto;
    color: var(--c-muted);
    white-space: nowrap;
  }
  .mock__tabs {
    display: flex;
    gap: var(--s-4);
    padding: 0 var(--s-4);
    border-bottom: 1px solid var(--c-line);
    overflow: hidden;
    white-space: nowrap;
  }
  .mock__tab {
    padding: 9px 0 8px;
    color: var(--c-muted);
    border-bottom: 2px solid transparent;
  }
  .mock__tab.is-active {
    color: var(--c-ink);
    font-weight: 600;
    border-bottom-color: var(--c-ink);
  }
  .mock__body {
    padding: var(--s-4);
  }
  .mock__note {
    padding: 8px var(--s-4) 10px;
    border-top: 1px dashed var(--c-line);
    color: var(--c-muted);
    font-size: 12px;
  }
</style>
