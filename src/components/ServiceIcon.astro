---
// Линейные иконки направлений: свои, в одном стиле (штрих 1.4, скруглённые концы).
// models — Cash Flow со столбиками и линией, audit — лупа над таблицей,
// accounting — гроссбух с галочками, advisory — весы.
interface Props { name: string }
const { name } = Astro.props;
---

<svg class="s-icon" viewBox="0 0 40 40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
  {name === 'models' && (
    <>
      <path d="M4 34h32" />
      <path d="M9 30v-5M15 30v-9M21 30v-6M27 30v-13M33 30v-10" />
      <path d="M7 19l7-6 6 4 13-10" />
      <path d="M28 7h5v5" />
    </>
  )}
  {name === 'audit' && (
    <>
      <rect x="4" y="6" width="22" height="26" rx="2" />
      <path d="M4 13h22M4 20h10M4 26h8M12 6v26" />
      <circle cx="26" cy="25" r="7" />
      <path d="M31 30l5 5" />
      <path d="M23 25l2 2 4-4" />
    </>
  )}
  {name === 'accounting' && (
    <>
      <path d="M8 5h22a3 3 0 0 1 3 3v27H11a3 3 0 0 1-3-3Z" />
      <path d="M8 32a3 3 0 0 1 3-3h22" />
      <path d="M14 11l2 2 3-3M14 18l2 2 3-3" />
      <path d="M22 12h6M22 19h6M14 25h14" />
    </>
  )}
  {name === 'advisory' && (
    <>
      <path d="M20 5v29M12 34h16M10 10h20" />
      <circle cx="20" cy="7" r="1.6" />
      <path d="M10 10l-5 11h10Z" />
      <path d="M30 10l-5 11h10Z" />
      <path d="M5 21a5 3 0 0 0 10 0M25 21a5 3 0 0 0 10 0" />
    </>
  )}
</svg>

<style>
  .s-icon { width: 40px; height: 40px; color: var(--accent); flex: none; }
</style>
