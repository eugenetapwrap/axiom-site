---
import { t } from '../lib/typo';
import { team } from '../content/ru';
---

<section class="section section--soft" id="team" aria-labelledby="team-title">
  <div class="container team">
    <div class="team__intro">
      <p class="eyebrow">{team.eyebrow}</p>
      <h2 id="team-title" class="h2">{t(team.title)}</h2>
      <p class="lead">{t(team.text)}</p>
    </div>

    <div class="team__side">
      <div class:list={['founder', { tbd: team.founder.tbd }]}>
        <div class="founder__photo" role="img" aria-label="Место для фото основателя">Фото</div>
        <div>
          <p class="founder__name">{team.founder.name}</p>
          <p class="founder__role">{t(team.founder.role)}</p>
          <p class="founder__text">{t(team.founder.text)}</p>
        </div>
      </div>
      <ul class="roles">
        {
          team.roles.map((r) => (
            <li>
              <p class="roles__title">{r.title}</p>
              <p class="roles__text">{t(r.text)}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .team {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 1040px) {
    .team {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
    }
  }
  .team__intro {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .team__side {
    display: grid;
    gap: var(--s-5);
  }
  .founder {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
  }
  .founder__photo {
    display: grid;
    place-items: center;
    width: 96px;
    height: 96px;
    border-radius: var(--r-md);
    background: repeating-linear-gradient(45deg, var(--c-bg-soft) 0 8px, #eceee9 8px 16px);
    color: var(--c-muted);
    font-size: var(--fs-xs);
  }
  .founder__name {
    font-size: var(--fs-lg);
    font-weight: 600;
  }
  .founder__role {
    color: var(--c-muted);
    font-size: var(--fs-sm);
    margin-bottom: var(--s-2);
  }
  .founder__text {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .roles {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 560px) {
    .roles {
      grid-template-columns: 1fr 1fr;
    }
  }
  .roles li {
    padding: var(--s-4) var(--s-5);
    background: var(--c-surface);
  }
  .roles__title {
    font-weight: 600;
    font-size: var(--fs-sm);
  }
  .roles__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
</style>
