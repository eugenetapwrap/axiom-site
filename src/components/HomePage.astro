  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: var(--s3) var(--s3) var(--s3) 0;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 640px) { .services li:nth-child(even) .service { padding-left: var(--s3); } }
  @media (min-width: 1100px) { .services li:not(:first-child) .service { padding-left: var(--s3); } }
  .service:hover .service-title { color: var(--accent); }
  .service:hover .service-more { text-decoration: underline; }
  .service-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; color: var(--accent); }
  .service-top :global(.s-icon) { width: 36px; height: 36px; }
  .service-num { font-size: 14px; color: var(--ink-3); }
  .service-title { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; transition: color .2s ease; }
  .service-lead { color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .service-more { margin-top: auto; padding-top: var(--s1); color: var(--accent); font-size: 15px; font-weight: 600; }
