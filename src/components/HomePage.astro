  @media (min-width: 1100px) { .services { grid-template-columns: repeat(4, 1fr); } }
  .services li { display: flex; border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .services li:nth-child(odd) { border-right: 1px solid var(--line); } }
