---
// Главная на двух языках (ветка intl): страница ставит язык (src/pages/index.astro и en/index.astro),
// тексты берутся из home.ts или home.en.ts, короткие подписи переводит tr()
import Base from '../layouts/Base.astro';
import ServiceIcon from './ServiceIcon.astro';
import Calculators from './Calculators.astro';
import MiniJCurve from './MiniJCurve.astro';
import MiniThreads from './MiniThreads.astro';
import MiniRegister from './MiniRegister.astro';
import FinalThreads from './FinalThreads.astro';
import { site, tgLink } from '../data/site';
import { content } from '../data/content';
import { t } from '../lib/typo';
import { tr, isEn, dec } from '../lib/i18n';
import { villa, VILLA_DEFAULT, installment, INST_DEFAULT, usd, pct, group } from '../lib/calc';

const { hero, practices, results, cases, team, faq, finalCta, method, requestForm } = content();
const en = isEn();

// Калькуляторы для инвестанализа: что вводят, что получают и пример расчёта на значениях калькулятора по умолчанию.
// «Рост стоимости» и «Оценку виллы» Евгений убрал 02.11.2026
// На телефоне в «Что входит» видны первые 4 пункта, остальные под кнопкой «Ещё N пунктов»
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'пункт' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'пункта' : 'пунктов');
const moreLabel = (n: number) => (en ? `${n} more` : `Ещё ${n} ${plural(n)}`);
const vEx = villa(VILLA_DEFAULT);
const iEx = installment(INST_DEFAULT);
const calcLinks = en ? [
  {
    id: 'villa', title: 'Villa yield', inp: 'price, ADR, occupancy, commissions, taxes, costs', out: 'net income, ROI, payback, IRR, MOIC',
    cap: `Villa at ${usd(VILLA_DEFAULT.price)}, ${usd(VILLA_DEFAULT.adr)} a night, ${VILLA_DEFAULT.occ}% occupancy, sold after ${VILLA_DEFAULT.years} years`,
    kv: [['IRR', pct(vEx.irr)], ['MOIC', `${group(vEx.moic, 2)}×`], ['First-year yield', pct(vEx.net1)]],
  },
  {
    id: 'inst', title: 'Instalments or discount', inp: 'price, down payment, term, rates', out: 'the real cost of the instalment plan and which option pays',
    cap: `Villa at ${usd(INST_DEFAULT.price)}, ${INST_DEFAULT.down}% down, ${INST_DEFAULT.months}-month instalment plan. Developer's rate ${INST_DEFAULT.dev}%, buyer's ${INST_DEFAULT.buy}%`,
    kv: [['Monthly payment', usd(Math.round(iEx.pay))], ['Discount that suits both', `${group(iEx.evenBuy * 100, 1)}–${pct(iEx.evenDev)}`]],
  },
] : [
  {
    id: 'villa', title: 'Доходность виллы', inp: 'цена, ADR, загрузка, комиссии, налоги, расходы', out: 'чистый доход, ROI, срок окупаемости, IRR, MOIC',
    cap: `Вилла за ${usd(VILLA_DEFAULT.price)}, ночь ${usd(VILLA_DEFAULT.adr)}, загрузка ${VILLA_DEFAULT.occ}%, продажа через ${VILLA_DEFAULT.years} лет`,
    kv: [['IRR', pct(vEx.irr)], ['MOIC', `${group(vEx.moic, 2)}×`], ['Доходность в первый год', pct(vEx.net1)]],
  },
  {
    id: 'inst', title: 'Рассрочка или скидка', inp: 'цена, первый взнос, срок, ставки', out: 'реальная ставка рассрочки и что выгоднее',
    cap: `Вилла за ${usd(INST_DEFAULT.price)}, взнос ${INST_DEFAULT.down}%, рассрочка на ${INST_DEFAULT.months} месяцев. Ставка девелопера ${INST_DEFAULT.dev}%, покупателя ${INST_DEFAULT.buy}%`,
    kv: [['Платёж в месяц', usd(Math.round(iEx.pay))], ['Выгодная обоим скидка', `${group(iEx.evenBuy * 100, 1)}–${pct(iEx.evenDev)}`]],
  },
];
const pageTitle = en ? 'Axiom — financial consulting for real estate development and construction' : 'Axiom — финансовый консалтинг для девелопмента и строительства';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title={pageTitle} jsonLd={[faqLd]}>
  <!-- Первый экран (каталог): заголовок слева; справа крупные цифры, как в презентации, и кнопки по низу заголовка.
       Под ними четыре услуги карточками -->
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-text">
          <!-- На широком экране строки заданы явно: четыре строки, кнопки по низу последней -->
          <h1>{hero.lines.map((l) => <span class="h1-l">{t(l)} </span>)}<span class="hero-aud">{hero.audLines.map((l) => <span class="h1-l">{t(l)} </span>)}</span></h1>
        </div>
        <div class="hero-side">
          <dl class="hero-stats">
            {hero.stats.map((s) => (
              <div><dt>{s.value}</dt><dd>{t(s.text)}</dd></div>
            ))}
          </dl>
          <div class="btn-row hero-btns">
            <!-- Ветка intl: «Обсудить проект» ведёт к выбору канала и форме, второй путь — проверка модели (исследование 02.11.2026) -->
            <a class="btn btn-primary" href="#contact" data-cta="hero_discuss">{tr('Обсудить проект')}</a>
            <a class="btn btn-secondary" href="#contact" data-open-req={requestForm.services[2]} data-cta="hero_review">{tr('Проверить модель')}</a>
          </div>
        </div>
      </div>

      <ul class="services">
        {practices.map((p) => (
          <li>
            <a class="service" href={`#${p.id}`}>
              <span class="service-top">
                <ServiceIcon name={p.id} />
                <span class="service-num">{p.num}</span>
              </span>
              <span class="service-title">{t(p.title)}</span>
              <span class="service-lead">{t(p.card)}</span>
              <span class="service-more">{tr('Что входит')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Услуги (Евгений 02.11.2026, выбрал раскладку «пример снизу»): у всех четырёх один шаблон из прямоугольных блоков.
       Сверху два блока рядом: название, строка «что это», результат и кнопка; «Что входит» в две колонки.
       Под ними пример на демо-данных во всю ширину карточки -->
  <section class="section section--alt practices" id="practices" aria-label={tr('Услуги')}>
    <div class="container">
      <div class="practices-list">
      {practices.map((p) => (
        <article class="practice" id={p.id} data-reveal aria-labelledby={`pr-h-${p.id}`}>
          <div class="pr-main">
            <div class="pr-title">
              <span class="practice-num" aria-hidden="true">{p.num}</span>
              <h2 id={`pr-h-${p.id}`}>{t(p.title)}</h2>
            </div>
            <p class="practice-lead">{t(p.card)}</p>
            <p class="practice-result"><span>{tr('Результат')}</span>{t(p.result)}</p>
          </div>
          <div class="pr-list">
            <p class="practice-label">{tr('Что входит')}</p>
            <ul class="dots practice-items">
              {p.items.map((i) => <li>{t(i)}</li>)}
            </ul>
            {p.items.length > 5 && <button type="button" class="pr-more" data-more>{moreLabel(p.items.length - 4)}</button>}
          </div>
          <div class="pr-cta">
            <a class="btn btn-soft" href={tgLink(p.topic)}>{p.cta}</a>
            {/* Ветка accounting: у учёта своя страница. Пока только русская, английской ссылки нет */}
            {p.id === 'accounting' && !en && <a class="link-arrow pr-page" href="/accounting/" data-cta="practice_accounting_page">Подробнее</a>}
          </div>
          <div class="pr-ex">
            {p.id === 'models' && <MiniJCurve />}
            {p.id === 'accounting' && <MiniThreads />}
            {p.id === 'audit' && <MiniRegister />}
            {p.id === 'advisory' && (
              <div class="calc-links">
                <p class="calc-links-head">{tr('Посчитайте сами на сайте')}</p>
                <div class="calc-links-list">
                  {calcLinks.map((l) => (
                    <a href="#calc" data-open-calc={l.id}>
                      <span class="cl-text">
                        <b>{l.title}</b>
                        <span class="cl-row"><em>{tr('Вводите')}</em>{t(l.inp)}</span>
                        <span class="cl-row"><em>{tr('Получаете')}</em>{t(l.out)}</span>
                      </span>
                      <span class="cl-ex">
                        <span class="cl-cap"><em>{tr('Пример')}</em>{t(l.cap)}</span>
                        <span class="cl-kv">{l.kv.map(([k, v]) => <span><i>{t(k)}</i><strong>{v}</strong></span>)}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
      </div>
      <p class="practices-note">{tr('Цифры в примерах — демо-данные.')}</p>
    </div>
  </section>

  <!-- Методика (ветка intl): правила моделирования, две ступени аудита, чего не делаем.
       Крупные консультанты доказывают уровень именно этим, а не числом картинок (исследование 02.11.2026) -->
  <section class="section section--white method" id="method" aria-labelledby="method-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{method.eyebrow}</p>
        <h2 id="method-title">{t(method.title)}</h2>
      </div>
      <div class="m-grid" data-reveal style="--d: 100ms">
        <div class="m-col">
          <h3>{t(method.rules.title)}</h3>
          <ol class="m-rules">
            {method.rules.items.map((i) => <li>{t(i)}</li>)}
          </ol>
          <p class="m-note">{t(method.rules.note)}</p>
        </div>
        <div class="m-col m-audit">
          <h3>{t(method.audit.title)}</h3>
          <ol class="m-steps">
            {method.audit.steps.map((st) => <li><b>{t(st.name)}</b><span>{t(st.text)}</span></li>)}
          </ol>
          <p class="m-deliv">{t(method.audit.deliverables)}</p>
          <div class="m-stat">
            <p class="m-stat-top"><b>{method.audit.stat.value}</b><span>{t(method.audit.stat.text)}</span></p>
            <p class="m-bar" aria-hidden="true">{method.audit.stat.parts.map((x) => <i class={`m-${x.cls}`} style={`flex: ${x.n}`}></i>)}</p>
            <p class="m-legend">{method.audit.stat.parts.map((x) => <span class={`m-${x.cls}`}><b>{x.n}</b> {x.label}</span>)}</p>
          </div>
        </div>
        <div class="m-col">
          <h3>{t(method.limits.title)}</h3>
          <ul class="m-limits">
            {method.limits.items.map((i) => <li>{t(i)}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Калькуляторы вместо демо-виджетов: считают цифры самого посетителя -->
  <section class="section" id="calc">
    <div class="container">
      <Calculators />
    </div>
  </section>

  <!-- Результаты за 2 года: три равные крупные цифры -->
  <section class="section section--signal results" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="results-title" data-reveal>{results.title}</h2>
      <dl class="results-grid" data-reveal>
        {results.items.map((r) => (
          <div>
            <dt>{r.value}</dt>
            <dd>{t(r.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">{tr('Кейсы')}</p>
          <h2>{tr('Задачи, которые мы решали')}</h2>
        </div>
        <p class="caption">{tr('Клиентов и проекты не называем')}</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card cv-gap">
                  <!-- Схема без цифр: накопленный итог до и после настройки против лимита финансирования -->
                  <svg viewBox="0 0 260 96">
                    <line class="cv-lim" x1="4" x2="256" y1="62" y2="62"></line>
                    <text class="cv-t" x="256" y="74" text-anchor="end">{tr('лимит')}</text>
                    <path class="cv-before" d="M6,14 C40,18 64,82 104,82 C150,82 178,40 254,12"></path>
                    <path class="cv-after" d="M6,14 C40,18 64,46 104,46 C150,46 178,24 254,12"></path>
                    <text class="cv-t cv-t--ok" x="104" y="33" text-anchor="middle">{tr('после')}</text>
                    <line class="cv-gapl" x1="104" x2="104" y1="50" y2="58"></line>
                    <text class="cv-t" x="110" y="56">{tr('запас')}</text>
                    <text class="cv-t cv-t--risk" x="104" y="96" text-anchor="middle">{tr('до: разрыв')}</text>
                  </svg>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card">
                  <p><span>{t(`${tr('Заявка №')} 63`)}</span><b>{group(1080000)} IDR</b></p>
                  <p class="cv-dup"><span>{t(`${tr('Заявка №')} 75`)}</span><b>{group(1080000)} IDR</b><em>{tr('дубль')}</em></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-bars">
                  <p><span>{tr('Норма')}</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>{tr('Факт')}</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 3 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>{dec(9, 1)}%</b><span>→</span><b class="cv-risk">{dec(8.2, 1)}%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>{tr('Решение')}</dt>
                <dd>{t(c.action)}</dd>
                <dt>{tr('Результат')}</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда: компактная строка, фото и подпись (Евгений 02.11.2026) -->
  <section class="section section--white team-sec" id="team">
    <div class="container team">
      <h2 data-reveal>{team.title}</h2>
      <ul class="people" data-reveal style="--d: 120ms">
        {team.people.map((m) => (
          <li class="person">
            {m.photo ? (
              <img class="person-photo" src={m.photo} alt={m.name} width="120" height="120" />
            ) : (
              <span class="person-photo person-photo--empty" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).join('')}</span>
            )}
            <p class="person-name">{m.name}</p>
            <p class="person-role">{t(m.role)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Вопросы: список слева, ответ справа. Ничего не раскрывается и не сдвигается (Евгений 02.11.2026).
       На телефоне ответ показывается под вопросом -->
  <section class="section" id="faq">
    <div class="container faq-wrap" data-faq>
      <div class="faq-side">
        <h2>{tr('Частые вопросы')}</h2>
        <div class="faq-list" role="tablist" aria-orientation="vertical" aria-label={tr('Частые вопросы')}>
          {faq.map((f, i) => (
            <button type="button" role="tab" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-faq-q={i}>{t(f.q)}</button>
          ))}
        </div>
        <p class="muted faq-more">{tr('Не нашли ответ?')} <a href={site.telegramUrl}>{tr('Напишите в Telegram')}</a></p>
      </div>
      <div class="faq-answers">
        {faq.map((f, i) => (
          <div class="faq-answer" role="tabpanel" id={`faq-a-${i}`} aria-labelledby={`faq-q-${i}`} data-faq-a={i} hidden={i !== 0}>
            <p class="faq-answer-q">{t(f.q)}</p>
            <p>{t(f.a)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Финальный блок -->
  <!-- Нити лежат только под верхней частью блока: раскрытая форма не растягивает их (ветка intl) -->
  <section class="section section--dark final" id="contact">
    <div class="final-top">
    <FinalThreads />
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">{tr('Контакты')}</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <p class="final-sub">{t(finalCta.itemsTitle)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <!-- Ветка intl: три канала рядом. Telegram остаётся первым, почта и форма запроса для корпоративных клиентов -->
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl} data-cta="final_telegram">{tr('Написать в Telegram')} @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`} data-cta="final_email">{site.email}</a>
        <button type="button" class="btn btn-ghost-light req-open" aria-expanded="false" aria-controls="req" data-req-open>{requestForm.open}</button>
      </div>
    </div>
    </div>
    <div class="container final-req">
      <form class="req" id="req" hidden data-req data-email={site.email} data-greet={requestForm.greet} data-subject={requestForm.subject}>
        <p class="req-title">{requestForm.title}</p>
        <div class="req-grid">
          <label><span>{requestForm.name}</span><input name="name" autocomplete="name" required /></label>
          <label><span>{requestForm.company}</span><input name="company" autocomplete="organization" /></label>
          <label><span>{requestForm.service}</span><select name="service"><option value="">{requestForm.choose}</option>{requestForm.services.map((o) => <option>{o}</option>)}</select></label>
          <label><span>{requestForm.country}</span><select name="country"><option value="">{requestForm.choose}</option>{requestForm.countries.map((o) => <option>{o}</option>)}</select></label>
          <label><span>{requestForm.stage}</span><select name="stage"><option value="">{requestForm.choose}</option>{requestForm.stages.map((o) => <option>{o}</option>)}</select></label>
          <label class="req-wide"><span>{requestForm.task}</span><textarea name="task" rows="3" placeholder={requestForm.taskHint}></textarea></label>
        </div>
        <fieldset class="req-ch">
          <legend>{requestForm.channel}</legend>
          <label><input type="radio" name="channel" value="telegram" checked /> Telegram</label>
          <label><input type="radio" name="channel" value="email" /> {site.email}</label>
        </fieldset>
        <div class="req-foot">
          <button class="btn btn-light" type="submit">{requestForm.submit}</button>
          <p>{t(requestForm.note)}</p>
        </div>
      </form>
    </div>
  </section>
</Base>

<script>
  import { track } from '../lib/track';
  import { tgLink } from '../data/site';

  // «Что входит» на телефоне: 4 пункта и кнопка «Ещё N пунктов». На десктопе CSS кнопку не показывает
  document.querySelectorAll<HTMLElement>('.practice').forEach((card) => {
    const more = card.querySelector<HTMLButtonElement>('[data-more]');
    if (!more) return;
    card.classList.add('is-clamped');
    more.addEventListener('click', () => {
      card.classList.remove('is-clamped');
      card.querySelector<HTMLElement>('.practice-items li:nth-child(5)')?.setAttribute('tabindex', '-1');
      card.querySelector<HTMLElement>('.practice-items li:nth-child(5)')?.focus({ preventScroll: true });
    });
  });

  // Вопросы: клик по вопросу показывает ответ справа. На узком экране ответ встаёт под вопросом.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLButtonElement>('[data-faq-q]')];
    const as = [...root.querySelectorAll<HTMLElement>('[data-faq-a]')];
    const box = root.querySelector<HTMLElement>('.faq-answers')!;
    const narrow = window.matchMedia('(max-width: 899px)');
    let cur = 0;
    const place = () => {
      if (narrow.matches) qs[cur].after(as[cur]);
      else as.forEach((a) => box.append(a));
    };
    const show = (i: number) => {
      cur = i;
      qs.forEach((q, k) => {
        q.setAttribute('aria-selected', String(k === i));
        q.tabIndex = k === i ? 0 : -1;
      });
      as.forEach((a, k) => { a.hidden = k !== i; });
      place();
    };
    qs.forEach((q, i) => {
      q.addEventListener('click', () => show(i));
      q.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowDown' ? 1 : qs.length - 1)) % qs.length;
        qs[n].focus();
        show(n);
      });
    });
    narrow.addEventListener('change', place);
    place();
  });

  // Форма запроса: собирает сообщение и открывает Telegram или почту. Сервера у сайта нет
  const req = document.querySelector<HTMLFormElement>('[data-req]');
  const reqBtn = document.querySelector<HTMLButtonElement>('[data-req-open]');
  const openReq = (service?: string) => {
    if (!req) return;
    req.hidden = false;
    reqBtn?.setAttribute('aria-expanded', 'true');
    if (service) (req.elements.namedItem('service') as HTMLSelectElement).value = service;
    track('request_open', { service: service ?? '' });
  };
  reqBtn?.addEventListener('click', () => {
    if (!req) return;
    if (req.hidden) {
      openReq();
      req.querySelector<HTMLInputElement>('input')?.focus({ preventScroll: true });
    } else {
      req.hidden = true;
      reqBtn.setAttribute('aria-expanded', 'false');
    }
  });
  document.querySelectorAll<HTMLElement>('[data-open-req]').forEach((a) => {
    a.addEventListener('click', () => openReq(a.dataset.openReq));
  });
  req?.addEventListener('submit', (e) => {
    e.preventDefault();
    const lines = [req.dataset.greet!, ''];
    req.querySelectorAll<HTMLElement>('.req-grid label').forEach((l) => {
      const f = l.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('input, select, textarea')!;
      const v = f.value.trim();
      if (v) lines.push(`${l.querySelector('span')!.textContent}: ${v}`);
    });
    const text = lines.join('\n');
    const ch = (req.elements.namedItem('channel') as RadioNodeList).value;
    track('lead', { channel: ch, service: (req.elements.namedItem('service') as HTMLSelectElement).value });
    if (ch === 'email') location.href = `mailto:${req.dataset.email}?subject=${encodeURIComponent(req.dataset.subject!)}&body=${encodeURIComponent(text)}`;
    else window.open(tgLink(text), '_blank', 'noopener');
  });

  // События кнопок для аналитики
  document.querySelectorAll<HTMLElement>('[data-cta]').forEach((a) => {
    a.addEventListener('click', () => track('cta_click', { id: a.dataset.cta! }));
  });
</script>

<style>
  /* Первый экран. Цифры справа: их линии стоят на высоте заглавных первой строки, кнопки по базовой линии последней.
     Смещения считаны с метрик Inter Tight при межстрочном 1,06: от края строки до верха заглавных и до базовой линии около 0,17 кегля */
  .hero { padding: var(--s5) 0 var(--s6); background-color: var(--bg); }
