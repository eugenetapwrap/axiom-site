  .results-grid dd { margin: 12px 0 0; font-size: 16px; line-height: 1.45; max-width: 22em; }

  /* Кейсы */
  .cases { display: grid; gap: var(--s3); }
  @media (min-width: 760px) { .cases { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1400px) { .cases { grid-template-columns: repeat(4, 1fr); } }
  .case { display: flex; flex-direction: column; padding: 8px; }
  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 48px var(--s3) var(--s3);
    border-radius: 6px;
    background: var(--deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .case-tag { position: absolute; top: 14px; left: 16px; color: var(--gold-on-deep); font-size: 13px; font-weight: 600; }
  .cv-card { width: 100%; max-width: 280px; padding: 12px 14px; border-radius: 8px; background: var(--surface); font-size: 13px; display: grid; gap: 8px; }
  .cv-card p { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: none; }
  .cv-card span { color: var(--ink-3); }
  .cv-card p span, .cv-card p b { white-space: nowrap; }
  @media (min-width: 1400px) { .cv-card { font-size: 12.5px; padding: 12px; } }
  .cv-dup { padding: 4px 6px; margin: 0 -6px; border-radius: 6px; background: var(--risk-soft); }
  .cv-dup em { font-style: normal; font-weight: 700; color: var(--risk); }
  .cv-bars p { display: grid; grid-template-columns: 52px 1fr; }
  .cv-bars i { display: block; height: 10px; width: var(--w); border-radius: 5px; background: var(--accent-2); }
  .cv-over i { background: var(--risk); }
  .cv-gap { max-width: 320px; }
  .cv-gap svg { display: block; width: 100%; height: auto; overflow: visible; }
  .cv-lim { stroke: var(--ink-3); stroke-width: 1; stroke-dasharray: 3 3; }
  .cv-before, .cv-after { fill: none; stroke-width: 2.2; stroke-linecap: round; }
  .cv-before { stroke: var(--risk); }
  .cv-after { stroke: var(--c-pos-strong); }
  .cv-gapl { stroke: var(--ink-2); stroke-width: 1; }
  .cv-t { font: 400 14px var(--font); fill: var(--ink-3); }
  .cv-t--risk { font-weight: 600; fill: var(--risk); }
  .cv-t--ok { font-weight: 600; fill: var(--c-pos-strong); }
  .cv-irr { display: flex; align-items: baseline; justify-content: center; gap: 10px; font-size: 15px; }
  .cv-irr b { font-size: 30px; letter-spacing: -0.02em; }
  .cv-risk { color: var(--risk); }
  .case-body { padding: var(--s3) var(--s2) var(--s2); }
  .case-body h3 { font-size: 21px; }
  .case-dl { display: grid; gap: 2px; margin-top: var(--s2); font-size: 16px; }
  .case-dl dt { color: var(--ink-3); font-size: 13px; margin-top: var(--s1); }
  .case-result { font-weight: 700; color: var(--accent); }

  /* Команда: заголовок слева, люди в строку справа */
  .team-sec { padding-block: var(--s6); }
  .team { display: grid; gap: var(--s4); align-items: start; }
  @media (min-width: 1024px) { .team { grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); column-gap: var(--s5); } }
  .people { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin: 0; padding: 0; list-style: none; }
  .person-photo { display: block; width: 100%; max-width: 168px; aspect-ratio: 1; border-radius: 12px; object-fit: cover; }
  .person-photo--empty { display: grid; place-items: center; background: var(--track); color: var(--ink-3); font-family: var(--font-display); font-size: clamp(24px, 3vw, 40px); font-weight: 600; letter-spacing: -0.02em; }
  .person-name { margin-top: 14px; font-weight: 600; font-size: 17px; line-height: 1.3; }
  .person-role { margin-top: 4px; color: var(--ink-2); font-size: 15px; line-height: 1.4; }
  @media (max-width: 520px) {
    .people { gap: var(--s2); }
    .person-name { font-size: 15px; }
    .person-role { font-size: 13px; }
  }

  /* Вопросы: список слева, ответ справа */
  .faq-wrap { display: grid; gap: var(--s4); }
  @media (min-width: 900px) { .faq-wrap { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); column-gap: var(--s6); align-items: start; } }
  .faq-list { display: grid; margin-top: var(--s3); border-top: 1px solid var(--line); }
  .faq-list button {
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: 17px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
  }
  .faq-list button::after { content: '→'; color: var(--ink-3); transition: transform .2s ease; }
  .faq-list button:hover { color: var(--ink); }
  .faq-list button[aria-selected='true'] { color: var(--ink); font-weight: 600; }
  .faq-list button[aria-selected='true']::after { color: var(--accent); }
  .faq-list button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .faq-more { margin-top: var(--s3); }
  .faq-answer { padding: var(--s4); border-radius: 10px; background: var(--surface); border: 1px solid var(--line); }
  .faq-answer[hidden] { display: none; }
  .faq-answer-q { font-family: var(--font-display); font-size: 22px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; margin-bottom: var(--s2); }
  .faq-answer p:last-child { font-size: 17px; line-height: 1.6; color: var(--ink-2); }
  @media (min-width: 900px) { .faq-answers { position: sticky; top: 96px; } }
  /* На телефоне ответ встаёт под выбранный вопрос (скрипт переносит его в список) */
  @media (max-width: 899px) {
    .faq-list .faq-answer { margin: 4px 0 12px; padding: var(--s3); }
    .faq-list .faq-answer-q { display: none; }
    .faq-answers:empty { display: none; }
  }

  /* Финальный блок: фирменные нити сходятся в узел за кнопками (FinalThreads) */
  .final { position: relative; overflow: hidden; }
  .final-inner { position: relative; text-align: center; display: grid; justify-items: center; }
  .final-text { margin-top: var(--s3); max-width: 34em; color: var(--on-deep-2); }
  .final-sub { margin-top: var(--s4); font-size: 15px; color: var(--on-deep-2); }
  .final-list { list-style: none; padding: 0; margin: var(--s2) 0 var(--s4); display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .final-list li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 16px;
  }
  .final-list b { color: var(--gold-on-deep); }
  .final-btns { justify-content: center; }
  /* Методика (ветка intl): три колонки через линии, как ряд услуг в первом экране. На узком экране столбиком */
  .method .section-head { margin-bottom: var(--s4); }
  .m-grid { display: grid; border-top: 1px solid var(--line); }
  .m-col { padding: var(--s4) 0; min-width: 0; }
  .m-col + .m-col { border-top: 1px solid var(--line); }
  @media (min-width: 1100px) {
    .m-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) minmax(0, 1fr); }
    .m-col { padding-right: var(--s4); }
    .m-col + .m-col { border-top: 0; border-left: 1px solid var(--line); padding-left: var(--s4); }
    .m-col:last-child { padding-right: 0; }
  }
  .m-col h3 { font-size: 21px; line-height: 1.25; margin-bottom: var(--s2); }
  .m-rules, .m-limits, .m-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; font-size: 16px; line-height: 1.45; color: var(--ink-2); }
  /* Правила пронумерованы: это стандарт, на пункт можно сослаться */
