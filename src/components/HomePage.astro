  /* Услуги: карточка из четырёх областей — main (название, что это, результат), list (что входит), cta (кнопка), ex (пример).
     На широком экране main и list рядом, кнопка по низу списка, пример во всю ширину карточки. На телефоне всё столбиком */
  .practices { padding-top: var(--s5); }
  .practice {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
