  @media (max-width: 600px) { .practice { padding: var(--s3) 18px; } }
  .pr-main { grid-area: main; }
  .pr-list { grid-area: list; }
  .pr-cta { grid-area: cta; align-self: end; display: flex; flex-wrap: wrap; align-items: center; gap: 12px var(--s3); }
  .pr-page { font-size: 17px; }
  .pr-ex { grid-area: ex; container-type: inline-size; display: grid; min-width: 0; }
  /* Номер мелко слева в строке названия (Евгений 02.11.2026): карточка ниже, название выше */
  .pr-title { display: flex; align-items: baseline; gap: 14px; }
  .practice-num { flex: none; font-size: 14px; font-weight: 500; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .practice h2 { font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; letter-spacing: -0.02em; }
  .practice-lead { margin-top: var(--s2); font-size: 18px; line-height: 1.45; color: var(--ink); max-width: 30em; }
  .practice-result { margin-top: var(--s2); padding-top: var(--s2); border-top: 1px solid var(--line); font-size: 16px; line-height: 1.45; color: var(--ink-2); max-width: 32em; }
  .practice-result span { display: block; margin-bottom: 4px; font-size: 13px; font-weight: 600; color: var(--ink-3); }
  .practice-label { font-size: 13px; font-weight: 600; color: var(--ink-3); margin-bottom: 12px; }
  /* «Что входит» мельче лида: это справка, а не главный текст (Евгений 02.11.2026) */
  .practice-items { gap: 8px; font-size: 15px; line-height: 1.45; color: var(--ink-2); }
  .practice-items li { padding-left: 22px; }
  /* Телефон и планшет: карточка в одну колонку, длинный список уводит пример на второй экран.
     Показываем 4 пункта, остальные по кнопке. Без JS класса is-clamped нет и список виден целиком */
  .pr-more { display: none; margin-top: 10px; padding: 4px 0 4px 22px; border: 0; background: none; font: 600 15px var(--font); color: var(--accent); cursor: pointer; }
  .pr-more::after { content: ' ↓'; }
  @media (max-width: 1023px) {
    .practice.is-clamped .practice-items li:nth-child(n+5) { display: none; }
    .practice.is-clamped .pr-more { display: inline-block; }
  }
  /* Шрифты в примерах сведены к шкале: 12 подписи, 13 текст, 18 цифры (в широкой карточке 20) */

  @media (min-width: 1024px) {
    /* Все карточки одной высоты (Евгений 02.11.2026: эталон — финансовое планирование). Лишнюю высоту забирает пример */
    .practices-list { display: grid; grid-auto-rows: 1fr; gap: var(--s3); }
    .practice { margin-bottom: 0; grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr); grid-template-rows: auto auto 1fr; grid-template-areas: 'main list' 'cta list' 'ex ex'; column-gap: var(--s5); row-gap: var(--s4); }
    .pr-list { padding-left: var(--s5); border-left: 1px solid var(--line); }
    .practice-items { display: block; columns: 2; column-gap: var(--s5); }
    .practice-items li { break-inside: avoid; margin-bottom: 8px; }
    .pr-ex { margin-top: var(--s1); }
  }

  /* Ссылки на калькуляторы у инвестанализа: в узкой колонке списком, в широкой в ряд */
  .calc-links { display: flex; flex-direction: column; border-radius: 8px; background: var(--bg); overflow: hidden; }
  .calc-links-head { padding: 16px 18px 10px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .calc-links-list { display: grid; flex: 1; grid-auto-rows: 1fr; }
  .calc-links a { display: grid; gap: 14px; padding: 14px 18px 18px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .calc-links a:hover { background: color-mix(in srgb, var(--accent) 6%, var(--bg)); }
  .calc-links a b { color: var(--accent); font-weight: 600; font-size: 16px; }
  .calc-links a b::after { content: ' →'; }
  .cl-text { display: grid; align-content: start; }
  .cl-row, .cl-cap { display: block; font-size: 13px; line-height: 1.4; color: var(--ink-2); }
  .cl-row em, .cl-cap em { display: block; margin-top: 8px; font-style: normal; font-size: 12px; color: var(--ink-3); }
  .cl-cap em { margin-top: 0; }
  /* Пример расчёта на значениях калькулятора: чтобы было видно, какой ответ получит человек */
  .cl-ex { display: grid; align-content: start; gap: 12px; padding: 14px 16px; border-radius: 8px; background: var(--surface); }
  .cl-kv { display: flex; flex-wrap: wrap; gap: 10px 22px; }
