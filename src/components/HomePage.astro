  @media (min-width: 1200px) {
    .hero-top { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: var(--s6); align-items: stretch; }
    .h1-l { display: block; }
    .hero-side { display: flex; flex-direction: column; justify-content: space-between; padding: calc(var(--hfs) * 0.166) 0 calc(var(--hfs) * 0.167); }
  }
  /* Крупные цифры, как в презентации. Линии в цветах нитей */
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin: 0; }
  .hero-stats div { padding-top: 14px; border-top: 3px solid var(--th-1); }
  .hero-stats div:nth-child(2) { border-top-color: var(--th-2); }
  .hero-stats div:nth-child(3) { border-top-color: var(--th-3); }
  .hero-stats dt { font-family: var(--font-display); font-size: clamp(26px, 2.5vw, 40px); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hero-stats dd { margin: 8px 0 0; font-size: 14px; line-height: 1.35; color: var(--ink-2); }
  @media (max-width: 520px) {
    .hero-stats { grid-template-columns: 1fr; gap: 0; }
    .hero-stats div { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: var(--s2); align-items: baseline; padding: 10px 0; border-top-width: 2px; }
    .hero-stats dd { margin: 0; }
  }

  .services {
    list-style: none;
    padding: 0;
    margin-top: var(--s5);
    display: grid;
    border-top: 1px solid var(--line);
  }
