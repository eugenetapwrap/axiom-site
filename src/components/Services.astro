---
import { t } from '../lib/typo';
import { services } from '../content/ru';
import AuditMock from './mock/AuditMock.astro';
import DashboardMock from './mock/DashboardMock.astro';

// Сводка модели уже показана на первом экране, поэтому у модели здесь — состав файла.
const modelSheets = ['Допущения', 'Бюджет стройки', 'График стройки', 'Продажи и рассрочки', 'Аренда', 'Налоги', 'Cash Flow', 'Пик финансирования', 'Показатели', 'Сценарии'];
---

<div id="services">
  {
    services.items.map((s, idx) => (
      <section
        class:list={['section', 'svc', { 'section--soft': idx % 2 === 1, 'svc--compact': !s.mock }]}
        id={s.id}
        aria-labelledby={`${s.id}-title`}
      >
        <div class="container">
          <header class="svc__head">
            <p class="eyebrow">
              {s.num} · {s.name}
            </p>
            <h2 id={`${s.id}-title`} class="h2 svc__title">{t(s.title)}</h2>
          </header>

          <div class="svc__grid">
            <div class="svc__main">
              <ul class="qa">
                {s.questions.map((item) => (
                  <li class="qa__item">
                    <p class="qa__q">{t(item.q)}</p>
                    <p class="qa__a">{t(item.a)}</p>
                  </li>
                ))}
              </ul>
              <a class="btn btn--secondary svc__cta" href="#request">
                {s.cta}
              </a>
            </div>

            {s.mock && (
              <div class="svc__aside">
                {s.mock === 'sheets' && (
                  <figure class="sheets">
                    <p class="sheets__title mono">Модель_проекта.xlsx</p>
                    <ol>
                      {modelSheets.map((name, i) => (
                        <li>
                          <span class="mono">{String(i).padStart(2, '0')}</span>
                          {name}
                        </li>
                      ))}
                    </ol>
                    <figcaption class="sheets__note">
                      + сводка для инвестора на одной странице и пояснительная записка
                    </figcaption>
                  </figure>
                )}
                {s.mock === 'audit' && <AuditMock />}
                {s.mock === 'dashboard' && <DashboardMock />}

                {s.get.length > 0 && (
                  <div class="get">
                    <p class="label">Что вы получите</p>
                    <ul class="get__list">
                      {s.get.map((g) => <li>{t(g)}</li>)}
                    </ul>
                  </div>
                )}
                {s.formats.length > 0 && (
                  <div class="fmt">
                    <p class="label">Форматы и сроки</p>
                    <ul class="fmt__list">
                      {s.formats.map((f) => (
                        <li>
                          <span class="fmt__name">{f.name}</span>
                          <span class:list={['fmt__time', { tbd: f.tbd }]}>{t(f.time)}</span>
                          <span class="fmt__what">{t(f.what)}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {s.terms.length > 0 && (
                  <dl class="terms">
                    {s.terms.map((term) => (
                      <div class:list={{ tbd: term.tbd }}>
                        <dt>{term.label}</dt>
                        <dd>{t(term.value)}</dd>
                      </div>
                    ))}
                  </dl>
                )}
              </div>
            )}
          </div>

        </div>
      </section>
    ))
  }
</div>

<style>
  .svc {
    scroll-margin-top: 64px;
  }
  .svc__head {
    display: grid;
    gap: var(--s-3);
    max-width: 820px;
    margin-bottom: var(--s-6);
  }
  .svc__grid {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 1040px) {
    .svc__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--s-8);
      align-items: start;
    }
  }
  .qa {
    list-style: none;
    display: grid;
  }
  .qa__item {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-4) 0;
    border-top: 1px solid var(--c-line);
  }
  .qa__item:first-child {
    border-top: 2px solid var(--c-ink);
  }
  .qa__q {
    font-weight: 600;
    font-size: var(--fs-md);
    line-height: 1.35;
  }
  .qa__a {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .svc--compact .qa {
    gap: 0 var(--s-6);
  }
  @media (min-width: 720px) {
    .svc--compact .qa {
      grid-template-columns: 1fr 1fr;
    }
    .svc--compact .qa__item:nth-child(2) {
      border-top: 2px solid var(--c-ink);
    }
  }
  @media (min-width: 1040px) {
    .svc--compact .svc__grid {
      grid-template-columns: 1fr;
    }
    .svc--compact .qa {
      grid-template-columns: repeat(3, 1fr);
    }
    .svc--compact .qa__item:nth-child(3) {
      border-top: 2px solid var(--c-ink);
    }
  }
  .svc__aside {
    display: grid;
    gap: var(--s-5);
    min-width: 0;
  }
  .label {
    margin-bottom: var(--s-2);
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--c-muted);
    text-align: left;
  }
  .get__list {
    list-style: none;
    display: grid;
    gap: var(--s-2);
    font-size: var(--fs-sm);
  }
  .get__list li {
    position: relative;
    padding-left: 18px;
  }
  .get__list li::before {
    content: '';
    position: absolute;
    left: 1px;
    top: 0.5em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--c-accent);
  }
  .fmt__list {
    list-style: none;
    display: grid;
    border-top: 1px solid var(--c-line);
    font-size: var(--fs-sm);
  }
  .fmt__list li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px var(--s-3);
    padding: 10px 0;
    border-bottom: 1px solid var(--c-line);
  }
  .fmt__name {
    font-weight: 600;
  }
  .fmt__time {
    font-family: var(--f-mono);
    font-size: var(--fs-xs);
    text-align: right;
    align-self: center;
  }
  .fmt__what {
    grid-column: 1 / -1;
    color: var(--c-ink-2);
  }
  .terms {
    display: grid;
    gap: var(--s-2);
    margin: 0;
    padding: var(--s-4);
    border-radius: var(--r-md);
    background: var(--c-bg-soft);
    font-size: var(--fs-sm);
  }
  .section--soft .terms {
    background: var(--c-surface);
  }
  .terms div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-3);
  }
  .terms dt {
    color: var(--c-muted);
  }
  .terms dd {
    margin: 0;
  }
  .svc__cta {
    margin-top: var(--s-5);
  }
  .sheets {
    margin: 0;
    padding: var(--s-5);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-1);
  }
  .sheets__title {
    font-size: var(--fs-xs);
    font-weight: 500;
    margin-bottom: var(--s-3);
  }
  .sheets ol {
    list-style: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-md);
    overflow: hidden;
    font-size: var(--fs-sm);
  }
  @media (min-width: 480px) {
    .sheets ol {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .sheets li {
    display: flex;
    gap: var(--s-3);
    align-items: center;
    padding: 9px 12px;
    background: var(--c-surface);
  }
  .sheets li:nth-child(8) {
    background: var(--c-accent-soft);
    color: var(--c-accent-ink);
    font-weight: 600;
  }
  .sheets li .mono {
    font-size: 12px;
    color: var(--c-muted);
  }
  .sheets__note {
    margin-top: var(--s-3);
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
</style>
