---
import { brand, footer, nav } from '../content/ru';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <p class="footer__brand">{brand}</p>
      <p class="footer__note">{footer.note}</p>
    </div>
    <ul class="footer__nav">
      {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
    </ul>
    <p class="footer__legal">© {year} {footer.legal}</p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--s-7) 0;
    background: var(--c-ink);
    color: #c9d0d7;
    font-size: var(--fs-sm);
  }
  .footer__inner {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 860px) {
    .footer__inner {
      grid-template-columns: 1.4fr 1fr auto;
      align-items: start;
    }
  }
  .footer__brand {
    color: #fff;
    font-weight: 600;
    margin-bottom: var(--s-1);
  }
  .footer__note {
    max-width: 44ch;
  }
  .footer__nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .footer__nav a,
  .footer a {
    color: #e6eaee;
    text-decoration: none;
  }
  .footer__nav a:hover {
    text-decoration: underline;
    color: #fff;
  }
  .footer__legal {
    color: #9aa3ad;
  }
  .footer :focus-visible {
    box-shadow: 0 0 0 2px var(--c-ink), 0 0 0 4px #fff;
  }
</style>
