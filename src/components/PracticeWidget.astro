---
// Живой виджет справа от описания направления: три шага с номерами, как в интерфейсе.
// Все значения демонстрационные, кроме IRR 9,0% → 8,2% и NPV «в 3,6 раза» из кейса аудита.
import { SCENARIOS, YEARS, kpis, barHeight, barTitle, cumPath, payback, ZERO } from '../lib/finmodel';
import { MONTHS_SHORT } from '../lib/sankey';

interface Props {
  variant: 'models' | 'audit' | 'accounting' | 'advisory';
}
const { variant } = Astro.props;

const models = SCENARIOS;
const years = YEARS;
const m0 = models[0];
const k0 = kpis(m0.cf);
const pb0 = payback(m0.cf);
const objects = ['Апартаменты', 'Вилла', 'Таунхаус'];

// Шаг «Аналитика»: Cash Flow по месяцам с накопленным итогом, как в дашборде портала.
// Демо-данные, млрд IDR, январь–октябрь: поступления скачут (месяцы с продажами и без),
// расходы ровнее, поэтому накопленный итог ходит около нуля, а с осени уверенно растёт.
const INFLOW = [1.8, 4.6, 1.2, 3.9, 5.2, 1.6, 4.8, 2.2, 5.6, 4.4];
const OUTFLOW = [3.0, 2.4, 3.5, 2.6, 3.1, 3.8, 2.5, 3.6, 2.9, 2.6];
const CW = 480;
const CH = 212;
const step = (CW - 16) / INFLOW.length;
const r1 = (v: number) => Math.round(v * 10) / 10;
let acc = 0;
const cfm = INFLOW.map((inflow, m) => {
  const outflow = OUTFLOW[m];
  acc = r1(acc + inflow - outflow);
  return { m, inflow, outflow, cum: acc, cx: 8 + step * (m + 0.5) };
});
const NOW = cfm.length - 1;
// Один масштаб для столбиков и линии: ноль на высоте ZY, ниже нуля место для минусов итога
const top = Math.max(...cfm.map((d) => Math.max(d.inflow, d.outflow, d.cum)));
const bottom = Math.min(0, ...cfm.map((d) => d.cum));
const ZY = 22 + (top / (top - bottom)) * 150;
const sc = 150 / (top - bottom);
const vy = (v: number) => ZY - v * sc;
const linePath = cfm.map((d, i) => `${i ? 'L' : 'M'}${d.cx.toFixed(1)},${vy(d.cum).toFixed(1)}`).join(' ');
const fmt1 = (v: number) => v.toFixed(1).replace('.', ',').replace('-', '−');
---

<div class="pw" data-pw={variant}>
  {variant === 'models' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Стратегия проекта</p>
          <div class="pw-chips" data-m-chips>
            {models.map((m, i) => <span class={`pw-chip${i === 0 ? ' is-on' : ''}`}>{m.name}</span>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Предпосылки</p>
          <div class="ui-card pw-panel pw-sliders">
            {m0.params.map((q, j) => (
              <div><span data-ml={j}>{q.label}</span><b data-mv={j}>{q.value}</b><i style={`--p:${q.p}%`} data-mp={j}></i></div>
            ))}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Cash Flow и показатели для инвестора</p>
          <div class="ui-card pw-panel pw-cf-panel">
            <div class="pw-cash-legend" aria-hidden="true"><span class="in">Cash Flow по годам</span><span class="cum">Накопленный итог</span></div>
            <div class="pw-cf" aria-hidden="true">
              {m0.cf.map((v, i) => (
                <span class={v < 0 ? 'neg' : 'pos'} style={`--h:${barHeight(v)}`} data-cf={i} title={barTitle(years[i], v)}></span>
              ))}
              <svg class="pw-cum" viewBox="0 0 100 100" preserveAspectRatio="none" data-cum>
                <path d={cumPath(m0.cf)} vector-effect="non-scaling-stroke"></path>
              </svg>
              <i class={`pw-pb${pb0 && pb0.x > 60 ? ' is-right' : ''}`} data-pb style={pb0 ? `left:${pb0.x.toFixed(1)}%;top:${ZERO}%` : 'display:none'}><b data-pb-text>Окупаемость в {pb0?.year}</b></i>
            </div>
            <div class="pw-cf-axis" aria-hidden="true"><span>{years[0]}</span><span>млн USD</span><span>{years[years.length - 1]}</span></div>
            <dl class="pw-kpis">
              <div><dt>IRR</dt><dd data-m="irr">{k0.irr}</dd></div>
              <div><dt>NPV при 12%</dt><dd data-m="npv" class={k0.npvNeg ? 'is-neg' : undefined}>{k0.npv}</dd></div>
              <div><dt>MOIC</dt><dd data-m="moic">{k0.moic}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'audit' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Модель на проверке</p>
          <div class="ui-card pw-panel pw-file">
            <span class="pw-xls" aria-hidden="true">XLS</span>
            <div>
              <b>Финмодель проекта.xlsx</b>
              <span class="pw-progress"><i data-a-progress></i></span>
              <span class="pw-sub">14 листов · <span data-a-pct>100</span>% проверено</span>
            </div>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Реестр замечаний</p>
          <div class="ui-card pw-panel">
            <ul class="pw-sev">
              <li><span class="sev sev--risk"></span>Критичные<b data-a-count="3">3</b></li>
              <li><span class="sev sev--warn"></span>Существенные<b data-a-count="9">9</b></li>
              <li><span class="sev sev--low"></span>Незначительные<b data-a-count="17">17</b></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Влияние на показатели</p>
          <div class="ui-card pw-panel pw-impact">
            <div><span>IRR до аудита</span><span class="pw-bar"><i style="--w:90%"></i></span><b>9,0%</b></div>
            <div><span>IRR после</span><span class="pw-bar pw-bar--risk"><i style="--w:82%" data-a-after></i></span><b class="risk" data-a-irr>8,2%</b></div>
            <p class="pw-sub" data-a-note>NPV меньше в 3,6 раза</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'accounting' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Заявка по фото счёта <span class="pw-badge">AI · 30 секунд</span></p>
          <div class="ui-card pw-panel pw-form">
            <span class="pw-invoice" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <dl>
              <div><dt>Поставщик</dt><dd data-f="0">Поставщик № 12</dd></div>
              <div><dt>Сумма, IDR</dt><dd data-f="1">1 080 000</dd></div>
              <div><dt>Статья</dt><dd data-f="2">Материалы · цемент</dd></div>
            </dl>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Антифрод-проверка до оплаты</p>
          <div class="ui-card pw-panel pw-check" data-check="ok">
            <p class="pw-check-ok"><b>Совпадений нет</b> · заявка ушла на согласование</p>
            <p class="pw-check-dup"><b>Дубль № 75</b> · совпадает с заявкой № 63, оплата остановлена</p>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Согласование</p>
          <ol class="pw-route" data-route>
            <li class="is-ok">Прораб</li>
            <li class="is-ok">Проект-менеджер</li>
            <li class="is-ok">Финансовый контроллер</li>
          </ol>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">4</span>
        <div class="pw-body">
          <p class="pw-title">Аналитика</p>
          <div class="ui-card pw-panel pw-cash">
            <div class="pw-cash-legend" aria-hidden="true">
              <span class="in">Поступления</span><span class="out">Расходы</span><span class="cum">Накопленный итог</span>
            </div>
            <svg class="pw-cash-chart" viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label={`Cash Flow за январь–октябрь, млрд IDR: накопленный итог колеблется около нуля и к октябрю доходит до ${fmt1(cfm[NOW].cum)}`}>
              <rect class="pw-cash-today" data-today x={(cfm[NOW].cx - step / 2 + 1).toFixed(1)} y="4" width={(step - 2).toFixed(1)} height={CH - 26} rx="4"></rect>
              <line class="pw-cash-base" x1="8" x2={CW - 8} y1={ZY.toFixed(1)} y2={ZY.toFixed(1)}></line>
              {cfm.map((d) => (
                <g>
                  <rect class="in" x={(d.cx - 12).toFixed(1)} y={vy(d.inflow).toFixed(1)} width="11" height={(d.inflow * sc).toFixed(1)} rx="1.5"><title>{`${MONTHS_SHORT[d.m]}: поступления ${fmt1(d.inflow)}`}</title></rect>
                  <rect class="out" x={(d.cx + 1).toFixed(1)} y={vy(d.outflow).toFixed(1)} width="11" height={(d.outflow * sc).toFixed(1)} rx="1.5"><title>{`${MONTHS_SHORT[d.m]}: расходы ${fmt1(d.outflow)}`}</title></rect>
                  <text class={`pw-cash-m${d.m === NOW ? ' is-now' : ''}`} x={d.cx.toFixed(1)} y={CH - 6} text-anchor="middle">{MONTHS_SHORT[d.m]}</text>
                </g>
              ))}
              <path class="pw-cash-line" d={linePath}></path>
              {cfm.map((d) => (
                <circle class={`pw-cash-dot${d.cum < 0 ? ' is-neg' : ''}`} cx={d.cx.toFixed(1)} cy={vy(d.cum).toFixed(1)} r={d.m === NOW ? 4 : 2.8}><title>{`${MONTHS_SHORT[d.m]}: накопленный итог ${fmt1(d.cum)}`}</title></circle>
              ))}
              {cfm.map((d) => (
                <text class={`pw-cash-v${d.m === NOW ? ' is-now' : ''}${d.cum < 0 ? ' is-neg' : ''}`} x={d.cx.toFixed(1)} y={(vy(d.cum) + (d.cum < 0 ? 15 : -10)).toFixed(1)} text-anchor="middle">{fmt1(d.cum)}</text>
              ))}
            </svg>
            <p class="pw-sub" data-c-note>Платёж 1 080 000 IDR попал в Cash Flow за октябрь</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'advisory' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Объект</p>
          <div class="pw-chips" data-o-chips>
            {objects.map((o, i) => <span class={`pw-chip${i === 0 ? ' is-on' : ''}`}>{o}</span>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Скидка или рассрочка</p>
          <div class="ui-card pw-panel pw-impact" data-o-cmp>
            <div data-o-row="a" class="is-win"><span>Скидка 10%</span><span class="pw-bar"><i style="--w:78%"></i></span><b data-o-v>1,35 млн</b></div>
            <div data-o-row="b"><span>Рассрочка 24 мес.</span><span class="pw-bar"><i style="--w:84%"></i></span><b data-o-v>1,41 млн</b></div>
            <p class="pw-sub">Приведённая стоимость покупки, USD. Меньше — выгоднее</p>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Доходность</p>
          <div class="ui-card pw-panel">
            <dl class="pw-kpis">
              <div><dt>Аренда, в год</dt><dd data-o="yld">8,1%</dd></div>
              <div><dt>Окупаемость</dt><dd data-o="pb">11,2 года</dd></div>
              <div><dt>Налоги</dt><dd data-o="tax">10%</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </>
  )}
</div>

<script>
  import { SCENARIOS, YEARS, kpis, barHeight, barTitle, cumPath, payback } from '../lib/finmodel';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const OBJECTS = [
    { a: '1,35 млн', b: '1,41 млн', wa: 78, wb: 84, win: 'a', yld: '8,1%', pb: '11,2 года', tax: '10%' },
    { a: '2,62 млн', b: '2,49 млн', wa: 88, wb: 82, win: 'b', yld: '9,6%', pb: '9,8 года', tax: '10%' },
    { a: '0,94 млн', b: '0,99 млн', wa: 70, wb: 76, win: 'a', yld: '7,4%', pb: '12,6 года', tax: '10%' },
  ];
  const FORMS = [
    ['Поставщик № 12', '1 080 000', 'Материалы · цемент'],
    ['Поставщик № 4', '14 300 000', 'Материалы · арматура'],
    ['Поставщик № 9', '9 500 000', 'Техника · аренда'],
  ];
  const DUP = 1; // вторая заявка в цикле — дубль, её ловит антифрод

  const flash = (el: Element) => {
    el.classList.remove('pw-flash');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('pw-flash');
  };

  const runners: Record<string, (w: HTMLElement) => () => void> = {
    models(w) {
      let i = 0;
      const chips = [...w.querySelectorAll('[data-m-chips] .pw-chip')];
      return () => {
        i = (i + 1) % SCENARIOS.length;
        const sc = SCENARIOS[i];
        const k = kpis(sc.cf);
        chips.forEach((c, n) => c.classList.toggle('is-on', n === i));
        w.querySelectorAll<HTMLElement>('[data-ml]').forEach((el) => { el.textContent = sc.params[Number(el.dataset.ml)].label; });
        w.querySelectorAll<HTMLElement>('[data-mv]').forEach((el) => { el.textContent = sc.params[Number(el.dataset.mv)].value; flash(el); });
        w.querySelectorAll<HTMLElement>('[data-mp]').forEach((el) => el.style.setProperty('--p', `${sc.params[Number(el.dataset.mp)].p}%`));
        w.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
          el.textContent = String(k[el.dataset.m as 'irr' | 'npv' | 'moic']);
          if (el.dataset.m === 'npv') el.classList.toggle('is-neg', k.npvNeg);
          flash(el);
        });
        const cum = w.querySelector<SVGSVGElement>('[data-cum]');
        if (cum) {
          cum.querySelector('path')!.setAttribute('d', cumPath(sc.cf));
          cum.classList.remove('is-draw');
          void cum.getBoundingClientRect();
          cum.classList.add('is-draw');
        }
        const pb = payback(sc.cf);
        const pbEl = w.querySelector<HTMLElement>('[data-pb]');
        if (pbEl) {
          pbEl.style.display = pb ? '' : 'none';
          if (pb) {
            pbEl.style.left = `${pb.x.toFixed(1)}%`;
            pbEl.classList.toggle('is-right', pb.x > 60);
            pbEl.querySelector('[data-pb-text]')!.textContent = `Окупаемость в ${pb.year}`;
            flash(pbEl);
          }
        }
        w.querySelectorAll<HTMLElement>('[data-cf]').forEach((el) => {
          const n = Number(el.dataset.cf);
          const v = sc.cf[n];
          el.style.setProperty('--h', barHeight(v));
          el.className = v < 0 ? 'neg' : 'pos';
          el.title = barTitle(YEARS[n], v);
        });
      };
    },
    audit(w) {
      const bar = w.querySelector<HTMLElement>('[data-a-progress]')!;
      const pct = w.querySelector<HTMLElement>('[data-a-pct]')!;
      const counts = [...w.querySelectorAll<HTMLElement>('[data-a-count]')];
      const after = w.querySelector<HTMLElement>('[data-a-after]')!;
      const irrAfter = w.querySelector<HTMLElement>('[data-a-irr]')!;
      const note = w.querySelector<HTMLElement>('[data-a-note]')!;
      let step = 0;
      return () => {
        step = (step + 1) % 6;
        const p = Math.min(100, step * 25);
        bar.style.width = `${p}%`;
        pct.textContent = String(p);
        counts.forEach((c) => { c.textContent = String(Math.round(Number(c.dataset.aCount) * p / 100)); });
        // До проверки IRR после = IRR до (9,0%), дальше снижается по мере правок до 8,2%
        const irr = 9 - 0.8 * p / 100;
        after.style.setProperty('--w', `${irr * 10}%`);
        irrAfter.textContent = `${irr.toFixed(1).replace('.', ',')}%`;
        irrAfter.classList.toggle('risk', p > 0);
        after.parentElement!.classList.toggle('pw-bar--risk', p > 0);
        after.parentElement!.classList.toggle('is-same', p === 0);
        note.textContent = p === 100 ? 'NPV меньше в 3,6 раза' : p === 0 ? 'Проверка ещё не началась' : 'Пересчитываем по найденным замечаниям';
      };
    },
    accounting(w) {
      // Порядок как в системе: заявка → антифрод → согласование → платёж в аналитике.
      // Дубль останавливается на антифроде и до согласования не доходит.
      const fields = [...w.querySelectorAll<HTMLElement>('[data-f]')];
      const route = [...w.querySelectorAll<HTMLElement>('[data-route] li')];
      const check = w.querySelector<HTMLElement>('[data-check]')!;
      const today = w.querySelector<SVGElement>('[data-today]')!;
      const note = w.querySelector<HTMLElement>('[data-c-note]')!;
      // Первый тик сразу сбрасывает виджет и заново проводит первую заявку по всем шагам
      let step = 9;
      let n = FORMS.length - 1;
      return () => {
        step = (step + 1) % 10;
        if (step === 0) {
          n = (n + 1) % FORMS.length;
          fields.forEach((f) => { f.textContent = ''; f.classList.add('is-typing'); });
          route.forEach((r) => r.classList.remove('is-ok'));
          check.dataset.check = 'wait';
          today.classList.remove('is-hit');
          note.textContent = 'Собирается из оплаченных заявок';
        }
        const dup = n === DUP;
        if (step >= 1 && step <= 3) {
          const f = fields[step - 1];
          f.textContent = FORMS[n][step - 1];
          f.classList.remove('is-typing');
        }
        if (step === 4) check.dataset.check = dup ? 'dup' : 'ok';
        if (!dup && step >= 5 && step <= 7) route[step - 5].classList.add('is-ok');
        if (step === 8) {
          note.textContent = dup ? 'Дубль не оплачен и в отчёт не попал' : `Платёж ${FORMS[n][1]} IDR попал в Cash Flow за октябрь`;
          if (!dup) today.classList.add('is-hit');
          flash(note);
        }
      };
    },
    advisory(w) {
      let i = 0;
      const chips = [...w.querySelectorAll('[data-o-chips] .pw-chip')];
      return () => {
        i = (i + 1) % OBJECTS.length;
        const o = OBJECTS[i] as Record<string, string | number>;
        chips.forEach((c, k) => c.classList.toggle('is-on', k === i));
        (['a', 'b'] as const).forEach((k) => {
          const row = w.querySelector<HTMLElement>(`[data-o-row="${k}"]`)!;
          row.classList.toggle('is-win', o.win === k);
          row.querySelector<HTMLElement>('i')!.style.setProperty('--w', `${k === 'a' ? o.wa : o.wb}%`);
          row.querySelector<HTMLElement>('[data-o-v]')!.textContent = String(o[k]);
        });
        w.querySelectorAll<HTMLElement>('[data-o]').forEach((el) => { el.textContent = String(o[el.dataset.o!]); flash(el); });
      };
    },
  };

  if (!reduce && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-pw]').forEach((w) => {
      const tick = runners[w.dataset.pw!](w);
      const period = w.dataset.pw === 'accounting' || w.dataset.pw === 'audit' ? 1100 : 3000;
      let timer = 0;
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !timer) timer = window.setInterval(tick, period);
        if (!e.isIntersecting && timer) { clearInterval(timer); timer = 0; }
      }, { threshold: 0.3 }).observe(w);
    });
  }
</script>

<style is:global>
  .pw { display: grid; gap: 22px; font-size: 14px; line-height: 1.4; }
  .pw-step { position: relative; display: grid; grid-template-columns: 28px 1fr; gap: 14px; }
  .pw-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 30px;
    bottom: -22px;
    width: 1px;
    background: var(--line);
  }
  .pw-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 500;
  }
