---
// Живой виджет справа от описания направления: три шага с номерами, как в интерфейсе.
// Все значения демонстрационные, кроме IRR 9,0% → 8,2% и NPV «в 3,6 раза» из кейса аудита.
import { SCENARIOS, YEARS, kpis, barHeight, barTitle } from '../lib/finmodel';

interface Props {
  variant: 'models' | 'audit' | 'accounting' | 'advisory';
}
const { variant } = Astro.props;

const models = SCENARIOS;
const years = YEARS;
const m0 = models[0];
const k0 = kpis(m0.cf);
const objects = ['Апартаменты', 'Вилла', 'Таунхаус'];
---

<div class="pw" data-pw={variant}>
  {variant === 'models' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Стратегия проекта</p>
          <div class="pw-chips" data-m-chips>
            {models.map((m, i) => <span class={`pw-chip${i === 0 ? ' is-on' : ''}`}>{m.name}</span>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Предпосылки</p>
          <div class="ui-card pw-panel pw-sliders">
            {m0.params.map((q, j) => (
              <div><span data-ml={j}>{q.label}</span><b data-mv={j}>{q.value}</b><i style={`--p:${q.p}%`} data-mp={j}></i></div>
            ))}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Cash Flow и показатели для инвестора</p>
          <div class="ui-card pw-panel pw-cf-panel">
            <div class="pw-cf" aria-hidden="true">
              {m0.cf.map((v, i) => (
                <span class={v < 0 ? 'neg' : 'pos'} style={`--h:${barHeight(v)}`} data-cf={i} title={barTitle(years[i], v)}></span>
              ))}
            </div>
            <div class="pw-cf-axis" aria-hidden="true"><span>{years[0]}</span><span>Cash Flow, млн USD</span><span>{years[years.length - 1]}</span></div>
            <dl class="pw-kpis">
              <div><dt>IRR</dt><dd data-m="irr">{k0.irr}</dd></div>
              <div><dt>NPV при 12%</dt><dd data-m="npv" class={k0.npvNeg ? 'is-neg' : undefined}>{k0.npv}</dd></div>
              <div><dt>MOIC</dt><dd data-m="moic">{k0.moic}</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'audit' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Модель на проверке</p>
          <div class="ui-card pw-panel pw-file">
            <span class="pw-xls" aria-hidden="true">XLS</span>
            <div>
              <b>Финмодель проекта.xlsx</b>
              <span class="pw-progress"><i data-a-progress></i></span>
              <span class="pw-sub">14 листов · <span data-a-pct>100</span>% проверено</span>
            </div>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Реестр замечаний</p>
          <div class="ui-card pw-panel">
            <ul class="pw-sev">
              <li><span class="sev sev--risk"></span>Критичные<b data-a-count="3">3</b></li>
              <li><span class="sev sev--warn"></span>Существенные<b data-a-count="9">9</b></li>
              <li><span class="sev sev--low"></span>Незначительные<b data-a-count="17">17</b></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Влияние на показатели</p>
          <div class="ui-card pw-panel pw-impact">
            <div><span>IRR до аудита</span><span class="pw-bar"><i style="--w:90%"></i></span><b>9,0%</b></div>
            <div><span>IRR после</span><span class="pw-bar pw-bar--risk"><i style="--w:82%" data-a-after></i></span><b class="risk" data-a-irr>8,2%</b></div>
            <p class="pw-sub" data-a-note>NPV меньше в 3,6 раза</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'accounting' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Заявка по фото счёта <span class="pw-badge">AI · 30 секунд</span></p>
          <div class="ui-card pw-panel pw-form">
            <span class="pw-invoice" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <dl>
              <div><dt>Поставщик</dt><dd data-f="0">Поставщик № 12</dd></div>
              <div><dt>Сумма, IDR</dt><dd data-f="1">1 080 000</dd></div>
              <div><dt>Статья</dt><dd data-f="2">Материалы · цемент</dd></div>
            </dl>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Согласование</p>
          <ol class="pw-route" data-route>
            <li class="is-ok">Прораб</li>
            <li class="is-ok">Проект-менеджер</li>
            <li class="is-ok">Финансовый директор</li>
          </ol>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Антифрод-проверка до оплаты</p>
          <div class="ui-card pw-panel pw-check" data-check="dup">
            <p class="pw-check-ok"><b>Совпадений нет</b> · заявка передана в реестр к оплате</p>
            <p class="pw-check-dup"><b>Дубль № 75</b> · совпадает с заявкой № 63, оплата остановлена</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'advisory' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Объект</p>
          <div class="pw-chips" data-o-chips>
            {objects.map((o, i) => <span class={`pw-chip${i === 0 ? ' is-on' : ''}`}>{o}</span>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Скидка или рассрочка</p>
          <div class="ui-card pw-panel pw-impact" data-o-cmp>
            <div data-o-row="a" class="is-win"><span>Скидка 10%</span><span class="pw-bar"><i style="--w:78%"></i></span><b data-o-v>1,35 млн</b></div>
            <div data-o-row="b"><span>Рассрочка 24 мес.</span><span class="pw-bar"><i style="--w:84%"></i></span><b data-o-v>1,41 млн</b></div>
            <p class="pw-sub">Приведённая стоимость покупки, USD. Меньше — выгоднее</p>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Доходность</p>
          <div class="ui-card pw-panel">
            <dl class="pw-kpis">
              <div><dt>Аренда, в год</dt><dd data-o="yld">8,1%</dd></div>
              <div><dt>Окупаемость</dt><dd data-o="pb">11,2 года</dd></div>
              <div><dt>Налоги</dt><dd data-o="tax">10%</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </>
  )}
</div>

<script>
  import { SCENARIOS, YEARS, kpis, barHeight, barTitle } from '../lib/finmodel';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const OBJECTS = [
    { a: '1,35 млн', b: '1,41 млн', wa: 78, wb: 84, win: 'a', yld: '8,1%', pb: '11,2 года', tax: '10%' },
    { a: '2,62 млн', b: '2,49 млн', wa: 88, wb: 82, win: 'b', yld: '9,6%', pb: '9,8 года', tax: '10%' },
    { a: '0,94 млн', b: '0,99 млн', wa: 70, wb: 76, win: 'a', yld: '7,4%', pb: '12,6 года', tax: '10%' },
  ];
  const FORMS = [
    ['Поставщик № 12', '1 080 000', 'Материалы · цемент'],
    ['Поставщик № 4', '14 300 000', 'Материалы · арматура'],
    ['Поставщик № 9', '9 500 000', 'Техника · аренда'],
  ];

  const flash = (el: Element) => {
    el.classList.remove('pw-flash');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('pw-flash');
  };

  const runners: Record<string, (w: HTMLElement) => () => void> = {
    models(w) {
      let i = 0;
      const chips = [...w.querySelectorAll('[data-m-chips] .pw-chip')];
      return () => {
        i = (i + 1) % SCENARIOS.length;
        const sc = SCENARIOS[i];
        const k = kpis(sc.cf);
        chips.forEach((c, n) => c.classList.toggle('is-on', n === i));
        w.querySelectorAll<HTMLElement>('[data-ml]').forEach((el) => { el.textContent = sc.params[Number(el.dataset.ml)].label; });
        w.querySelectorAll<HTMLElement>('[data-mv]').forEach((el) => { el.textContent = sc.params[Number(el.dataset.mv)].value; flash(el); });
        w.querySelectorAll<HTMLElement>('[data-mp]').forEach((el) => el.style.setProperty('--p', `${sc.params[Number(el.dataset.mp)].p}%`));
        w.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
          el.textContent = String(k[el.dataset.m as 'irr' | 'npv' | 'moic']);
          if (el.dataset.m === 'npv') el.classList.toggle('is-neg', k.npvNeg);
          flash(el);
        });
        w.querySelectorAll<HTMLElement>('[data-cf]').forEach((el) => {
          const n = Number(el.dataset.cf);
          const v = sc.cf[n];
          el.style.setProperty('--h', barHeight(v));
          el.className = v < 0 ? 'neg' : 'pos';
          el.title = barTitle(YEARS[n], v);
        });
      };
    },
    audit(w) {
      const bar = w.querySelector<HTMLElement>('[data-a-progress]')!;
      const pct = w.querySelector<HTMLElement>('[data-a-pct]')!;
      const counts = [...w.querySelectorAll<HTMLElement>('[data-a-count]')];
      const after = w.querySelector<HTMLElement>('[data-a-after]')!;
      const irrAfter = w.querySelector<HTMLElement>('[data-a-irr]')!;
      const note = w.querySelector<HTMLElement>('[data-a-note]')!;
      let step = 0;
      return () => {
        step = (step + 1) % 6;
        const p = Math.min(100, step * 25);
        bar.style.width = `${p}%`;
        pct.textContent = String(p);
        counts.forEach((c) => { c.textContent = String(Math.round(Number(c.dataset.aCount) * p / 100)); });
        // До проверки IRR после = IRR до (9,0%), дальше снижается по мере правок до 8,2%
        const irr = 9 - 0.8 * p / 100;
        after.style.setProperty('--w', `${irr * 10}%`);
        irrAfter.textContent = `${irr.toFixed(1).replace('.', ',')}%`;
        irrAfter.classList.toggle('risk', p > 0);
        after.parentElement!.classList.toggle('pw-bar--risk', p > 0);
        after.parentElement!.classList.toggle('is-same', p === 0);
        note.textContent = p === 100 ? 'NPV меньше в 3,6 раза' : p === 0 ? 'Проверка ещё не началась' : 'Пересчитываем по найденным замечаниям';
      };
    },
    accounting(w) {
      const fields = [...w.querySelectorAll<HTMLElement>('[data-f]')];
      const route = [...w.querySelectorAll<HTMLElement>('[data-route] li')];
      const check = w.querySelector<HTMLElement>('[data-check]')!;
      let step = 0;
      let n = 0;
      return () => {
        step = (step + 1) % 7;
        if (step === 0) {
          n = (n + 1) % FORMS.length;
          fields.forEach((f) => { f.textContent = ''; f.classList.add('is-typing'); });
          route.forEach((r) => r.classList.remove('is-ok'));
          check.dataset.check = 'wait';
        }
        if (step >= 1 && step <= 3) {
          const f = fields[step - 1];
          f.textContent = FORMS[n][step - 1];
          f.classList.remove('is-typing');
        }
        if (step >= 3 && step <= 5) route[step - 3].classList.add('is-ok');
        if (step === 6) check.dataset.check = n === 0 ? 'dup' : 'ok';
      };
    },
    advisory(w) {
      let i = 0;
      const chips = [...w.querySelectorAll('[data-o-chips] .pw-chip')];
      return () => {
        i = (i + 1) % OBJECTS.length;
        const o = OBJECTS[i] as Record<string, string | number>;
        chips.forEach((c, k) => c.classList.toggle('is-on', k === i));
        (['a', 'b'] as const).forEach((k) => {
          const row = w.querySelector<HTMLElement>(`[data-o-row="${k}"]`)!;
          row.classList.toggle('is-win', o.win === k);
          row.querySelector<HTMLElement>('i')!.style.setProperty('--w', `${k === 'a' ? o.wa : o.wb}%`);
          row.querySelector<HTMLElement>('[data-o-v]')!.textContent = String(o[k]);
        });
        w.querySelectorAll<HTMLElement>('[data-o]').forEach((el) => { el.textContent = String(o[el.dataset.o!]); flash(el); });
      };
    },
  };

  if (!reduce && 'IntersectionObserver' in window) {
    document.querySelectorAll<HTMLElement>('[data-pw]').forEach((w) => {
      const tick = runners[w.dataset.pw!](w);
      const period = w.dataset.pw === 'accounting' || w.dataset.pw === 'audit' ? 1100 : 3000;
      let timer = 0;
      new IntersectionObserver(([e]) => {
        if (e.isIntersecting && !timer) timer = window.setInterval(tick, period);
        if (!e.isIntersecting && timer) { clearInterval(timer); timer = 0; }
      }, { threshold: 0.3 }).observe(w);
    });
  }
</script>

<style is:global>
  .pw { display: grid; gap: 22px; font-size: 14px; line-height: 1.4; }
  .pw-step { position: relative; display: grid; grid-template-columns: 28px 1fr; gap: 14px; }
  .pw-step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 13px;
    top: 30px;
    bottom: -22px;
    width: 1px;
    background: var(--line);
  }
  .pw-num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    font-size: 13px;
    font-weight: 500;
  }
  .pw-title { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; margin: 3px 0 10px; font-weight: 700; font-size: 15px; }
  .pw-badge { padding: 1px 8px; border-radius: 999px; background: var(--accent-soft); color: var(--accent); font-size: 12px; font-weight: 600; }
  .pw-panel { padding: 14px 16px; }
  .pw-sub { font-size: 12.5px; color: var(--ink-3); }
  .pw-flash { animation: pw-flash .9s ease; }
  @keyframes pw-flash { 0% { color: var(--accent-2); } 100% { color: inherit; } }

  .pw-chips { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .pw-chip {
    position: relative;
    padding: 12px 8px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    text-align: center;
    font-weight: 500;
    transition: border-color .4s ease, color .4s ease;
  }
  .pw-chip.is-on { border-color: var(--ink); color: var(--ink); }
  /* Выбранный вариант отмечен только рамкой, без значков */

  .pw-sliders { display: grid; gap: 12px; }
  .pw-sliders div { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; }
  .pw-sliders span { color: var(--ink-2); }
  .pw-sliders i {
    grid-column: 1 / -1;
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--gold) var(--p), #ebe8df var(--p));
    transition: background .6s ease;
  }
  .pw-sliders i::after {
    content: '';
    position: absolute;
    top: 50%;
    left: var(--p);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid var(--gold);
    transform: translate(-50%, -50%);
    transition: left .6s cubic-bezier(.2, .8, .2, 1);
  }

  .pw-cf-panel { display: grid; gap: 10px; }
  .pw-cf { position: relative; display: grid; grid-template-columns: repeat(10, 1fr); gap: 5px; height: 130px; }
  .pw-cf::after { content: ''; position: absolute; left: 0; right: 0; top: 80%; height: 1px; background: var(--line); }
  .pw-cf span { position: relative; height: 100%; }
  /* Один масштаб для плюсов и минусов, ноль на 80% высоты (высоты считает src/lib/finmodel.ts) */
  .pw-cf span::before { content: ''; position: absolute; left: 0; right: 0; height: var(--h); border-radius: 2px; transition: height .6s cubic-bezier(.2, .8, .2, 1); }
  .pw-cf .pos::before { bottom: 20%; background: var(--accent-2); }
  .pw-cf .neg::before { top: 80%; background: #d7c9a8; }
  .pw-cf-axis { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--ink-3); }
  .pw-kpis { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .pw-kpis div { padding: 4px 0 0; border-top: 2px solid var(--accent-soft); }
  .pw-kpis dt { font-size: 12.5px; color: var(--ink-3); }
  .pw-kpis dd { font-size: clamp(20px, 2vw, 26px); font-weight: 700; letter-spacing: -0.01em; color: var(--accent); white-space: nowrap; }
  .pw-kpis dd.is-neg { color: var(--risk); }

  .pw-file { display: grid; grid-template-columns: 44px 1fr; gap: 14px; align-items: center; }
  .pw-xls { display: grid; place-items: center; width: 44px; height: 52px; border-radius: 6px; background: var(--accent-soft); color: var(--accent); font-size: 12px; font-weight: 800; }
  .pw-file div { display: grid; gap: 6px; }
  .pw-progress { height: 6px; border-radius: 3px; background: #ebe8df; overflow: hidden; }
  .pw-progress i { display: block; height: 100%; width: 100%; background: var(--accent-2); transition: width 1s ease; }

  .pw-sev { list-style: none; padding: 0; display: grid; gap: 10px; }
  .pw-sev li { display: grid; grid-template-columns: 12px 1fr auto; gap: 10px; align-items: center; }
  .pw-sev b { font-size: 18px; min-width: 2ch; text-align: right; }
  .sev { width: 10px; height: 10px; border-radius: 50%; }
  .sev--risk { background: var(--risk); }
  .sev--warn { background: var(--gold); }
  .sev--low { background: #c9c5b9; }

  .pw-impact { display: grid; gap: 12px; }
  .pw-impact > div { display: grid; grid-template-columns: 1fr auto; gap: 6px 12px; align-items: center; }
  .pw-impact > div > span:first-child { color: var(--ink-2); }
  .pw-bar { grid-column: 1 / -1; grid-row: 2; height: 10px; border-radius: 5px; background: var(--bg); overflow: hidden; }
  .pw-bar i { display: block; height: 100%; width: var(--w); border-radius: 5px; background: #d7c9a8; transition: width .8s cubic-bezier(.2, .8, .2, 1); }
  .pw-impact > div:first-child .pw-bar i { background: var(--accent-2); }
  .pw-bar--risk i { background: var(--risk) !important; }
  .pw-impact .pw-bar.is-same i { background: var(--accent-2); }
  .pw-impact .risk { color: var(--risk); }
  [data-o-cmp] .pw-bar i { background: #d7c9a8 !important; }
  [data-o-cmp] .is-win .pw-bar i { background: var(--accent-2) !important; }
  [data-o-cmp] .is-win > span:first-child { color: var(--accent); font-weight: 700; }
  [data-o-cmp] .is-win > span:first-child::after { content: ' ✓'; }

  .pw-form { display: grid; grid-template-columns: 64px 1fr; gap: 16px; align-items: start; }
  .pw-invoice { display: grid; gap: 6px; align-content: start; height: 80px; padding: 10px 8px; border-radius: 4px; background: var(--bg); border: 1px solid var(--line); }
  .pw-invoice i { height: 4px; border-radius: 2px; background: #dcd8cc; }
  .pw-invoice i:nth-child(2) { width: 70%; }
  .pw-invoice i:nth-child(4) { width: 50%; margin-top: 10px; background: var(--gold); }
  .pw-form dl { display: grid; gap: 8px; }
  .pw-form dl div { display: grid; grid-template-columns: 96px 1fr; gap: 8px; align-items: baseline; }
  .pw-form dt { font-size: 12.5px; color: var(--ink-3); }
  .pw-form dd { min-height: 1.4em; font-weight: 600; border-bottom: 1px solid var(--line); }
  .pw-form dd.is-typing::after { content: ''; display: inline-block; width: 2px; height: 1em; background: var(--gold); vertical-align: -2px; animation: pw-caret .8s steps(1) infinite; }
  @keyframes pw-caret { 50% { opacity: 0; } }

  .pw-route { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .pw-route li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
    font-weight: 600;
    color: var(--ink-3);
    transition: color .3s ease, border-color .3s ease;
  }
  .pw-route li::before {
    content: '';
