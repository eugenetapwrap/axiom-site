---
// Живой виджет справа от описания направления: три шага с номерами, как в интерфейсе.
// Финмодели и инвестанализ можно трогать: сценарии и ползунки пересчитывают график и показатели.
// Все значения демонстрационные, кроме IRR 9,0% → 8,2% и NPV «в 3,6 раза» из кейса аудита.
import { SCENARIOS, YEARS, BASE, INPUTS, fmtInput, kpis, barHeight, barTitle, cumPath, payback, scaleFor, ZERO } from '../lib/finmodel';
import type { InputKey } from '../lib/finmodel';
import { OFFERS, DISC, MONTHS, compare, fmtMln, fmtPct, fmtYears } from '../lib/advisory';
import { MONTHS_SHORT } from '../lib/sankey';
import { smoothPath } from '../lib/smooth';

interface Props {
  variant: 'models' | 'audit' | 'accounting' | 'advisory';
}
const { variant } = Astro.props;

const models = SCENARIOS;
const years = YEARS;
const m0 = models[0];
const k0 = kpis(m0.cf);
const max0 = scaleFor(m0.cf);
const pb0 = payback(m0.cf);
// Порядок строк подобран так, чтобы у каждого сценария его три ползунка шли подряд
const inputKeys: InputKey[] = ['price', 'pace', 'adr', 'occ', 'cap', 'mat'];
const pct = (k: InputKey, v: number) => ((v - INPUTS[k].min) / (INPUTS[k].max - INPUTS[k].min)) * 100;

const o0 = OFFERS[0];
const c0 = compare(o0, o0.disc, o0.months);

// Шаг «Аналитика»: Cash Flow по месяцам с накопленным итогом, как в дашборде портала.
// Демо-данные, млрд IDR. Январь–октябрь заполнены, ноябрь и декабрь ещё впереди (пустые).
// Месяцы неровные, как в жизни: итог растёт, проседает, растёт сильнее, проседает глубже.
const INFLOW = [2.1, 2.6, 2.4, 3.6, 2.7, 3.2, 4.1, 3.3, 4.4, 3.9];
const OUTFLOW = [1.8, 2.3, 2.5, 2.8, 3.4, 2.8, 3.2, 3.7, 3.4, 3.6];
const CW = 480;
const CH = 212;
const step = (CW - 16) / 12;
const r1 = (v: number) => Math.round(v * 10) / 10;
let acc = 0;
const cfm = INFLOW.map((inflow, m) => {
  const outflow = OUTFLOW[m];
  acc = r1(acc + inflow - outflow);
  return { m, inflow, outflow, cum: acc, cx: 8 + step * (m + 0.5) };
});
const NOW = cfm.length - 1;
const future = [10, 11].map((m) => ({ m, cx: 8 + step * (m + 0.5) }));
// Один масштаб для столбиков и линии: ноль на высоте ZY, ниже нуля место для минусов итога
const top = Math.max(...cfm.map((d) => Math.max(d.inflow, d.outflow, d.cum)));
const bottom = Math.min(0, ...cfm.map((d) => d.cum));
const ZY = 22 + (top / (top - bottom)) * 150;
const sc = 150 / (top - bottom);
const vy = (v: number) => ZY - v * sc;
const linePath = smoothPath(cfm.map((d) => [d.cx, vy(d.cum)] as [number, number]));
const fmt1 = (v: number) => v.toFixed(1).replace('.', ',').replace('-', '−');
---

<div class="pw" data-pw={variant}>
  {variant === 'models' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Стратегия проекта</p>
          <div class="pw-chips" role="group" aria-label="Стратегия проекта">
            {models.map((m, i) => <button type="button" class={`pw-chip${i === 0 ? ' is-on' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} data-m-chip={i}>{m.name}</button>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Предпосылки <span class="pw-badge">можно двигать</span></p>
          <div class="ui-card pw-panel pw-sliders">
            {inputKeys.map((key) => (
              <label class="pw-range" data-in={key} hidden={!m0.keys.includes(key)}>
                <span>{INPUTS[key].label}</span><b data-iv={key}>{fmtInput(key, BASE[key])}</b>
                <input type="range" min={INPUTS[key].min} max={INPUTS[key].max} step={INPUTS[key].step} value={BASE[key]} data-ii={key} style={`--p:${pct(key, BASE[key]).toFixed(1)}%`} />
              </label>
            ))}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Cash Flow и показатели для инвестора</p>
          <div class="ui-card pw-panel pw-cf-panel">
            <div class="pw-cash-legend" aria-hidden="true"><span class="in">Cash Flow по годам</span><span class="cum">Накопленный итог</span></div>
            <div class="pw-cf" aria-hidden="true" data-cf-box>
              {m0.cf.map((v, i) => (
                <span class={v < 0 ? 'neg' : 'pos'} style={`--h:${barHeight(v, max0)}`} data-cf={i} title={barTitle(years[i], v)}></span>
              ))}
              <svg class="pw-cum" viewBox="0 0 100 100" preserveAspectRatio="none" data-cum>
                <path d={cumPath(m0.cf, max0)} vector-effect="non-scaling-stroke"></path>
              </svg>
              <i class="pw-pb" data-pb style={pb0 ? `left:${pb0.x.toFixed(1)}%;top:${ZERO}%` : 'display:none'}></i>
              <b class="pw-pb-label" data-pb-label style={pb0 ? `left:${pb0.x.toFixed(1)}%;top:${ZERO}%` : 'display:none'}>{pb0 ? `окупаемость в ${pb0.year}` : ''}</b>
            </div>
            <div class="pw-cf-axis" aria-hidden="true"><span>{years[0]}</span><span>млн USD</span><span>{years[years.length - 1]}</span></div>
            <dl class="pw-kpis">
              <div><dt>IRR</dt><dd data-m="irr">{k0.irr}</dd></div>
              <div><dt>NPV при 12%</dt><dd data-m="npv" class={k0.npvNeg ? 'is-neg' : undefined}>{k0.npv}</dd></div>
              <div><dt>MOIC</dt><dd data-m="moic">{k0.moic}</dd></div>
            </dl>
            <p class="pw-sub" data-pb-none hidden>Накопленный итог не выходит выше нуля: проект не окупается</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'audit' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Модель на проверке</p>
          <div class="ui-card pw-panel pw-file">
            <span class="pw-xls" aria-hidden="true">XLS</span>
            <div>
              <b>Финмодель проекта.xlsx</b>
              <span class="pw-progress"><i data-a-progress></i></span>
              <span class="pw-sub">14 листов · <span data-a-pct>100</span>% проверено</span>
            </div>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Реестр замечаний</p>
          <div class="ui-card pw-panel">
            <ul class="pw-sev">
              <li><span class="sev sev--risk"></span>Критичные<b data-a-count="3">3</b></li>
              <li><span class="sev sev--warn"></span>Существенные<b data-a-count="9">9</b></li>
              <li><span class="sev sev--low"></span>Незначительные<b data-a-count="17">17</b></li>
            </ul>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Влияние на показатели</p>
          <div class="ui-card pw-panel pw-impact">
            <div><span>IRR до аудита</span><span class="pw-bar"><i style="--w:90%"></i></span><b>9,0%</b></div>
            <div><span>IRR после</span><span class="pw-bar pw-bar--risk"><i style="--w:82%" data-a-after></i></span><b class="risk" data-a-irr>8,2%</b></div>
            <p class="pw-sub" data-a-note>NPV меньше в 3,6 раза</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'accounting' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Заявка по фото счёта <span class="pw-badge">AI · 30 секунд</span></p>
          <div class="ui-card pw-panel pw-form">
            <span class="pw-invoice" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
            <dl>
              <div><dt>Поставщик</dt><dd data-f="0">Поставщик № 12</dd></div>
              <div><dt>Сумма, IDR</dt><dd data-f="1">1 080 000</dd></div>
              <div><dt>Статья</dt><dd data-f="2">Материалы · цемент</dd></div>
            </dl>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Антифрод-проверка до оплаты</p>
          <div class="ui-card pw-panel pw-check" data-check="ok">
            <p class="pw-check-ok"><b>Совпадений нет</b> · заявка ушла на согласование</p>
            <p class="pw-check-dup"><b>Дубль № 75</b> · совпадает с заявкой № 63, оплата остановлена</p>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Согласование</p>
          <ol class="pw-route" data-route>
            <li class="is-ok">Прораб</li>
            <li class="is-ok">Проект-менеджер</li>
            <li class="is-ok">Финансовый контроллер</li>
          </ol>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">4</span>
        <div class="pw-body">
          <p class="pw-title">Аналитика</p>
          <div class="ui-card pw-panel pw-cash">
            <div class="pw-cash-legend" aria-hidden="true">
              <span class="in">Поступления</span><span class="out">Расходы</span><span class="cum">Накопленный итог</span>
            </div>
            <svg class="pw-cash-chart" viewBox={`0 0 ${CW} ${CH}`} role="img" aria-label={`Cash Flow за январь–октябрь, млрд IDR: накопленный итог неровно растёт от нуля до ${fmt1(cfm[NOW].cum)}, ноябрь и декабрь ещё впереди`}>
              <rect class="pw-cash-today" data-today x={(cfm[NOW].cx - step / 2 + 1).toFixed(1)} y="4" width={(step - 2).toFixed(1)} height={CH - 26} rx="4"></rect>
              <line class="pw-cash-base" x1="8" x2={CW - 8} y1={ZY.toFixed(1)} y2={ZY.toFixed(1)}></line>
              {cfm.map((d) => (
                <g>
                  <rect class="in" x={(d.cx - 11).toFixed(1)} y={vy(d.inflow).toFixed(1)} width="10" height={(d.inflow * sc).toFixed(1)} rx="1.5"><title>{`${MONTHS_SHORT[d.m]}: поступления ${fmt1(d.inflow)}`}</title></rect>
                  <rect class="out" x={(d.cx + 1).toFixed(1)} y={vy(d.outflow).toFixed(1)} width="10" height={(d.outflow * sc).toFixed(1)} rx="1.5"><title>{`${MONTHS_SHORT[d.m]}: расходы ${fmt1(d.outflow)}`}</title></rect>
                  <text class={`pw-cash-m${d.m === NOW ? ' is-now' : ''}`} x={d.cx.toFixed(1)} y={CH - 6} text-anchor="middle">{MONTHS_SHORT[d.m]}</text>
                </g>
              ))}
              {future.map((d) => (
                <g class="pw-cash-future">
                  <rect x={(d.cx - step / 2 + 3).toFixed(1)} y="22" width={(step - 6).toFixed(1)} height={(ZY - 22).toFixed(1)} rx="4"></rect>
                  <text class="pw-cash-m" x={d.cx.toFixed(1)} y={CH - 6} text-anchor="middle">{MONTHS_SHORT[d.m]}</text>
                </g>
              ))}
              <path class="pw-cash-line" d={linePath}></path>
              {cfm.map((d) => (
                <circle class={`pw-cash-dot${d.cum < 0 ? ' is-neg' : ''}`} cx={d.cx.toFixed(1)} cy={vy(d.cum).toFixed(1)} r={d.m === NOW ? 4 : 2.8}><title>{`${MONTHS_SHORT[d.m]}: накопленный итог ${fmt1(d.cum)}`}</title></circle>
              ))}
              {cfm.map((d) => (
                <text class={`pw-cash-v${d.m === NOW ? ' is-now' : ''}${d.cum < 0 ? ' is-neg' : ''}`} x={d.cx.toFixed(1)} y={(vy(d.cum) + (d.cum < 0 ? 15 : -10)).toFixed(1)} text-anchor="middle">{fmt1(d.cum)}</text>
              ))}
            </svg>
            <p class="pw-sub" data-c-note>Платёж 1 080 000 IDR попал в Cash Flow за октябрь</p>
          </div>
        </div>
      </div>
    </>
  )}

  {variant === 'advisory' && (
    <>
      <div class="pw-step">
        <span class="pw-num">1</span>
        <div class="pw-body">
          <p class="pw-title">Объект</p>
          <div class="pw-chips" role="group" aria-label="Объект">
            {OFFERS.map((o, i) => <button type="button" class={`pw-chip${i === 0 ? ' is-on' : ''}`} aria-pressed={i === 0 ? 'true' : 'false'} data-o-chip={i}>{o.name}</button>)}
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">2</span>
        <div class="pw-body">
          <p class="pw-title">Скидка или рассрочка <span class="pw-badge">можно двигать</span></p>
          <div class="ui-card pw-panel pw-offer">
            <div class="pw-sliders">
              <label class="pw-range">
                <span>Скидка за полную оплату</span><b data-ov="disc">{o0.disc}%</b>
                <input type="range" min={DISC.min} max={DISC.max} step={DISC.step} value={o0.disc} data-oi="disc" style={`--p:${((o0.disc - DISC.min) / (DISC.max - DISC.min)) * 100}%`} />
              </label>
              <label class="pw-range">
                <span>Рассрочка, месяцев</span><b data-ov="months">{o0.months}</b>
                <input type="range" min={MONTHS.min} max={MONTHS.max} step={MONTHS.step} value={o0.months} data-oi="months" style={`--p:${((o0.months - MONTHS.min) / (MONTHS.max - MONTHS.min)) * 100}%`} />
              </label>
            </div>
            <div class="pw-impact" data-o-cmp>
              <div data-o-row="a" class={c0.win === 'a' ? 'is-win' : undefined}><span data-o-name>Скидка {o0.disc}%</span><span class="pw-bar"><i style={`--w:${c0.wa.toFixed(1)}%`}></i></span><b data-o-v>{fmtMln(c0.a)}</b></div>
              <div data-o-row="b" class={c0.win === 'b' ? 'is-win' : undefined}><span data-o-name>Рассрочка {o0.months} мес.</span><span class="pw-bar"><i style={`--w:${c0.wb.toFixed(1)}%`}></i></span><b data-o-v>{fmtMln(c0.b)}</b></div>
              <p class="pw-sub">Приведённая стоимость покупки при ставке 12%, USD. Меньше — выгоднее</p>
            </div>
          </div>
        </div>
      </div>
      <div class="pw-step">
        <span class="pw-num">3</span>
        <div class="pw-body">
          <p class="pw-title">Доходность</p>
          <div class="ui-card pw-panel">
            <dl class="pw-kpis">
              <div><dt>Аренда, в год</dt><dd data-o="yld">{fmtPct(c0.yld)}</dd></div>
              <div><dt>Окупаемость</dt><dd data-o="pb">{fmtYears(c0.pb)}</dd></div>
              <div><dt>Налог на аренду</dt><dd data-o="tax">10%</dd></div>
            </dl>
          </div>
        </div>
      </div>
    </>
  )}
</div>

<script>
  import { SCENARIOS, YEARS, BASE, fmtInput, buildCF, kpis, barHeight, barTitle, cumPath, cumulative, payback, scaleFor, ZERO } from '../lib/finmodel';
  import type { Inputs, InputKey } from '../lib/finmodel';
  import { OFFERS, DISC, MONTHS, compare, fmtMln, fmtPct, fmtYears } from '../lib/advisory';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const FORMS = [
    ['Поставщик № 12', '1 080 000', 'Материалы · цемент'],
    ['Поставщик № 4', '14 300 000', 'Материалы · арматура'],
    ['Поставщик № 9', '9 500 000', 'Техника · аренда'],
  ];
  const DUP = 1; // вторая заявка в цикле — дубль, её ловит антифрод

  const flash = (el: Element) => {
    el.classList.remove('pw-flash');
    void (el as HTMLElement).offsetWidth;
    el.classList.add('pw-flash');
  };
  const setRange = (el: HTMLInputElement, v: number) => {
    el.value = String(v);
    const min = Number(el.min);
    const max = Number(el.max);
    el.style.setProperty('--p', `${((v - min) / (max - min)) * 100}%`);
  };

  // Каждый виджет возвращает шаг автопоказа; число — пауза до следующего шага (по умолчанию period).
  // Как только посетитель трогает виджет, автопоказ останавливается (data-manual).
  type Tick = () => number | void;
  const runners: Record<string, (w: HTMLElement) => Tick> = {
    models(w) {
      const chips = [...w.querySelectorAll<HTMLButtonElement>('[data-m-chip]')];
      const rows = [...w.querySelectorAll<HTMLElement>('[data-in]')];
      const inputs = [...w.querySelectorAll<HTMLInputElement>('[data-ii]')];
      const box = w.querySelector<HTMLElement>('[data-cf-box]')!;
      const cum = w.querySelector<SVGSVGElement>('[data-cum]')!;
      const pbEl = w.querySelector<HTMLElement>('[data-pb]')!;
      const pbLabel = w.querySelector<HTMLElement>('[data-pb-label]')!;
      const pbNone = w.querySelector<HTMLElement>('[data-pb-none]')!;
      const state: Inputs = { ...BASE };
      let i = 0;
      let last = { cf: SCENARIOS[0].cf, max: scaleFor(SCENARIOS[0].cf), x: payback(SCENARIOS[0].cf)?.x ?? 0 };

      // Подпись окупаемости ставим у точки в тот из четырёх углов, где она меньше всего задевает
      // столбики и линию накопленного итога и не вылезает за график
      const SIDES = ['al', 'ar', 'br', 'bl'] as const;
      const placeLabel = () => {
        const W = box.clientWidth;
        const H = box.clientHeight;
        const lw = pbLabel.offsetWidth;
        const lh = pbLabel.offsetHeight;
        if (!W || !lw) return;
        const { cf, max, x } = last;
        const dx = (W * x) / 100;
        const dy = (H * ZERO) / 100;
        const cw = (W - 9 * 5) / 10;
        const bars = cf.map((v, j) => {
          const h = (H * (Math.abs(v) / max) * 56) / 100;
          return { x0: j * (cw + 5), x1: j * (cw + 5) + cw, y0: v < 0 ? dy : dy - h, y1: v < 0 ? dy + h : dy };
        });
        const pts = [[0, dy], ...cumulative(cf).map((v, j) => [(W * (j + 0.5)) / 10, (H * (ZERO - (v / max) * 56)) / 100])];
        const score = (lx: number, ly: number) => {
          const r = { x0: lx - 2, x1: lx + lw + 2, y0: ly - 2, y1: ly + lh + 2 };
          let sc = 0;
          bars.forEach((b) => {
            const ow = Math.min(r.x1, b.x1) - Math.max(r.x0, b.x0);
            const oh = Math.min(r.y1, b.y1) - Math.max(r.y0, b.y0);
            if (ow > 0 && oh > 0) sc += ow * oh;
          });
          for (let k = 0; k < pts.length - 1; k++) {
            for (let t = 0; t <= 1; t += 0.05) {
              const px = pts[k][0] + (pts[k + 1][0] - pts[k][0]) * t;
              const py = pts[k][1] + (pts[k + 1][1] - pts[k][1]) * t;
              if (px > r.x0 && px < r.x1 && py > r.y0 && py < r.y1) sc += 60;
            }
          }
          const over = Math.max(0, -r.x0) + Math.max(0, r.x1 - W) + Math.max(0, -r.y0) + Math.max(0, r.y1 - H);
          return sc + over * 400;
        };
        const at = {
          al: [dx - 8 - lw, dy - 9 - lh],
          ar: [dx + 8, dy - 9 - lh],
          br: [dx + 8, dy + 7],
          bl: [dx - 8 - lw, dy + 7],
        };
        let best: (typeof SIDES)[number] = 'al';
        let bestScore = Infinity;
        SIDES.forEach((sd) => {
          const v = score(at[sd][0], at[sd][1]);
          if (v < bestScore - 0.5) { bestScore = v; best = sd; }
        });
        SIDES.forEach((sd) => pbLabel.classList.toggle(`is-${sd}`, sd === best));
      };

      const render = (scenarioChanged: boolean) => {
        const sc = SCENARIOS[i];
        const cf = buildCF(sc.id, state);
        const max = scaleFor(cf);
        const k = kpis(cf);
        chips.forEach((c, n) => { c.classList.toggle('is-on', n === i); c.setAttribute('aria-pressed', String(n === i)); });
        rows.forEach((r) => { r.hidden = !sc.keys.includes(r.dataset.in as InputKey); });
        w.querySelectorAll<HTMLElement>('[data-iv]').forEach((el) => {
          const key = el.dataset.iv as InputKey;
          el.textContent = fmtInput(key, state[key]);
        });
        w.querySelectorAll<HTMLElement>('[data-m]').forEach((el) => {
          el.textContent = String(k[el.dataset.m as 'irr' | 'npv' | 'moic']);
          if (el.dataset.m === 'npv') el.classList.toggle('is-neg', k.npvNeg);
          if (scenarioChanged) flash(el);
        });
        w.querySelectorAll<HTMLElement>('[data-cf]').forEach((el) => {
          const n = Number(el.dataset.cf);
          const v = cf[n];
          el.style.setProperty('--h', barHeight(v, max));
          el.className = v < 0 ? 'neg' : 'pos';
          el.title = barTitle(YEARS[n], v);
        });
        cum.querySelector('path')!.setAttribute('d', cumPath(cf, max));
        if (scenarioChanged && !reduce) {
          cum.classList.remove('is-draw');
          void cum.getBoundingClientRect();
          cum.classList.add('is-draw');
        }
        const pb = payback(cf);
        last = { cf, max, x: pb?.x ?? 0 };
        pbEl.style.display = pb ? '' : 'none';
        pbLabel.style.display = pb ? '' : 'none';
        pbNone.hidden = !!pb;
        if (pb) {
          pbEl.style.left = `${pb.x.toFixed(1)}%`;
          pbLabel.style.left = `${pb.x.toFixed(1)}%`;
          pbLabel.textContent = `окупаемость в ${pb.year}`;
          placeLabel();
          if (scenarioChanged) flash(pbLabel);
        }
      };

      chips.forEach((c, n) => c.addEventListener('click', () => { i = n; render(true); }));
      inputs.forEach((el) => {
        const key = el.dataset.ii as InputKey;
        el.addEventListener('input', () => {
          state[key] = Number(el.value);
          setRange(el, state[key]);
          render(false);
        });
      });
      requestAnimationFrame(placeLabel);
      window.addEventListener('resize', placeLabel);

      return () => {
        i = (i + 1) % SCENARIOS.length;
        render(true);
      };
    },
    audit(w) {
      const bar = w.querySelector<HTMLElement>('[data-a-progress]')!;
      const pct = w.querySelector<HTMLElement>('[data-a-pct]')!;
      const counts = [...w.querySelectorAll<HTMLElement>('[data-a-count]')];
      const after = w.querySelector<HTMLElement>('[data-a-after]')!;
      const irrAfter = w.querySelector<HTMLElement>('[data-a-irr]')!;
      const note = w.querySelector<HTMLElement>('[data-a-note]')!;
      let step = 0;
      return () => {
        step = (step + 1) % 6;
        const p = Math.min(100, step * 25);
        bar.style.width = `${p}%`;
        pct.textContent = String(p);
        counts.forEach((c) => { c.textContent = String(Math.round(Number(c.dataset.aCount) * p / 100)); });
        // До проверки IRR после = IRR до (9,0%), дальше снижается по мере правок до 8,2%
        const irr = 9 - 0.8 * p / 100;
        after.style.setProperty('--w', `${irr * 10}%`);
        irrAfter.textContent = `${irr.toFixed(1).replace('.', ',')}%`;
        irrAfter.classList.toggle('risk', p > 0);
        after.parentElement!.classList.toggle('pw-bar--risk', p > 0);
        after.parentElement!.classList.toggle('is-same', p === 0);
        note.textContent = p === 100 ? 'NPV меньше в 3,6 раза' : p === 0 ? 'Проверка ещё не началась' : 'Пересчитываем по найденным замечаниям';
      };
    },
    accounting(w) {
      // Порядок как в системе: заявка → антифрод → согласование → платёж в аналитике.
      // Дубль останавливается на антифроде и до согласования не доходит.
      // Поля заявки заполняются быстро, дальше шаги идут спокойнее.
      const fields = [...w.querySelectorAll<HTMLElement>('[data-f]')];
      const route = [...w.querySelectorAll<HTMLElement>('[data-route] li')];
      const check = w.querySelector<HTMLElement>('[data-check]')!;
      const today = w.querySelector<SVGElement>('[data-today]')!;
      const note = w.querySelector<HTMLElement>('[data-c-note]')!;
      let step = 8;
      let n = FORMS.length - 1;
      return () => {
        step = (step + 1) % 9;
        if (step === 0) {
          n = (n + 1) % FORMS.length;
          fields.forEach((f) => { f.textContent = ''; f.classList.add('is-typing'); });
          route.forEach((r) => r.classList.remove('is-ok'));
          check.dataset.check = 'wait';
          today.classList.remove('is-hit');
          note.textContent = 'Собирается из оплаченных заявок';
          return 250;
        }
        const dup = n === DUP;
        if (step >= 1 && step <= 3) {
          const f = fields[step - 1];
          f.textContent = FORMS[n][step - 1];
          f.classList.remove('is-typing');
          return step < 3 ? 180 : 450;
        }
        if (step === 4) {
          check.dataset.check = dup ? 'dup' : 'ok';
          if (dup) step = 7; // дубль сразу идёт к итогу
          return 900;
        }
        if (step >= 5 && step <= 7) {
          route[step - 5].classList.add('is-ok');
          return step < 7 ? 420 : 700;
        }
        note.textContent = dup ? 'Дубль не оплачен и в отчёт не попал' : `Платёж ${FORMS[n][1]} IDR попал в Cash Flow за октябрь`;
        if (!dup) today.classList.add('is-hit');
        flash(note);
        return 2600;
      };
    },
    advisory(w) {
      const chips = [...w.querySelectorAll<HTMLButtonElement>('[data-o-chip]')];
      const disc = w.querySelector<HTMLInputElement>('[data-oi="disc"]')!;
      const months = w.querySelector<HTMLInputElement>('[data-oi="months"]')!;
      let i = 0;
      const render = (objectChanged: boolean) => {
        const o = OFFERS[i];
        const d = Number(disc.value);
        const m = Number(months.value);
        const c = compare(o, d, m);
        chips.forEach((ch, k) => { ch.classList.toggle('is-on', k === i); ch.setAttribute('aria-pressed', String(k === i)); });
        w.querySelector<HTMLElement>('[data-ov="disc"]')!.textContent = `${d}%`;
        w.querySelector<HTMLElement>('[data-ov="months"]')!.textContent = String(m);
        ([['a', c.a, c.wa, `Скидка ${d}%`], ['b', c.b, c.wb, `Рассрочка ${m} мес.`]] as const).forEach(([k, v, wd, name]) => {
          const row = w.querySelector<HTMLElement>(`[data-o-row="${k}"]`)!;
          row.classList.toggle('is-win', c.win === k);
          row.querySelector<HTMLElement>('i')!.style.setProperty('--w', `${wd.toFixed(1)}%`);
          row.querySelector<HTMLElement>('[data-o-v]')!.textContent = fmtMln(v);
          row.querySelector<HTMLElement>('[data-o-name]')!.textContent = name;
        });
        const yld = w.querySelector<HTMLElement>('[data-o="yld"]')!;
        const pb = w.querySelector<HTMLElement>('[data-o="pb"]')!;
        yld.textContent = fmtPct(c.yld);
        pb.textContent = fmtYears(c.pb);
        if (objectChanged) { flash(yld); flash(pb); }
      };
      const pick = (k: number) => {
        i = k;
        setRange(disc, OFFERS[k].disc);
        setRange(months, OFFERS[k].months);
        render(true);
      };
      chips.forEach((ch, k) => ch.addEventListener('click', () => pick(k)));
      [disc, months].forEach((el) => el.addEventListener('input', () => { setRange(el, Number(el.value)); render(false); }));
      return () => pick((i + 1) % OFFERS.length);
    },
  };

  document.querySelectorAll<HTMLElement>('[data-pw]').forEach((w) => {
    const tick = runners[w.dataset.pw!](w);
    if (reduce || !('IntersectionObserver' in window)) return;
    const period = w.dataset.pw === 'audit' ? 1100 : 3200;
    let timer = 0;
    let on = false;
    const loop = () => {
      if (w.dataset.manual) return;
      const d = tick();
      timer = window.setTimeout(loop, typeof d === 'number' ? d : period);
    };
    const manual = () => { w.dataset.manual = '1'; clearTimeout(timer); };
    if (w.dataset.pw === 'models' || w.dataset.pw === 'advisory') {
      w.addEventListener('pointerdown', manual);
      w.addEventListener('keydown', manual);
    }
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !on && !w.dataset.manual) { on = true; timer = window.setTimeout(loop, w.dataset.pw === 'accounting' ? 400 : period); }
      if (!e.isIntersecting && on) { on = false; clearTimeout(timer); }
    }, { threshold: 0.3 }).observe(w);
  });
</script>

