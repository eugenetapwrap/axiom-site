---
import { t } from '../lib/typo';
import { results } from '../content/ru';
---

<section class="section section--soft" id="results" aria-labelledby="results-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{results.eyebrow}</p>
      <h2 id="results-title" class="h2">{t(results.title)}</h2>
      <p class="lead">{t(results.lead)}</p>
    </div>

    <ul class="stats">
      {
        results.stats.map((s) => (
          <li class:list={['stat', { tbd: s.tbd }]}>
            <span class="stat__value">{s.value}</span>
            <span class="stat__text">{t(s.text)}</span>
          </li>
        ))
      }
    </ul>

    <h3 class="cases__title">Случаи из практики</h3>
    <ul class="cases">
      {
        results.cases.map((c) => (
          <li class:list={['case', { tbd: c.tbd }]}>
            <p class="case__tag mono">{c.tag}</p>
            <p class="case__title">{t(c.title)}</p>
            <div class="case__part">
              <p class="case__label">Что было</p>
              <p>{t(c.situation)}</p>
            </div>
            <div class="case__part">
              <p class="case__label">Что сделали и итог</p>
              <p>{t(c.result)}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .stats {
    list-style: none;
    display: grid;
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .stats {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1040px) {
    .stats {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .stat {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding: var(--s-5);
    background: var(--c-surface);
  }
  .stat__value {
    font-family: var(--f-mono);
    font-size: clamp(1.5rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .stat__text {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .cases__title {
    margin: var(--s-8) 0 var(--s-5);
    font-size: var(--fs-xl);
  }
  .cases {
    list-style: none;
    display: grid;
    gap: var(--s-4);
  }
  @media (min-width: 1040px) {
    .cases {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .case {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    font-size: var(--fs-sm);
  }
  .case__tag {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .case__title {
    font-size: var(--fs-lg);
    font-weight: 600;
    line-height: 1.3;
    margin-top: calc(-1 * var(--s-2));
  }
  .case__part {
    display: grid;
    gap: var(--s-1);
    color: var(--c-ink-2);
  }
  .case__label {
    font-weight: 600;
    color: var(--c-ink);
  }
</style>
