  .kpis--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 640px) { .kpis--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .kpis--3 { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .kpis--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .kpis div { display: flex; flex-direction: column; justify-content: space-between; padding-top: 8px; border-top: 2px solid var(--accent-soft); }
  .kpis dt { font-size: 13px; color: var(--ink-3); line-height: 1.3; }
  .kpis dd { margin-top: 4px; font-size: clamp(20px, 2vw, 25px); font-weight: 700; letter-spacing: -0.01em; color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .kpis dd.is-neg { color: var(--risk); }

  /* График кэшфлоу */
  .vc-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2); }
  .vc-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .vc-legend span::before { content: ''; width: 10px; height: 10px; border-radius: 2px; }
