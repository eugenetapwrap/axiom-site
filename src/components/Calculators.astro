  }
  @media (max-width: 600px) { .calc-panel { padding: var(--s3) 18px; } }
  .calc-q { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; margin-bottom: var(--s3); }

  /* Поля */
  .cf-grid { display: grid; gap: 14px 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 340px) { .cf-grid { grid-template-columns: 1fr; } }
  .cf { display: grid; gap: 4px; align-content: start; }
  .cf-l { font-size: 14px; color: var(--ink-2); line-height: 1.3; }
  .cf-box { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); transition: border-color .15s ease; }
  .cf-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .cf-box input { flex: 1; min-width: 0; width: 100%; padding: 10px 0 10px 12px; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; outline: none; }
  .cf-box i { padding: 0 12px 0 6px; font-style: normal; font-size: 13px; color: var(--ink-3); white-space: nowrap; }
  .cf small { font-size: 12.5px; color: var(--ink-3); line-height: 1.3; }
  .cf-more { margin-top: var(--s3); }
  .cf-more summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 15px; margin-bottom: 14px; }
  .cf-note { margin-top: var(--s3); }

  /* Результат */
  .calc-out { display: grid; gap: var(--s3); min-width: 0; }
  .kpis { display: grid; gap: 12px 16px; }
  .kpis--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 640px) { .kpis--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .kpis--3 { grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); }
  .kpis--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .kpis div { display: flex; flex-direction: column; justify-content: space-between; padding-top: 8px; border-top: 2px solid var(--accent-soft); }
  .kpis dt { font-size: 13px; color: var(--ink-3); line-height: 1.3; }
  .kpis dd { margin-top: 4px; font-size: clamp(20px, 2vw, 25px); font-weight: 700; letter-spacing: -0.01em; color: var(--accent); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .kpis dd.is-neg { color: var(--risk); }

  /* График кэшфлоу */
  .vc-legend { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2); }
  .vc-legend span { display: inline-flex; align-items: center; gap: 6px; }
  .vc-legend span::before { content: ''; width: 10px; height: 10px; border-radius: 2px; }
  .vc-legend .l-buy::before { background: var(--c-neg-soft); }
  .vc-legend .l-net::before { background: var(--accent-2); }
  .vc-legend .l-sale::before { background: var(--th-3); }
  .vc-legend .l-cum::before { width: 16px; height: 2px; border-radius: 1px; background: var(--ink); }
  .vc-box { position: relative; min-width: 0; }
  .vc { display: block; width: 100%; height: 280px; overflow: visible; }
  .vc :global(.vc-grid) { stroke: var(--line); stroke-width: 1; }
  .vc :global(.vc-zero) { stroke: var(--ink-3); }
  .vc :global(.vc-ylab), .vc :global(.vc-xlab) { fill: var(--ink-3); font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .vc :global(.vc-buy) { fill: var(--c-neg-soft); }
  .vc :global(.vc-net) { fill: var(--accent-2); }
  .vc :global(.vc-sale) { fill: var(--th-3); }
  .vc :global(.vc-cum) { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .vc :global(.vc-lab) { font: 600 12px var(--font); fill: var(--ink); paint-order: stroke; stroke: var(--surface); stroke-width: 4px; stroke-linejoin: round; font-variant-numeric: tabular-nums; }
  .vc :global(.vc-lab--buy), .vc :global(.vc-lab--neg) { fill: var(--risk); }
  .vc :global(.vc-lab--mute) { font-weight: 400; fill: var(--ink-2); }
  .vc :global(.vc-lab--sale) { fill: var(--accent); }
  .vc :global(.vc-dot) { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .vc :global(.vc-hit) { fill: transparent; cursor: crosshair; }
  .vc :global(.vc-hit.is-on) { fill: color-mix(in srgb, var(--ink) 6%, transparent); }
  .vc-tip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: auto auto;
    gap: 2px 14px;
