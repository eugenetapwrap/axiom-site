---
// Блок «Посчитайте сами»: пять вкладок, три калькулятора работают, рост стоимости и оценка виллы пока заготовки.
// 1. Рассрочка или скидка (для девелопера, первая вкладка): коридор скидки при двух ставках.
// 2. Вилла: кэшфлоу инвестора по годам, продажа в конце срока, IRR, NPV, MOIC.
// 3. Дубли и ошибки: ориентир по клиентам Axiom (около 0,9% затрат), в IDR или USD.
// Считает браузер посетителя, данные никуда не уходят. При сборке страница получает расчёт по умолчанию.
import {
  villa, villaChart, villaTable, VILLA_DEFAULT, installment, INST_DEFAULT, dupes, DUP_DEFAULT,
  usd, pct, group, idr,
} from '../lib/calc';
import { tgLink } from '../data/site';
import { t } from '../lib/typo';

type Field = { k: string; label: string; unit: string; hint?: string };
const villaMain: Field[] = [
  { k: 'price', label: 'Цена виллы', unit: 'USD' },
  { k: 'adr', label: 'Цена ночи', unit: 'USD', hint: 'средняя за год' },
  { k: 'occ', label: 'Загрузка', unit: '%' },
  { k: 'mgmt', label: 'Комиссия УК', unit: '%', hint: 'управляющая компания, от выручки после площадок' },
  { k: 'fixed', label: 'Постоянные расходы', unit: 'USD в год', hint: 'персонал, коммунальные, страховка' },
  { k: 'years', label: 'Срок владения', unit: 'лет', hint: 'продажа в конце срока' },
  { k: 'lease', label: 'Срок лизхолда', unit: 'лет', hint: '0, если земля в собственности' },
  { k: 'growth', label: 'Рост цены виллы', unit: '% в год', hint: 'для цены продажи' },
];
const villaMore: Field[] = [
  { k: 'build', label: 'Лет до сдачи', unit: 'лет', hint: 'если покупаете на стройке: аренды в эти годы нет' },
  { k: 'ota', label: 'Комиссии площадок', unit: '%', hint: 'Airbnb, Booking и другие' },
  { k: 'opex', label: 'Переменные расходы', unit: '%', hint: 'расходники, прачечная, мелкий ремонт' },
  { k: 'tax', label: 'Налоги', unit: '%', hint: 'от выручки' },
  { k: 'adrGrowth', label: 'Рост цены ночи', unit: '% в год', hint: 'постоянные расходы растут так же' },
  { k: 'saleCost', label: 'Расходы на продажу', unit: '%', hint: 'агент и оформление' },
  { k: 'rate', label: 'Ставка для NPV', unit: '%', hint: 'доходность, на которую вы ориентируетесь' },
];
const instFields: Field[] = [
  { k: 'price', label: 'Цена объекта', unit: 'USD' },
  { k: 'down', label: 'Первый взнос', unit: '%' },
  { k: 'months', label: 'Срок рассрочки', unit: 'мес.' },
  { k: 'disc', label: 'Скидка за полную оплату', unit: '%', hint: 'которую предлагаете или хотите получить' },
  { k: 'dev', label: 'Ставка девелопера', unit: '% годовых', hint: 'сколько стоят деньги кредита или инвестора' },
  { k: 'buy', label: 'Ставка покупателя', unit: '% годовых', hint: 'сколько деньги приносят ему сейчас, например на депозите' },
];
const dupFields: Field[] = [
  { k: 'spend', label: 'Расходы проекта в месяц', unit: 'IDR' },
  { k: 'months', label: 'Срок стройки', unit: 'мес.' },
];

// Вкладки в порядке Евгения: вилла, рост стоимости, оценка, рассрочка; дубли — наш ориентир по клиентам
const TABS = [
  { id: 'villa', label: 'Доходность виллы' },
  { id: 'growth', label: 'Рост стоимости' },
  { id: 'value', label: 'Оценка виллы' },
  { id: 'inst', label: 'Рассрочка или скидка' },
  { id: 'dup', label: 'Дубли и ошибки' },
];
// Заготовки (идеи Евгения 02.11.2026). Поля и выводы взяты из его описания, расчёт пока не делаем
const STUBS = [
  {
    id: 'growth',
    q: 'Сколько будет стоить объект через 1–5 лет',
    inputs: ['Цена сегодня', 'Горизонт прогноза, 1–5 лет', 'Факторы роста', 'Факторы падения'],
    outputs: ['Прогноз цены по годам', 'Рост за весь срок', 'Рост в среднем за год'],
  },
  {
    id: 'value',
    q: 'Сколько стоит вилла: затратный и доходный методы',
    inputs: ['Земля', 'Строительство', 'Износ', 'Чистый операционный доход, NOI', 'Ставка капитализации', 'Ставка дисконтирования'],
    outputs: ['Стоимость по затратному методу', 'Стоимость по NOI', 'Стоимость по DCF'],
  },
];

const show = (v: number) => (Math.abs(v) >= 1000 ? group(v) : String(v).replace('.', ','));

const vo = villa(VILLA_DEFAULT);
const vc = villaChart(vo);
const io = installment(INST_DEFAULT);
const dx = dupes(DUP_DEFAULT);
// Положение на шкале скидки: от 0 до max
const scaleMax = (...v: number[]) => Math.max(0.1, Math.ceil((Math.max(...v) * 100 + 1) / 5) * 0.05);
const iMax = scaleMax(io.evenDev, INST_DEFAULT.disc / 100);
const at = (v: number) => `${((Math.max(0, v) / iMax) * 100).toFixed(2)}%`;
---

<div class="calc" data-calc>
  <!-- Заголовок и вкладки в одну строку (Евгений 02.11.2026). Порядок вкладок — его список калькуляторов -->
  <div class="calc-head">
    <h2>Посчитайте сами</h2>
    <div class="calc-tabs" role="tablist" aria-label="Калькуляторы">
      {TABS.map((tb, i) => (
        <button type="button" role="tab" id={`ct-${tb.id}`} aria-controls={`cp-${tb.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-ct={tb.id}>{tb.label}</button>
      ))}
    </div>
  </div>

  <!-- Заготовки новых калькуляторов: блок вводных и блок результата. Поля и расчёт Евгений уточнит -->
  {STUBS.map((st) => (
    <div class="calc-panel calc-panel--stub ui-card" id={`cp-${st.id}`} role="tabpanel" aria-labelledby={`ct-${st.id}`} data-cp={st.id} hidden>
      <div class="stub">
        <p class="calc-q">{t(st.q)}</p>
        <p class="stub-h">Вводные</p>
        <ul class="stub-in">{st.inputs.map((f) => <li><span>{t(f)}</span><i></i></li>)}</ul>
      </div>
      <div class="stub stub--out">
        <p class="stub-h">Результат</p>
        <ul class="stub-out">{st.outputs.map((o) => <li><span>{t(o)}</span><b>—</b></li>)}</ul>
        <p class="caption">Калькулятор готовим: поля и порядок расчёта уточняем.</p>
      </div>
    </div>
  ))}

  <!-- 1. Рассрочка или скидка -->
  <div class="calc-panel ui-card" id="cp-inst" role="tabpanel" aria-labelledby="ct-inst" data-cp="inst" hidden>
    <form class="calc-form" data-form="inst" onsubmit="return false">
      <p class="calc-q">{t('Какая скидка за полную оплату выгодна и девелоперу, и покупателю')}</p>
      <div class="cf-grid">
        {instFields.map((f) => (
          <label class="cf">
            <span class="cf-l">{t(f.label)}</span>
            <span class="cf-box"><input inputmode="decimal" autocomplete="off" value={show((INST_DEFAULT as any)[f.k])} data-k={f.k} /><i>{f.unit}</i></span>
            {f.hint && <small>{t(f.hint)}</small>}
          </label>
        ))}
      </div>
    </form>

    <div class="calc-out">
      <dl class="kpis kpis--3">
        <div><dt>Платёж в месяц</dt><dd data-i="pay">{usd(io.pay)}</dd></div>
        <div><dt>Скидка, выгодная обеим сторонам</dt><dd data-i="range">{io.corridor ? `${group(io.evenBuy * 100, 1)}–${pct(io.evenDev)}` : 'нет'}</dd></div>
        <div><dt>Полная оплата со скидкой</dt><dd data-i="cash">{usd(io.cash)}</dd></div>
      </dl>

      <div class="disc-scale" aria-hidden="true">
        <div class="ds-track">
          <span class="ds-zone" data-i-zone style={`left:${at(io.evenBuy)};width:calc(${at(io.evenDev)} - ${at(io.evenBuy)})`}></span>
          <i class="ds-mark" data-i-disc style={`left:${at(INST_DEFAULT.disc / 100)}`}><b>ваша {pct(INST_DEFAULT.disc / 100)}</b></i>
          <span class="ds-tick ds-tick--buy" data-i-buy style={`left:${at(io.evenBuy)}`}>{pct(io.evenBuy)}</span>
          <span class="ds-tick ds-tick--dev" data-i-dev style={`left:${at(io.evenDev)}`}>{pct(io.evenDev)}</span>
        </div>
        <div class="ds-axis"><span>0%</span><span data-i-max>{group(iMax * 100)}%</span></div>
        <div class="ds-keys"><span class="k-both">Полная оплата выгодна обеим сторонам</span><span class="k-inst">Одной из сторон выгоднее рассрочка</span></div>
      </div>

      <p class="calc-sum" data-i="sum"></p>

      <div class="calc-cta">
        <a class="btn btn-primary" data-tg="inst" href={tgLink('Здравствуйте! Хочу обсудить условия рассрочки и скидки.')}>Обсудить условия</a>
        <p class="caption">{t('Ставки годовые, в расчёте делим их на 12: 12% годовых = 1% в месяц. Платежи в конце каждого месяца. Риски стройки и курса валют не учитываются.')}</p>
      </div>
    </div>
  </div>

  <!-- 2. Вилла -->
  <div class="calc-panel ui-card" id="cp-villa" role="tabpanel" aria-labelledby="ct-villa" data-cp="villa">
    <form class="calc-form" data-form="villa" onsubmit="return false">
      <p class="calc-q">{t('Сколько вилла принесёт за срок владения: аренда и продажа')}</p>
      <div class="cf-grid">
        {villaMain.map((f) => (
          <label class="cf">
            <span class="cf-l">{t(f.label)}</span>
            <span class="cf-box"><input inputmode="decimal" autocomplete="off" value={show((VILLA_DEFAULT as any)[f.k])} data-k={f.k} /><i>{f.unit}</i></span>
            {f.hint && <small>{t(f.hint)}</small>}
          </label>
        ))}
      </div>
      <details class="cf-more">
        <summary>Ещё параметры</summary>
        <div class="cf-grid">
          {villaMore.map((f) => (
            <label class="cf">
              <span class="cf-l">{t(f.label)}</span>
              <span class="cf-box"><input inputmode="decimal" autocomplete="off" value={show((VILLA_DEFAULT as any)[f.k])} data-k={f.k} /><i>{f.unit}</i></span>
              {f.hint && <small>{t(f.hint)}</small>}
            </label>
          ))}
        </div>
      </details>
    </form>

    <div class="calc-out">
      <dl class="kpis kpis--4">
        <div><dt>IRR</dt><dd data-v="irr">{pct(vo.irr)}</dd></div>
        <div><dt>NPV при <span data-v="rate">{VILLA_DEFAULT.rate}</span>%</dt><dd data-v="npv" class={vo.npv < 0 ? 'is-neg' : undefined}>{usd(vo.npv)}</dd></div>
        <div><dt>MOIC</dt><dd data-v="moic">{group(vo.moic, 2)}×</dd></div>
        <div><dt>Чистая доходность в первый год аренды</dt><dd data-v="net1">{pct(vo.net1)}</dd></div>
      </dl>
      <p class="calc-verdict" data-v="verdict"></p>

      <div class="vc-legend" aria-hidden="true">
        <span class="l-buy">Покупка</span><span class="l-net">Чистый доход от аренды</span><span class="l-sale">Продажа</span><span class="l-cum">Накопленный итог</span>
      </div>
      <div class="vc-box" data-vc-box>
        <svg class="vc" viewBox={`0 0 ${vc.W} ${vc.H}`} role="img" aria-label="Кэшфлоу инвестора по годам" data-vc set:html={vc.svg}></svg>
        <div class="vc-tip" data-vc-tip hidden></div>
      </div>

      <p class="calc-sum" data-v="sum">
        За {vo.years} лет аренда принесёт {usd(vo.rent)} чистыми, продажа {usd(vo.sale)}. Из каждых 100 долларов выручки владельцу остаётся {group(vo.netShare * 100)}.
      </p>
      <p class="calc-warn" data-v="lease" hidden></p>

      <details class="calc-table">
        <summary>Кэшфлоу по годам</summary>
        <div class="table-wrap"><table data-v="table" set:html={villaTable(vo)}></table></div>
      </details>

      <div class="calc-cta">
        <a class="btn btn-primary" data-tg="villa" href={tgLink('Здравствуйте! Посчитал доходность виллы на сайте, хочу обсудить расчёт.')}>Обсудить расчёт</a>
        <p class="caption">{t('Ориентировочный расчёт без кредита и курсовых разниц, цены покупки и продажи в USD. Модель проекта мы строим по месяцам и по вашим данным.')}</p>
      </div>
    </div>
  </div>

  <!-- 3. Дубли и ошибки -->
  <div class="calc-panel ui-card" id="cp-dup" role="tabpanel" aria-labelledby="ct-dup" data-cp="dup" hidden>
    <form class="calc-form" data-form="dup" onsubmit="return false">
      <p class="calc-q">{t('Сколько может уйти на дубли и ошибки в оплатах')}</p>
      <div class="cur" role="group" aria-label="Валюта">
        <button type="button" data-cur="IDR" aria-pressed="true">IDR</button>
        <button type="button" data-cur="USD" aria-pressed="false">USD</button>
      </div>
      <div class="cf-grid">
        {dupFields.map((f) => (
          <label class="cf">
            <span class="cf-l">{t(f.label)}</span>
            <span class="cf-box"><input inputmode="decimal" autocomplete="off" value={show((DUP_DEFAULT as any)[f.k])} data-k={f.k} /><i data-unit={f.k === 'spend' ? '' : undefined}>{f.unit}</i></span>
          </label>
        ))}
      </div>
      <p class="caption cf-note">{t('У наших клиентов дубли и ошибки, которые система остановила до оплаты, составили 3,55 млрд IDR, около 0,9% затрат.')}</p>
    </form>

    <div class="calc-out">
      <div class="dup-main">
        <p class="dup-value" data-d="total">{idr(dx.total)}</p>
        <p class="dup-text">за <span data-d="months">{dx.months}</span> мес. на дублях и ошибках, если доля как у наших клиентов: около 0,9% затрат</p>
      </div>
      <dl class="kpis kpis--2">
        <div><dt>В месяц</dt><dd data-d="month">{idr(dx.month)}</dd></div>
        <div><dt>Все расходы за срок</dt><dd data-d="volume">{idr(dx.volume)}</dd></div>
      </dl>

      <div class="calc-cta">
        <a class="btn btn-primary" data-tg="dup" href={tgLink('Здравствуйте! Интересует управленческий учёт и контроль платежей.')}>Обсудить контроль платежей</a>
        <p class="caption">Ориентир по проектам наших клиентов, а не прогноз для вашего проекта.</p>
      </div>
    </div>
  </div>

  <p class="caption calc-foot">Считает ваш браузер, цифры никуда не отправляются</p>
</div>

<script>
  import {
    villa, villaChart, villaTable, villaTip, villaAdrFor, VILLA_DEFAULT, installment, INST_DEFAULT, dupes, DUP_DEFAULT, DUP_DEFAULT_USD,
    usd, pct, group, idr, parseNum, type VillaIn, type InstIn, type DupIn, type VillaOut,
  } from '../lib/calc';
  import { tgLink } from '../data/site';

  // Допустимые пределы: если ввели лишнее, считаем по границе и не ломаем график
  const LIM: Record<string, [number, number]> = {
    price: [1000, 100000000], adr: [1, 100000], occ: [0, 100], mgmt: [0, 60], years: [1, 30], growth: [-20, 30],
    fixed: [0, 10000000], build: [0, 3], ota: [0, 40], opex: [0, 80], tax: [0, 50], adrGrowth: [-20, 30], saleCost: [0, 20],
    lease: [0, 99], rate: [0, 50], down: [0, 100], months: [1, 120], disc: [0, 50], dev: [0, 60], buy: [0, 60],
    spend: [0, 1e13],
  };
  const clamp = (k: string, v: number) => Math.min(LIM[k][1], Math.max(LIM[k][0], v));
  // Вкладки в порядке Евгения: вилла, рост стоимости, оценка, рассрочка; дубли — наш ориентир по клиентам
const TABS = [
  { id: 'villa', label: 'Доходность виллы' },
  { id: 'growth', label: 'Рост стоимости' },
  { id: 'value', label: 'Оценка виллы' },
  { id: 'inst', label: 'Рассрочка или скидка' },
  { id: 'dup', label: 'Дубли и ошибки' },
];
// Заготовки (идеи Евгения 02.11.2026). Поля и выводы взяты из его описания, расчёт пока не делаем
const STUBS = [
  {
    id: 'growth',
    q: 'Сколько будет стоить объект через 1–5 лет',
    inputs: ['Цена сегодня', 'Горизонт прогноза, 1–5 лет', 'Факторы роста', 'Факторы падения'],
    outputs: ['Прогноз цены по годам', 'Рост за весь срок', 'Рост в среднем за год'],
  },
  {
    id: 'value',
    q: 'Сколько стоит вилла: затратный и доходный методы',
    inputs: ['Земля', 'Строительство', 'Износ', 'Чистый операционный доход, NOI', 'Ставка капитализации', 'Ставка дисконтирования'],
    outputs: ['Стоимость по затратному методу', 'Стоимость по NOI', 'Стоимость по DCF'],
  },
];

const show = (v: number) => (Math.abs(v) >= 1000 ? group(v) : String(v).replace('.', ','));
  const yWord = (y: number) => (y % 10 === 1 && y % 100 !== 11 ? 'год' : [2, 3, 4].includes(y % 10) && ![12, 13, 14].includes(y % 100) ? 'года' : 'лет');

  function read<T extends Record<string, number>>(form: HTMLFormElement, base: T): T {
    const out = { ...base };
    form.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((el) => {
      const k = el.dataset.k!;
      const v = parseNum(el.value);
      if (Number.isFinite(v)) (out as any)[k] = clamp(k, v);
    });
    return out;
  }

  const root = document.querySelector<HTMLElement>('[data-calc]');
  if (root) {
    // ---------- Вкладки ----------
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-ct]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-cp]')];
    const select = (id: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.ct === id;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p.dataset.cp !== id; });
      if (id === 'villa') renderVilla();
    };
    // Ссылки из услуг («Инвестиционный анализ») открывают нужную вкладку, прокрутку делает href="#calc"
    document.querySelectorAll<HTMLElement>('[data-open-calc]').forEach((a) => {
      a.addEventListener('click', () => select(a.dataset.openCalc!));
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t.dataset.ct!));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus();
        select(next.dataset.ct!);
      });
    });

    // Поля: пересчёт на каждый ввод, красивое число при выходе из поля
    root.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((el) => {
      el.addEventListener('blur', () => {
        const v = parseNum(el.value);
        if (Number.isFinite(v)) el.value = show(clamp(el.dataset.k!, v));
      });
    });

    // ---------- 1. Вилла ----------
    const vForm = root.querySelector<HTMLFormElement>('[data-form="villa"]')!;
    const vBox = root.querySelector<HTMLElement>('[data-vc-box]')!;
    const vSvg = root.querySelector<SVGSVGElement>('[data-vc]')!;
    const vTip = root.querySelector<HTMLElement>('[data-vc-tip]')!;
    const $v = (k: string) => root.querySelector<HTMLElement>(`[data-v="${k}"]`)!;
    let vo: VillaOut = villa(VILLA_DEFAULT);
    let vIn: VillaIn = VILLA_DEFAULT;
    let geo = villaChart(vo);

    function drawVilla() {
      const w = Math.round(vBox.clientWidth);
      if (!w) return;
      geo = villaChart(vo, w, w < 560 ? 240 : 280);
      vSvg.setAttribute('viewBox', `0 0 ${geo.W} ${geo.H}`);
      vSvg.style.height = `${geo.H}px`;
      vSvg.innerHTML = geo.svg;
      vTip.hidden = true;
    }

    function renderVilla() {
      vIn = read(vForm, VILLA_DEFAULT);
      vo = villa(vIn);
      $v('irr').textContent = Number.isFinite(vo.irr) && vo.irr > -0.89 ? pct(vo.irr) : '—';
      $v('rate').textContent = group(vIn.rate, vIn.rate % 1 ? 1 : 0);
      $v('npv').textContent = usd(vo.npv);
      $v('npv').classList.toggle('is-neg', vo.npv < 0);
      $v('moic').textContent = `${group(vo.moic, 2)}×`;
      $v('net1').textContent = pct(vo.net1);
      $v('net1').classList.toggle('is-neg', vo.net1 < 0);
      const y = vo.years;
      // Вывод: IRR против ставки, на которую ориентируется инвестор
      const okIrr = Number.isFinite(vo.irr) && vo.irr > -0.89;
      const gap = (vo.irr - vIn.rate / 100) * 100;
      const rateTxt = `${group(vIn.rate, vIn.rate % 1 ? 1 : 0)}%`;
      // Цена ночи, при которой IRR равен ставке: ориентир для переговоров и проверки допущений
      const be = gap < 2 ? villaAdrFor(vIn) : null;
      const beTxt = be === null ? '' : usd(Math.ceil(be));
      $v('verdict').textContent = gap >= 2
        ? `IRR ${pct(vo.irr)} выше вашей ставки ${rateTxt} с запасом.`
        : gap >= 0
          ? `IRR ${pct(vo.irr)} выше вашей ставки ${rateTxt}, но запас небольшой${be !== null ? `: при цене ночи ниже ${beTxt} доходность опустится ниже ставки` : ''}.`
          : `${okIrr ? `IRR ${pct(vo.irr)} ниже вашей ставки ${rateTxt}.` : 'Вложенные деньги не возвращаются.'}`
            + (be !== null ? ` Чтобы выйти на ставку при той же загрузке, нужна цена ночи от ${beTxt}.` : '');
      $v('sum').textContent = `За ${y} ${yWord(y)} аренда принесёт ${usd(vo.rent)} чистыми, продажа ${usd(vo.sale)}.`
        + (vo.netShare > 0 ? ` Из каждых 100 долларов выручки владельцу остаётся ${group(vo.netShare * 100)}.` : '');
      const warn = $v('lease');
      warn.hidden = !(vIn.lease > 0);
      warn.textContent = vo.leaseEnd
        ? `Лизхолд ${group(vIn.lease)} ${yWord(vIn.lease)} заканчивается${vo.leaseCut ? ' раньше конца срока владения' : ' к концу срока владения'}: продавать нечего, считаем только аренду за ${y} ${yWord(y)}.`
        : vIn.lease > 0
          ? `Лизхолд: к продаже остаётся ${group(vIn.lease - y)} ${yWord(vIn.lease - y)} из ${group(vIn.lease)}, цена продажи снижена пропорционально.`
          : '';
      root.querySelector('[data-v="table"]')!.innerHTML = villaTable(vo);
      const a = root.querySelector<HTMLAnchorElement>('[data-tg="villa"]')!;
      a.href = tgLink(`Здравствуйте! Посчитал виллу на сайте: цена ${usd(vIn.price)}, ночь ${usd(vIn.adr)}, загрузка ${group(vIn.occ)}%, УК ${group(vIn.mgmt)}%, постоянные расходы ${usd(vIn.fixed)} в год, ${y} ${yWord(y)}${vIn.lease > 0 ? `, лизхолд ${group(vIn.lease)} ${yWord(vIn.lease)}` : ''}. IRR ${$v('irr').textContent}, NPV ${usd(vo.npv)}. Хочу обсудить расчёт.`);
      drawVilla();
    }

    vForm.addEventListener('input', renderVilla);
    new ResizeObserver(() => drawVilla()).observe(vBox);

    // Подсказка по году: зона наведения шире столбика, подсказка у верхнего края графика
    const tipAt = (i: number) => {
      const r = vo.rows[i];
      if (!r) return;
      vTip.innerHTML = villaTip(r);
      vTip.hidden = false;
      const x = geo.x[i];
      const left = Math.min(Math.max(x, 90), geo.W - 90);
      vTip.style.left = `${left}px`;
      vSvg.querySelectorAll('.vc-hit').forEach((h, k) => h.classList.toggle('is-on', k === i));
    };
    vSvg.addEventListener('pointermove', (e) => {
      const t = (e.target as Element).closest('[data-vc-i]');
      if (t) tipAt(Number(t.getAttribute('data-vc-i')));
    });
    vSvg.addEventListener('pointerleave', () => {
      vTip.hidden = true;
      vSvg.querySelectorAll('.vc-hit.is-on').forEach((h) => h.classList.remove('is-on'));
    });

    // ---------- 2. Рассрочка ----------
    const iForm = root.querySelector<HTMLFormElement>('[data-form="inst"]')!;
    const $i = (k: string) => root.querySelector<HTMLElement>(`[data-i="${k}"]`)!;
    function renderInst() {
      const v: InstIn = read(iForm, INST_DEFAULT);
      const o = installment(v);
      const d = v.disc / 100;
      $i('pay').textContent = usd(o.pay);
      $i('range').textContent = o.corridor ? `${group(o.evenBuy * 100, 1)}–${pct(o.evenDev)}` : 'нет';
      $i('cash').textContent = usd(o.cash);
      // Шкала: коридор между скидками, равными рассрочке для покупателя и для девелопера
      const max = Math.max(0.1, Math.ceil((Math.max(o.evenDev, o.evenBuy, d) * 100 + 1) / 5) * 0.05);
      const at = (x: number) => `${((Math.max(0, x) / max) * 100).toFixed(2)}%`;
      root.querySelector<HTMLElement>('[data-i-max]')!.textContent = `${group(max * 100)}%`;
      const zone = root.querySelector<HTMLElement>('[data-i-zone]')!;
      zone.style.left = at(o.evenBuy);
      zone.style.width = o.corridor ? `calc(${at(o.evenDev)} - ${at(o.evenBuy)})` : '0';
      const ds = root.querySelector<HTMLElement>('[data-i-disc]')!;
      ds.style.left = at(d);
      ds.querySelector('b')!.textContent = `ваша ${pct(d)}`;
      const tb = root.querySelector<HTMLElement>('[data-i-buy]')!;
      const td = root.querySelector<HTMLElement>('[data-i-dev]')!;
      tb.style.left = at(o.evenBuy);
      td.style.left = at(o.evenDev);
      tb.textContent = pct(o.evenBuy);
      td.textContent = pct(o.evenDev);
      // Если ставка покупателя выше ставки девелопера, метки меняются местами
      tb.classList.toggle('is-right', !o.corridor);
      td.classList.toggle('is-left', !o.corridor);
      $i('sum').textContent = !o.corridor
        ? `Коридора нет: деньги покупателя стоят дороже, чем деньги девелопера. Любая скидка, выгодная покупателю, девелоперу невыгодна, обеим сторонам выгоднее рассрочка.`
        : d < o.evenBuy
          ? `Скидка ${pct(d)} меньше ${pct(o.evenBuy)}: покупателю выгоднее рассрочка, его деньги и так приносят ${group(v.buy)}% годовых. Полную оплату он выберет при скидке от ${pct(o.evenBuy)}.`
          : d > o.evenDev
            ? `Скидка ${pct(d)} больше ${pct(o.evenDev)}: девелопер отдаёт больше, чем для него стоят эти деньги. Ему выгоднее рассрочка или скидка до ${pct(o.evenDev)}.`
            : `Скидка ${pct(d)} в коридоре от ${pct(o.evenBuy)} до ${pct(o.evenDev)}: полная оплата выгодна обеим сторонам. В сегодняшних деньгах девелопер выигрывает ${usd(o.gainDev)}, покупатель ${usd(o.gainBuy)}.`;
      root.querySelector<HTMLAnchorElement>('[data-tg="inst"]')!.href = tgLink(
        `Здравствуйте! Считаю рассрочку: цена ${usd(v.price)}, взнос ${group(v.down)}%, ${o.months} мес., ставка девелопера ${group(v.dev)}%, покупателя ${group(v.buy)}%. Скидка ${pct(d)}, коридор ${o.corridor ? `${pct(o.evenBuy)}–${pct(o.evenDev)}` : 'нет'}. Хочу обсудить условия.`,
      );
    }
    iForm.addEventListener('input', renderInst);
    renderInst();

    // ---------- 3. Дубли ----------
    const dForm = root.querySelector<HTMLFormElement>('[data-form="dup"]')!;
    const $d = (k: string) => root.querySelector<HTMLElement>(`[data-d="${k}"]`)!;
    // Валюта: рупии по умолчанию (доказательства на сайте в IDR), доллары по кнопке
    let cur: 'IDR' | 'USD' = 'IDR';
    const spendEl = dForm.querySelector<HTMLInputElement>('[data-k="spend"]')!;
    const unitEl = dForm.querySelector<HTMLElement>('[data-unit]')!;
    const money = (v: number) => (cur === 'IDR' ? idr(v) : usd(v));
    dForm.querySelectorAll<HTMLButtonElement>('[data-cur]').forEach((b) => b.addEventListener('click', () => {
      const next = b.dataset.cur as 'IDR' | 'USD';
      if (next === cur) return;
      cur = next;
      dForm.querySelectorAll<HTMLButtonElement>('[data-cur]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      unitEl.textContent = cur;
      spendEl.value = show((cur === 'IDR' ? DUP_DEFAULT : DUP_DEFAULT_USD).spend);
      renderDup();
    }));
    function renderDup() {
      const v: DupIn = read(dForm, cur === 'IDR' ? DUP_DEFAULT : DUP_DEFAULT_USD);
      const o = dupes(v);
      $d('total').textContent = money(o.total);
      $d('months').textContent = String(o.months);
      $d('month').textContent = money(o.month);
      $d('volume').textContent = money(o.volume);
      root.querySelector<HTMLAnchorElement>('[data-tg="dup"]')!.href = tgLink(
        `Здравствуйте! Расходы проекта около ${money(v.spend)} в месяц, стройка ${o.months} мес. Интересует контроль платежей.`,
      );
    }
    dForm.addEventListener('input', renderDup);
    renderDup();

    renderVilla();
  }
</script>

<style>
  .calc { display: grid; gap: var(--s2); }
  /* Заголовок слева, вкладки справа в одну строку; на узком экране вкладки под заголовком и прокручиваются */
  .calc-head { display: grid; gap: var(--s3); margin-bottom: var(--s4); }
  @media (min-width: 1200px) { .calc-head { grid-template-columns: auto minmax(0, 1fr); align-items: end; column-gap: var(--s5); } .calc-tabs { justify-content: flex-end; } }
  .calc-tabs { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; margin: 0 -16px; padding: 0 16px; }
  .calc-tabs::-webkit-scrollbar { display: none; }
