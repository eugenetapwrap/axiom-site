  .ds-tick { position: absolute; top: 100%; padding-top: 6px; font-size: 12.5px; color: var(--ink-2); white-space: nowrap; font-variant-numeric: tabular-nums; transition: left .3s ease; }
  .ds-tick--buy { transform: translateX(calc(-100% - 2px)); }
  .ds-tick--dev { transform: translateX(2px); }
  .ds-tick--buy.is-right { transform: translateX(2px); }
  .ds-tick--dev.is-left { transform: translateX(calc(-100% - 2px)); }
  .ds-axis { display: flex; justify-content: space-between; font-size: 12px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .ds-keys { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 13px; color: var(--ink-2); }
  .ds-keys span { display: inline-flex; align-items: center; gap: 6px; }
  .ds-keys span::before { content: ''; width: 10px; height: 10px; border-radius: 2px; }
  .ds-keys .k-both::before { background: var(--accent-2); }
  .ds-keys .k-inst::before { background: var(--track); border: 1px solid var(--line); }

  /* Переключатель валюты */

