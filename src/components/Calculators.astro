  .cur { display: inline-flex; margin-bottom: var(--s2); border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .cur button { padding: 6px 14px; border: 0; background: transparent; color: var(--ink-2); font: inherit; font-size: 14px; font-weight: 600; cursor: pointer; }
  .cur button + button { border-left: 1px solid var(--line); }
  .cur button[aria-pressed='true'] { background: var(--ink); color: var(--surface); }

  /* Дубли */
  .dup-main { display: grid; gap: 6px; }
  .dup-value { font-family: var(--font-display); font-size: clamp(44px, 6vw, 72px); font-weight: 500; line-height: 1; letter-spacing: -0.04em; color: var(--ink); font-variant-numeric: tabular-nums; }
  .dup-text { font-size: 17px; color: var(--ink-2); max-width: 30em; }
</style>
