  .vc :global(.vc-zero) { stroke: var(--ink-3); }
  .vc :global(.vc-ylab), .vc :global(.vc-xlab) { fill: var(--ink-3); font-size: 11.5px; font-variant-numeric: tabular-nums; }
  .vc :global(.vc-buy) { fill: var(--c-neg-soft); }
  .vc :global(.vc-net) { fill: var(--accent-2); }
  .vc :global(.vc-sale) { fill: var(--th-3); }
  .vc :global(.vc-cum) { fill: none; stroke: var(--ink); stroke-width: 2; stroke-linejoin: round; }
  .vc :global(.vc-dot) { fill: var(--surface); stroke: var(--ink); stroke-width: 1.5; }
  .vc :global(.vc-hit) { fill: transparent; cursor: crosshair; }
  .vc :global(.vc-hit.is-on) { fill: color-mix(in srgb, var(--ink) 6%, transparent); }
  .vc-tip {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    display: grid;
    grid-template-columns: auto auto;
    gap: 2px 14px;
    min-width: 170px;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    font-size: 13px;
    pointer-events: none;
  }
  .vc-tip[hidden] { display: none; }
  .vc-tip :global(b) { grid-column: 1 / -1; margin-bottom: 2px; }
  .vc-tip :global(span) { color: var(--ink-3); }
  .vc-tip :global(em) { font-style: normal; font-weight: 600; text-align: right; font-variant-numeric: tabular-nums; }

  .calc-sum { color: var(--ink-2); font-size: 16px; line-height: 1.5; max-width: 44em; }
  .calc-verdict { font-size: 17px; font-weight: 600; line-height: 1.4; color: var(--ink); max-width: 40em; font-variant-numeric: tabular-nums; }
  .calc-warn { font-size: 14px; color: var(--ink-2); padding: 8px 12px; border-left: 2px solid var(--gold-ink, var(--accent)); background: var(--bg); }
  .calc-warn[hidden] { display: none; }

  .calc-table summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 15px; }
  .table-wrap { margin-top: var(--s2); overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .table-wrap table { width: 100%; border-collapse: collapse; font-size: 13px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .table-wrap :global(th), .table-wrap :global(td) { padding: 6px 10px; text-align: right; border-bottom: 1px solid var(--line); }
  .table-wrap :global(thead th) { color: var(--ink-3); font-weight: 500; }
  .table-wrap :global(th[scope='row']) { text-align: left; font-weight: 600; }
  .table-wrap :global(td:nth-last-child(2)) { font-weight: 600; }

  .calc-cta { display: grid; gap: 10px; justify-items: start; }
