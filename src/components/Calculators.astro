  @media (min-width: 480px) { .stub-in { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px 16px; } }
  .stub-in li { display: grid; gap: 6px; align-content: end; font-size: 14px; color: var(--ink-2); }
  .stub-in i { display: block; height: 44px; border: 1px dashed var(--line); border-radius: 6px; background: var(--bg); }
  .stub--out { padding: var(--s3); border-radius: 8px; background: var(--bg); }
  .stub-out li { display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
  .stub-out b { color: var(--ink-3); font-weight: 600; }
  .calc-tabs button {
    padding: 10px 16px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-size: 15px;
    font-weight: 500;
    white-space: nowrap;
    flex: none;
    cursor: pointer;
  }
  .calc-tabs button:hover { color: var(--ink); border-color: var(--ink-3); }
  .calc-tabs button[aria-selected='true'] { background: var(--ink); border-color: var(--ink); color: var(--surface); }

  .calc-panel { display: grid; gap: var(--s4); padding: var(--s4); }
  .calc-panel[hidden] { display: none; }
  @media (min-width: 1024px) {
    .calc-panel { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: var(--s5); align-items: start; }
  }
  @media (max-width: 600px) { .calc-panel { padding: var(--s3) 18px; } }
  .calc-q { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.25; letter-spacing: -0.02em; margin-bottom: var(--s3); }

  /* Поля */
  .cf-grid { display: grid; gap: 14px 16px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 340px) { .cf-grid { grid-template-columns: 1fr; } }
  .cf { display: grid; gap: 4px; align-content: start; }
  .cf-l { font-size: 14px; color: var(--ink-2); line-height: 1.3; }
  .cf-box { display: flex; align-items: center; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); transition: border-color .15s ease; }
  .cf-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .cf-box input { flex: 1; min-width: 0; width: 100%; padding: 10px 0 10px 12px; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 17px; font-weight: 600; font-variant-numeric: tabular-nums; outline: none; }
  .cf-box i { padding: 0 12px 0 6px; font-style: normal; font-size: 13px; color: var(--ink-3); white-space: nowrap; }
  .cf small { font-size: 12.5px; color: var(--ink-3); line-height: 1.3; }
  .cf-more { margin-top: var(--s3); }
  .cf-more summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 15px; margin-bottom: 14px; }
  .cf-note { margin-top: var(--s3); }

