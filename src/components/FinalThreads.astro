---
// Фон финального блока: те же фирменные нити, что на первом экране, только тоньше и приглушённее.
// Проекты слева сходятся в узел за кнопками, справа расходятся статьи разной длины.
// Ширина нитей и длины — из тех же июньских демо-данных (src/lib/sankey.ts), чтобы мотив был одним.
import { LINKS, SERIES } from '../lib/sankey';

const values = SERIES[5];
const projects = LINKS.map((l, i) => ({ to: l.to, v: values[i] }))
  .filter((l) => l.to === 'cash').map((l) => l.v).sort((a, b) => b - a);
const costs = LINKS.map((l, i) => ({ to: l.to, v: values[i] }))
  .filter((l) => /^c\d+$/.test(l.to)).map((l) => l.v).sort((a, b) => b - a);

const PAL = ['#7fd1b9', '#5fb8a6', '#8fb3e8', '#b3a6ea', '#e3a6c3', '#f0b29b', '#eac77e', '#c3d18c'];
const K = 3.5;
const KX = 720;
const KY = 300;
const total = projects.reduce((s, v) => s + v, 0);
const top = KY - (total * K) / 2;
const f = (n: number) => n.toFixed(1);

let acc = top;
const left = projects.map((v, i) => {
  const h = v * K;
  const y = 70 + i * 62;
  const xs = 520 - (v / projects[0]) * 480;
  const yb = acc + h / 2;
  acc += h;
  return { h, color: PAL[i], d: `M${f(xs)},${y} L520,${y} C620,${y} 620,${f(yb)} ${KX},${f(yb)}`, delay: i * 50 };
});
acc = top;
const right = costs.map((v, i) => {
  const h = Math.max(v * K, 1);
  const y = 30 + i * 52;
  const xe = 920 + (v / costs[0]) * 480;
  const ya = acc + v * K / 2;
  acc += v * K;
  return { h, color: PAL[i], d: `M${KX + 2},${f(ya)} C820,${f(ya)} 820,${y} 920,${y} L${f(xe)},${y}`, delay: 900 + i * 60 };
});
---

<svg class="ft" viewBox="0 0 1440 420" preserveAspectRatio="xMidYMid slice" aria-hidden="true" data-ft>
  {left.map((t) => <path d={t.d} pathLength="1" stroke={t.color} stroke-width={f(t.h)} style={`--d:${t.delay}ms`} class="ft-in"></path>)}
  {right.map((t) => <path d={t.d} pathLength="1" stroke={t.color} stroke-width={f(t.h)} style={`--d:${t.delay}ms`} class="ft-out"></path>)}
  <rect class="ft-knot" x={KX - 1} y={f(top - 8)} width="3" height={f(total * K + 16)} rx="1.5"></rect>
</svg>

<script>
  // Нити прорисовываются, когда блок доходит до экрана. Без JS и при reduced motion они просто видны.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    document.querySelectorAll<SVGSVGElement>('[data-ft]').forEach((svg) => {
      svg.classList.add('is-armed');
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        svg.classList.add('is-play');
      }, { threshold: 0.35 });
      io.observe(svg);
    });
  }
</script>

<style>
  .ft { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  .ft path { fill: none; stroke-opacity: .3; stroke-dasharray: 1 1; stroke-dashoffset: 0; }
  .ft-knot { fill: var(--gold-on-deep); opacity: .7; }
  .ft.is-armed path { stroke-dashoffset: 1; }
  .ft.is-armed .ft-knot { opacity: 0; }
  .ft.is-play .ft-in { animation: ft-draw 900ms cubic-bezier(.7, 0, .84, 0) var(--d) both; }
  .ft.is-play .ft-out { animation: ft-draw 1300ms cubic-bezier(.16, 1, .3, 1) var(--d) both; }
  .ft.is-play .ft-knot { animation: ft-knot 600ms ease 850ms both; }
  @keyframes ft-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes ft-knot { from { opacity: 0; } to { opacity: .7; } }
</style>
