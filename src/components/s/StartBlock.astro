---
// Как начать, вопросы и заявка — финальная часть страницы.
import { t } from '../../lib/typo';
import { steps, faq, request } from '../../content/site';
import LeadForm from '../LeadForm.astro';
---

<section class="section" id="start" aria-labelledby="start-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{steps.eyebrow}</p>
      <h2 id="start-title" class="h2">{steps.title}</h2>
    </div>
    <ol class="steps">
      {
        steps.items.map((s, i) => (
          <li>
            <span class="mono">{i + 1}</span>
            <p class="steps__title">{s.title}</p>
            <p class="steps__text">{t(s.text)}</p>
          </li>
        ))
      }
    </ol>
    <ul class="terms">
      {steps.terms.map((x) => <li class:list={{ tbd: x.tbd }}>{t(x.text)}</li>)}
    </ul>
  </div>
</section>

<section class="section section--soft" id="faq" aria-labelledby="faq-title">
  <div class="container faq">
    <div>
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 id="faq-title" class="h2">{faq.title}</h2>
    </div>
    <div class="faq__list">
      {
        faq.items.map((item) => (
          <details class:list={{ tbd: item.tbd }}>
            <summary>{t(item.q)}</summary>
            <p>{t(item.a)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<section class="section" id="request" aria-labelledby="request-title">
  <div class="container req">
    <div class="req__intro">
      <p class="eyebrow">{request.eyebrow}</p>
      <h2 id="request-title" class="h2">{request.title}</h2>
      <p class="lead">{t(request.lead)}</p>
      <dl class="contacts">
        {
          request.contacts.map((c) => (
            <div class:list={{ tbd: c.tbd }}>
              <dt>{c.label}</dt>
              <dd>
                <a href={c.href}>{c.value}</a>
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="req__form">
      <LeadForm
        taskLabel={request.taskLabel}
        tasks={request.tasks}
        submit={request.submit}
        privacy={request.privacy}
        demoNote={request.demoNote}
      />
    </div>
  </div>
</section>

<style>
  .steps {
    list-style: none;
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 720px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .steps li {
    display: grid;
    gap: 4px;
    padding-top: var(--s-3);
    border-top: 2px solid var(--c-ink);
  }
  .steps .mono {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .steps__title {
    font-weight: 600;
    font-size: var(--fs-lg);
  }
  .steps__text {
    font-size: var(--fs-sm);
    color: var(--c-ink-2);
  }
  .terms {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }
  .terms li {
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--c-bg-soft);
    font-size: var(--fs-sm);
  }
  .faq {
    display: grid;
    gap: var(--s-5);
  }
  @media (min-width: 1040px) {
    .faq {
      grid-template-columns: 1fr 2fr;
      gap: var(--s-8);
    }
  }
  .faq__list {
    border-top: 1px solid var(--c-line);
  }
  details {
    border-bottom: 1px solid var(--c-line);
  }
  summary {
    position: relative;
    display: block;
    padding: var(--s-4) var(--s-7) var(--s-4) 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    position: absolute;
    right: var(--s-2);
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--f-mono);
    font-size: 20px;
    font-weight: 400;
    color: var(--c-muted);
  }
  details[open] summary::after {
    content: '−';
  }
  details p {
    padding: 0 var(--s-7) var(--s-4) 0;
    color: var(--c-ink-2);
    max-width: 64ch;
  }
  .req {
    display: grid;
    gap: var(--s-6);
  }
  @media (min-width: 1040px) {
    .req {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--s-8);
    }
  }
  .req__intro {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .contacts {
    display: grid;
    gap: var(--s-2);
    margin: var(--s-3) 0 0;
  }
  .contacts div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-3);
  }
  .contacts dt {
    color: var(--c-muted);
  }
  .contacts dd {
    margin: 0;
  }
  .req__form {
    padding: clamp(20px, 3vw, 36px);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
  }
</style>
