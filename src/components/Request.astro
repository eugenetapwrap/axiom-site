---
import { t } from '../lib/typo';
import { request } from '../content/ru';
import LeadForm from './LeadForm.astro';
---

<section class="section" id="request" aria-labelledby="request-title">
  <div class="container req">
    <div class="req__intro">
      <p class="eyebrow">{request.eyebrow}</p>
      <h2 id="request-title" class="h2">{t(request.title)}</h2>
      <p class="lead">{t(request.lead)}</p>
      <dl class="contacts">
        {
          request.contacts.map((c) => (
            <div class:list={{ tbd: c.tbd }}>
              <dt>{c.label}</dt>
              <dd><a href={c.href}>{c.value}</a></dd>
            </div>
          ))
        }
      </dl>
    </div>
    <div class="req__form">
      <LeadForm
        roleLabel={request.roleLabel}
        roles={request.roles}
        taskLabel={request.taskLabel}
        tasks={request.tasks}
        submit={request.submit}
        privacy={request.privacy}
        demoNote={request.demoNote}
      />
    </div>
  </div>
</section>

<style>
  .req {
    display: grid;
    gap: var(--s-7);
  }
  @media (min-width: 1040px) {
    .req {
      grid-template-columns: 1fr 1.2fr;
      gap: var(--s-8);
    }
  }
  .req__intro {
    display: grid;
    gap: var(--s-4);
    align-content: start;
  }
  .contacts {
    display: grid;
    gap: var(--s-3);
    margin: var(--s-4) 0 0;
  }
  .contacts div {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: var(--s-3);
  }
  .contacts dt {
    color: var(--c-muted);
  }
  .contacts dd {
    margin: 0;
  }
  .req__form {
    padding: clamp(20px, 3vw, 40px);
    background: var(--c-bg-soft);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
  }
</style>
