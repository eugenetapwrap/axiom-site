---
import { t } from '../lib/typo';
import { questions } from '../content/ru';
---

<section class="section section--soft" id="questions" aria-labelledby="questions-title">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{questions.eyebrow}</p>
      <h2 id="questions-title" class="h2">{t(questions.title)}</h2>
      <p class="lead">{t(questions.lead)}</p>
    </div>

    <nav class="jump" aria-label="Этапы проекта">
      {questions.groups.map((g, i) => (
        <a href={`#q-${g.id}`}><span class="mono">0{i + 1}</span> {g.title}</a>
      ))}
    </nav>

    <div class="groups">
      {
        questions.groups.map((g, i) => (
          <section class="group" id={`q-${g.id}`} aria-labelledby={`q-${g.id}-title`}>
            <header class="group__head">
              <span class="group__num mono">0{i + 1}</span>
              <h3 id={`q-${g.id}-title`} class="group__title">{g.title}</h3>
              <p class="group__who">{t(g.who)}</p>
            </header>
            <ul class="qs">
              {g.items.map((item) => (
                <li class="q">
                  <p class="q__q">{t(item.q)}</p>
                  <p class="q__a">{t(item.a)}</p>
                  <a class="q__link" href={item.href}>{item.service} →</a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-bottom: var(--s-6);
  }
  .jump a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-height: 40px;
    padding: 0 var(--s-4);
    border: 1px solid var(--c-line-strong);
    border-radius: 999px;
    background: var(--c-surface);
    color: var(--c-ink);
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 500;
  }
  .jump a:hover {
    border-color: var(--c-ink);
  }
  .jump .mono {
    font-size: 12px;
    color: var(--c-muted);
  }
  .groups {
    display: grid;
    gap: var(--s-4);
  }
  .group {
    display: grid;
    gap: var(--s-5);
    padding: var(--s-5);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    scroll-margin-top: 88px;
  }
  @media (min-width: 960px) {
    .group {
      grid-template-columns: 240px 1fr;
      gap: var(--s-6);
      padding: var(--s-6);
    }
  }
  .group__head {
    display: grid;
    gap: var(--s-1);
    align-content: start;
  }
  .group__num {
    font-size: var(--fs-xs);
    color: var(--c-muted);
  }
  .group__title {
    font-size: var(--fs-xl);
  }
  .group__who {
    color: var(--c-muted);
    font-size: var(--fs-sm);
  }
  .qs {
    list-style: none;
    display: grid;
    gap: var(--s-5) var(--s-6);
  }
  @media (min-width: 720px) {
    .qs {
      grid-template-columns: 1fr 1fr;
    }
  }
  .q {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-top: var(--s-4);
    border-top: 1px solid var(--c-line);
  }
  .q__q {
    font-weight: 600;
    font-size: var(--fs-md);
    line-height: 1.35;
  }
  .q__a {
    color: var(--c-ink-2);
    font-size: var(--fs-sm);
  }
  .q__link {
    justify-self: start;
    font-size: var(--fs-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .q__link:hover {
    text-decoration: underline;
  }
</style>
