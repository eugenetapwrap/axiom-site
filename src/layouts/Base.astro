---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { lang, isEn, tr } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  jsonLd?: object[];
}

const en = isEn();
const descEn = 'Financial consulting for real estate development and construction: financial models, model audit, management accounting and payment control. Southeast Asia and the CIS.';
const { title, description = en ? descEn : site.description, jsonLd = [] } = Astro.props;
// Обе языковые версии главной ссылаются друг на друга (ветка intl)
const alt = { ru: new URL('/', Astro.site), en: new URL('/en/', Astro.site) };
const canonical = new URL(Astro.url.pathname, Astro.site);

const org = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  legalName: site.legalName,
  url: Astro.site?.toString(),
  description: en ? descEn : site.description,
  email: site.email,
  areaServed: ['Indonesia', 'Thailand', 'United Arab Emirates', 'Uzbekistan', 'Southeast Asia', 'CIS'],
  address: { '@type': 'PostalAddress', addressRegion: 'Bali', addressCountry: 'ID' },
  sameAs: [site.telegramUrl],
};
---

<!doctype html>
<html lang={lang()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={alt.ru} />
    <link rel="alternate" hreflang="en" href={alt.en} />
    <link rel="alternate" hreflang="x-default" href={alt.en} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={en ? 'en_US' : 'ru_RU'} />
    <meta name="theme-color" content="#f5f3ec" />
    <script is:inline>
      // Палитра для сравнения ставится до отрисовки, чтобы не мигали цвета (?palette=clay тоже работает)
      try {
        var q = new URLSearchParams(location.search).get('palette');
        var p = q || localStorage.getItem('axiom-palette');
        if (q) localStorage.setItem('axiom-palette', q);
        if (p && p !== 'forest') document.documentElement.dataset.palette = p;
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600&family=Inter:wght@400;500;600&display=swap"
    />
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    {jsonLd.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="visually-hidden" href="#main">{tr('Перейти к содержанию')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Плавное появление блоков при прокрутке. При reduced-motion ничего не делаем.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if (!reduce && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
        els.forEach((el) => {
          if (el.getBoundingClientRect().top > window.innerHeight) {
            el.classList.add('reveal');
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
