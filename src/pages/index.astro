---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Situations from '../components/Situations.astro';
import Services from '../components/Services.astro';
import Results from '../components/Results.astro';
import Process from '../components/Process.astro';
import Team from '../components/Team.astro';
import Faq from '../components/Faq.astro';
import Request from '../components/Request.astro';
import Footer from '../components/Footer.astro';
import { meta, brand, nav, headerCta } from '../content/ru';
---

<Base title={meta.title} description={meta.description}>
  <Header nav={nav} cta={headerCta} brand={brand} />
  <main id="main">
    <Hero />
    <Situations />
    <Services />
    <Results />
    <Process />
    <Team />
    <Faq />
    <Request />
  </main>
  <Footer />
  <script is:inline>
    // Режим ревью: ?review или #review подсвечивает факты, которые ждут подтверждения.
    if (new URLSearchParams(location.search).has('review') || location.hash === '#review') document.documentElement.classList.add('review');
  </script>
</Base>
