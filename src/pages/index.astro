---
import Base from '../layouts/Base.astro';
import SankeyFlow from '../components/SankeyFlow.astro';
import { site } from '../data/site';
import {
  hero, practices, geography, flow, stats, cases, team, bot, faq, finalCta,
} from '../data/home';
import { t } from '../lib/typo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const titleWords = hero.title.split(' ');
const titleAccent = titleWords.slice(0, hero.accent).join(' ');
const titleRest = titleWords.slice(hero.accent).join(' ');

const serviceIcons: Record<string, string> = {
  models: 'M2 13.5h12M3.5 11l3-3.5 2.5 2 4-5',
  audit: 'M11.2 11.2 14 14M7 11.5a4.5 4.5 0 1 1 0-9 4.5 4.5 0 0 1 0 9Z',
  accounting: 'M2 4.5h12v8H2zM2 7.5h12M5 10.5h3',
  advisory: 'M3 13V8M6.3 13V5M9.7 13V9.5M13 13V3',
};
---

<Base title="Axiom — финансовый консалтинг для девелопмента и строительства" jsonLd={[faqLd]}>
  <!-- Первый экран: кто мы, для кого и четыре услуги -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1><span class="h1-accent">{titleAccent}</span> {t(titleRest)}</h1>
      <p class="hero-lead">{t(hero.lead)}</p>
      <div class="btn-row hero-btns">
        <a class="btn btn-primary" href={site.telegramUrl}>Обсудить проект</a>
        <a class="btn btn-secondary" href="#practices">Все направления</a>
      </div>

      <ul class="services">
        {practices.map((p) => (
          <li>
            <a class="service ui-card" href={`#${p.id}`}>
              <span class="service-top">
                <span class="service-num">{p.num}</span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d={serviceIcons[p.id]} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
              <span class="service-title">{t(p.title)}</span>
              <span class="service-lead">{t(p.lead)}</span>
              <span class="service-more">Подробнее</span>
            </a>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- Направления: четыре карточки со списками -->
  <section class="section section--alt" id="practices">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Направления</p>
        <h2>Что входит в каждое направление</h2>
      </div>
      <div class="pgrid">
        {practices.map((p, i) => (
          <article class="pcard ui-card" id={p.id} data-reveal style={`--d: ${(i % 2) * 100}ms`}>
            <p class="pcard-num">{p.num}</p>
            <h3>{t(p.title)}</h3>
            <p class="pcard-lead">{t(p.lead)}</p>
            <ul class="dots">
              {p.items.map((it) => <li>{t(it)}</li>)}
            </ul>
            <a class="btn btn-soft" href={site.telegramUrl}>{p.cta}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Ключевые цифры -->
  <section class="section section--dark" aria-labelledby="stats-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Результаты</p>
        <h2 id="stats-title">Axiom в цифрах</h2>
      </div>
      <dl class="stats" data-reveal>
        {stats.map((s) => (
          <div class="stat">
            <dt><span class="stat-value" data-count={s.value}>{s.value}</span> <span class="stat-unit">{s.unit}</span></dt>
            <dd>{t(s.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Движение денег -->
  <section class="section section--white" id="accounting-system">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Система учёта</p>
        <h2>{t(flow.title)}</h2>
        <p>{t(flow.lead)}</p>
      </div>
      <div data-reveal><SankeyFlow /></div>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Кейсы</p>
          <h2>Задачи, которые мы решали</h2>
        </div>
        <p class="caption">Клиентов и проекты не называем</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card">
                  <p><span>Заявка № 63</span><b>1 080 000 IDR</b></p>
                  <p class="cv-dup"><span>Заявка № 75</span><b>1 080 000 IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>9,0%</b><span>→</span><b class="cv-risk">8,2%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда -->
  <section class="section section--white" id="team">
    <div class="container team">
      <div data-reveal>
        <p class="eyebrow">{team.title}</p>
        <h2>Кто работает над проектом</h2>
        <p class="muted team-lead">{t(team.lead)}</p>
        <p class="founder">{t(team.founder)}</p>
        <dl class="geo">
          {geography.regions.map((r) => (
            <div><dt>{r.title}</dt><dd>{r.countries}</dd></div>
          ))}
        </dl>
      </div>
      <dl class="roles" data-reveal style="--d: 120ms">
        {team.roles.map((r) => (
          <div class="ui-card">
            <dt>{r.title}</dt>
            <dd>{t(r.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Продукт: бот, одной полосой -->
  <section class="bot-strip" id="bot">
    <div class="container bot-row" data-reveal>
      <div>
        <p class="eyebrow">Продукт · {bot.badge}</p>
        <h2 class="bot-title">{bot.title}</h2>
        <p class="muted">{t(bot.lead)}</p>
      </div>
      <div class="bot-side">
        <p class="tagline">{t(bot.tagline)}</p>
        <a class="btn btn-primary" href={site.botUrl}>{bot.cta}</a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container faq-wrap">
      <div data-reveal>
        <p class="eyebrow">Вопросы</p>
        <h2>Частые вопросы</h2>
        <p class="muted faq-more">Не нашли ответ? <a href={site.telegramUrl}>Напишите в Telegram</a></p>
      </div>
      <div class="faq" data-reveal style="--d: 120ms">
        {faq.map((f) => (
          <details class="ui-card">
            <summary>{t(f.q)}</summary>
            <p class="muted">{t(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Финальный блок -->
  <section class="section section--dark final" id="contact">
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">Контакты</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl}>Написать в Telegram @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Счётчики в полосе цифр: от нуля до значения, один раз
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const final = el.dataset.count!;
        const m = final.match(/^([\d\s ]+)(?:,(\d+))?(.*)$/);
        if (!m) return;
        const whole = Number(m[1].replace(/[\s ]/g, ''));
        const dec = m[2] ?? '';
        const target = Number(`${whole}.${dec || 0}`);
        const tail = m[3];
        const t0 = performance.now();
        const dur = 1400;
        const fmt = (v: number) => {
          const [a, b] = v.toFixed(dec.length).split('.');
          const grouped = a.length > 4 ? a.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : a;
          return b ? `${grouped},${b}` : grouped;
        };
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? fmt(target * eased) + tail : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* Первый экран */
  .hero { padding: var(--s6) 0; background-color: var(--bg); }
  .hero h1 { max-width: 17em; font-size: clamp(32px, 4.6vw, 58px); }
  .h1-accent { color: var(--accent); }
  .hero-lead { margin-top: var(--s3); max-width: 34em; color: var(--ink-2); font-size: 1.1em; }

  .services {
    list-style: none;
    padding: 0;
    margin-top: var(--s5);
    display: grid;
    gap: var(--s2);
  }
  @media (min-width: 640px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .services { grid-template-columns: repeat(4, 1fr); } }
  .services li { display: flex; }
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: var(--s3);
    color: var(--ink);
    text-decoration: none;
    transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
  }
  .service:hover { border-color: var(--accent); transform: translateY(-2px); }
  .service-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }
  .service-num { font-size: 15px; font-weight: 700; color: var(--gold-ink); }
  .service-top svg { width: 22px; height: 22px; color: var(--accent); }
  .service-title { font-size: 20px; font-weight: 700; line-height: 1.25; letter-spacing: -0.01em; }
  .service-lead { color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .service-more { margin-top: auto; padding-top: var(--s1); color: var(--accent); font-size: 15px; font-weight: 600; }
  .service-more::after { content: ' →'; }

  .hero-btns { margin-top: var(--s4); }

  /* Направления */
  .pgrid { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .pgrid { grid-template-columns: 1fr 1fr; } }
  .pcard { display: flex; flex-direction: column; padding: var(--s4); scroll-margin-top: 96px; }
  .pcard-num { font-size: 15px; font-weight: 700; color: var(--gold-ink); }
  .pcard h3 { margin-top: var(--s1); font-size: clamp(22px, 2vw, 26px); }
  .pcard-lead { margin: var(--s2) 0 var(--s3); color: var(--ink-2); font-size: 16px; }
  .pcard .dots { margin-bottom: var(--s4); font-size: 16px; }
  .pcard .btn { margin-top: auto; align-self: flex-start; }

  /* Цифры */
  .stats { display: grid; gap: var(--s4) 0; }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stat { padding: 0 var(--s3) 0 0; }
  @media (min-width: 720px) { .stat:not(:first-child) { padding-left: var(--s3); } }
  @media (min-width: 720px) and (max-width: 1023px) { .stat:nth-child(3) { padding-left: 0; } }
  .stat-value { font-size: clamp(40px, 4.4vw, 60px); font-weight: 700; letter-spacing: -0.03em; color: var(--gold-on-deep); line-height: 1; }
  .stat-unit { display: block; margin-top: var(--s1); font-size: 18px; font-weight: 600; color: var(--on-deep); }
  .stat dd { margin-top: 6px; color: var(--on-deep-2); font-size: 15px; max-width: 18em; }

  /* Кейсы */
  .cases { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; padding: 8px; }
  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 48px var(--s3) var(--s3);
    border-radius: 6px;
    background: var(--deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .case-tag { position: absolute; top: 14px; left: 16px; color: var(--gold-on-deep); font-size: 13px; font-weight: 600; }
  .cv-card { width: 100%; max-width: 280px; padding: 12px 14px; border-radius: 8px; background: var(--surface); font-size: 13px; display: grid; gap: 8px; }
  .cv-card p { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: none; }
  .cv-card span { color: var(--ink-3); }
  .cv-dup { padding: 4px 6px; margin: 0 -6px; border-radius: 6px; background: var(--risk-soft); }
  .cv-dup em { font-style: normal; font-weight: 700; color: var(--risk); }
  .cv-bars p { display: grid; grid-template-columns: 52px 1fr; }
  .cv-bars i { display: block; height: 10px; width: var(--w); border-radius: 5px; background: var(--accent-2); }
  .cv-over i { background: var(--risk); }
  .cv-irr { display: flex; align-items: baseline; justify-content: center; gap: 10px; font-size: 15px; }
  .cv-irr b { font-size: 30px; letter-spacing: -0.02em; }
  .cv-risk { color: var(--risk); }
  .case-body { padding: var(--s3) var(--s2) var(--s2); }
  .case-body h3 { font-size: 21px; }
  .case-dl { display: grid; gap: 2px; margin-top: var(--s2); font-size: 16px; }
  .case-dl dt { color: var(--ink-3); font-size: 13px; margin-top: var(--s1); }
  .case-result { font-weight: 700; color: var(--accent); }

  /* Команда */
  .team { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .team { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .team-lead { margin-top: var(--s3); }
  .founder { margin-top: var(--s3); padding-left: var(--s3); border-left: 2px solid var(--gold); font-size: 17px; }
  .roles { display: grid; gap: var(--s2); }
  @media (min-width: 640px) { .roles { grid-template-columns: 1fr 1fr; } }
  .roles > div { padding: var(--s3); }
  .roles dt { font-weight: 700; font-size: 18px; }
  .roles dd { margin-top: 6px; color: var(--ink-2); font-size: 15px; }

  .geo { display: flex; flex-wrap: wrap; gap: var(--s2) var(--s4); margin-top: var(--s4); padding-top: var(--s3); border-top: 1px solid var(--line); }
  .geo dt { font-size: 14px; color: var(--ink-3); }
  .geo dd { margin-top: 2px; font-weight: 700; }

  /* Бот */
  .bot-strip { padding: var(--s5) 0; background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .bot-row { display: grid; gap: var(--s3); align-items: center; }
  @media (min-width: 1024px) { .bot-row { grid-template-columns: 1.4fr 1fr; column-gap: 112px; } }
  .bot-title { font-size: clamp(26px, 2.6vw, 34px); }
  .bot-row .muted { margin-top: var(--s1); max-width: 34em; }
  .bot-side { display: grid; gap: var(--s2); justify-items: start; }
  .tagline { font-weight: 700; font-size: 20px; color: var(--gold-ink); }

  /* FAQ */
  .faq-wrap { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .faq-wrap { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .faq-more { margin-top: var(--s3); }
  .faq { display: grid; gap: 10px; }
  .faq details { padding: 18px 22px; box-shadow: none; }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--gold-ink); font-weight: 600; font-size: 22px; line-height: 1; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: var(--s1); font-size: 16px; }

  /* Финальный блок */
  .final-inner { text-align: center; display: grid; justify-items: center; }
  .final-text { margin-top: var(--s3); color: var(--on-deep-2); }
  .final-list { list-style: none; padding: 0; margin: var(--s4) 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .final-list li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 16px;
  }
  .final-list b { color: var(--gold-on-deep); }
  .final-btns { justify-content: center; }
</style>
