---
import Base from '../layouts/Base.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Calculators from '../components/Calculators.astro';
import MiniJCurve from '../components/MiniJCurve.astro';
import MiniThreads from '../components/MiniThreads.astro';
import MiniRegister from '../components/MiniRegister.astro';
import FinalThreads from '../components/FinalThreads.astro';
import { site, tgLink } from '../data/site';
import {
  hero, practices, results, cases, team, faq, finalCta,
} from '../data/home';
import { t } from '../lib/typo';
import { villa, VILLA_DEFAULT, installment, INST_DEFAULT, usd, pct, group } from '../lib/calc';

// Калькуляторы для инвестанализа: что вводят, что получают и пример расчёта на значениях калькулятора по умолчанию.
// «Рост стоимости» и «Оценку виллы» Евгений убрал 02.11.2026
// На телефоне в «Что входит» видны первые 4 пункта, остальные под кнопкой «Ещё N пунктов»
const plural = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'пункт' : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 10 || n % 100 >= 20) ? 'пункта' : 'пунктов');
const vEx = villa(VILLA_DEFAULT);
const iEx = installment(INST_DEFAULT);
const calcLinks = [
  {
    id: 'villa', title: 'Доходность виллы', inp: 'цена, ADR, загрузка, комиссии, налоги, расходы', out: 'чистый доход, ROI, срок окупаемости, IRR, MOIC',
    cap: `Вилла за ${usd(VILLA_DEFAULT.price)}, ночь ${usd(VILLA_DEFAULT.adr)}, загрузка ${VILLA_DEFAULT.occ}%, продажа через ${VILLA_DEFAULT.years} лет`,
    kv: [['IRR', pct(vEx.irr)], ['MOIC', `${group(vEx.moic, 2)}×`], ['Доходность в первый год', pct(vEx.net1)]],
  },
  {
    id: 'inst', title: 'Рассрочка или скидка', inp: 'цена, первый взнос, срок, ставки', out: 'реальная ставка рассрочки и что выгоднее',
    cap: `Вилла за ${usd(INST_DEFAULT.price)}, взнос ${INST_DEFAULT.down}%, рассрочка на ${INST_DEFAULT.months} месяцев. Ставка девелопера ${INST_DEFAULT.dev}%, покупателя ${INST_DEFAULT.buy}%`,
    kv: [['Платёж в месяц', usd(Math.round(iEx.pay))], ['Выгодная обоим скидка', `${group(iEx.evenBuy * 100, 1)}–${pct(iEx.evenDev)}`]],
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title="Axiom — финансовый консалтинг для девелопмента и строительства" jsonLd={[faqLd]}>
  <!-- Первый экран (каталог): заголовок слева; справа крупные цифры, как в презентации, и кнопки по низу заголовка.
       Под ними четыре услуги карточками -->
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-text">
          <!-- На широком экране строки заданы явно: четыре строки, кнопки по низу последней -->
          <h1>{hero.lines.map((l) => <span class="h1-l">{t(l)} </span>)}<span class="hero-aud">{hero.audLines.map((l) => <span class="h1-l">{t(l)} </span>)}</span></h1>
        </div>
        <div class="hero-side">
          <dl class="hero-stats">
            {hero.stats.map((s) => (
              <div><dt>{s.value}</dt><dd>{t(s.text)}</dd></div>
            ))}
          </dl>
          <div class="btn-row hero-btns">
            <a class="btn btn-primary" href={site.telegramUrl}>Обсудить проект</a>
            <a class="btn btn-secondary" href="#calc">Калькуляторы</a>
          </div>
        </div>
      </div>

      <ul class="services">
        {practices.map((p) => (
          <li>
            <a class="service" href={`#${p.id}`}>
              <span class="service-top">
                <ServiceIcon name={p.id} />
                <span class="service-num">{p.num}</span>
              </span>
              <span class="service-title">{t(p.title)}</span>
              <span class="service-lead">{t(p.card)}</span>
              <span class="service-more">Что входит</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Услуги (Евгений 02.11.2026, выбрал раскладку «пример снизу»): у всех четырёх один шаблон из прямоугольных блоков.
       Сверху два блока рядом: название, строка «что это», результат и кнопка; «Что входит» в две колонки.
       Под ними пример на демо-данных во всю ширину карточки -->
  <section class="section section--alt practices" id="practices" aria-label="Услуги">
    <div class="container">
      <div class="practices-list">
      {practices.map((p) => (
        <article class="practice" id={p.id} data-reveal aria-labelledby={`pr-h-${p.id}`}>
          <div class="pr-main">
            <div class="pr-title">
              <span class="practice-num" aria-hidden="true">{p.num}</span>
              <h2 id={`pr-h-${p.id}`}>{t(p.title)}</h2>
            </div>
            <p class="practice-lead">{t(p.card)}</p>
            <p class="practice-result"><span>Результат</span>{t(p.result)}</p>
          </div>
          <div class="pr-list">
            <p class="practice-label">Что входит</p>
            <ul class="dots practice-items">
              {p.items.map((i) => <li>{t(i)}</li>)}
            </ul>
            {p.items.length > 5 && <button type="button" class="pr-more" data-more>Ещё {p.items.length - 4} {plural(p.items.length - 4)}</button>}
          </div>
          <div class="pr-cta">
            <a class="btn btn-soft" href={tgLink(p.topic)}>{p.cta}</a>
          </div>
          <div class="pr-ex">
            {p.id === 'models' && <MiniJCurve />}
            {p.id === 'accounting' && <MiniThreads />}
            {p.id === 'audit' && <MiniRegister />}
            {p.id === 'advisory' && (
              <div class="calc-links">
                <p class="calc-links-head">Посчитайте сами на сайте</p>
                <div class="calc-links-list">
                  {calcLinks.map((l) => (
                    <a href="#calc" data-open-calc={l.id}>
                      <span class="cl-text">
                        <b>{l.title}</b>
                        <span class="cl-row"><em>Вводите</em>{t(l.inp)}</span>
                        <span class="cl-row"><em>Получаете</em>{t(l.out)}</span>
                      </span>
                      <span class="cl-ex">
                        <span class="cl-cap"><em>Пример</em>{t(l.cap)}</span>
                        <span class="cl-kv">{l.kv.map(([k, v]) => <span><i>{t(k)}</i><strong>{v}</strong></span>)}</span>
                      </span>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
      </div>
      <p class="practices-note">Цифры в примерах — демо-данные.</p>
    </div>
  </section>

  <!-- Калькуляторы вместо демо-виджетов: считают цифры самого посетителя -->
  <section class="section" id="calc">
    <div class="container">
      <Calculators />
    </div>
  </section>

  <!-- Результаты за 2 года: три равные крупные цифры -->
  <section class="section section--signal results" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="results-title" data-reveal>{results.title}</h2>
      <dl class="results-grid" data-reveal>
        {results.items.map((r) => (
          <div>
            <dt>{r.value}</dt>
            <dd>{t(r.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Кейсы</p>
          <h2>Задачи, которые мы решали</h2>
        </div>
        <p class="caption">Клиентов и проекты не называем</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card cv-gap">
                  <!-- Схема без цифр: накопленный итог до и после настройки против лимита финансирования -->
                  <svg viewBox="0 0 260 96">
                    <line class="cv-lim" x1="4" x2="256" y1="62" y2="62"></line>
                    <text class="cv-t" x="256" y="74" text-anchor="end">лимит</text>
                    <path class="cv-before" d="M6,14 C40,18 64,82 104,82 C150,82 178,40 254,12"></path>
                    <path class="cv-after" d="M6,14 C40,18 64,46 104,46 C150,46 178,24 254,12"></path>
                    <text class="cv-t cv-t--ok" x="104" y="33" text-anchor="middle">после</text>
                    <line class="cv-gapl" x1="104" x2="104" y1="50" y2="58"></line>
                    <text class="cv-t" x="110" y="56">запас</text>
                    <text class="cv-t cv-t--risk" x="104" y="96" text-anchor="middle">до: разрыв</text>
                  </svg>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card">
                  <p><span>Заявка № 63</span><b>1 080 000 IDR</b></p>
                  <p class="cv-dup"><span>Заявка № 75</span><b>1 080 000 IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 3 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>9,0%</b><span>→</span><b class="cv-risk">8,2%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда: компактная строка, фото и подпись (Евгений 02.11.2026) -->
  <section class="section section--white team-sec" id="team">
    <div class="container team">
      <h2 data-reveal>{team.title}</h2>
      <ul class="people" data-reveal style="--d: 120ms">
        {team.people.map((m) => (
          <li class="person">
            {m.photo ? (
              <img class="person-photo" src={m.photo} alt={m.name} width="120" height="120" />
            ) : (
              <span class="person-photo person-photo--empty" aria-hidden="true">{m.name.split(' ').map((w) => w[0]).join('')}</span>
            )}
            <p class="person-name">{m.name}</p>
            <p class="person-role">{t(m.role)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Вопросы: список слева, ответ справа. Ничего не раскрывается и не сдвигается (Евгений 02.11.2026).
       На телефоне ответ показывается под вопросом -->
  <section class="section" id="faq">
    <div class="container faq-wrap" data-faq>
      <div class="faq-side">
        <h2>Частые вопросы</h2>
        <div class="faq-list" role="tablist" aria-orientation="vertical" aria-label="Частые вопросы">
          {faq.map((f, i) => (
            <button type="button" role="tab" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-faq-q={i}>{t(f.q)}</button>
          ))}
        </div>
        <p class="muted faq-more">Не нашли ответ? <a href={site.telegramUrl}>Напишите в Telegram</a></p>
      </div>
      <div class="faq-answers">
        {faq.map((f, i) => (
          <div class="faq-answer" role="tabpanel" id={`faq-a-${i}`} aria-labelledby={`faq-q-${i}`} data-faq-a={i} hidden={i !== 0}>
            <p class="faq-answer-q">{t(f.q)}</p>
            <p>{t(f.a)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Финальный блок -->
  <section class="section section--dark final" id="contact">
    <FinalThreads />
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">Контакты</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <p class="final-sub">{t(finalCta.itemsTitle)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl}>Написать в Telegram @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // «Что входит» на телефоне: 4 пункта и кнопка «Ещё N пунктов». На десктопе CSS кнопку не показывает
  document.querySelectorAll<HTMLElement>('.practice').forEach((card) => {
    const more = card.querySelector<HTMLButtonElement>('[data-more]');
    if (!more) return;
    card.classList.add('is-clamped');
    more.addEventListener('click', () => {
      card.classList.remove('is-clamped');
      card.querySelector<HTMLElement>('.practice-items li:nth-child(5)')?.setAttribute('tabindex', '-1');
      card.querySelector<HTMLElement>('.practice-items li:nth-child(5)')?.focus({ preventScroll: true });
    });
  });

  // Вопросы: клик по вопросу показывает ответ справа. На узком экране ответ встаёт под вопросом.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLButtonElement>('[data-faq-q]')];
    const as = [...root.querySelectorAll<HTMLElement>('[data-faq-a]')];
    const box = root.querySelector<HTMLElement>('.faq-answers')!;
    const narrow = window.matchMedia('(max-width: 899px)');
    let cur = 0;
    const place = () => {
      if (narrow.matches) qs[cur].after(as[cur]);
      else as.forEach((a) => box.append(a));
    };
    const show = (i: number) => {
      cur = i;
      qs.forEach((q, k) => {
        q.setAttribute('aria-selected', String(k === i));
        q.tabIndex = k === i ? 0 : -1;
      });
      as.forEach((a, k) => { a.hidden = k !== i; });
      place();
    };
    qs.forEach((q, i) => {
      q.addEventListener('click', () => show(i));
      q.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowDown' ? 1 : qs.length - 1)) % qs.length;
        qs[n].focus();
        show(n);
      });
    });
    narrow.addEventListener('change', place);
    place();
  });

  // Счётчики в полосе цифр: от нуля до значения, один раз
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const final = el.dataset.count!;
        const m = final.match(/^([\d\s ]+)(?:,(\d+))?(.*)$/);
        if (!m) return;
        const whole = Number(m[1].replace(/[\s ]/g, ''));
        const dec = m[2] ?? '';
        const target = Number(`${whole}.${dec || 0}`);
        const tail = m[3];
        const t0 = performance.now();
        const dur = 1400;
        const fmt = (v: number) => {
          const [a, b] = v.toFixed(dec.length).split('.');
          const grouped = a.length > 4 ? a.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : a;
          return b ? `${grouped},${b}` : grouped;
        };
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? fmt(target * eased) + tail : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* Первый экран. Цифры справа: их линии стоят на высоте заглавных первой строки, кнопки по базовой линии последней.
     Смещения считаны с метрик Inter Tight при межстрочном 1,06: от края строки до верха заглавных и до базовой линии около 0,17 кегля */
  .hero { padding: var(--s5) 0 var(--s6); background-color: var(--bg); }
  .hero-top { --hfs: clamp(30px, 3.6vw, 60px); display: grid; gap: var(--s4); }
  .hero h1 { font-size: var(--hfs); line-height: 1.06; max-width: 16em; text-wrap: balance; }
  .hero-aud { color: var(--ink-3); }
  .hero-side { display: grid; gap: var(--s4); }
  @media (min-width: 1200px) {
    .hero-top { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); column-gap: var(--s6); align-items: stretch; }
    .h1-l { display: block; }
    .hero-side { display: flex; flex-direction: column; justify-content: space-between; padding: calc(var(--hfs) * 0.166) 0 calc(var(--hfs) * 0.167); }
  }
  /* Крупные цифры, как в презентации. Линии в цветах нитей */
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin: 0; }
  .hero-stats div { padding-top: 14px; border-top: 3px solid var(--th-1); }
  .hero-stats div:nth-child(2) { border-top-color: var(--th-2); }
  .hero-stats div:nth-child(3) { border-top-color: var(--th-3); }
  .hero-stats dt { font-family: var(--font-display); font-size: clamp(26px, 2.5vw, 40px); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hero-stats dd { margin: 8px 0 0; font-size: 14px; line-height: 1.35; color: var(--ink-2); }
  @media (max-width: 520px) {
    .hero-stats { grid-template-columns: 1fr; gap: 0; }
    .hero-stats div { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: var(--s2); align-items: baseline; padding: 10px 0; border-top-width: 2px; }
    .hero-stats dd { margin: 0; }
  }

  .services {
    list-style: none;
    padding: 0;
    margin-top: var(--s5);
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .services { grid-template-columns: repeat(4, 1fr); } }
  .services li { display: flex; border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .services li:nth-child(odd) { border-right: 1px solid var(--line); } }
  @media (min-width: 1100px) {
    .services li { border-bottom: 0; }
    .services li:not(:last-child) { border-right: 1px solid var(--line); }
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: var(--s3) var(--s3) var(--s3) 0;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 640px) { .services li:nth-child(even) .service { padding-left: var(--s3); } }
  @media (min-width: 1100px) { .services li:not(:first-child) .service { padding-left: var(--s3); } }
  .service:hover .service-title { color: var(--accent); }
  .service:hover .service-more { text-decoration: underline; }
  .service-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; color: var(--accent); }
  .service-top :global(.s-icon) { width: 36px; height: 36px; }
  .service-num { font-size: 14px; color: var(--ink-3); }
  .service-title { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; transition: color .2s ease; }
  .service-lead { color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .service-more { margin-top: auto; padding-top: var(--s1); color: var(--accent); font-size: 15px; font-weight: 600; }
  .service-more::after { content: ' ↓'; }

  /* Услуги: карточка из четырёх областей — main (название, что это, результат), list (что входит), cta (кнопка), ex (пример).
     На широком экране main и list рядом, кнопка по низу списка, пример во всю ширину карточки. На телефоне всё столбиком */
  .practices { padding-top: var(--s5); }
  .practice {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'main' 'list' 'cta' 'ex';
    gap: var(--s3);
    margin-bottom: var(--s3);
    padding: var(--s4);
    border: 1px solid var(--line);
    border-radius: 12px;
