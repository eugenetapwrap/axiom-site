---
import Base from '../layouts/Base.astro';
import PracticeWidget from '../components/PracticeWidget.astro';
import RolloutStory from '../components/RolloutStory.astro';
import BotMessage from '../components/BotMessage.astro';
import HeroSignature from '../components/HeroSignature.astro';
import FinalThreads from '../components/FinalThreads.astro';
import { site, tgLink } from '../data/site';
import {
  hero, practices, results, steps, cases, team, reviews, bot, faq, finalCta,
} from '../data/home';
import { t } from '../lib/typo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const widgetFor = {
  models: 'models',
  audit: 'audit',
  accounting: 'accounting',
  advisory: 'advisory',
} as const;
---

<Base title="Axiom — финансовый консалтинг для девелопмента и строительства" jsonLd={[faqLd]}>
  <!-- Первый экран: заголовок слева, цифры и кнопка справа, под ними во всю ширину фишка — поток денег по месяцам
       (переключатель на J-кривую — две точки в шапке, техническая строка до выбора) -->
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-text">
          <h1>{t(hero.title)} <span class="hero-aud">{t(hero.audience)}</span></h1>
        </div>
        <div class="hero-side">
          <p class="hero-lead">{t(hero.lead)}</p>
          <div class="btn-row hero-btns">
            <a class="btn btn-primary" href={site.telegramUrl}>Обсудить проект</a>
            <a class="btn btn-secondary" href="#practices">Направления</a>
          </div>
          <p class="hero-note">{t(hero.note)}</p>
        </div>
      </div>
      <div class="hero-art"><HeroSignature /></div>
    </div>
  </section>

  <!-- Направления: текст слева, живой интерфейс справа -->
  <section class="section section--alt" id="practices">
    <div class="container">
      <h2 class="visually-hidden">Направления</h2>
      {practices.map((p) => (
        <article class="practice" id={p.id}>
          <div class="practice-text" data-reveal>
            <div class="practice-head">
              <h2>{t(p.title)}</h2>
            </div>
            <p class="practice-lead">{t(p.lead)}</p>
            <ul class="dots">
              {p.items.map((i) => <li>{t(i)}</li>)}
            </ul>
            <a class="btn btn-soft" href={tgLink(p.topic)}>{p.cta}</a>
          </div>
          <div class="practice-widget" data-reveal style="--d: 120ms">
            <PracticeWidget variant={widgetFor[p.id as keyof typeof widgetFor]} />
          </div>
        </article>
      ))}
      <p class="caption practices-note">Интерфейсы показаны на демонстрационных данных</p>
    </div>
  </section>

  <!-- Результаты: главная цифра крупно, две рядом -->
  <section class="section section--signal" aria-labelledby="stats-title">
    <div class="container signal">
      <div class="signal-main" data-reveal>
        <h2 id="stats-title" class="eyebrow">Результаты</h2>
        <p class="signal-value"><span data-count={results.main.value}>{results.main.value}</span> <span class="signal-unit">{results.main.unit}</span></p>
        <p class="signal-text">{t(results.main.text)}</p>
      </div>
      <dl class="signal-rest" data-reveal style="--d: 120ms">
        {results.rest.map((s) => (
          <div>
            <dt><span class="num">{s.value}</span></dt>
            <dd>{t(s.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Внедрение за 30 дней -->
  <section class="section" id="rollout">
    <div class="container">
      <RolloutStory />
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Кейсы</p>
          <h2>Задачи, которые мы решали</h2>
        </div>
        <p class="caption">Клиентов и проекты не называем</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card">
                  <p><span>Заявка № 63</span><b>1 080 000 IDR</b></p>
                  <p class="cv-dup"><span>Заявка № 75</span><b>1 080 000 IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>9,0%</b><span>→</span><b class="cv-risk">8,2%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Отзывы: заготовка, тексты появятся после согласования с клиентами -->
  <section class="section" id="reviews">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Отзывы</p>
        <h2>{reviews.title}</h2>
      </div>
      <div class="reviews">
        {reviews.items.map((r, i) => (
          <figure class={`review ui-card${r.text ? '' : ' review--soon'}`} data-reveal style={`--d: ${i * 100}ms`}>
            {r.text ? (
              <blockquote>{t(r.text)}</blockquote>
            ) : (
              <div class="review-skeleton" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
            )}
            <figcaption>
              <b>{r.role}</b>
              <span>{r.company}</span>
              {!r.text && <em>Отзыв появится после согласования с клиентом</em>}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда: основатель с фото, роли без имён (пока) -->
  <section class="section section--white" id="team">
    <div class="container team">
      <div data-reveal>
        <p class="eyebrow">{team.title}</p>
        <h2>Кто работает над проектом</h2>
        <p class="muted team-lead">{t(team.lead)}</p>
      </div>
      <div class="team-cards" data-reveal style="--d: 120ms">
        <div class="founder ui-card">
          {team.founder.photo ? (
            <img class="founder-photo" src={team.founder.photo} alt={team.founder.name} width="88" height="88" />
          ) : (
            <span class="founder-photo founder-photo--empty" aria-hidden="true">{team.founder.name[0]}</span>
          )}
          <div>
            <p class="founder-name">{team.founder.name}</p>
            <p class="founder-role">{team.founder.role}</p>
            <p class="founder-text">{t(team.founder.text)}</p>
          </div>
        </div>
        <dl class="roles">
          {team.roles.map((r) => (
            <div class="ui-card">
              <dt>{r.title}</dt>
              <dd>{t(r.text)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Продукт: бот -->
  <section class="section section--alt" id="bot">
    <div class="container bot">
      <div class="bot-visual" data-reveal>
        <BotMessage />
      </div>
      <div data-reveal style="--d: 120ms">
        <p class="eyebrow">Продукт · {bot.badge}</p>
        <h2>{bot.title}</h2>
        <p class="bot-lead">{t(bot.lead)}</p>
        <p class="bot-aud">{t(bot.audience)}</p>
        <ul class="dots bot-list">
          {bot.items.map((i) => <li>{t(i)}</li>)}
        </ul>
        <p class="tagline">{t(bot.tagline)}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={tgLink(bot.topic)}>{bot.cta}</a>
          {site.channelUrl && <a class="btn btn-secondary" href={site.channelUrl}>Канал «{site.channelName}»</a>}
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" id="faq">
    <div class="container faq-wrap">
      <div data-reveal>
        <p class="eyebrow">Вопросы</p>
        <h2>Частые вопросы</h2>
        <p class="muted faq-more">Не нашли ответ? <a href={site.telegramUrl}>Напишите в Telegram</a></p>
      </div>
      <div class="faq" data-reveal style="--d: 120ms">
        {faq.map((f) => (
          <details class="ui-card">
            <summary>{t(f.q)}</summary>
            <p class="muted">{t(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Что будет после заявки -->
  <section class="section section--white" id="steps">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Как начать</p>
        <h2>{steps.title}</h2>
      </div>
      <ol class="cols4 approach" data-reveal>
        {steps.items.map((s, i) => (
          <li class="col">
            <span class="approach-num">{i + 1}</span>
            <h3>{t(s.title)}</h3>
            <p class="muted">{t(s.text)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Финальный блок -->
  <section class="section section--dark final" id="contact">
    <FinalThreads />
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">Контакты</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <p class="final-sub">{t(finalCta.itemsTitle)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl}>Написать в Telegram @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Счётчики в полосе цифр: от нуля до значения, один раз
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const final = el.dataset.count!;
        const m = final.match(/^([\d\s ]+)(?:,(\d+))?(.*)$/);
        if (!m) return;
        const whole = Number(m[1].replace(/[\s ]/g, ''));
        const dec = m[2] ?? '';
        const target = Number(`${whole}.${dec || 0}`);
        const tail = m[3];
        const t0 = performance.now();
        const dur = 1400;
        const fmt = (v: number) => {
          const [a, b] = v.toFixed(dec.length).split('.');
          const grouped = a.length > 4 ? a.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : a;
          return b ? `${grouped},${b}` : grouped;
        };
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? fmt(target * eased) + tail : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* Первый экран */
  .hero { padding: var(--s5) 0 var(--s6); background-color: var(--bg); }
  .hero-top { display: grid; gap: var(--s3); align-items: start; }
  @media (min-width: 1024px) { .hero-side { padding-top: 8px; } }
  @media (min-width: 1024px) { .hero-top { grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); column-gap: var(--s6); } }
  .hero h1 { font-size: clamp(30px, 3.6vw, 50px); line-height: 1.06; max-width: 16em; text-wrap: balance; }
  .hero-aud { color: var(--ink-3); }
  .hero-lead { max-width: 26em; font-size: clamp(17px, 1.35vw, 19px); line-height: 1.45; color: var(--ink-2); }
  .hero-btns { margin-top: var(--s3); }
  .hero-note { margin-top: 10px; font-size: 14px; color: var(--ink-3); }
  .hero-art { min-width: 0; margin-top: var(--s4); }

  /* Направления */
  .practice {
    display: grid;
    gap: var(--s5);
    padding: var(--s6) 0;
    border-top: 1px solid var(--line);
  }
  .practice:first-of-type { border-top: 0; padding-top: 0; }
  @media (min-width: 1024px) {
    .practice { grid-template-columns: 1fr 1fr; column-gap: 112px; align-items: start; padding: var(--s7) 0; }
  }
  .practice-head { padding-top: 0; }
  .practice-lead { margin: var(--s3) 0; color: var(--ink-2); }
  .practice .dots { margin-bottom: var(--s4); }
  .practices-note { margin-top: var(--s2); }

  /* Сигнальная полоса */
  .signal { display: grid; gap: var(--s5); align-items: end; }
  @media (min-width: 1024px) { .signal { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); column-gap: var(--s7); } }
  .signal .eyebrow { color: var(--ink); }
  .signal-value { max-width: none; font-family: var(--font-display); font-size: clamp(60px, 9vw, 120px); font-weight: 500; line-height: .95; letter-spacing: -0.05em; }
  .signal-unit { font-size: .3em; font-weight: 500; letter-spacing: -0.01em; vertical-align: .95em; }
  .signal-text { margin-top: var(--s2); font-size: 20px; max-width: 22em; }
  .signal-rest { display: grid; gap: 0; border-top: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
  .signal-rest > div { display: grid; grid-template-columns: minmax(0, 11em) minmax(0, 1fr); gap: var(--s2); padding: 14px 0; border-bottom: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); align-items: baseline; }
  .signal-rest dt { font-weight: 500; font-size: 17px; }
  .signal-rest dt .num { font-weight: 600; font-size: 22px; letter-spacing: -0.02em; }
  .signal-rest dd { font-size: 15px; }
  @media (max-width: 520px) { .signal-rest > div { grid-template-columns: 1fr; gap: 2px; } }

  /* Четыре колонки */
  .cols4 { display: grid; gap: var(--s4) 0; list-style: none; padding: 0; }
  @media (min-width: 720px) { .cols4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cols4 { grid-template-columns: repeat(4, 1fr); } }
  .col { padding-right: var(--s3); }
  @media (min-width: 1024px) { .col:not(:first-child) { padding-left: var(--s3); } }
  @media (min-width: 720px) and (max-width: 1023px) { .col:nth-child(even) { padding-left: var(--s3); } }


  /* Кейсы */
  .cases { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; padding: 8px; }
  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 48px var(--s3) var(--s3);
    border-radius: 6px;
    background: var(--deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .case-tag { position: absolute; top: 14px; left: 16px; color: var(--gold-on-deep); font-size: 13px; font-weight: 600; }
  .cv-card { width: 100%; max-width: 280px; padding: 12px 14px; border-radius: 8px; background: var(--surface); font-size: 13px; display: grid; gap: 8px; }
  .cv-card p { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: none; }
  .cv-card span { color: var(--ink-3); }
  .cv-dup { padding: 4px 6px; margin: 0 -6px; border-radius: 6px; background: var(--risk-soft); }
  .cv-dup em { font-style: normal; font-weight: 700; color: var(--risk); }
  .cv-bars p { display: grid; grid-template-columns: 52px 1fr; }
  .cv-bars i { display: block; height: 10px; width: var(--w); border-radius: 5px; background: var(--accent-2); }
  .cv-over i { background: var(--risk); }
  .cv-irr { display: flex; align-items: baseline; justify-content: center; gap: 10px; font-size: 15px; }
  .cv-irr b { font-size: 30px; letter-spacing: -0.02em; }
  .cv-risk { color: var(--risk); }
  .case-body { padding: var(--s3) var(--s2) var(--s2); }
  .case-body h3 { font-size: 21px; }
  .case-dl { display: grid; gap: 2px; margin-top: var(--s2); font-size: 16px; }
  .case-dl dt { color: var(--ink-3); font-size: 13px; margin-top: var(--s1); }
  .case-result { font-weight: 700; color: var(--accent); }

  /* Подход */
  .approach .col { position: relative; }
  .approach-num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--s3);
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink-2);
    font-weight: 500;
    font-size: 14px;
  }
  .approach h3 { font-size: 21px; }
  .approach p { margin-top: 6px; font-size: 16px; }

  /* Отзывы */
  .reviews { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .reviews { grid-template-columns: repeat(3, 1fr); } }
  .review { margin: 0; display: flex; flex-direction: column; gap: var(--s3); padding: var(--s3); }
  .review blockquote { margin: 0; font-size: 17px; line-height: 1.5; }
  .review figcaption { display: grid; gap: 2px; margin-top: auto; font-size: 15px; }
  .review figcaption span { color: var(--ink-3); }
  .review figcaption em { margin-top: var(--s1); font-style: normal; font-size: 13px; color: var(--ink-3); }
  .review-skeleton { display: grid; gap: 10px; }
  .review-skeleton i { display: block; height: 10px; border-radius: 5px; background: var(--track); }
  .review-skeleton i:nth-child(2) { width: 92%; }
  .review-skeleton i:nth-child(3) { width: 84%; }
  .review-skeleton i:nth-child(4) { width: 55%; }

  /* Команда */
  .team { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .team { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: 112px; } }
  .team-lead { margin-top: var(--s3); }
  .team-cards { display: grid; gap: var(--s2); }
  .founder { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: var(--s3); align-items: start; padding: var(--s3); }
  .founder-photo { width: 88px; height: 88px; border-radius: 50%; object-fit: cover; }
  .founder-photo--empty { display: grid; place-items: center; background: var(--track); color: var(--ink-3); font-family: var(--font-display); font-size: 34px; font-weight: 600; }
  .founder-name { font-weight: 700; font-size: 20px; }
  .founder-role { color: var(--ink-3); font-size: 15px; }
  .founder-text { margin-top: var(--s1); color: var(--ink-2); font-size: 16px; }
  .roles { display: grid; gap: var(--s2); }
  .roles > div { padding: 18px var(--s3); }
  .roles dt { font-weight: 700; font-size: 17px; }
  .roles dd { margin-top: 6px; color: var(--ink-2); font-size: 15px; }
  @media (min-width: 640px) {
    .roles > div { display: grid; grid-template-columns: 12em minmax(0, 1fr); gap: var(--s2); align-items: baseline; }
    .roles dd { margin-top: 0; }
  }

  /* Бот */
  .bot { display: grid; gap: var(--s5); align-items: center; }
  @media (min-width: 1024px) { .bot { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .bot-visual { display: grid; justify-items: center; }
  .bot-visual :global(.chat) { width: 100%; }
  .bot-lead { margin-top: var(--s3); color: var(--ink-2); }
  .bot-aud { margin-top: var(--s1); color: var(--ink-2); }
  .bot-list { margin: var(--s3) 0; }
  .tagline { margin-bottom: var(--s4); font-family: var(--font-display); font-weight: 600; font-size: 22px; letter-spacing: -0.02em; color: var(--accent); }

  /* FAQ */
  .faq-wrap { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .faq-wrap { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .faq-more { margin-top: var(--s3); }
  .faq { display: grid; gap: 10px; }
  .faq details { padding: 18px 22px; box-shadow: none; }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--gold-ink); font-weight: 600; font-size: 22px; line-height: 1; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: var(--s1); font-size: 16px; }

  /* Финальный блок: фирменные нити сходятся в узел за кнопками (FinalThreads) */
