---
import Base from '../layouts/Base.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import Calculators from '../components/Calculators.astro';
import MiniJCurve from '../components/MiniJCurve.astro';
import MiniThreads from '../components/MiniThreads.astro';
import MiniRegister from '../components/MiniRegister.astro';
import FinalThreads from '../components/FinalThreads.astro';
import { site, tgLink } from '../data/site';
import {
  hero, practices, results, cases, team, faq, finalCta,
} from '../data/home';
import { t } from '../lib/typo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base title="Axiom — финансовый консалтинг для девелопмента и строительства" jsonLd={[faqLd]}>
  <!-- Первый экран (каталог): заголовок слева; справа крупные цифры, как в презентации, и кнопки по низу заголовка.
       Под ними четыре услуги карточками -->
  <section class="hero">
    <div class="container">
      <div class="hero-top">
        <div class="hero-text">
          <h1>{t(hero.title)} <span class="hero-aud">{t(hero.audience)}</span></h1>
        </div>
        <div class="hero-side">
          <dl class="hero-stats">
            {hero.stats.map((s) => (
              <div><dt>{s.value}</dt><dd>{t(s.text)}</dd></div>
            ))}
          </dl>
          <p class="hero-note">{t(hero.note)}</p>
          <div class="btn-row hero-btns">
            <a class="btn btn-primary" href={site.telegramUrl}>Обсудить проект</a>
            <a class="btn btn-secondary" href="#calc">Калькуляторы</a>
          </div>
        </div>
      </div>

      <ul class="services">
        {practices.map((p) => (
          <li>
            <a class="service" href={`#${p.id}`}>
              <span class="service-top">
                <ServiceIcon name={p.id} />
                <span class="service-num">{p.num}</span>
              </span>
              <span class="service-title">{t(p.title)}</span>
              <span class="service-lead">{t(p.card)}</span>
              <span class="service-more">Что входит</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Услуги строками (Евгений 02.11.2026): под заголовком результат, в центре что входит, справа пример на демо-данных -->
  <section class="section section--alt practices" id="practices" aria-label="Услуги">
    <div class="container">
      {practices.map((p) => (
        <article class="practice" id={p.id} data-reveal>
          <div class="practice-head">
            <span class="practice-num">{p.num}</span>
            <h2>{t(p.title)}</h2>
            <p class="practice-result">{t(p.result)}</p>
            <a class="btn btn-soft" href={tgLink(p.topic)}>{p.cta}</a>
          </div>
          <div class="practice-col">
            <p class="practice-label">Что входит</p>
            <ul class="dots practice-items">
              {p.items.map((i) => <li>{t(i)}</li>)}
            </ul>
          </div>
          <div class="practice-ex">
            {p.id === 'models' && <MiniJCurve />}
            {p.id === 'accounting' && <MiniThreads />}
            {p.id === 'audit' && <MiniRegister />}
            {p.id === 'advisory' && (
              <div class="calc-links">
                <p class="calc-links-head">Посчитайте сами на сайте</p>
                <a href="#calc" data-open-calc="inst"><b>Рассрочка или скидка</b><span>Какая скидка за полную оплату выгодна обеим сторонам</span></a>
                <a href="#calc" data-open-calc="villa"><b>Доходность виллы</b><span>Cash Flow инвестора по годам, IRR и NPV</span></a>
                <a href="#calc" data-open-calc="dup"><b>Дубли и ошибки</b><span>Ориентир по проектам наших клиентов</span></a>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Калькуляторы вместо демо-виджетов: считают цифры самого посетителя -->
  <section class="section" id="calc">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Калькуляторы</p>
          <h2>Посчитайте сами</h2>
        </div>
        <p class="caption">Считает ваш браузер, цифры никуда не отправляются</p>
      </div>
      <Calculators />
    </div>
  </section>

  <!-- Результаты за 2 года: три равные крупные цифры -->
  <section class="section section--signal results" aria-labelledby="stats-title">
    <div class="container">
      <h2 id="stats-title" class="results-title" data-reveal>{results.title}</h2>
      <dl class="results-grid" data-reveal>
        {results.items.map((r) => (
          <div>
            <dt>{r.value}</dt>
            <dd>{t(r.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Кейсы</p>
          <h2>Задачи, которые мы решали</h2>
        </div>
        <p class="caption">Клиентов и проекты не называем</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card">
                  <p><span>Заявка № 63</span><b>1 080 000 IDR</b></p>
                  <p class="cv-dup"><span>Заявка № 75</span><b>1 080 000 IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>9,0%</b><span>→</span><b class="cv-risk">8,2%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда: основатель с фото, роли без имён (пока) -->
  <section class="section section--white" id="team">
    <div class="container team">
      <div data-reveal>
        <h2>{team.title}</h2>
        <p class="muted team-lead">{t(team.lead)}</p>
      </div>
      <div class="team-cards" data-reveal style="--d: 120ms">
        <div class="founder ui-card">
          {team.founder.photo ? (
            <img class="founder-photo" src={team.founder.photo} alt={team.founder.name} width="88" height="88" />
          ) : (
            <span class="founder-photo founder-photo--empty" aria-hidden="true">{team.founder.name[0]}</span>
          )}
          <div>
            <p class="founder-name">{team.founder.name}</p>
            <p class="founder-role">{team.founder.role}</p>
            <p class="founder-text">{t(team.founder.text)}</p>
          </div>
        </div>
        <dl class="roles">
          {team.roles.map((r) => (
            <div class="ui-card">
              <dt>{r.title}</dt>
              <dd>{t(r.text)}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Вопросы: список слева, ответ справа. Ничего не раскрывается и не сдвигается (Евгений 02.11.2026).
       На телефоне ответ показывается под вопросом -->
  <section class="section" id="faq">
    <div class="container faq-wrap" data-faq>
      <div class="faq-side">
        <h2>Частые вопросы</h2>
        <div class="faq-list" role="tablist" aria-orientation="vertical" aria-label="Частые вопросы">
          {faq.map((f, i) => (
            <button type="button" role="tab" id={`faq-q-${i}`} aria-controls={`faq-a-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-faq-q={i}>{t(f.q)}</button>
          ))}
        </div>
        <p class="muted faq-more">Не нашли ответ? <a href={site.telegramUrl}>Напишите в Telegram</a></p>
      </div>
      <div class="faq-answers">
        {faq.map((f, i) => (
          <div class="faq-answer" role="tabpanel" id={`faq-a-${i}`} aria-labelledby={`faq-q-${i}`} data-faq-a={i} hidden={i !== 0}>
            <p class="faq-answer-q">{t(f.q)}</p>
            <p>{t(f.a)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Финальный блок -->
  <section class="section section--dark final" id="contact">
    <FinalThreads />
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">Контакты</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <p class="final-sub">{t(finalCta.itemsTitle)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl}>Написать в Telegram @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Вопросы: клик по вопросу показывает ответ справа. На узком экране ответ встаёт под вопросом.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((root) => {
    const qs = [...root.querySelectorAll<HTMLButtonElement>('[data-faq-q]')];
    const as = [...root.querySelectorAll<HTMLElement>('[data-faq-a]')];
    const box = root.querySelector<HTMLElement>('.faq-answers')!;
    const narrow = window.matchMedia('(max-width: 899px)');
    let cur = 0;
    const place = () => {
      if (narrow.matches) qs[cur].after(as[cur]);
      else as.forEach((a) => box.append(a));
    };
    const show = (i: number) => {
      cur = i;
      qs.forEach((q, k) => {
        q.setAttribute('aria-selected', String(k === i));
        q.tabIndex = k === i ? 0 : -1;
      });
      as.forEach((a, k) => { a.hidden = k !== i; });
      place();
    };
    qs.forEach((q, i) => {
      q.addEventListener('click', () => show(i));
      q.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const n = (i + (e.key === 'ArrowDown' ? 1 : qs.length - 1)) % qs.length;
        qs[n].focus();
        show(n);
      });
    });
    narrow.addEventListener('change', place);
    place();
  });

  // Счётчики в полосе цифр: от нуля до значения, один раз
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const final = el.dataset.count!;
        const m = final.match(/^([\d\s ]+)(?:,(\d+))?(.*)$/);
        if (!m) return;
        const whole = Number(m[1].replace(/[\s ]/g, ''));
        const dec = m[2] ?? '';
        const target = Number(`${whole}.${dec || 0}`);
        const tail = m[3];
        const t0 = performance.now();
        const dur = 1400;
        const fmt = (v: number) => {
          const [a, b] = v.toFixed(dec.length).split('.');
          const grouped = a.length > 4 ? a.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : a;
          return b ? `${grouped},${b}` : grouped;
        };
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? fmt(target * eased) + tail : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* Первый экран */
  .hero { padding: var(--s5) 0 var(--s6); background-color: var(--bg); }
  .hero-top { display: grid; gap: var(--s4); align-items: end; }
  @media (min-width: 1024px) { .hero-top { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); column-gap: var(--s6); } }
  .hero h1 { font-size: clamp(30px, 3.6vw, 60px); line-height: 1.06; max-width: 16em; text-wrap: balance; }
  .hero-aud { color: var(--ink-3); }
  /* Крупные цифры, как в презентации: значение и подпись */
  .hero-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); margin: 0; }
  .hero-stats div { padding-top: 12px; border-top: 2px solid var(--ink); }
  .hero-stats dt { font-family: var(--font-display); font-size: clamp(26px, 2.5vw, 40px); font-weight: 600; line-height: 1.05; letter-spacing: -0.03em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .hero-stats dd { margin: 8px 0 0; font-size: 14px; line-height: 1.35; color: var(--ink-2); }
  .hero-note { margin-top: var(--s3); font-size: 14px; color: var(--ink-3); }
  .hero-btns { margin-top: 12px; }
  @media (max-width: 520px) {
    .hero-stats { grid-template-columns: 1fr; gap: 0; }
    .hero-stats div { display: grid; grid-template-columns: 7.5em minmax(0, 1fr); gap: var(--s2); align-items: baseline; padding: 10px 0; border-top: 1px solid var(--line); }
    .hero-stats div:first-child { border-top: 2px solid var(--ink); }
    .hero-stats dd { margin: 0; }
  }

  .services {
    list-style: none;
    padding: 0;
    margin-top: var(--s5);
    display: grid;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 640px) { .services { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .services { grid-template-columns: repeat(4, 1fr); } }
  .services li { display: flex; border-bottom: 1px solid var(--line); }
  @media (min-width: 640px) { .services li:nth-child(odd) { border-right: 1px solid var(--line); } }
  @media (min-width: 1100px) {
    .services li { border-bottom: 0; }
    .services li:not(:last-child) { border-right: 1px solid var(--line); }
  }
  .service {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    padding: var(--s3) var(--s3) var(--s3) 0;
    color: var(--ink);
    text-decoration: none;
  }
  @media (min-width: 640px) { .services li:nth-child(even) .service { padding-left: var(--s3); } }
  @media (min-width: 1100px) { .services li:not(:first-child) .service { padding-left: var(--s3); } }
  .service:hover .service-title { color: var(--accent); }
  .service:hover .service-more { text-decoration: underline; }
  .service-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px; color: var(--accent); }
  .service-top :global(.s-icon) { width: 36px; height: 36px; }
  .service-num { font-size: 14px; color: var(--ink-3); }
  .service-title { font-family: var(--font-display); font-size: 21px; font-weight: 600; line-height: 1.2; letter-spacing: -0.02em; transition: color .2s ease; }
  .service-lead { color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  .service-more { margin-top: auto; padding-top: var(--s1); color: var(--accent); font-size: 15px; font-weight: 600; }
  .service-more::after { content: ' ↓'; }

  /* Услуги: строки с тонкой линией между ними. Слева название и результат, в центре что входит, справа пример */
  .practices { padding-top: var(--s5); }
  .practice { display: grid; gap: var(--s4); padding: var(--s5) 0; border-top: 1px solid var(--line); }
  .practice:last-child { border-bottom: 1px solid var(--line); }
  @media (min-width: 760px) {
    /* Две колонки: слева название и пример под ним, справа что входит */
    .practice { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s5); align-items: start; }
    .practice-head { grid-column: 1; grid-row: 1; }
    .practice-col { grid-column: 2; grid-row: 1 / span 2; }
    .practice-ex { grid-column: 1; grid-row: 2; }
  }
  @media (min-width: 1180px) {
    .practice { grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr) minmax(0, 1.15fr); column-gap: var(--s5); align-items: start; }
    .practice-head, .practice-col, .practice-ex { grid-column: auto; grid-row: auto; }
  }
  .practice-num { display: block; margin-bottom: var(--s1); font-size: 14px; color: var(--ink-3); }
  .practice h2 { font-size: clamp(24px, 2.2vw, 32px); line-height: 1.15; letter-spacing: -0.02em; }
  .practice-result { margin: var(--s2) 0 var(--s3); font-size: 18px; line-height: 1.45; color: var(--ink-2); max-width: 26em; }
  .practice-label { font-size: 13px; font-weight: 600; color: var(--ink-3); margin-bottom: 12px; }
  .practice-items { gap: 8px; }
  /* Ссылки на калькуляторы у инвестанализа */
  .calc-links { display: grid; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); overflow: hidden; }
  .calc-links-head { padding: 16px 18px 10px; font-size: 13px; font-weight: 600; color: var(--ink-2); }
  .calc-links a { display: grid; gap: 2px; padding: 12px 18px; border-top: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .calc-links a:hover { background: color-mix(in srgb, var(--accent) 5%, var(--surface)); }
  .calc-links a b { color: var(--accent); font-weight: 600; font-size: 16px; }
  .calc-links a b::after { content: ' →'; }
  .calc-links a span { font-size: 14px; color: var(--ink-2); }

  /* Результаты за 2 года: три равные цифры */
  .results { padding: var(--s6) 0; }
  .results-title { font-size: clamp(24px, 2.2vw, 32px); letter-spacing: -0.02em; margin-bottom: var(--s4); }
  .results-grid { display: grid; gap: var(--s3); margin: 0; }
  @media (min-width: 760px) { .results-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s5); } }
  .results-grid div { padding-top: 14px; border-top: 2px solid color-mix(in srgb, var(--ink) 70%, transparent); }
  .results-grid dt { font-family: var(--font-display); font-size: clamp(40px, 4.4vw, 64px); font-weight: 600; line-height: 1; letter-spacing: -0.04em; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .results-grid dd { margin: 12px 0 0; font-size: 16px; line-height: 1.45; max-width: 22em; }

  /* Кейсы */
  .cases { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; padding: 8px; }
  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 48px var(--s3) var(--s3);
    border-radius: 6px;
    background: var(--deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .case-tag { position: absolute; top: 14px; left: 16px; color: var(--gold-on-deep); font-size: 13px; font-weight: 600; }
  .cv-card { width: 100%; max-width: 280px; padding: 12px 14px; border-radius: 8px; background: var(--surface); font-size: 13px; display: grid; gap: 8px; }
  .cv-card p { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: none; }
  .cv-card span { color: var(--ink-3); }
  .cv-dup { padding: 4px 6px; margin: 0 -6px; border-radius: 6px; background: var(--risk-soft); }
  .cv-dup em { font-style: normal; font-weight: 700; color: var(--risk); }
  .cv-bars p { display: grid; grid-template-columns: 52px 1fr; }
  .cv-bars i { display: block; height: 10px; width: var(--w); border-radius: 5px; background: var(--accent-2); }
  .cv-over i { background: var(--risk); }
  .cv-irr { display: flex; align-items: baseline; justify-content: center; gap: 10px; font-size: 15px; }
  .cv-irr b { font-size: 30px; letter-spacing: -0.02em; }
  .cv-risk { color: var(--risk); }
  .case-body { padding: var(--s3) var(--s2) var(--s2); }
  .case-body h3 { font-size: 21px; }
  .case-dl { display: grid; gap: 2px; margin-top: var(--s2); font-size: 16px; }
  .case-dl dt { color: var(--ink-3); font-size: 13px; margin-top: var(--s1); }
  .case-result { font-weight: 700; color: var(--accent); }

  /* Команда */
  .team { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .team { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); column-gap: 112px; } }
  .team-lead { margin-top: var(--s3); }
