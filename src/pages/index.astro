---
import Base from '../layouts/Base.astro';
import HeroBand from '../components/HeroBand.astro';
import PracticeWidget from '../components/PracticeWidget.astro';
import SankeyFlow from '../components/SankeyFlow.astro';
import PaymentBoard from '../components/PaymentBoard.astro';
import RolloutStory from '../components/RolloutStory.astro';
import BotMessage from '../components/BotMessage.astro';
import { site } from '../data/site';
import {
  hero, practices, expertise, geography, flow, stats, payment, approach, cases, team, bot, faq, finalCta,
} from '../data/home';
import { t } from '../lib/typo';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const [titleFirst, ...titleRest] = hero.title.split(' ');
const widgetFor = {
  models: 'models',
  audit: 'audit',
  accounting: 'accounting',
  advisory: 'advisory',
} as const;
---

<Base title="Axiom — финансовый консалтинг для девелопмента и строительства" jsonLd={[faqLd]}>
  <!-- Первый экран -->
  <section class="hero gridded">
    <div class="container hero-head">
      <p class="eyebrow">{hero.eyebrow} · Юго-Восточная Азия и СНГ</p>
      <h1><span class="h1-accent">{titleFirst}</span> {t(titleRest.join(' '))}</h1>
      <p class="hero-lead">{t(hero.lead)}</p>
    </div>
    <HeroBand />
    <div class="container">
      <dl class="facts">
        {hero.facts.map((f) => (
          <div>
            <dt>{f.value}</dt>
            <dd>{t(f.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Направления: текст слева, живой интерфейс справа -->
  <section class="section section--alt gridded" id="practices">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Направления</p>
        <h2>Четыре практики для девелоперов, генподрядчиков и инвесторов</h2>
      </div>
      {practices.map((p) => (
        <article class="practice" id={p.id}>
          <div class="practice-text" data-reveal>
            <div class="practice-head">
              <p class="eyebrow">Направление {p.num}</p>
              <h2>{t(p.title)}</h2>
            </div>
            <p class="practice-lead">{t(p.lead)}</p>
            <ul class="dots">
              {p.items.map((i) => <li>{t(i)}</li>)}
            </ul>
            <a class="btn btn-soft" href={site.telegramUrl}>{p.cta}</a>
          </div>
          <div class="practice-widget" data-reveal style="--d: 120ms">
            <PracticeWidget variant={widgetFor[p.id as keyof typeof widgetFor]} />
          </div>
        </article>
      ))}
      <p class="caption practices-note">Интерфейсы показаны на демонстрационных данных</p>
    </div>
  </section>

  <!-- Ключевые цифры -->
  <section class="section section--dark gridded" aria-labelledby="stats-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Результаты</p>
        <h2 id="stats-title">Цифры из наших систем учёта</h2>
      </div>
      <dl class="stats" data-reveal>
        {stats.map((s) => (
          <div class="stat">
            <dt><span class="stat-value" data-count={s.value}>{s.value}</span> <span class="stat-unit">{s.unit}</span></dt>
            <dd>{t(s.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Движение денег -->
  <section class="section section--white gridded" id="accounting-system">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Система учёта</p>
        <h2>{t(flow.title)}</h2>
        <p>{t(flow.lead)}</p>
      </div>
      <div data-reveal><SankeyFlow /></div>
    </div>
  </section>

  <!-- Контроль платежей -->
  <section class="section section--alt gridded" id="payments">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Система учёта</p>
        <h2>{t(payment.title)}</h2>
        <p>{t(payment.lead)}</p>
      </div>
      <div data-reveal>
        <PaymentBoard columns={payment.columns.map((c) => ({ title: t(c.title), text: t(c.text) }))} />
      </div>
    </div>
  </section>

  <!-- Внедрение за 40 дней -->
  <section class="section gridded" id="rollout">
    <div class="container">
      <RolloutStory />
    </div>
  </section>

  <!-- Экспертиза и география -->
  <section class="section section--white gridded" id="expertise">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">{expertise.title}</p>
        <h2>Девелопмент, строительство, инвестиции и технологии</h2>
      </div>
      <div class="cols4 areas" data-reveal>
        {expertise.areas.map((a, i) => (
          <div class="col">
            <span class="col-num">0{i + 1}</span>
            <h3>{a.title}</h3>
            <ul>
              {a.items.map((item) => <li>{t(item)}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="cols4 geo" data-reveal>
        <div class="col">
          <h3>{geography.title}</h3>
          <p class="caption">{t(geography.note)}</p>
        </div>
        {geography.regions.map((r) => (
          <div class="col">
            <p class="geo-region">{r.title}</p>
            <p class="geo-countries">{r.countries}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="section section--alt gridded" id="cases">
    <div class="container">
      <div class="section-head section-head--row" data-reveal>
        <div>
          <p class="eyebrow">Кейсы</p>
          <h2>Задачи, которые мы решали</h2>
        </div>
        <p class="caption">Клиентов и проекты не называем</p>
      </div>
      <div class="cases">
        {cases.map((c, i) => (
          <article class="case ui-card" data-reveal style={`--d: ${i * 100}ms`}>
            <div class="case-visual" aria-hidden="true">
              <span class="case-tag">{c.tag}</span>
              {i === 0 && (
                <div class="cv-card">
                  <p><span>Заявка № 63</span><b>1 080 000 IDR</b></p>
                  <p class="cv-dup"><span>Заявка № 75</span><b>1 080 000 IDR</b><em>дубль</em></p>
                </div>
              )}
              {i === 1 && (
                <div class="cv-card cv-bars">
                  <p><span>Норма</span><i style="--w:62%"></i></p>
                  <p class="cv-over"><span>Факт</span><i style="--w:88%"></i></p>
                </div>
              )}
              {i === 2 && (
                <div class="cv-card cv-irr">
                  <span>IRR</span><b>9,0%</b><span>→</span><b class="cv-risk">8,2%</b>
                </div>
              )}
            </div>
            <div class="case-body">
              <h3>{t(c.problem)}</h3>
              <dl class="case-dl">
                <dt>Решение</dt>
                <dd>{t(c.action)}</dd>
                <dt>Результат</dt>
                <dd class="case-result">{t(c.result)}</dd>
              </dl>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Как работаем -->
  <section class="section gridded" id="approach">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Подход</p>
        <h2>{approach.title}</h2>
      </div>
      <ol class="cols4 approach" data-reveal>
        {approach.steps.map((s, i) => (
          <li class="col">
            <span class="approach-num">{i + 1}</span>
            <h3>{s.title}</h3>
            <p class="muted">{t(s.text)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Команда -->
  <section class="section section--white gridded" id="team">
    <div class="container team">
      <div data-reveal>
        <p class="eyebrow">{team.title}</p>
        <h2>Кто работает над проектом</h2>
        <p class="muted team-lead">{t(team.lead)}</p>
        <p class="founder">{t(team.founder)}</p>
      </div>
      <dl class="roles" data-reveal style="--d: 120ms">
        {team.roles.map((r) => (
          <div class="ui-card">
            <dt>{r.title}</dt>
            <dd>{t(r.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Продукт: бот -->
  <section class="section section--dark gridded" id="bot">
    <div class="container bot">
      <div class="bot-visual" data-reveal>
        <BotMessage />
      </div>
      <div data-reveal style="--d: 120ms">
        <p class="eyebrow">Продукт · {bot.badge}</p>
        <h2>{bot.title}</h2>
        <p class="bot-lead">{t(bot.lead)}</p>
        <ul class="dots bot-list">
          {bot.items.map((i) => <li>{t(i)}</li>)}
        </ul>
        <p class="tagline">{t(bot.tagline)}</p>
        <div class="btn-row">
          <a class="btn btn-light" href={site.botUrl}>{bot.cta}</a>
          <a class="btn btn-ghost-light" href={site.telegramUrl}>Задать вопрос</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section gridded" id="faq">
    <div class="container faq-wrap">
      <div data-reveal>
        <p class="eyebrow">Вопросы</p>
        <h2>Частые вопросы</h2>
        <p class="muted faq-more">Не нашли ответ? <a href={site.telegramUrl}>Напишите в Telegram</a></p>
      </div>
      <div class="faq" data-reveal style="--d: 120ms">
        {faq.map((f) => (
          <details class="ui-card">
            <summary>{t(f.q)}</summary>
            <p class="muted">{t(f.a)}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- Финальный блок -->
  <section class="section section--dark gridded final" id="contact">
    <div class="container final-inner" data-reveal>
      <p class="eyebrow">Контакты</p>
      <h2>{finalCta.title}</h2>
      <p class="final-text">{t(finalCta.text)}</p>
      <ul class="final-list">
        {finalCta.items.map((i, k) => <li><b>{k + 1}</b>{t(i)}</li>)}
      </ul>
      <div class="btn-row final-btns">
        <a class="btn btn-light" href={site.telegramUrl}>Написать в Telegram @{site.telegram}</a>
        <a class="btn btn-ghost-light" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </section>
</Base>

<script>
  // Счётчики в полосе цифр: от нуля до значения, один раз
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const nums = document.querySelectorAll<HTMLElement>('[data-count]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        const el = e.target as HTMLElement;
        const final = el.dataset.count!;
        const m = final.match(/^([\d\s ]+)(?:,(\d+))?(.*)$/);
        if (!m) return;
        const whole = Number(m[1].replace(/[\s ]/g, ''));
        const dec = m[2] ?? '';
        const target = Number(`${whole}.${dec || 0}`);
        const tail = m[3];
        const t0 = performance.now();
        const dur = 1400;
        const fmt = (v: number) => {
          const [a, b] = v.toFixed(dec.length).split('.');
          const grouped = a.length > 4 ? a.replace(/\B(?=(\d{3})+(?!\d))/g, ' ') : a;
          return b ? `${grouped},${b}` : grouped;
        };
        const step = (now: number) => {
          const k = Math.min(1, (now - t0) / dur);
          const eased = 1 - Math.pow(1 - k, 3);
          el.textContent = k < 1 ? fmt(target * eased) + tail : final;
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  }
</script>

<style>
  /* Первый экран */
  .hero { padding: var(--s6) 0 var(--s6); background-color: var(--bg); }
  .hero-head { text-align: center; }
  .hero-head p { margin-left: auto; margin-right: auto; }
  .hero h1 { max-width: 14em; margin: 0 auto; }
  .h1-accent { color: var(--accent); }
  .hero-lead { margin-top: var(--s3); max-width: 38em; color: var(--ink-2); font-size: 1.08em; }
  @media (max-width: 719px) {
    .hero { padding-top: var(--s6); }
    .hero-head { text-align: left; }
    .hero-head p { margin-left: 0; }
    .hero h1 { margin: 0; }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--s4) var(--s3);
    margin-top: var(--s5);
  }
  @media (min-width: 1024px) { .facts { grid-template-columns: repeat(4, 1fr); gap: 0; text-align: center; } }
  .facts dt { font-size: clamp(30px, 3.2vw, 40px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; color: var(--accent); }
  .facts dd { margin: var(--s1) auto 0; max-width: 16em; color: var(--ink-2); font-size: 15px; line-height: 1.45; }
  @media (max-width: 1023px) { .facts dd { margin-left: 0; } }

  /* Направления */
  .practice {
    display: grid;
    gap: var(--s5);
    padding: var(--s6) 0;
    border-top: 1px solid var(--line);
  }
  .practice:first-of-type { border-top: 0; padding-top: 0; }
  @media (min-width: 1024px) {
    .practice { grid-template-columns: 1fr 1fr; column-gap: 112px; align-items: start; padding: var(--s7) 0; }
  }
  .practice-head { border-left: 2px solid var(--gold); padding-left: var(--s3); margin-left: -1px; }
  .practice-head .eyebrow { margin-bottom: var(--s1); }
  .practice-lead { margin: var(--s3) 0; color: var(--ink-2); }
  .practice .dots { margin-bottom: var(--s4); }
  .practices-note { margin-top: var(--s2); }

  /* Цифры */
  .stats { display: grid; gap: var(--s4) 0; }
  @media (min-width: 720px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .stats { grid-template-columns: repeat(4, 1fr); } }
  .stat { padding: 0 var(--s3) 0 0; }
  @media (min-width: 720px) { .stat:not(:first-child) { padding-left: var(--s3); } }
  @media (min-width: 720px) and (max-width: 1023px) { .stat:nth-child(3) { padding-left: 0; } }
  .stat-value { font-size: clamp(40px, 4.4vw, 60px); font-weight: 700; letter-spacing: -0.03em; color: var(--gold-on-deep); line-height: 1; }
  .stat-unit { display: block; margin-top: var(--s1); font-size: 18px; font-weight: 600; color: var(--on-deep); }
  .stat dd { margin-top: 6px; color: var(--on-deep-2); font-size: 15px; max-width: 18em; }

  /* Сетка из четырёх колонок по линиям страницы */
  .cols4 { display: grid; gap: var(--s4) 0; list-style: none; padding: 0; }
  @media (min-width: 720px) { .cols4 { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cols4 { grid-template-columns: repeat(4, 1fr); } }
  .col { padding-right: var(--s3); }
  @media (min-width: 1024px) { .col:not(:first-child) { padding-left: var(--s3); } }
  @media (min-width: 720px) and (max-width: 1023px) { .col:nth-child(even) { padding-left: var(--s3); } }

  .col-num { display: block; margin-bottom: var(--s2); font-size: 14px; font-weight: 700; color: var(--gold-ink); }
  .areas h3 { margin-bottom: var(--s2); font-size: 22px; }
  .areas ul { list-style: none; padding: 0; display: grid; gap: 8px; color: var(--ink-2); font-size: 16px; }
  .geo { margin-top: var(--s6); padding-top: var(--s4); border-top: 1px solid var(--line); }
  .geo h3 { font-size: 22px; margin-bottom: var(--s1); }
  .geo-region { font-size: 14px; color: var(--ink-3); }
  .geo-countries { margin-top: 2px; font-size: 20px; font-weight: 700; }

  /* Кейсы */
  .cases { display: grid; gap: var(--s3); }
  @media (min-width: 900px) { .cases { grid-template-columns: repeat(3, 1fr); } }
  .case { display: flex; flex-direction: column; padding: 8px; }
  .case-visual {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 180px;
    padding: 48px var(--s3) var(--s3);
    border-radius: 6px;
    background: var(--deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .case-tag { position: absolute; top: 14px; left: 16px; color: var(--gold-on-deep); font-size: 13px; font-weight: 600; }
  .cv-card { width: 100%; max-width: 280px; padding: 12px 14px; border-radius: 8px; background: var(--surface); font-size: 13px; display: grid; gap: 8px; }
  .cv-card p { display: flex; align-items: center; justify-content: space-between; gap: 8px; max-width: none; }
  .cv-card span { color: var(--ink-3); }
  .cv-dup { padding: 4px 6px; margin: 0 -6px; border-radius: 6px; background: var(--risk-soft); }
  .cv-dup em { font-style: normal; font-weight: 700; color: var(--risk); }
  .cv-bars p { display: grid; grid-template-columns: 52px 1fr; }
  .cv-bars i { display: block; height: 10px; width: var(--w); border-radius: 5px; background: var(--accent-2); }
  .cv-over i { background: var(--risk); }
  .cv-irr { display: flex; align-items: baseline; justify-content: center; gap: 10px; font-size: 15px; }
  .cv-irr b { font-size: 30px; letter-spacing: -0.02em; }
  .cv-risk { color: var(--risk); }
  .case-body { padding: var(--s3) var(--s2) var(--s2); }
  .case-body h3 { font-size: 21px; }
  .case-dl { display: grid; gap: 2px; margin-top: var(--s2); font-size: 16px; }
  .case-dl dt { color: var(--ink-3); font-size: 13px; margin-top: var(--s1); }
  .case-result { font-weight: 700; color: var(--accent); }

  /* Подход: номера на линиях сетки */
  .approach .col { position: relative; }
  .approach-num {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: var(--s3);
    border-radius: 50%;
    background: var(--accent);
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    box-shadow: 0 0 0 6px var(--accent-soft);
  }
  @media (min-width: 1024px) {
    .approach .col { padding-left: var(--s4); }
    .approach-num { margin-left: calc(-1 * var(--s4) - 18px); }
  }
  .approach h3 { font-size: 21px; }
  .approach p { margin-top: 6px; font-size: 16px; }

  /* Команда */
  .team { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .team { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .team-lead { margin-top: var(--s3); }
  .founder { margin-top: var(--s3); padding-left: var(--s3); border-left: 2px solid var(--gold); font-size: 17px; }
  .roles { display: grid; gap: var(--s2); }
  @media (min-width: 640px) { .roles { grid-template-columns: 1fr 1fr; } }
  .roles > div { padding: var(--s3); }
  .roles dt { font-weight: 700; font-size: 18px; }
  .roles dd { margin-top: 6px; color: var(--ink-2); font-size: 15px; }

  /* Бот */
  .bot { display: grid; gap: var(--s5); align-items: center; }
  @media (min-width: 1024px) { .bot { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .bot-visual { display: grid; justify-items: center; }
  .bot-visual :global(.chat) { width: 100%; }
  .bot-visual :global(figcaption) { color: var(--on-deep-2); }
  .bot-lead { margin-top: var(--s3); color: var(--on-deep-2); }
  .bot-list { margin: var(--s3) 0; }
  .tagline { margin-bottom: var(--s4); font-weight: 700; font-size: 20px; color: var(--gold-on-deep); }

  /* FAQ */
  .faq-wrap { display: grid; gap: var(--s5); }
  @media (min-width: 1024px) { .faq-wrap { grid-template-columns: 1fr 1fr; column-gap: 112px; } }
  .faq-more { margin-top: var(--s3); }
  .faq { display: grid; gap: 10px; }
  .faq details { padding: 18px 22px; box-shadow: none; }
  .faq summary {
    cursor: pointer;
    font-weight: 600;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: var(--s2);
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { content: '+'; color: var(--gold-ink); font-weight: 600; font-size: 22px; line-height: 1; }
  .faq details[open] summary::after { content: '−'; }
  .faq details p { margin-top: var(--s1); font-size: 16px; }

  /* Финальный блок */
  .final-inner { text-align: center; display: grid; justify-items: center; }
  .final-text { margin-top: var(--s3); color: var(--on-deep-2); }
  .final-list { list-style: none; padding: 0; margin: var(--s4) 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .final-list li {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-radius: 8px;
