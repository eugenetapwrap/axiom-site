---
import Base from '../layouts/Base.astro';
---

<Base title="Страница не найдена — Axiom Consulting" description="Такой страницы нет.">
  <main id="main" class="container nf">
    <p class="eyebrow">404</p>
    <h1>Такой страницы нет</h1>
    <p>Возможно, ссылка устарела. Всё о наших услугах — на главной.</p>
    <a class="btn btn--primary" href="/">На главную</a>
  </main>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    padding-top: var(--s-9);
    padding-bottom: var(--s-9);
  }
  h1 {
    font-size: var(--fs-3xl);
  }
</style>
